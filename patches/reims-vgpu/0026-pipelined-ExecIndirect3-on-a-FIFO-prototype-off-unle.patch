+    /// LOCAL (Atlas, VM-B): an exec of a pipelining FIFO that was refused or faulted before its
+    /// commit still moves the FIFO's event chain on, as its success would have: one command buffer
+    /// that waits as the exec's would (`fifo_event_value_in`, unless 0 or this task's own last
+    /// value), stores and signals `fifo_event_value_in + 1` when scheduled, and commits. A later
+    /// exec of another task, sent with that value before this reply, waits for it. `false` when
+    /// nothing was committed (no FIFO event, no command queue, or a raise, landed): the host's
+    /// settlement then signals it (`tasks::remote::PendingRemoteExec`).
+    fn fill_chain(&self, hold: Hold<'_>, stamp_index: u32, fifo_event_value_in: u64) -> bool {
+        let Some((event, signaled)) = self.fifo(stamp_index) else {
+            return false;
+        };
+        if event.is_none() {
+            return false;
+        }
+        let filled = (|| -> RaiseResult<bool> {
+            let command_queue = self.command_queue.lock().as_ref().map(Handle::clone_ref);
+            let command_buffer = match &command_queue {
+                Some(q) => q.command_buffer(OnFault::Return)?,
+                None => None,
+            };
+            let Some(b) = &command_buffer else {
+                return Ok(false);
+            };
+            let signaled_value = signaled.load(Ordering::SeqCst);
+            if fifo_event_value_in != 0 && fifo_event_value_in != signaled_value {
+                b.encode_wait(event.as_ref().map(EventRef::Shared), fifo_event_value_in)?;
+            }
+            let value = fifo_event_value_in.wrapping_add(1);
+            signaled.store(value, Ordering::SeqCst);
+            b.encode_signal_when_scheduled(event.as_ref(), value)?;
+            b.commit(OnFault::Return)?;
+            Ok(true)
+        })();
+        match filled {
+            Ok(f) => f,
+            Err(t) => {
+                log::warn!("task {}: the FIFO chain's fill faulted: {}", self.id(), exception(&t));
+                hold.land(t);
+                false
+            }
+        }
+    }
