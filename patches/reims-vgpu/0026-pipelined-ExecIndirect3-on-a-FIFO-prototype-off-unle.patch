+/// LOCAL (Atlas, VM-B): a remote exec a pipelining FIFO sent and has not settled
+/// (`fifo::pipeline`): what `RemoteTask::exec` does after its reply, run at the settlement.
+pub(crate) struct PendingRemoteExec<P: Platform> {
+    /// The reply's wait: its handler stores nothing (the value was reserved at the send).
+    gpu_token: Arc<Token>,
+    /// The completion token, completed here on a failure as on the base path.
+    token: Arc<Token>,
+    backings: Arc<Mutex<Backings>>,
+    endpoint: Arc<Endpoint<P>>,
+    /// The FIFO's event and the value this exec waits for: on a failure the service did not
+    /// carry, the host signals `value_in + 1` once `value_in` is reached.
+    event: Option<P::SharedEvent>,
+    value_in: u64,
+    /// Set by the service when the chain's value is its to signal (`GpuTask::fill_chain`).
+    carried: Arc<std::sync::atomic::AtomicBool>,
+}
+
+/// How long a failure's settlement waits for the chain to reach its value before it signals the
+/// next one anyway.
+const CHAIN_WAIT_MS: u64 = 5000;
+
+impl<P: Platform> crate::fifo::pipeline::PendingExec for PendingRemoteExec<P> {
+    fn replied(&self) -> bool {
+        self.gpu_token.is_complete()
+    }
+
+    fn settle(self: Box<Self>, hold: Hold<'_>) {
+        let status = self.gpu_token.wait();
+        let ids = backing_ids(&self.backings);
+        self.endpoint
+            .device_link()
+            .invalidate_shared_texture_backings(hold, &ids);
+        if status != ExecStatus::OK && status != ExecStatus::CRASHED {
+            self.endpoint.completions().complete(&self.token, status);
+        }
+        if status != ExecStatus::OK
+            && !self.carried.load(Ordering::SeqCst)
+            && let Some(event) = &self.event
+        {
+            // The chain waits for this exec's value: once the previous one is reached, and unless
+            // this one already is (a dead task's committed buffer), the host signals it.
+            let next = self.value_in.wrapping_add(1);
+            if !event.wait_until_signaled_value(self.value_in, CHAIN_WAIT_MS) {
+                log::warn!(
+                    "FIFO chain: value {} not reached in {CHAIN_WAIT_MS} ms; signalling {next}",
+                    self.value_in
+                );
+            }
+            if !event.wait_until_signaled_value(next, 0) {
+                if let Err(e) = event.set_signaled_value(next) {
+                    log::warn!("FIFO chain: signalling {next} failed: {}", e.exception());
+                    hold.land(e);
+                }
+            }
+        }
+    }
+}
+
+/// The reply's count of ids, bounded by the ids it sent (the service always sends as many as it
+/// counts).
+fn backing_ids(backings: &Mutex<Backings>) -> Vec<u32> {
+    let b = backings.lock();
+    let all: Vec<u32> = b
+        .data
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|w| u32::from_ne_bytes(*w))
+        .collect();
+    let n = b.count.to_usize().min(all.len());
+    all.get(..n).map(<[u32]>::to_vec).unwrap_or_default()
+}
+
+impl<P: Platform> RemoteTask<P> {
+    /// LOCAL (Atlas, VM-B): ExecIndirect3 on a pipelining FIFO: shares the FIFO's event, reserves
+    /// the FIFO's event value (the base path advances it on the reply of 1), sends the command with
+    /// the fill flag, and returns what follows the reply, for the FIFO's settlement.
+    pub(crate) fn exec_indirect3_pipelined(
+        &self,
+        args: ExecArgs<'_, P, CmdExecIndirectResource3>,
+        done: Completion,
+    ) -> Box<dyn crate::fifo::pipeline::PendingExec> {
+        let data = command_data(&args.resources, &args.cmd_buffers);
+        self.share_fifo_event(args.fifo_event, args.stamp_index);
+        let value_in = args.fifo_event_value.fetch_add(1, Ordering::SeqCst);
+        let gpu_token = self.endpoint.completions().issue();
+        let backings = Arc::new(Mutex::new(Backings::default()));
+        let token = self.endpoint.completions().issue_with(completing(done));
+        let carried = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let reply = {
+            let reply = ExecReply {
+                gpu_token: gpu_token.clone(),
+                _token: token.clone(),
+                backings: backings.clone(),
+                endpoint: self.endpoint.clone(),
+                _task: self.me.upgrade(),
+            };
+            Reply::new(move |v: (u32, Option<Vec<u8>>, u32)| reply.invoke(v))
+        };
+        self.link.send(ToService::ExecIndirect3 {
+            data,
+            cmd_buffer_count: args.cmd_buffers.count(),
+            resource_count: args.resources.count(),
+            stamp_index: args.stamp_index,
+            fifo_event_value_in: value_in,
+            gpu_completion: token.id(),
+            fill_on_failure: Some(carried.clone()),
+            reply,
+        });
+        Box::new(PendingRemoteExec {
+            gpu_token,
+            token,
+            backings,
+            endpoint: self.endpoint.clone(),
+            event: args.fifo_event.map(Handle::clone_ref),
+            value_in,
+            carried,
+        })
+    }
+}
