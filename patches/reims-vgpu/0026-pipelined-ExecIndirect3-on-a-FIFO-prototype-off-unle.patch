new file mode 100644
index 00000000..9734e771
--- /dev/null
+++ b/crates/reims-vgpu-core/src/fifo/pipeline.rs
@@ -0,0 +1,238 @@
+//! LOCAL (Atlas, VM-B, branch atlas/deep-multisim-pipeline-exec): pipelined remote execs.
+//!
+//! The base FIFO thread blocks in each remote exec until the task's service replied
+//! (`tasks::remote::RemoteTask::exec`), so every task's execs on one FIFO run one after
+//! another. A pipelining FIFO sends a remote exec and goes on; the part of the exec that followed
+//! the reply (the kernel task's shared-texture invalidation, a failure's completion) runs later on
+//! the FIFO's thread, in send order, at a settlement:
+//! - before each pipelined exec, every pending exec whose reply came (no wait), and the oldest
+//!   while [`WINDOW`] are pending (a wait);
+//! - before every other command, all of them (waits): every non-exec command sees what it sees on
+//!   the base path;
+//! - before the thread waits for ring bytes, the replied ones, and the wait is then at most
+//!   [`IDLE_POLL`] while any is pending; at the loop's end, all of them.
+//!
+//! Per task, the task's serial connection and service queues keep its execs in order. Across
+//! tasks the FIFO's shared-event chain keeps them in order on the GPU (`gpu_task::exec`): the FIFO's
+//! event value is reserved at the send, and a refused or faulted exec still moves the chain on
+//! (the service's fill, or the host's signal at settlement after a crash).
+//!
+//! The switch: `REIMS_VGPU_PIPELINE_EXEC=<path>`; pipelining is on while that file exists, looked
+//! at most once a second and only while nothing is pending. Unset: the base path, unchanged.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+use parking_lot::Mutex;
+
+use super::Fifo;
+use crate::platform::Platform;
+use crate::rt::Hold;
+use crate::rt::held::Held;
+use crate::rt::pool::Pool;
+
+/// The most remote execs a FIFO keeps sent and unsettled.
+pub const WINDOW: usize = 8;
+
+/// While execs are pending, the longest wait for ring bytes before the replied ones settle.
+pub const IDLE_POLL: Duration = Duration::from_micros(500);
+
+/// One remote exec sent and not settled.
+pub trait PendingExec: Send + Sync {
+    /// Whether its reply came (its settlement will not wait).
+    fn replied(&self) -> bool;
+    /// What followed the reply on the base path, after waiting for it.
+    fn settle(self: Box<Self>, hold: Hold<'_>);
+}
+
+/// The switch file, and its last look.
+struct Switch {
+    path: Option<std::path::PathBuf>,
+    look: Mutex<(Option<Instant>, bool)>,
+}
+
+fn switch() -> &'static Switch {
+    static S: OnceLock<Switch> = OnceLock::new();
+    S.get_or_init(|| Switch {
+        path: std::env::var_os("REIMS_VGPU_PIPELINE_EXEC")
+            .filter(|p| !p.is_empty())
+            .map(std::path::PathBuf::from),
+        look: Mutex::new((None, false)),
+    })
+}
+
+/// Counts for the log, all FIFOs together: execs sent pipelined, settlements that waited for a
+/// reply (and of those, the ones the full window forced), and the settlements of pending execs a
+/// non-exec command forced, by opcode.
+struct Stats {
+    sent: AtomicU64,
+    waited: AtomicU64,
+    full: AtomicU64,
+    forced: [AtomicU64; 128],
+    last: Mutex<Option<Instant>>,
+}
+
+static STATS: Stats = Stats {
+    sent: AtomicU64::new(0),
+    waited: AtomicU64::new(0),
+    full: AtomicU64::new(0),
+    forced: [const { AtomicU64::new(0) }; 128],
+    last: Mutex::new(None),
+};
+
+/// Logs the counts (and resets them) at most every 10 s.
+fn log_stats() {
+    let now = Instant::now();
+    {
+        let mut last = STATS.last.lock();
+        match *last {
+            None => {
+                *last = Some(now);
+                return;
+            }
+            Some(t) if now.duration_since(t) < Duration::from_secs(10) => return,
+            Some(_) => *last = Some(now),
+        }
+    }
+    let sent = STATS.sent.swap(0, Ordering::Relaxed);
+    let waited = STATS.waited.swap(0, Ordering::Relaxed);
+    let full = STATS.full.swap(0, Ordering::Relaxed);
+    let mut forced = String::new();
+    for (op, n) in STATS.forced.iter().enumerate() {
+        let n = n.swap(0, Ordering::Relaxed);
+        if n != 0 {
+            forced.push_str(&format!(" {op}:{n}"));
+        }
+    }
+    if sent != 0 {
+        log::info!("FIFO exec pipelining: {sent} sent, {waited} waited ({full} window full), forced by opcode:{forced}");
+    }
+}
+
+/// Whether pipelining is wanted now (the file, looked at most once a second).
+fn wanted() -> bool {
+    let s = switch();
+    let Some(path) = &s.path else {
+        return false;
+    };
+    let mut look = s.look.lock();
+    let now = Instant::now();
+    if look.0.is_none_or(|t| now.duration_since(t) >= Duration::from_secs(1)) {
+        log_stats();
+        let on = path.exists();
+        if on != look.1 {
+            log::info!("FIFO exec pipelining {}", if on { "on" } else { "off" });
+        }
+        *look = (Some(now), on);
+    }
+    look.1
+}
+
+impl<P: Platform> Fifo<P> {
+    /// Whether this FIFO pipelines its next remote exec: it follows the switch only while nothing
+    /// is pending.
+    pub(crate) fn pipelining(&self) -> bool {
+        if self.pending.lock().is_empty() {
+            let on = wanted();
+            self.pipelining.store(on, Ordering::Relaxed);
+            on
+        } else {
+            self.pipelining.load(Ordering::Relaxed)
+        }
+    }
+
+    /// Settles `p` under a pool and a holder of its own, as a command's.
+    fn settle_one(&self, p: Box<dyn PendingExec>) {
+        if !p.replied() {
+            STATS.waited.fetch_add(1, Ordering::Relaxed);
+        }
+        let pool = Pool::push(&*self.platform);
+        let held = Held::new();
+        p.settle(Hold::of(&held));
+        drop(held);
+        drop(pool);
+    }
+
+    /// Before a pipelined exec: settles the replied execs at the front, then the oldest while the
+    /// window is full.
+    pub(crate) fn settle_before_exec(&self) {
+        loop {
+            let next = {
+                let mut q = self.pending.lock();
+                match q.front() {
+                    Some(f) if f.replied() => q.pop_front(),
+                    Some(_) if q.len() >= WINDOW => {
+                        STATS.full.fetch_add(1, Ordering::Relaxed);
+                        q.pop_front()
+                    }
+                    _ => None,
+                }
+            };
+            match next {
+                Some(p) => self.settle_one(p),
+                None => return,
+            }
+        }
+    }
+
+    /// Settles the replied execs at the front (no wait).
+    pub(crate) fn settle_replied(&self) {
+        loop {
+            let next = {
+                let mut q = self.pending.lock();
+                match q.front() {
+                    Some(f) if f.replied() => q.pop_front(),
+                    _ => None,
+                }
+            };
+            match next {
+                Some(p) => self.settle_one(p),
+                None => return,
+            }
+        }
+    }
+
+    /// Whether an exec is pending.
+    pub(crate) fn has_pending(&self) -> bool {
+        !self.pending.lock().is_empty()
+    }
+
+    /// Keeps a sent exec for its settlement.
+    pub(crate) fn keep_pending(&self, p: Box<dyn PendingExec>) {
+        STATS.sent.fetch_add(1, Ordering::Relaxed);
+        self.pending.lock().push_back(p);
+    }
+
+    /// Before a command other than ExecIndirect3: settles every pending exec, counted under the
+    /// command's opcode.
+    pub(crate) fn settle_for_command(&self, command_id: u16) {
+        if self.settle_all() {
+            let i = usize::from(command_id).min(STATS.forced.len() - 1);
+            if let Some(n) = STATS.forced.get(i) {
+                n.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+
+    /// Settles every pending exec, oldest first; whether there was one.
+    pub(crate) fn settle_all(&self) -> bool {
+        let mut any = false;
+        loop {
+            let next = self.pending.lock().pop_front();
+            match next {
+                Some(p) => {
+                    any = true;
+                    self.settle_one(p);
+                }
+                None => return any,
+            }
+        }
+    }
+
+    /// Tests: how many execs are pending.
+    #[cfg(test)]
+    pub(crate) fn pending_count(&self) -> usize {
+        self.pending.lock().len()
+    }
+}
