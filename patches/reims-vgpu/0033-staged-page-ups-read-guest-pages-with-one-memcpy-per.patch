+    /// Copies guest physical `physical..+dst.len()` into `dst` with one `memcpy`; false when
+    /// no range of the map holds it all. For a staged page-up's pages only: no GPU access to
+    /// them is pending (`memory::page_refs`) and the guest's CPU may not write a committed
+    /// command buffer's resource, so nothing writes them while they are read.
+    fn read_guest(map: &MemoryMap<P>, physical: u64, dst: &mut [u8]) -> bool {
+        let source = map.virtual_address_for_physical(physical, dst.len().to_u64());
+        if source.is_null() {
+            return false;
+        }
+        #[allow(unsafe_code)] // architecture 17.3: a bulk read of mapped guest RAM
+        // SAFETY: `source..source + dst.len()` lies in one range of the map, which the map's
+        // owner keeps mapped while the map lives (`map` holds it here), and `dst` is ours.
+        unsafe {
+            std::ptr::copy_nonoverlapping(source.as_ptr::<u8>(), dst.as_mut_ptr(), dst.len());
+        }
+        true
+    }
+
     /// Whether every byte of the guest's `ranges` reads zero, read a page at a time and stopping
