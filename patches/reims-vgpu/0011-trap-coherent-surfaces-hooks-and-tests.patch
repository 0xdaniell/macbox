diff --git a/scripts/internal/census/coherent_test.c b/scripts/internal/census/coherent_test.c
new file mode 100644
index 00000000..3cb7eca5
--- /dev/null
+++ b/scripts/internal/census/coherent_test.c
@@ -0,0 +1,483 @@
+// coherent_test.c: the coherent pages of QEMU's accel/kvm/census.c on a real KVM guest, with no
+// QEMU and no library: this file plays the library's surface (an image, a lock, syncs at faults),
+// census_test.c plays kvm-all.c, and the guest's instructions run in CPL0 on real pages, so
+// `rep movsb` and the emulator's accesses are the ones the kernel copies run.
+//   gcc -O2 -g -Wall -D_GNU_SOURCE -I$QEMU/include coherent_test.c $QEMU/accel/kvm/census.c -lpthread
+//   ./a.out <empty output dir> [slot_mib]
+#define CENSUS_TEST_NO_MAIN
+#include "census_test.c"
+
+#include <stdatomic.h>
+
+#define PAGES 16
+#define WORDS (PG / 8)
+
+// One surface: the "image" holds each page's current word, and a page is ahead while `ahead`.
+static struct {
+    pthread_mutex_t lock;
+    uint64_t base, off;
+    uint32_t id;
+    uint64_t image[PAGES];
+    uint8_t ahead[PAGES];
+    int probing, faults, syncs, writes, probes, resets, abandons;
+    uint64_t came, refused, probed_at;
+    int beside;     // A sync leaves the first word of each page: the rectangle stops short of it.
+    uint32_t dirty; // Pages the guest may have written, as the library would know.
+} s = {.lock = PTHREAD_MUTEX_INITIALIZER};
+
+static uint64_t page_at(int i) { return s.base + i * PG; }
+
+static void note(const uint64_t *pages, size_t n) {
+    for (size_t i = 0; i < n; i++) s.dirty |= 1u << ((pages[i] - s.base) / PG);
+}
+
+static void list_all(uint64_t *out) {
+    for (int i = 0; i < PAGES; i++) out[i] = page_at(i);
+}
+
+static void sync_all_locked(void) {
+    uint64_t list[PAGES], came[PAGES];
+    int n = 0;
+
+    for (int i = 0; i < PAGES; i++) {
+        if (s.ahead[i]) {
+            uint64_t *to = (uint64_t *)page_at(i);
+
+            for (uint64_t w = s.beside; w < WORDS; w++) to[w] = s.image[i];
+            s.ahead[i] = 0;
+            list[n++] = page_at(i);
+            s.syncs++;
+        }
+    }
+    if (n) {
+        size_t found = census_coh_hold(list, n, false, came, PAGES);
+
+        s.came += found;
+        note(came, found);
+    }
+}
+
+static void on_fault(void *ctx, uint64_t addr, bool write) {
+    uint64_t page = addr & ~(PG - 1);
+
+    pthread_mutex_lock(&s.lock);
+    s.faults++;
+    sync_all_locked();
+    if (s.probing && (now_ns() - s.probed_at > 1000000 || (write && s.probing == 1))) {
+        uint64_t list[PAGES], came[PAGES];
+
+        s.probing = 0;
+        list_all(list);
+        size_t found = census_coh_hold(list, PAGES, false, came, PAGES);
+        s.came += found;
+        note(came, found);
+    } else if (write && s.probing) {
+        s.probing--;
+    }
+    census_coh_hold(&page, 1, false, NULL, 0);
+    if (write) {
+        census_coh_open(page);
+        note(&page, 1);
+        s.writes++;
+    }
+    pthread_mutex_unlock(&s.lock);
+}
+
+static void on_timed(void *ctx, uint64_t addr, uint64_t ns) {}
+
+static void on_probe(void *ctx) {
+    uint64_t list[PAGES];
+
+    pthread_mutex_lock(&s.lock);
+    s.probing++;
+    s.probed_at = now_ns();
+    s.probes++;
+    list_all(list);
+    size_t found = census_coh_arm(list, PAGES, list, PAGES);
+    s.came += found;
+    note(list, found);
+    pthread_mutex_unlock(&s.lock);
+}
+
+static void on_abandon(void *ctx) {
+    pthread_mutex_lock(&s.lock);
+    sync_all_locked();
+    s.abandons++;
+    census_coh_untrack(s.base);
+    pthread_mutex_unlock(&s.lock);
+}
+
+static void on_reset(void *ctx) { s.resets++; }
+
+static size_t on_report(void *ctx, const char *label, char *out, size_t room) { return 0; }
+
+static const CensusCoherentOps ops = {
+    .fault = on_fault, .timed = on_timed, .probe = on_probe, .abandon = on_abandon,
+    .reset = on_reset, .report = on_report,
+};
+
+static void surface(uint32_t id, uint64_t off) {
+    uint64_t list[PAGES];
+
+    for (uint64_t i = 0; i < PAGES; i++) list[i] = (uint64_t)main_map + off + i * PG;
+    CensusSurface f = {.mapping_id = id, .width = 2000, .height = 2000, .pixel_format = 0x42475241,
+                       .alloc_size = PAGES * PG, .bytes_per_row = 8000,
+                       .base_address = (uint64_t)main_map + off};
+    census_surface_mapped(&f, list, PAGES, PG);
+    s.id = id; s.off = off; s.base = (uint64_t)main_map + off;
+    memset(s.ahead, 0, sizeof s.ahead);
+    s.probing = 0;
+    if (!census_coh_track(s.base, PAGES * PG)) DIE("track");
+}
+
+// The GPU wrote `word` over the pages `mask` holds, and the command buffer completed.
+static void completed(uint32_t mask, uint64_t word) {
+    uint64_t list[PAGES];
+    int n = 0;
+
+    pthread_mutex_lock(&s.lock);
+    for (int i = 0; i < PAGES; i++) {
+        if (mask >> i & 1) {
+            s.image[i] = word;
+            s.ahead[i] = 1;
+            list[n++] = page_at(i);
+        }
+    }
+    size_t refused = census_coh_arm(list, n, list, PAGES);
+    if (refused) {
+        // As the library: no trap will come, and no one has heard yet.
+        s.refused += refused;
+        sync_all_locked();
+        note(list, refused);
+    }
+    pthread_mutex_unlock(&s.lock);
+}
+
+static int state(int page) { return census_page_state(main_map + s.off + page * PG); }
+static uint64_t gpa(int page) { return DATA_GPA + s.off + page * PG; }
+
+static void t_read(struct vcpu *c) {
+    printf("[read] the guest reads a page the image is ahead of\n");
+    surface(1, 0x100000);
+    CHECK(state(0) == 2, "tracked: held");
+    completed(1, 0x1111);
+    CHECK(state(0) == 1, "completion arms it");
+    setr(c, STUB(g_read), 0, gpa(0), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO && getr(c).rax == 0x1111, "the read gets the image's word");
+    CHECK(state(0) == 2, "held after the sync");
+    int faults = s.faults;
+    setr(c, STUB(g_read), 0, gpa(0), 0, 0, 0, 0);
+    run_guest(c, 0);
+    CHECK(s.faults == faults, "a second read is free");
+    census_surface_unmapped(1);
+}
+
+static void t_write(struct vcpu *c) {
+    printf("[write] a write to a held page names its page, with no read before it\n");
+    surface(2, 0x200000);
+    int probes = s.probes;
+    setr(c, STUB(g_write), 0x2222, gpa(3), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO, "the write ran");
+    CHECK(s.probes == probes + 1, "by one probe");
+    CHECK(state(3) == 3 && state(2) == 2 && state(4) == 2, "that page alone is open");
+    CHECK(*(uint64_t *)(main_map + s.off + 3 * PG) == 0x2222, "the guest's word is in the page");
+    setr(c, STUB(g_write), 0x3333, gpa(3), 0, 0, 0, 0);
+    run_guest(c, 0);
+    CHECK(s.probes == probes + 1, "an open page takes writes free");
+
+    printf("[write] a read that traps, then a write of the page at the same instruction\n");
+    completed(1 << 5, 0x4444);
+    setr(c, STUB(g_lock), 0, gpa(5), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO, "lock incq ran");
+    CHECK(*(uint64_t *)(main_map + s.off + 5 * PG) == 0x4445, "over the synced word");
+    CHECK(state(5) == 3, "and the page is open");
+    census_surface_unmapped(2);
+}
+
+static void t_frozen(struct vcpu *c) {
+    printf("[frozen] a page poisoned while open stops the guest until it thaws\n");
+    surface(3, 0x300000);
+    setr(c, STUB(g_write), 0x55, gpa(1), 0, 0, 0, 0);
+    run_guest(c, 0);
+    uint64_t page = page_at(1);
+    census_coh_freeze(&page, 1);
+    CHECK(state(1) == 7, "frozen");
+    setr(c, STUB(g_read), 0, gpa(1), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO && getr(c).rax == 0x55, "the read waited and got the word");
+    CHECK(state(1) == 3, "open again");
+    census_surface_unmapped(3);
+}
+
+static void t_kernel_copy(struct vcpu *c) {
+    printf("[rep movsb] a CPL0 copy over armed pages, as the kernel's at 0xffffff8005901092\n");
+    surface(4, 0x400000);
+    completed(0xff, 0x6666);
+    int syncs = s.syncs;
+    uint64_t to = DATA_GPA + 0x500000;
+    setr(c, STUB(g_repmovs), 0, 0, 8 * PG, 0, gpa(0), to);
+    CHECK(run_guest(c, 0) == RUN_IO, "the copy ran");
+    CHECK(*(uint64_t *)(main_map + 0x500000) == 0x6666 &&
+          *(uint64_t *)(main_map + 0x500000 + 8 * PG - 8) == 0x6666, "every byte is the image's");
+    CHECK(s.syncs == syncs + 8, "one sync brought all eight pages");
+    census_surface_unmapped(4);
+
+    printf("[rep movsb] a CPL0 copy into held pages\n");
+    surface(5, 0x400000);
+    memset(main_map + 0x500000, 0x77, 4 * PG);
+    setr(c, STUB(g_repmovs), 0, 0, 4 * PG, 0, DATA_GPA + 0x500000, gpa(2));
+    CHECK(run_guest(c, 0) == RUN_IO, "the copy ran");
+    CHECK(state(2) == 3 && state(5) == 3 && state(6) == 2, "the pages it wrote are open");
+    CHECK(*(uint64_t *)(main_map + s.off + 5 * PG) == 0x7777777777777777ULL, "with its bytes");
+    census_surface_unmapped(5);
+}
+
+static void t_emulator_read(struct vcpu *c) {
+    printf("[emulator] QEMU's own access to an armed page faults like the guest's\n");
+    surface(6, 0x600000);
+    completed(1, 0x8888);
+    census_coherent_access(main_map + s.off, 8, false);
+    CHECK(state(0) == 2 && *(uint64_t *)(main_map + s.off) == 0x8888, "a device's read syncs");
+    census_coherent_access(main_map + s.off + PG, 8, true);
+    CHECK(state(1) == 3, "a device's write opens the page");
+    census_surface_unmapped(6);
+}
+
+static void t_unmap_reset(struct vcpu *c) {
+    printf("[unmap] armed, held and open pages all come off\n");
+    surface(7, 0x700000);
+    completed(0xf, 1);
+    setr(c, STUB(g_write), 9, gpa(8), 0, 0, 0, 0);
+    run_guest(c, 0);
+    census_surface_unmapped(7);
+    int plain = 1;
+    for (int i = 0; i < PAGES; i++) plain &= state(i) == 6;
+    CHECK(plain, "no marker left");
+    setr(c, STUB(g_write), 3, gpa(0), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO && *(uint64_t *)(main_map + s.off) == 3, "the guest reuses the page");
+    printf("[reset] the guest resets\n");
+    surface(8, 0x700000);
+    completed(0xf, 1);
+    int resets = s.resets;
+    census_reset();
+    CHECK(s.resets == resets + 1, "the library heard");
+    setr(c, STUB(g_read), 0, gpa(0), 0, 0, 0, 0);
+    CHECK(run_guest(c, 0) == RUN_IO, "and a read after it passes");
+}
+
+// The guest reads, and must see every word whose completion it could have heard of.
+static atomic_uint_fast64_t done_word;
+static atomic_int race_stop;
+struct guest { struct vcpu c; int fatal, stale, id; uint64_t rounds; };
+static void *reader(void *p) {
+    struct guest *g = p;
+
+    while (!atomic_load(&race_stop) && !g->fatal) {
+        uint64_t known = atomic_load(&done_word);
+        int page = g->rounds++ % 8;
+
+        setr(&g->c, STUB(g_read), 0, gpa(page), 0, 0, 0, 0);
+        g->fatal = run_guest(&g->c, 0) != RUN_IO;
+        uint64_t got = getr(&g->c).rax;
+        if (got < known && g->stale++ < 3) printf("    read page %d: %lu, known %lu state %d\n", page, got, known, state(page));
+    }
+    return 0;
+}
+// Writes its own page and reads it back through the main mapping: nothing may lose it.
+static void *writer(void *p) {
+    struct guest *g = p;
+    uint64_t *own = (uint64_t *)(main_map + s.off + (8 + g->id) * PG);
+
+    while (!atomic_load(&race_stop) && !g->fatal) {
+        uint64_t word = ++g->rounds;
+
+        setr(&g->c, STUB(g_write), word, gpa(8 + g->id), 0, 0, 0, 0);
+        g->fatal = run_guest(&g->c, 0) != RUN_IO;
+        if (*own != word && g->stale++ < 3) printf("    wrote %lu, own %lu state %d rip %llx\n", word, *own, state(8 + g->id), getr(&g->c).rip);
+    }
+    return 0;
+}
+
+static void t_coherent_race(uint64_t mib) {
+    printf("[race] %lu MiB: 2 readers and 2 writers, armed and held again every 100 us\n", mib);
+    enum { R = 2, W = 2 };
+    struct guest g[R + W];
+    pthread_t th[R + W];
+    CensusCounts a, b;
+
+    surface(9, 0x800000);
+    census_counts(&a);
+    atomic_store(&done_word, 0);
+    atomic_store(&race_stop, 0);
+    for (int i = 0; i < R + W; i++) {
+        memset(&g[i], 0, sizeof g[i]);
+        vcpu_init(&g[i].c, 20 + i);
+        g[i].id = i - R;
+        pthread_create(&th[i], 0, i < R ? reader : writer, &g[i]);
+    }
+    uint64_t t0 = now_ns(), word = 0;
+    for (int i = 0; i < 30000; i++) {
+        completed(0xff, ++word);
+        // Only now could the guest have heard: its next read must see this word.
+        atomic_store(&done_word, word);
+        if (i % 7 == 0) {
+            uint64_t list[PAGES], came[PAGES];
+
+            list_all(list);
+            pthread_mutex_lock(&s.lock);
+            sync_all_locked();
+            s.came += census_coh_hold(list + 8, 8, true, came, PAGES);
+            pthread_mutex_unlock(&s.lock);
+        }
+        usleep(100);
+    }
+    atomic_store(&race_stop, 1);
+    int fatal = 0, stale = 0;
+    uint64_t reads = 0, writes = 0;
+    for (int i = 0; i < R + W; i++) {
+        pthread_join(th[i], 0);
+        fatal |= g[i].fatal;
+        stale += g[i].stale;
+        *(i < R ? &reads : &writes) += g[i].rounds;
+    }
+    census_counts(&b);
+    CHECK(!fatal, "no vCPU died in %.1f s: %lu reads, %lu writes, %lu traps, %lu probes, %lu spurious",
+          (now_ns() - t0) / 1e9, reads, writes, b.traps - a.traps, b.upgrades - a.upgrades,
+          b.spurious - a.spurious);
+    CHECK(!stale, "no read older than the last completion, no write lost (%d)", stale);
+    CHECK(b.errors == 0 && !b.dead, "no uffd error, fuse not blown (errors %lu)", b.errors);
+    printf("    pages reached as their markers moved: %lu held, %lu armed\n", s.came, s.refused);
+    census_surface_unmapped(9);
+}
+
+// Writes the first word of a page again and again, beside the rectangles the GPU leaves in it.
+static void *beside_writer(void *p) {
+    struct guest *g = p;
+
+    while (!atomic_load(&race_stop) && !g->fatal) {
+        setr(&g->c, STUB(g_write), ++g->rounds, gpa(0), 0, 0, 0, 0);
+        g->fatal = run_guest(&g->c, 0) != RUN_IO;
+    }
+    return 0;
+}
+
+static void t_arm_window(void) {
+    printf("[arming] a write as a page's markers move is in the page and the library knows it\n");
+    struct guest g;
+    pthread_t th;
+
+    surface(12, 0xe00000);
+    s.beside = 1;
+    s.dirty = 0;
+    atomic_store(&race_stop, 0);
+    memset(&g, 0, sizeof g);
+    vcpu_init(&g.c, 30);
+    pthread_create(&th, 0, beside_writer, &g);
+    volatile uint64_t *word = (uint64_t *)main_map + s.off / 8;
+    uint64_t known = 0, unseen = 0, seen = 0, list[PAGES], came[PAGES];
+    list_all(list);
+    for (int i = 0; i < 60000 && !g.fatal; i++) {
+        completed(1, i);
+        for (int spin = 0; spin < 200; spin++) __asm__("pause");
+        pthread_mutex_lock(&s.lock);
+        sync_all_locked();
+        size_t found = census_coh_hold(list, 1, true, came, PAGES);
+        note(came, found);
+        // Held: no write gets by from here to the arm.
+        uint64_t now = *word;
+        if (now != known && !(s.dirty & 1)) unseen++;
+        seen += now != known;
+        known = now;
+        s.dirty = 0;
+        pthread_mutex_unlock(&s.lock);
+    }
+    atomic_store(&race_stop, 1);
+    pthread_join(th, 0);
+    CHECK(!g.fatal && !unseen, "%lu writes in the rounds, %lu the library did not hear of", seen, unseen);
+    s.beside = 0;
+    census_surface_unmapped(12);
+}
+
+static void t_coherent_cost(struct vcpu *c) {
+    printf("[cost] trap to resume of a read whose sync moves one page\n");
+    surface(10, 0xc00000);
+    enum { N = 2000 };
+    uint64_t total = 0;
+    for (int i = 0; i < N; i++) {
+        completed(1, i + 1);
+        setr(c, STUB(g_read), 0, gpa(0), 0, 0, 0, 0);
+        uint64_t t0 = now_ns();
+        run_guest(c, 0);
+        total += now_ns() - t0;
+    }
+    printf("    %.2f us a read, the page's arm before it apart\n", total / 1e3 / N);
+    uint64_t t0 = now_ns();
+    for (int i = 0; i < N; i++) completed(1, 0), sync_all_locked();
+    printf("    %.2f us to arm and hold a page\n", (now_ns() - t0) / 1e3 / N);
+    census_surface_unmapped(10);
+
+    printf("[cost] arming and holding a surface's run of pages, nothing touching them\n");
+    static uint64_t list[3600], refused[3600], came[3600];
+    uint32_t id = 13;
+    for (size_t n = 937; n <= 3516; n += 2579, id++) {
+        uint64_t off = 0x10000000;
+
+        for (size_t i = 0; i < n; i++) list[i] = (uint64_t)main_map + off + i * PG;
+        CensusSurface f = {.mapping_id = id, .width = 2000, .height = 2000, .pixel_format = 0x42475241,
+                           .alloc_size = n * PG, .bytes_per_row = 8000,
+                           .base_address = (uint64_t)main_map + off};
+        census_surface_mapped(&f, list, n, PG);
+        census_coh_track(list[0], n * PG);
+        uint64_t armed = 0, held = 0;
+        for (int i = 0; i < 300; i++) {
+            uint64_t t0 = now_ns();
+            census_coh_arm(list, n, refused, 3600);
+            uint64_t t1 = now_ns();
+            census_coh_hold(list, n, false, came, 3600);
+            armed += t1 - t0;
+            held += now_ns() - t1;
+        }
+        printf("    %zu pages: arm %.1f us, hold %.1f us\n", n, armed / 300e3, held / 300e3);
+        census_surface_unmapped(id);
+    }
+}
+
+static void t_fuse_coherent(struct vcpu *c) {
+    printf("[fuse] an -EFAULT nothing explains: everything lands, markers off\n");
+    surface(11, 0xd00000);
+    completed(1, 0x9999);
+    int abandons = s.abandons;
+    census_fuse_test();
+    CHECK(s.abandons == abandons + 1, "the library caught up first");
+    CHECK(*(uint64_t *)(main_map + s.off) == 0x9999, "with the image's word");
+    int plain = 1, faults = s.faults;
+    for (int i = 0; i < PAGES; i++) {
+        setr(c, STUB(g_write), i, gpa(i), 0, 0, 0, 0);
+        plain &= run_guest(c, 0) == RUN_IO && *(uint64_t *)(main_map + s.off + i * PG) == (uint64_t)i;
+    }
+    CHECK(plain && s.faults == faults, "and the guest writes every page with no marker left");
+}
+
+int main(int argc, char **argv) {
+    setvbuf(stdout, 0, _IOLBF, 0);
+    if (argc < 2) return 2;
+    uint64_t mib = argc > 2 ? atol(argv[2]) : 512;
+    setenv("REIMS_VGPU_COHERENT", "1", 1);
+    setup(argv, mib);
+    CHECK(census_coherent(), "coherent is on");
+    census_coherent_set_ops(&ops);
+    struct vcpu c;
+    vcpu_init(&c, 0);
+    t_read(&c);
+    t_write(&c);
+    t_frozen(&c);
+    t_kernel_copy(&c);
+    t_emulator_read(&c);
+    t_unmap_reset(&c);
+    t_coherent_race(mib);
+    t_arm_window();
+    t_coherent_cost(&c);
+    t_fuse_coherent(&c);
+    census_flush();
+    printf("%s: %d failed\n", failures ? "FAILED" : "PASSED", failures);
+    return failures != 0;
+}
