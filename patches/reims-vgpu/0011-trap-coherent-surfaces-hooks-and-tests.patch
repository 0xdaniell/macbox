diff --git a/crates/reims-vgpu-c/src/coherent.rs b/crates/reims-vgpu-c/src/coherent.rs
new file mode 100644
index 00000000..d8f6e9ad
--- /dev/null
+++ b/crates/reims-vgpu-c/src/coherent.rs
@@ -0,0 +1,258 @@
+//! LOCAL (Atlas): trap-coherent surfaces' exports: QEMU's census view marks the pages of the
+//! surfaces metal2vulkan leaves ahead in their images (its `shadow_coherent.rs`), and tells of each
+//! touch here. On a platform without them, nothing here does anything.
+
+use std::ffi::{CStr, c_char, c_void};
+
+use crate::ffi;
+use crate::sized::{self, HostStruct};
+#[cfg(not(feature = "vulkan"))]
+use crate::status::RVG_ERR_UNSUPPORTED;
+#[cfg(feature = "vulkan")]
+use crate::status::RVG_OK;
+use crate::status::{RVG_ERR_INVALID_ARGUMENT, RvgStatus};
+
+/// What marks a trap-coherent surface's pages. See the header.
+#[repr(C)]
+#[derive(Clone, Copy)]
+#[expect(
+    missing_docs,
+    reason = "the fields' names say what they hold, as the header shows them"
+)]
+pub struct RvgCoherentHooks {
+    /// sizeof(RvgCoherentHooks) as the host was compiled.
+    pub struct_size: u32,
+    pub ctx: *mut c_void,
+    pub track: Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, start: u64, len: u64) -> bool>,
+    pub untrack: Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, start: u64)>,
+    pub arm: Option<
+        unsafe extern "C-unwind" fn(
+            ctx: *mut c_void,
+            addrs: *const u64,
+            n: usize,
+            refused: *mut u64,
+            room: usize,
+        ) -> usize,
+    >,
+    pub hold: Option<
+        unsafe extern "C-unwind" fn(
+            ctx: *mut c_void,
+            addrs: *const u64,
+            n: usize,
+            open_too: bool,
+            came: *mut u64,
+            room: usize,
+        ) -> usize,
+    >,
+    pub open: Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, addr: u64)>,
+    pub freeze: Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, addrs: *const u64, n: usize)>,
+    pub thaw: Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, addrs: *const u64, n: usize)>,
+}
+
+// SAFETY: repr(C), a u32 first; a pointer and optional function pointers.
+unsafe impl HostStruct for RvgCoherentHooks {}
+
+#[cfg(feature = "vulkan")]
+mod on {
+    use super::RvgCoherentHooks;
+    use metal2vulkan_runtime::shadow_coherent::Pages;
+
+    pub(super) use metal2vulkan_runtime::shadow_coherent as runtime;
+
+    /// The host's hooks, as the runtime's marks.
+    pub(super) struct HostPages(pub(super) RvgCoherentHooks);
+
+    // SAFETY: the host's contract: its functions run on any of the library's threads.
+    unsafe impl Send for HostPages {}
+    // SAFETY: as above.
+    unsafe impl Sync for HostPages {}
+
+    impl Pages for HostPages {
+        fn track(&self, start: u64, len: u64) -> bool {
+            // SAFETY: the host's function, given its context.
+            self.0.track.is_some_and(|track| unsafe { track(self.0.ctx, start, len) })
+        }
+
+        fn untrack(&self, start: u64) {
+            if let Some(untrack) = self.0.untrack {
+                // SAFETY: as above.
+                unsafe { untrack(self.0.ctx, start) };
+            }
+        }
+
+        fn arm(&self, pages: &[u64]) -> Vec<u64> {
+            let mut refused = vec![0; pages.len()];
+            let Some(arm) = self.0.arm else {
+                return Vec::new();
+            };
+            let (at, count, to) = (pages.as_ptr(), pages.len(), refused.as_mut_ptr());
+            // SAFETY: as above, with what lives across the call.
+            let found = unsafe { arm(self.0.ctx, at, count, to, count) };
+            refused.truncate(found);
+            refused
+        }
+
+        fn hold(&self, pages: &[u64], open_too: bool) -> Vec<u64> {
+            let mut came = vec![0; pages.len()];
+            let Some(hold) = self.0.hold else {
+                return Vec::new();
+            };
+            let (at, count, to) = (pages.as_ptr(), pages.len(), came.as_mut_ptr());
+            // SAFETY: as above.
+            let found = unsafe { hold(self.0.ctx, at, count, open_too, to, count) };
+            came.truncate(found);
+            came
+        }
+
+        fn open(&self, page: u64) {
+            if let Some(open) = self.0.open {
+                // SAFETY: as above.
+                unsafe { open(self.0.ctx, page) };
+            }
+        }
+
+        fn freeze(&self, pages: &[u64]) {
+            if let Some(freeze) = self.0.freeze {
+                // SAFETY: as above, with what lives across the call.
+                unsafe { freeze(self.0.ctx, pages.as_ptr(), pages.len()) };
+            }
+        }
+
+        fn thaw(&self, pages: &[u64]) {
+            if let Some(thaw) = self.0.thaw {
+                // SAFETY: as above, with what lives across the call.
+                unsafe { thaw(self.0.ctx, pages.as_ptr(), pages.len()) };
+            }
+        }
+    }
+}
+
+/// Before an unmap of the surface over `len` bytes from `start`: whether it may go on.
+pub(crate) fn unmapping(start: u64, len: u64) -> bool {
+    #[cfg(feature = "vulkan")]
+    return on::runtime::unmapping(start..start.wrapping_add(len));
+    #[cfg(not(feature = "vulkan"))]
+    {
+        let _ = (start, len);
+        true
+    }
+}
+
+/// Installs what marks the pages of trap-coherent surfaces. See the header.
+///
+/// # Safety
+/// `hooks` is NULL or a live table, whose functions and `ctx` live as long as the process.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_coherent_set_hooks(hooks: *const RvgCoherentHooks) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: the caller's contract.
+        let table = match unsafe { sized::read(hooks) } {
+            Ok(Some(table)) => table,
+            Ok(None) => return RVG_ERR_INVALID_ARGUMENT,
+            Err(status) => return status,
+        };
+        #[cfg(feature = "vulkan")]
+        {
+            let pages = std::sync::Arc::new(on::HostPages(table));
+            on::runtime::set_pages(Some(pages));
+            RVG_OK
+        }
+        #[cfg(not(feature = "vulkan"))]
+        {
+            let _ = table;
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+/// A page was touched. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_fault(addr: u64, write: bool) {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::fault(addr, write);
+        #[cfg(not(feature = "vulkan"))]
+        let _ = (addr, write);
+    });
+}
+
+/// How long an access stood. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_timed(addr: u64, ns: u64) {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::timed(addr, ns);
+        #[cfg(not(feature = "vulkan"))]
+        let _ = (addr, ns);
+    });
+}
+
+/// A write no one can name. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_probe() {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::probe();
+    });
+}
+
+/// Every surface back in its pages. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_abandon() {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::abandon();
+    });
+}
+
+/// The guest resets. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_reset() {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::reset();
+    });
+}
+
+/// A surface went. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_unmapped(start: u64, len: u64) {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::runtime::unmapped(start..start.wrapping_add(len));
+        #[cfg(not(feature = "vulkan"))]
+        let _ = (start, len);
+    });
+}
+
+/// The report. See the header.
+///
+/// # Safety
+/// `label` is a C string or NULL, and `out` holds `room` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_coherent_report(
+    label: *const c_char,
+    out: *mut c_char,
+    room: usize,
+) -> usize {
+    ffi::export(|| {
+        if label.is_null() {
+            return 0;
+        }
+        // SAFETY: the caller's contract.
+        let label = unsafe { CStr::from_ptr(label) }.to_string_lossy();
+        #[cfg(feature = "vulkan")]
+        let text = on::runtime::report(&label);
+        #[cfg(not(feature = "vulkan"))]
+        let text = {
+            let _ = &label;
+            String::new()
+        };
+        let count = text.len().min(room);
+        if count > 0 && !out.is_null() {
+            // SAFETY: the caller's contract; `count` is within `room`.
+            unsafe { std::ptr::copy_nonoverlapping(text.as_ptr(), out.cast(), count) };
+        }
+        count
+    })
+}
