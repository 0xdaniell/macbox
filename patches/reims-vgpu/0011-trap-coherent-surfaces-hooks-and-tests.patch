+// What marks a trap-coherent surface's pages (metal2vulkan's `shadow_coherent.rs`). Addresses are
+// the library's mapping of the surface, whole pages, ascending, one surface to a call.
+//
+// Thread: any library thread, a vCPU's in `rvg_coherent_fault` among them, under the surface's
+// lock. May call: nothing of this header.
+typedef struct {
+  // sizeof(RvgCoherentHooks) as the host was compiled.
+  uint32_t struct_size;
+  void *ctx;
+  // Every page of the surface held from now on: whether it can be.
+  bool (*track)(void *ctx, uint64_t start, uint64_t len);
+  void (*untrack)(void *ctx, uint64_t start);
+  // Held pages armed. Into up to `room` of `refused`, those a CPU reached as their markers moved,
+  // left held: how many.
+  size_t (*arm)(void *ctx, const uint64_t *addrs, size_t n, uint64_t *refused, size_t room);
+  // Into up to `room` of `came`, the pages a CPU reached as their markers moved: how many.
+  size_t (*hold)(void *ctx, const uint64_t *addrs, size_t n, bool open_too, uint64_t *came,
+                 size_t room);
+  void (*open)(void *ctx, uint64_t addr);
+  void (*freeze)(void *ctx, const uint64_t *addrs, size_t n);
+  void (*thaw)(void *ctx, const uint64_t *addrs, size_t n);
+} RvgCoherentHooks;
+
