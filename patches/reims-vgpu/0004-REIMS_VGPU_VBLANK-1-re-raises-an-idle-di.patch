+++ b/crates/reims-vgpu-core/src/display/guest_display/vblank.rs
@@ -0,0 +1,340 @@
+//! LOCAL (Atlas): `REIMS_VGPU_VBLANK=1`, an idle display's vblank.
+//!
+//! Apple's framework gives a display the host's display timing; this library's Linux path has
+//! none, so a guest display raises its present interrupt only when a frame the guest presented is
+//! done. With the variable set to `1`, a guest display that has gone a whole refresh period
+//! without a present raises the present interrupt again, for the frame it presented last, once a
+//! period, on the schedule of that frame's completion (`t0 + k * period`, `k >= 1`), as a display
+//! that scanned the frame out again at each vblank would. It writes nothing else in the page: the
+//! present count, the presented surface and `fieldfa4` stay those of the guest's last present, and
+//! it does no GPU work.
+//!
+//! - **Starts** with the first present's completion, on a thread of its own (one per guest
+//!   display that presents).
+//! - **Yields** to the guest's presents: each one starts the schedule again from its completion,
+//!   so a guest presenting at the refresh rate or faster gets no tick at all.
+//! - **Stops** while the guest sleeps (bit 0 of its sleep byte, as the presents test it), when the
+//!   client goes, and while the guest display is paused or restoring; the ticks start again with
+//!   the next present after it.
+//! - **The period** is the host's modes' highest refresh rate, 24 to 240 Hz, else 60 Hz.
+//! - **A late tick** (the thread was not run on time) raises once and goes on from the newest due
+//!   point: no burst.
+//!
+//! The variable is read once per process; unset, or any other value than `1`, no guest display
+//! has a ticker and nothing here runs. Each tick is a trace event (`vblank <ticks since the last
+//! present> <guest's enabledInterrupts>`), and the first tick of the process logs the guest's
+//! enabled interrupt bits, so a run shows whether the guest takes the bit at all.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, OnceLock, Weak};
+use std::time::Duration;
+
+use super::{GuestDisplay, INTERRUPT_PRESENT};
+use crate::display::page as sp;
+use crate::platform::Platform;
+use crate::platform::os::{Clock as _, Deadline, MonoTime};
+use crate::sync::{Condvar, Mutex};
+
+/// The variable: `1` turns the ticks on.
+pub const ENV_VAR: &str = "REIMS_VGPU_VBLANK";
+
+/// The refresh rate without a usable mode.
+const DEFAULT_HZ: f64 = 60.0;
+/// The lowest refresh rate taken from a mode.
+const MIN_HZ: f64 = 24.0;
+/// The highest refresh rate taken from a mode.
+const MAX_HZ: f64 = 240.0;
+/// The ticker thread's stack.
+const STACK: usize = 128 * 1024;
+
+/// Whether the variable turns the ticks on (read once).
+pub(crate) fn enabled_by_env() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os(ENV_VAR).is_some_and(|v| v == "1"))
+}
+
+/// Whether the first tick of the process was logged.
+static FIRST_TICK_LOGGED: AtomicBool = AtomicBool::new(false);
+
+/// The period of `hz`, or of 60 Hz outside 24-240 Hz (or not a number).
+pub(crate) fn period_of(hz: f64) -> Duration {
+    let hz = if (MIN_HZ..=MAX_HZ).contains(&hz) {
+        hz
+    } else {
+        DEFAULT_HZ
+    };
+    Duration::from_secs_f64(1.0 / hz)
+}
+
+/// What the ticker's thread and its guest display share, under [`Vblank::state`].
+#[derive(Debug)]
+struct State {
+    /// The thread was started.
+    started: bool,
+    /// The guest display ended: the thread leaves.
+    stopped: bool,
+    /// The monotonic time of the last present's completion, in nanoseconds; `None` before the
+    /// first, and after a sleep, a pause or the client's going until the next.
+    last_present: Option<u64>,
+    /// Counts the presents, so a tick decided before one is dropped.
+    epoch: u64,
+    /// The schedule points passed since the last present (the `k` of the last tick).
+    ticks: u64,
+    /// The period, in nanoseconds.
+    period_ns: u64,
+    /// Ticks raised, all told.
+    raised: u64,
+}
+
+/// A guest display's ticker (module doc).
+#[derive(Debug)]
+pub(crate) struct Vblank {
+    state: Mutex<State>,
+    cv: Condvar,
+}
+
+/// What a due tick hands the guest display.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct Tick {
+    epoch: u64,
+    k: u64,
+}
+
+impl Vblank {
+    /// A ticker at the default period, not started.
+    pub(crate) fn new() -> Arc<Vblank> {
+        Arc::new(Vblank {
+            state: Mutex::new(State {
+                started: false,
+                stopped: false,
+                last_present: None,
+                epoch: 0,
+                ticks: 0,
+                period_ns: nanos(period_of(DEFAULT_HZ)),
+                raised: 0,
+            }),
+            cv: Condvar::new(),
+        })
+    }
+
+    /// The modes' highest refresh rate sets the period (module doc).
+    pub(crate) fn set_refresh_hz(&self, hz: f64) {
+        let period = nanos(period_of(hz));
+        let mut s = self.state.lock();
+        if s.period_ns != period {
+            s.period_ns = period;
+            self.cv.notify_all();
+        }
+    }
+
+    /// The period now.
+    pub(crate) fn period(&self) -> Duration {
+        Duration::from_nanos(self.state.lock().period_ns)
+    }
+
+    /// A present completed at `now_ns`: the schedule starts again from it. Answers whether the
+    /// thread is to be started (the first present).
+    pub(crate) fn presented(&self, now_ns: u64) -> bool {
+        let mut s = self.state.lock();
+        s.last_present = Some(now_ns);
+        s.epoch = s.epoch.wrapping_add(1);
+        s.ticks = 0;
+        self.cv.notify_all();
+        let start = !s.started && !s.stopped;
+        s.started = true;
+        start
+    }
+
+    /// No ticks until the next present: the guest sleeps, the client went, or a pause.
+    pub(crate) fn idle(&self) {
+        let mut s = self.state.lock();
+        s.last_present = None;
+        s.epoch = s.epoch.wrapping_add(1);
+        self.cv.notify_all();
+    }
+
+    /// The guest display ended: the thread leaves.
+    pub(crate) fn stop(&self) {
+        self.state.lock().stopped = true;
+        self.cv.notify_all();
+    }
+
+    /// Whether `tick` is still the newest: no present, sleep or stop since it was decided.
+    fn current(&self, tick: Tick) -> bool {
+        let s = self.state.lock();
+        !s.stopped && s.epoch == tick.epoch
+    }
+
+    /// Counts a raised tick.
+    fn count(&self) -> u64 {
+        let mut s = self.state.lock();
+        s.raised = s.raised.wrapping_add(1);
+        s.raised
+    }
+
+    /// Ticks raised, all told (tests).
+    #[cfg(test)]
+    pub(crate) fn raised(&self) -> u64 {
+        self.state.lock().raised
+    }
+
+    /// Whether the thread was started (tests).
+    #[cfg(test)]
+    pub(crate) fn started(&self) -> bool {
+        self.state.lock().started
+    }
+
+    /// Waits for the next due tick on `clock`: `None` once stopped.
+    fn next_tick<C: crate::platform::os::Clock>(&self, clock: &C) -> Option<Tick> {
+        let mut s = self.state.lock();
+        loop {
+            if s.stopped {
+                return None;
+            }
+            let Some(t0) = s.last_present else {
+                clock.wait(&self.cv, &mut s);
+                continue;
+            };
+            let period = s.period_ns.max(1);
+            let k = s.ticks.saturating_add(1);
+            let due = t0.saturating_add(k.saturating_mul(period));
+            let now = clock.now_mono().as_nanos();
+            if now < due {
+                let _ = clock.wait_until(
+                    &self.cv,
+                    &mut s,
+                    Deadline::Mono(MonoTime::from_nanos(due)),
+                );
+                continue;
+            }
+            // Late: the newest due point, once.
+            let k = now
+                .saturating_sub(t0)
+                .checked_div(period)
+                .unwrap_or(k)
+                .max(k);
+            s.ticks = k;
+            return Some(Tick { epoch: s.epoch, k });
+        }
+    }
+}
+
+/// Nanoseconds of `d`, saturating.
+fn nanos(d: Duration) -> u64 {
+    u64::try_from(d.as_nanos()).unwrap_or(u64::MAX)
+}
+
+impl<P: Platform> GuestDisplay<P> {
+    /// A present completed: the ticker's schedule starts again, and its thread with the first.
+    pub(super) fn vblank_presented(&self) {
+        let Some(vb) = &self.vblank else {
+            return;
+        };
+        let now = self.platform.clock().now_mono().as_nanos();
+        if vb.presented(now) {
+            self.start_vblank_thread(Arc::clone(vb));
+        }
+    }
+
+    /// No ticks until the next present.
+    pub(super) fn vblank_idle(&self) {
+        if let Some(vb) = &self.vblank {
+            vb.idle();
+        }
+    }
+
+    /// The ticker's thread: holds the guest display weakly, and leaves when it is gone or stopped.
+    fn start_vblank_thread(&self, vb: Arc<Vblank>) {
+        let this: Weak<GuestDisplay<P>> = self.unlocked.this.clone();
+        let platform = Arc::clone(&self.platform);
+        log::info!(
+            "guest display on port {}: vblank ticks on ({ENV_VAR}=1), every {:?} while idle",
+            self.port,
+            vb.period()
+        );
+        crate::rt::thread::spawn_named(
+            self.platform.threads(),
+            "reims-vgpu.vblank",
+            STACK,
+            Box::new(()),
+            move || {
+                while let Some(tick) = vb.next_tick(platform.clock()) {
+                    let Some(guest_display) = this.upgrade() else {
+                        return;
+                    };
+                    guest_display.vblank_tick(&vb, tick);
+                }
+            },
+        );
+    }
+
+    /// One tick: the present interrupt raised again, as the present's completion raises it,
+    /// unless the guest presented, slept or was paused since the tick was decided.
+    fn vblank_tick(&self, vb: &Vblank, tick: Tick) {
+        let l = self.guest_display_mutex.lock();
+        if l.paused || l.will_restore || l.asleep & 1 != 0 {
+            drop(l);
+            vb.idle();
+            return;
+        }
+        if !vb.current(tick) {
+            return;
+        }
+        let p = self.page(&l);
+        p.fetch_or(sp::RAISED_INTERRUPTS, INTERRUPT_PRESENT);
+        let enabled = p.load(sp::ENABLED_INTERRUPTS);
+        if enabled & INTERRUPT_PRESENT != 0 {
+            self.poke();
+        }
+        let raised = vb.count();
+        drop(l);
+        // vblank: schedule points since the last present, the guest's enabled interrupt bits
+        crate::trace::event("vblank", &[tick.k, u64::from(enabled)]);
+        if !FIRST_TICK_LOGGED.swap(true, Ordering::Relaxed) {
+            log::info!(
+                "guest display on port {}: first vblank tick ({raised} raised); the guest enables \
+                 interrupts {enabled:#x}, so the tick {} the port",
+                self.port,
+                if enabled & INTERRUPT_PRESENT != 0 {
+                    "pokes"
+                } else {
+                    "only sets the bit and does not poke"
+                }
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// 60 Hz outside 24-240 Hz; the mode's rate inside
+    #[test]
+    fn period_follows_the_mode_within_bounds() {
+        assert_eq!(period_of(60.0), Duration::from_secs_f64(1.0 / 60.0));
+        assert_eq!(period_of(120.0), Duration::from_secs_f64(1.0 / 120.0));
+        assert_eq!(period_of(0.0), period_of(60.0));
+        assert_eq!(period_of(-1.0), period_of(60.0));
+        assert_eq!(period_of(f64::NAN), period_of(60.0));
+        assert_eq!(period_of(1000.0), period_of(60.0));
+    }
+
+    /// A present starts the thread once, and restarts the schedule
+    #[test]
+    fn presented_starts_once_and_restarts_the_schedule() {
+        let vb = Vblank::new();
+        assert!(vb.presented(10));
+        assert!(!vb.presented(20));
+        let s = vb.state.lock();
+        assert_eq!((s.last_present, s.epoch, s.ticks), (Some(20), 2, 0));
+    }
+
+    /// A stopped ticker starts no thread
+    #[test]
+    fn stopped_starts_no_thread() {
+        let vb = Vblank::new();
+        vb.stop();
+        assert!(!vb.presented(10));
+    }
+}
