+/// LOCAL (Atlas): `REIMS_VGPU_VBLANK=1`'s idle vblank (`vblank.rs`), on the virtual clock.
+mod vblank {
+    use super::*;
+    use crate::display::guest_display::vblank::{Vblank, period_of};
+
+    /// The real time a tick that is due may take to be raised.
+    const REAL: Duration = Duration::from_secs(10);
+    /// The real time given to a tick that must not come.
+    const SETTLE: Duration = Duration::from_millis(40);
+    const MS: Duration = Duration::from_millis(1);
+
+    /// The default period (no modes): 60 Hz.
+    fn period() -> Duration {
+        period_of(60.0)
+    }
+
+    fn vb(fx: &Fx) -> &Arc<Vblank> {
+        fx.guest_display.vblank.as_ref().unwrap()
+    }
+
+    /// A mapped present with no client: it completes at once (the completion raises 2).
+    fn present(fx: &Fx) {
+        let s = fx.p.fake_surfaces().make_simple(64, 32, FOURCC_BGRA, 4);
+        let task = fx.host.get_kernel_task(OnFault::Return).unwrap();
+        let mut l = fx.guest_display.guest_display_mutex.lock();
+        let keep = fx.guest_display.client_core();
+        present_mapped_with_surface(
+            Hold::NONE,
+            &fx.guest_display,
+            &mut l,
+            keep.as_ref(),
+            task,
+            Some(s),
+            5,
+            GammaTableArgs::default(),
+        )
+        .unwrap();
+    }
+
+    fn advance(fx: &Fx, d: Duration) {
+        fx.p.virtual_clock().advance(d);
+    }
+
+    /// Waits (real time) for `n` ticks raised in all.
+    fn raised_reaches(fx: &Fx, n: u64) -> u64 {
+        let mut left = REAL;
+        while vb(fx).raised() < n && !left.is_zero() {
+            std::thread::sleep(MS);
+            left = left.saturating_sub(MS);
+        }
+        vb(fx).raised()
+    }
+
+    /// The ticks raised once a tick that must not come has had its chance.
+    fn raised_after_settling(fx: &Fx) -> u64 {
+        std::thread::sleep(SETTLE);
+        vb(fx).raised()
+    }
+
+    /// Off without the switch: no ticker, and a present raises once
+    #[test]
+    fn off_without_the_switch() {
+        let fx = Fx::new();
+        assert!(fx.guest_display.vblank.is_none());
+        present(&fx);
+        fx.w32(sp::RAISED_INTERRUPTS, 0);
+        advance(&fx, period() * 5);
+        std::thread::sleep(SETTLE);
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), 0);
+    }
+
+    /// Starts after a period with no present, raises the present bit (poking an enabled port)
+    /// once a period, and leaves the page's present record alone
+    #[test]
+    fn starts_when_idle_and_keeps_the_period() {
+        let fx = Fx::with_vblank();
+        assert!(!vb(&fx).started());
+        fx.w32(sp::ENABLED_INTERRUPTS, INTERRUPT_PRESENT);
+        present(&fx);
+        assert!(vb(&fx).started());
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), INTERRUPT_PRESENT);
+        assert_eq!(fx.r64(sp::PRESENT_COUNT), 1);
+        fx.w32(sp::RAISED_INTERRUPTS, 0);
+        let pokes = fx.pokes();
+
+        // Not before a whole period.
+        advance(&fx, period() - MS);
+        assert_eq!(raised_after_settling(&fx), 0);
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), 0);
+
+        // At the period: one tick, as the completion raises it.
+        advance(&fx, MS);
+        assert_eq!(raised_reaches(&fx, 1), 1);
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), INTERRUPT_PRESENT);
+        assert_eq!(fx.pokes(), pokes + 1);
+        assert_eq!(fx.r64(sp::PRESENT_COUNT), 1);
+        assert_eq!(fx.r64(sp::PRESENTED_MAPPING_ID), 5);
+
+        // And one each period after.
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 2), 2);
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 3), 3);
+        assert_eq!(raised_after_settling(&fx), 3);
+        assert_eq!(fx.pokes(), pokes + 3);
+    }
+
+    /// The bit masked: the tick sets it and pokes nothing, as the completion does
+    #[test]
+    fn masked_bit_is_set_without_a_poke() {
+        let fx = Fx::with_vblank();
+        present(&fx);
+        fx.w32(sp::RAISED_INTERRUPTS, 0);
+        let pokes = fx.pokes();
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 1), 1);
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), INTERRUPT_PRESENT);
+        assert_eq!(fx.pokes(), pokes);
+    }
+
+    /// A late thread raises once, from the newest due point: no burst
+    #[test]
+    fn late_raises_once() {
+        let fx = Fx::with_vblank();
+        present(&fx);
+        advance(&fx, period() * 5 + MS);
+        assert_eq!(raised_reaches(&fx, 1), 1);
+        assert_eq!(raised_after_settling(&fx), 1);
+        // The next on the schedule: 6 periods after the present.
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 2), 2);
+        assert_eq!(raised_after_settling(&fx), 2);
+    }
+
+    /// Presents that come faster than the period get no tick; the schedule starts from the last
+    #[test]
+    fn stops_while_presents_come() {
+        let fx = Fx::with_vblank();
+        let half = period() / 2;
+        present(&fx);
+        for _ in 0..6 {
+            advance(&fx, half);
+            present(&fx);
+        }
+        advance(&fx, half);
+        assert_eq!(raised_after_settling(&fx), 0);
+        // A whole period after the last present.
+        advance(&fx, period() - half);
+        assert_eq!(raised_reaches(&fx, 1), 1);
+        // A present again: nothing until a period after it.
+        present(&fx);
+        advance(&fx, half);
+        assert_eq!(raised_after_settling(&fx), 1);
+        advance(&fx, period() - half);
+        assert_eq!(raised_reaches(&fx, 2), 2);
+    }
+
+    /// Sleep stops the ticks; a wake alone does not start them; the next present does
+    #[test]
+    fn respects_sleep() {
+        let fx = Fx::with_vblank();
+        present(&fx);
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 1), 1);
+
+        fx.guest_display.sleep_state(1);
+        advance(&fx, period() * 4);
+        assert_eq!(raised_after_settling(&fx), 1);
+        // A present while asleep: the tick finds the sleep and raises nothing.
+        present(&fx);
+        fx.w32(sp::RAISED_INTERRUPTS, 0);
+        advance(&fx, period() * 4);
+        assert_eq!(raised_after_settling(&fx), 1);
+        assert_eq!(fx.r32(sp::RAISED_INTERRUPTS), 0);
+
+        fx.guest_display.sleep_state(0);
+        advance(&fx, period() * 4);
+        assert_eq!(raised_after_settling(&fx), 1);
+
+        present(&fx);
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 2), 2);
+    }
+
+    /// Paused, the ticker leaves the page alone, and starts again with the next present
+    #[test]
+    fn paused_touches_nothing() {
+        let fx = Fx::with_vblank();
+        present(&fx);
+        fx.guest_display.pause();
+        advance(&fx, period() * 4);
+        assert_eq!(raised_after_settling(&fx), 0);
+        fx.guest_display.unpause().unwrap();
+        advance(&fx, period() * 4);
+        assert_eq!(raised_after_settling(&fx), 0);
+        present(&fx);
+        advance(&fx, period());
+        assert_eq!(raised_reaches(&fx, 1), 1);
+    }
+
+    /// The period is the host modes' highest refresh rate
+    #[test]
+    fn period_follows_the_modes() {
+        let fx = Fx::with_vblank();
+        assert_eq!(vb(&fx).period(), period_of(60.0));
+        fx.guest_display
+            .set_mode_list(
+                OnFault::Return,
+                Arc::from([mode(3440, 1440, 60.0), mode(1920, 1080, 120.0)]),
+            )
+            .unwrap();
+        assert!(sync_mode_list(&fx.guest_display));
+        assert_eq!(vb(&fx).period(), period_of(120.0));
+    }
+}
diff --git a/crates/reims-vgpu-core/src/display/guest_display/vblank.rs b/crates/reims-vgpu-core/src/display/guest_display/vblank.rs
