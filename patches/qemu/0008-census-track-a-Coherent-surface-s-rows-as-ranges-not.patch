+/* The range of s that holds its page `index`, or NULL. No lock: see CohRange. */
+static CohRange *coh_range(Surface *s, uint64_t index)
+{
+    uint32_t n = MIN(atomic_load(&s->range_count), COH_RANGES);
+
+    for (uint32_t r = 0; r < n; r++) {
+        if (index >= atomic_load(&s->ranges[r].lo) && index < atomic_load(&s->ranges[r].hi)) {
+            return &s->ranges[r];
+        }
+    }
+    return NULL;
+}
