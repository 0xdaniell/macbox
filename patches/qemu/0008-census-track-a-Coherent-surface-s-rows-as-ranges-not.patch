+    }
+    take_pages_in(s, id, lo, hi, MASK(ST_ARMED) | MASK(ST_HELD) | MASK(ST_FROZEN), true,
+                  coh_free_run, NULL);
+    atomic_fetch_sub(&census_coherent_pages, hi - lo);
+    atomic_store(&range->hi, lo);
+    range->writable = false;
+    s->tracked = false;
+    for (uint32_t r = 0; r < atomic_load(&s->range_count); r++) {
+        s->tracked |= atomic_load(&s->ranges[r].lo) != atomic_load(&s->ranges[r].hi);
+    }
+}
