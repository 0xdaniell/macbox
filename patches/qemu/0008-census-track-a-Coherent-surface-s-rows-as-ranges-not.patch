+/* One range's markers off, its pages open, and the range gone. */
+static void coh_untrack_range_locked(Surface *s, uint32_t id, CohRange *range)
+{
+    uint64_t lo = atomic_load(&range->lo), hi = atomic_load(&range->hi);
+
