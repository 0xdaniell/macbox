+/// Wait, a bounded time, until a held batch went with a copy in (`late_copies_in` past `from`).
+fn wait_for_late_copy(from: u64) {
+    let start = Instant::now();
+    while shadow_coherent::fallback_counts().late_copies_in <= from && start.elapsed() < SOON {
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+/// A blend of nothing over the case's texture (within `damage`), after a wait for `hold` at 1.
+fn blend_after(
+    case: &Case<'_>,
+    command_buffer: &CommandBuffer,
+    hold: &SharedEvent,
+    damage: Option<ScissorRect>,
+) {
+    let color = staged(case.device, &floats4([0.0; 4]));
+    let rects = std::slice::from_ref(&case.rect);
+    let blending = rects_blending(case.device);
+    command_buffer.encode_wait_for_event(hold.into(), 1).unwrap();
+    pass(command_buffer, case.texture(), &blending, rects, &color, damage);
+}
+
+/// A held batch's copy in (`shadow::LateCopies`) while another command buffer's write over the
+/// surface ran on the GPU and its command buffer had not completed (it waits for an event after
+/// its pass): the guest wrote beside that write, then set the event the reader waited for. The
+/// copy in takes the guest's texels alone, so the write in flight stays in the image.
+#[test]
+fn surface_coherent_a_late_copy_in_keeps_a_write_in_flight() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let other = case.device.new_command_queue().unwrap();
+        let gate = case.device.new_shared_event().unwrap();
+        let writer = other.command_buffer().unwrap();
+        case.pass(&writer, GREEN, scissor(0, 7, 64, 1));
+        writer.encode_wait_for_event((&gate).into(), 1).unwrap();
+        writer.commit().unwrap();
+        // Its pass runs on the GPU meanwhile; nothing the guest can see says when.
+        std::thread::sleep(Duration::from_millis(100));
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        blend_after(&case, &waiting, &hold, scissor(0, 64, WIDTH, HEIGHT - 64));
+        waiting.commit().unwrap();
+        let late = shadow_coherent::fallback_counts().late_copies_in;
+        case.write(9, 100, [1, 2, 3, 4]);
+        hold.set_signaled_value(1);
+        wait_for_late_copy(late);
+        gate.set_signaled_value(1);
+        for command_buffer in [&writer, &waiting] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        assert_eq!(shadow_coherent::fallback_counts().late_copies_in, late + 1);
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "the guest's write");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the write in flight");
+        assert_eq!(case.read(0, 100), [0, 0, 255, 0], "the older texels");
+    });
+}
+
+/// Two waits for shared events in one command buffer, each before a draw over the surface: the
+/// guest writes before each signal, the second time after the first batch went and beside its
+/// draw, and each draw sees the write before its own signal, the first draw's texels kept. Each
+/// wait notes the surface again (`shadow::LateCopies`): one note per surface left the second
+/// batch with no copy in.
+#[test]
+fn surface_coherent_each_wait_copies_in_what_came_before_its_signal() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let one = case.device.new_shared_event().unwrap();
+        let two = case.device.new_shared_event().unwrap();
+        let command_buffer = case.queue.command_buffer().unwrap();
+        blend_after(&case, &command_buffer, &one, scissor(0, 0, WIDTH, 1));
+        blend_after(&case, &command_buffer, &two, scissor(0, 3, WIDTH, 1));
+        command_buffer.commit().unwrap();
+        let late = shadow_coherent::fallback_counts().late_copies_in;
+        case.write(5, 0, [1, 2, 3, 4]);
+        one.set_signaled_value(1);
+        wait_for_late_copy(late);
+        case.write(5, 3, [5, 6, 7, 8]);
+        two.set_signaled_value(1);
+        command_buffer.wait_until_completed_for(SOON).unwrap();
+        assert_eq!(case.read(5, 0), [1, 2, 3, 0], "the write before the first signal");
+        assert_eq!(case.read(5, 3), [5, 6, 7, 0], "the write before the second");
+        assert_eq!(case.read(6, 3), [0, 0, 255, 0], "the older texels");
+    });
+}
+
+/// A command buffer draws over a part of the surface, waits for a shared event, then draws over
+/// all of it: the guest writes beside the first draw and sets the event. The second draw sees
+/// both, so the copy in takes the guest's texels and keeps the first draw's in the image. Before,
+/// the wait let the second draw take no standing (its own command buffer's), and its copy in of
+/// the whole surface from the pages lost the first draw's texels, CPU write or not.
+#[test]
+fn surface_coherent_a_late_copy_in_keeps_the_command_buffers_own_writes() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let command_buffer = case.queue.command_buffer().unwrap();
+        case.pass(&command_buffer, GREEN, scissor(0, 7, 64, 1));
+        blend_after(&case, &command_buffer, &hold, None);
+        command_buffer.commit().unwrap();
+        let late = shadow_coherent::fallback_counts().late_copies_in;
+        case.write(9, 100, [1, 2, 3, 4]);
+        hold.set_signaled_value(1);
+        command_buffer.wait_until_completed_for(SOON).unwrap();
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "the guest's write");
+        assert_eq!(case.read(8, 7), [0, 255, 0, 0], "the first draw");
+        assert_eq!(case.read(0, 0), [0, 0, 255, 0], "the older texels");
+        assert_eq!(shadow_coherent::fallback_counts().late_copies_in, late + 1);
+    });
+}
