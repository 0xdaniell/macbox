+
+/// Two partially planned readers overlap the same row. A writer, ordered after both readers'
+/// first passes, writes through another import. Releasing only one reader leaves the other's
+/// record potentially busy while the first takes its owed copy-in. The final guest bytes test
+/// whether the ordered write survived; the counters report whether this run reached the risk path.
+#[test]
+fn surface_coherent_two_held_readers_preserve_an_ordered_other_import_write() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let other_buffer = case.other_import();
+        let before = shadow_coherent::fallback_counts();
+        let first_a = case.device.new_shared_event().unwrap();
+        let first_b = case.device.new_shared_event().unwrap();
+        let gate_a = case.device.new_shared_event().unwrap();
+        let gate_b = case.device.new_shared_event().unwrap();
+        let queue_b = case.device.new_command_queue().unwrap();
+        let writer_queue = case.device.new_command_queue().unwrap();
+        let reader_a = case.queue.command_buffer().unwrap();
+        let reader_b = queue_b.command_buffer().unwrap();
+        let from = staged(case.device, &[7u8; 64]);
+        let to_a = staged(case.device, &[0u8; 64]);
+        let to_b = staged(case.device, &[0u8; 64]);
+        for (reader, first, gate, to) in [
+            (&reader_a, &first_a, &gate_a, &to_a),
+            (&reader_b, &first_b, &gate_b, &to_b),
+        ] {
+            case.pass(reader, GREEN, scissor(0, 100, 16, 1));
+            reader.encode_signal_event(first.into(), 1).unwrap();
+            reader.encode_wait_for_event(gate.into(), 1).unwrap();
+            let mut blit = reader.blit_command_encoder().unwrap();
+            blit.copy_from_buffer_to_buffer(&from, 0, to, 0, 64)
+                .unwrap();
+            blit.end_encoding().unwrap();
+            reader.commit().unwrap();
+        }
+        let writer = writer_queue.command_buffer().unwrap();
+        writer.encode_wait_for_event((&first_a).into(), 1).unwrap();
+        writer.encode_wait_for_event((&first_b).into(), 1).unwrap();
+        let bytes: Vec<u8> = (0..16).flat_map(|_| [1u8, 2, 3, 4]).collect();
+        let source = staged(case.device, &bytes);
+        let mut blit = writer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&source, 0, &other_buffer, 100 * ROW, 64)
+            .unwrap();
+        blit.end_encoding().unwrap();
+        writer.commit().unwrap();
+        let written = writer.wait_until_completed_for(SOON).is_ok();
+        gate_a.set_signaled_value(1);
+        let a_done = reader_a.wait_until_completed_for(SOON).is_ok();
+        gate_b.set_signaled_value(1);
+        let b_done = reader_b.wait_until_completed_for(SOON).is_ok();
+        let after = shadow_coherent::fallback_counts();
+        assert!(
+            written && a_done && b_done,
+            "the event chain completed"
+        );
+        let actual = case.read(9, 100);
+        eprintln!("TWO-READERS owed={} busy={} actual={actual:?}",
+            after.plan_owed_copies_in - before.plan_owed_copies_in,
+            after.late_copies_in_busy - before.late_copies_in_busy);
+        assert_eq!(actual, [1, 2, 3, 4], "the later ordered write survives both readers");
+    });
+}
