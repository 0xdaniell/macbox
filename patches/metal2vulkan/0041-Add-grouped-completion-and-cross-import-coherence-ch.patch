+/// A full 64-buffer group preserves each result, completion and submission check in order.
+#[test]
+fn a_group_of_64_keeps_completion_and_data_in_order() {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) { metal2vulkan_runtime::live::set("group_batches", None); }
+    }
+    let _reset = Reset;
+    metal2vulkan_runtime::live::set("group_batches", Some("64"));
+    let (grouped, batches, submissions, heard, merging, ends) = run_batches(CompletionPolicy::Grouped, true, 64);
+    if merging {
+        assert_eq!((grouped, batches, submissions, heard), (1, 64, 1, 1));
+        assert!(ends[0] >= 1, "the full 64-buffer group was submitted: {ends:?}");
+    } else {
+        assert_eq!((grouped, batches, submissions, heard), (0, 0, 64, 0));
+    }
+}
+
 /// The same with a submission check on each command buffer: each check runs once, in commit
 /// order, those of the batches behind a head with the head's.
 #[test]
