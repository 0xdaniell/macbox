+/// The guest's CPU wrote the pages under `lazy`, the one image over them that traps: the others
+/// have only this to tell them, and with no clock their images would keep the old bytes.
+pub(crate) fn guest_wrote(lazy: &Lazy) {
+    let Some(pages) = &lazy.pages else {
+        return;
+    };
+    for other in surfaces() {
+        if !std::ptr::eq(Arc::as_ptr(&other), lazy) && other.over(pages) {
+            other.written.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+}
