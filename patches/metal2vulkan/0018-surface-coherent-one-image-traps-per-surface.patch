+/// Two textures over one surface: a CPU read traps, and what the second made is in the pages.
+#[test]
+fn surface_coherent_a_cpu_read_gets_what_a_second_texture_made() {
+    on_surface(true, |case| {
+        let second = case.second_texture();
+        case.draw(RED, None);
+        case.draw_on(&second, GREEN);
+        assert_eq!(case.read(9, 9), GREEN_TEXEL);
+    });
+}
+
+/// A trap reaches one surface, and a second texture's image over the pages must hear of the write.
+/// The lanes' clock is off, as it is for any texture that trusts the traps.
+#[test]
+fn surface_coherent_a_second_texture_reads_each_cpu_write() {
+    on_surface(true, |case| {
+        let second = case.second_texture();
+        case.draw(RED, None);
+        assert_eq!(case.through(&second, 7, 7), [0, 0, 255, 0], "its image holds the bytes");
+        case.write(7, 7, [1, 2, 3, 4]);
+        assert_eq!(case.through(&second, 7, 7), [1, 2, 3, 0]);
+        // That read held the pages again: this write traps too, and it hears.
+        case.write(7, 7, [5, 6, 7, 8]);
+        assert_eq!(case.through(&second, 7, 7), [5, 6, 7, 0]);
+    });
+}
+
 /// A CPU writer down the whole surface stops once: a probe per page would stall it for a surface
 /// this size, and on a real guest every probe walks every tracked surface.
 #[test]
@@ -974,6 +1001,36 @@ fn surface_coherent_off_touches_no_page() {
 }
 
 impl Case<'_> {
+    /// Another texture over the surface's pages, as a second `MTLTexture` over an IOSurface is.
+    fn second_texture(&self) -> Texture {
+        let mut d =
+            TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, WIDTH, HEIGHT, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = self.buffer.resource_options();
+        self.buffer
+            .new_texture_with_iosurface_plane(&d, IoSurfacePlane::new(0, self.row, false))
+            .unwrap()
+    }
+
+    fn draw_on(&self, texture: &Texture, color: [f32; 4]) {
+        let color = staged(self.device, &floats4(color));
+        let rects = std::slice::from_ref(&self.rect);
+        let command_buffer = self.queue.command_buffer().unwrap();
+        pass(&command_buffer, texture, &self.opaque, rects, &color, None);
+        run(&command_buffer);
+    }
+
+    /// What `texture`'s image holds at `x`, `y`, as [`Self::through_image`] finds it.
+    fn through(&self, texture: &Texture, x: u64, y: u64) -> [u8; 4] {
+        let color = staged(self.device, &floats4([0.0; 4]));
+        let rects = std::slice::from_ref(&self.rect);
+        let blending = rects_blending(self.device);
+        let command_buffer = self.queue.command_buffer().unwrap();
+        pass(&command_buffer, texture, &blending, rects, &color, None);
+        run(&command_buffer);
+        self.read(x, y)
+    }
+
     fn other_import(&self) -> Buffer {
         surface_buffer(self.device, &self.mapping, self.len)
     }
