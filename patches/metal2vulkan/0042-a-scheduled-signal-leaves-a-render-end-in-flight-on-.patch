From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Fri, 6 Nov 2026 11:01:48 +0000
Subject: [PATCH 42/92] a scheduled signal leaves a render end in flight on the
 lowering thread

Under RenderLoweringPolicy::Worker, encode_signal_event_scheduled settled the
command buffer's in-flight render end on the program's thread, so Reims's exec
tail (end, completed handler, scheduled signal, commit) lowered every end and
ran every commit at the call: the worker overlapped nothing. A scheduled
signal is the command buffer's, set as it is scheduled, so it now reads the
in-flight end as queue_commit does and leaves it to the thread. host_ab:
HOST_AB_RENDER_LOWERING=worker.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../examples/host_ab/runtime.rs               |  7 +++++++
 .../src/command_buffer/mod.rs                 | 20 +++++++++++++++++--
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/crates/metal2vulkan-runtime/examples/host_ab/runtime.rs b/crates/metal2vulkan-runtime/examples/host_ab/runtime.rs
index c0bcffab..7f4da58a 100644
--- a/crates/metal2vulkan-runtime/examples/host_ab/runtime.rs
+++ b/crates/metal2vulkan-runtime/examples/host_ab/runtime.rs
@@ -53,6 +53,13 @@ impl Runtime {
         options.gpu_times_from_host = true;
         options.policy.completion = CompletionPolicy::Exact;
         options.policy.heap_compression = HeapCompressionPolicy::Uncompressed;
+        // LOCAL (Atlas) DEEP-CPU: `HOST_AB_RENDER_LOWERING=worker` lowers render calls on the
+        // device's lowering thread (`RenderLoweringPolicy::Worker`), for the A/B of what moves
+        // off the encoding thread; the default (unset) is `AtCall`, as reims-vgpu's production.
+        if std::env::var_os("HOST_AB_RENDER_LOWERING").is_some_and(|v| v == "worker") {
+            options.policy.render_lowering = metal2vulkan::device::RenderLoweringPolicy::Worker;
+            eprintln!("host_ab: render lowering on the worker");
+        }
         options.shader_cache = rt::ShaderCacheOptions::in_directory(cache);
         let device = rt::Device::system_default_with(&options).expect("open the runtime's device");
         let queue = device.new_command_queue().expect("new_command_queue");
diff --git a/crates/metal2vulkan-runtime/src/command_buffer/mod.rs b/crates/metal2vulkan-runtime/src/command_buffer/mod.rs
index 18824b72..8f3cb31d 100644
--- a/crates/metal2vulkan-runtime/src/command_buffer/mod.rs
+++ b/crates/metal2vulkan-runtime/src/command_buffer/mod.rs
@@ -2231,9 +2231,25 @@ impl CommandBuffer {
         if !event.device().same(&self.0.device) {
             return Err(invalid(CALL, Problem::ForeignObject));
         }
-        self.settle_end();
+        // LOCAL (Atlas, DEEP-CPU): a scheduled signal is the command buffer's, set as it is
+        // scheduled whatever its place among the encoders, so it does not settle a render
+        // encoder's end left to the device's lowering thread (`render/deferral.rs`): the commit
+        // after it, as Reims's exec makes one, is then left to wait for the end
+        // (`render/queued_commits.rs`) instead of the program's thread lowering it. The encoder
+        // open is then the one whose end is in flight, which ended, as `queue_commit` reads it.
+        let end_in_flight = {
+            let state = self.state();
+            state.ending.is_some() && !state.end_lowered
+        };
+        if !end_in_flight {
+            self.settle_end();
+        }
         let mut state = self.state();
-        match state.refusal() {
+        let refusal = match state.refusal() {
+            Some(Problem::EncoderOpen) if end_in_flight => None,
+            refusal => refusal,
+        };
+        match refusal {
             None => state.scheduled_signals.push((Arc::clone(event), value)),
             Some(Problem::AlreadyCommitted)
                 if matches!(
