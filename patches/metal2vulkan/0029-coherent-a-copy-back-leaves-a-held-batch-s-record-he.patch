diff --git a/crates/metal2vulkan-runtime/src/tests/coherent_late.rs b/crates/metal2vulkan-runtime/src/tests/coherent_late.rs
new file mode 100644
index 00000000..0aa52845
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/coherent_late.rs
@@ -0,0 +1,47 @@
+//! LOCAL (Atlas): the pieces of a held batch's copy in (`shadow::LateCopies`) that need no GPU:
+//! the rectangle a write of a trapping surface's bytes through another import covers
+//! (`shadow_coherent::Coherent::area_of_bytes`), and the plans a GPU copy back reads to leave a
+//! record whose command buffer still has a batch unplanned (`shadow_lazy::planned`).
+
+use crate::shadow_coherent::{Coherent, Layout};
+use std::sync::Weak;
+
+fn surface() -> std::sync::Arc<Coherent> {
+    let layout = Layout { base: 0x10_0000, row: 4096, texel: 4, width: 1000, height: 64 };
+    Coherent::new(layout, Box::new(|_, _, _| true), Weak::new())
+}
+
+#[test]
+fn a_write_inside_one_row_covers_its_texels() {
+    let surface = surface();
+    assert_eq!(surface.area_of_bytes(4096 * 3 + 36, 4096 * 3 + 100), Some([9, 3, 25, 4]));
+    // A texel's part takes the texel.
+    assert_eq!(surface.area_of_bytes(4096 * 3 + 37, 4096 * 3 + 38), Some([9, 3, 10, 4]));
+}
+
+#[test]
+fn a_write_over_rows_covers_them_whole() {
+    let surface = surface();
+    assert_eq!(surface.area_of_bytes(4096 * 2 + 8, 4096 * 5 + 4), Some([0, 2, 1000, 6]));
+    assert_eq!(surface.area_of_bytes(0, 4096 * 64), Some([0, 0, 1000, 64]));
+}
+
+#[test]
+fn a_write_past_the_texels_covers_none() {
+    let surface = surface();
+    // The row's padding past the texels, and past the last row.
+    assert_eq!(surface.area_of_bytes(4000 + 4096, 4096 * 2), None);
+    assert_eq!(surface.area_of_bytes(4096 * 64, 4096 * 65), None);
+    assert_eq!(surface.area_of_bytes(8, 8), None);
+}
+
+#[test]
+fn a_command_buffer_is_unplanned_from_its_commit_to_its_last_batch() {
+    // Identities no command buffer of the test process takes (`ShadowCarry::id` counts up).
+    let id = u64::MAX - 7;
+    assert!(!crate::shadow_lazy::unplanned(id));
+    crate::shadow_lazy::committed(id);
+    assert!(crate::shadow_lazy::unplanned(id));
+    crate::shadow_lazy::planned(id);
+    assert!(!crate::shadow_lazy::unplanned(id));
+}
