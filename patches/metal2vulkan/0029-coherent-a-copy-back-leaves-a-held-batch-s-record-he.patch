+    /// LOCAL (Atlas): the rectangle of the surface's bytes `[from, to)`, counted from its first
+    /// texel: its rows, or the texels of one row. `None` where it holds no texel.
+    pub(crate) fn area_of_bytes(&self, from: u64, to: u64) -> Option<[u32; 4]> {
+        let Layout { row, texel, width, height, .. } = self.layout;
+        if row == 0 || texel == 0 || to <= from {
+            return None;
+        }
+        let (y0, y1) = ((from / row) as u32, (to.div_ceil(row) as u32).min(height));
+        if y0 >= y1 {
+            return None;
+        }
+        let area = match y1 - y0 {
+            1 => {
+                let start = from - u64::from(y0) * row;
+                let end = to - u64::from(y0) * row;
+                let x0 = ((start / texel) as u32).min(width);
+                let x1 = (end.div_ceil(texel) as u32).min(width);
+                [x0, y0, x1, y1]
+            }
+            _ => [0, y0, width, y1],
+        };
+        (area[0] < area[2]).then_some(area)
+    }
