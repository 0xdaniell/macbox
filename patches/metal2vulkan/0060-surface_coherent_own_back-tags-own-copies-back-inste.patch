     for lazy in surfaces().iter().take(16) {
         eprintln!(
@@ -1110,6 +1116,9 @@ struct BesideWrite {
     part: usize,
     area: Option<[u32; 4]>,
     copied: bool,
+    /// LOCAL (Atlas): every write joined in it was the surface's own plain copy back of its image
+    /// ([`Lazy::own_back`]): its bytes hold what the image holds, so no copy in needs them.
+    own: bool,
 }
 
 const BESIDE_KEPT: usize = 256;
@@ -1263,6 +1272,19 @@ impl Lazy {
         OWN.with(Cell::get) == std::ptr::from_ref(self)
     }
 
+    /// LOCAL (Atlas): mark this thread as recording a plain copy back of this surface's own image
+    /// until the mark drops: still a write of its bytes for every count and plan, but one a later
+    /// copy in skips ([`BesideWrite::own`]).
+    pub(crate) fn own_back(&self) -> impl Drop {
+        struct OwnBack(*const Lazy);
+        impl Drop for OwnBack {
+            fn drop(&mut self) {
+                OWN_BACK.with(|own| own.set(self.0));
+            }
+        }
+        OwnBack(OWN_BACK.with(|own| own.replace(std::ptr::from_ref(self))))
+    }
+
     /// Mark this thread as recording its own copy back until the mark drops.
     pub(crate) fn own(&self) -> impl Drop {
         struct Own(*const Lazy);
