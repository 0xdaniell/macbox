From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Sun, 8 Nov 2026 05:29:06 +0000
Subject: [PATCH 60/92] surface_coherent_own_back tags own copies back instead
 of hiding them

Lazy::own hid the encoder-end copy back from the plans (plan_left_planned, a stalled Sim). Now it
counts as before; its beside record is tagged own, and a held batch's copy in skips it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/metal2vulkan-runtime/src/encoder.rs    | 14 ++++----
 .../metal2vulkan-runtime/src/shadow_lazy.rs   | 35 +++++++++++++++++--
 2 files changed, 40 insertions(+), 9 deletions(-)

diff --git a/crates/metal2vulkan-runtime/src/encoder.rs b/crates/metal2vulkan-runtime/src/encoder.rs
index d7cb1ae1..6cacdf3b 100644
--- a/crates/metal2vulkan-runtime/src/encoder.rs
+++ b/crates/metal2vulkan-runtime/src/encoder.rs
@@ -1590,12 +1590,12 @@ impl EncoderCore {
     /// retains each until it completes.
     /// LOCAL (Atlas): the encoder's end's copies back, as [`shadow_copies`](Self::shadow_copies)
     /// records them. With the live switch `surface_coherent_own_back` (default off), a trapping
-    /// lazy surface's plain copy back of its own image records as its own (`Lazy::own`): its
-    /// bytes then hold what the image holds, which no other import wrote, where before it counted
-    /// as a write beside the image (`shadow_lazy::note_writes`), and each held batch after it
-    /// copied those texels in again, over a record still running there (the coherent census's
-    /// `taking_beside` risk, 3 Sims, 2026-11-08). A merge's copy back keeps the CPU's texels and
-    /// still counts.
+    /// lazy surface's plain copy back of its own image is marked its own (`Lazy::own_back`): it
+    /// still counts as a write of the bytes for every plan (`shadow_lazy::note_writes`), but no
+    /// held batch after it copies those texels in again, over a record still running there (the
+    /// coherent census's `taking_beside` risk, 3 Sims, 2026-11-08). A merge's copy back keeps the
+    /// CPU's texels and is not marked. (`Lazy::own` there instead hid the write from the plans:
+    /// `plan_left_planned` and a stalled Sim.)
     fn end_copies(&mut self, copies: &[ShadowCopy]) {
         let own = |copy: &ShadowCopy| {
             (matches!(copy.step, Step::Back))
@@ -1609,7 +1609,7 @@ impl EncoderCore {
         }
         for copy in copies {
             let lazy = own(copy);
-            let _own = lazy.as_ref().map(|lazy| lazy.own());
+            let _own = lazy.as_ref().map(|lazy| lazy.own_back());
             self.shadow_copies(std::slice::from_ref(copy));
         }
     }
