     static OWN: Cell<*const Lazy> = const { Cell::new(std::ptr::null()) };
+    /// LOCAL (Atlas): the surface whose plain copy back of its own image this thread records
+    /// ([`Lazy::own_back`]).
+    static OWN_BACK: Cell<*const Lazy> = const { Cell::new(std::ptr::null()) };
 }
 
 /// Why a take found no standing it could use.
@@ -936,7 +941,7 @@ fn report() {
