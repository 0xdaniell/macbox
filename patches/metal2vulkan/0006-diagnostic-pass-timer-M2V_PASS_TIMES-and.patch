+/// Where a completed command buffer's units are placed on the host's clock ([`read`]).
+pub(crate) struct Placement<'a> {
+    /// The device's clock.
+    pub(crate) clock: Option<&'a GpuClock>,
+    /// The calibration pair its GPU times took.
+    pub(crate) pair: Option<Pair>,
+    /// Its GPU start's timestamp and host time, where read and placed.
+    pub(crate) start: Option<(u64, u64)>,
+    /// The host time its completion was seen.
+    pub(crate) completed: u64,
+}
+
+/// Whether a command of `class` is one an encoder of `kind` is made for.
+fn natural(kind: Option<EncoderKind>, class: Class) -> bool {
+    matches!(
+        (kind, class),
+        (Some(EncoderKind::Compute), Class::Compute) | (Some(EncoderKind::Blit), Class::Transfer)
+    )
+}
+
+/// The encoder kind's name.
+fn kind_name(kind: EncoderKind) -> &'static str {
+    match kind {
+        EncoderKind::Blit => "blit",
+        EncoderKind::Compute => "compute",
+        EncoderKind::Render => "render",
+        EncoderKind::ResourceState => "resource-state",
+    }
+}
+
+/// Read `capture`'s units, its command buffer completed, and append their lines: in the
+/// completion turn, inside its section (`command_buffer/mod.rs`, `read_pass_times`).
+pub(crate) fn read(capture: Arc<Capture>, placement: Placement<'_>) {
+    let state = lock(&capture.state);
+    if state.units.is_empty() {
+        return;
+    }
+    let device = capture.device.shared().vk();
+    // Each block's queries: value and availability.
+    let mut values: Vec<Vec<[u64; 2]>> = Vec::with_capacity(state.blocks.len());
+    for block in &state.blocks {
+        let mut results = vec![[0u64; 2]; BLOCK as usize];
+        // SAFETY: the block's queries were reset, and those written were written by work that
+        // completed; 64-bit values with availability, two words each.
+        let read = unsafe {
+            device.get_query_pool_results(
+                block.pool,
+                block.first,
+                &mut results,
+                vk::QueryResultFlags::TYPE_64 | vk::QueryResultFlags::WITH_AVAILABILITY,
+            )
+        };
+        exit_guard::called(Call::GetQueryPoolResults);
+        if !matches!(read, Ok(()) | Err(vk::Result::NOT_READY)) {
+            results.iter_mut().for_each(|r| *r = [0, 0]);
+        }
+        values.push(results);
+    }
+    let value = |block: usize, query: u32| {
+        let [value, available] = values[block][query as usize];
+        (available != 0).then_some(value)
+    };
+    let place = |ticks: u64| match (placement.clock, placement.pair, placement.start) {
+        (Some(clock), Some(pair), _) => clock.place(pair, ticks),
+        (Some(clock), None, Some((start, host))) => host + clock.duration(start, ticks),
+        _ => placement.completed,
+    };
+    // Each encoder's render pass instances, for `i/n`.
+    let instance = |unit: &Unit| match unit.tag {
+        Some(Tag::Pass(at)) => unit.class == Class::Pass && at != PassAt::Resolve,
+        _ => false,
+    };
+    let mut totals: HashMap<Option<u32>, u32> = HashMap::new();
+    for unit in state.units.iter().filter(|u| instance(u)) {
+        *totals.entry(unit.encoder).or_default() += 1;
+    }
+    let mut counted: HashMap<Option<u32>, u32> = HashMap::new();
+    let mut out = String::with_capacity(state.units.len() * 160);
+    for (index, unit) in state.units.iter().enumerate() {
+        let begin = value(unit.block, unit.offset);
+        let end = value(unit.block, unit.offset + 1);
+        let gpu = match (begin, end, placement.clock) {
+            (Some(begin), Some(end), Some(clock)) => clock.duration(begin, end).to_string(),
+            _ => String::new(),
+        };
+        let host = begin.map_or(placement.completed, place);
+        let note = unit.encoder.and_then(|e| state.encoders.get(e as usize));
+        let encoder = match (unit.encoder, note) {
+            (Some(e), Some(note)) => format!("{}#{e}", kind_name(note.kind)),
+            _ => "-".to_owned(),
+        };
+        let kind = match (unit.class, unit.tag) {
+            (Class::Pass, Some(Tag::Pass(PassAt::Resolve))) => "render-pass-resolve".to_owned(),
+            (Class::Pass, Some(Tag::Pass(_))) => "render-pass".to_owned(),
+            (Class::Pass, _) => {
+                let made = unit.label.as_ref().and_then(PassLabel::site);
+                let at = unit.site.map(image_log::short).or(made);
+                format!("pass:{}", at.as_deref().unwrap_or("?"))
+            }
+            (class, Some(Tag::Guest)) => {
+                let encoder = note.map_or("?", |n| kind_name(n.kind));
+                let what = match class {
+                    Class::Compute => "compute",
+                    _ => "transfer",
+                };
+                match (natural(note.map(|n| n.kind), class), unit.site) {
+                    (true, _) => format!("guest-{encoder}"),
+                    (false, Some(at)) => format!(
+                        "guest-{encoder}:{what}@{}/{}",
+                        image_log::short(at),
+                        unit.command
+                    ),
+                    (false, None) => format!("guest-{encoder}:{what}/{}", unit.command),
+                }
+            }
+            (_, _) => match unit.site {
+                Some(at) => format!("internal:{}/{}", image_log::short(at), unit.command),
+                None => format!("internal:{}", unit.command),
+            },
+        };
+        let attachments = unit
+            .label
+            .as_ref()
+            .map_or_else(|| "-".to_owned(), PassLabel::format);
+        let split = match unit.tag {
+            _ if instance(unit) => {
+                let n = totals.get(&unit.encoder).copied().unwrap_or(1);
+                let i = {
+                    let i = counted.entry(unit.encoder).or_default();
+                    *i += 1;
+                    *i
+                };
+                let cause = match i {
+                    1 => "first".to_owned(),
+                    _ => note
+                        .and_then(|n| n.causes.get(i as usize - 2))
+                        .map_or_else(|| "run".to_owned(), |c| format!("{c:?}")),
+                };
+                let records = match unit.tag {
+                    Some(Tag::Pass(PassAt::Inline)) => "inline",
+                    Some(Tag::Pass(PassAt::InlineSplit)) => "inline-split",
+                    _ => "secondary",
+                };
+                let not_inline = match (i, note.and_then(|n| n.not_inline)) {
+                    (1, Some(why)) => format!(";not-inline={why:?}"),
+                    _ => String::new(),
+                };
+                format!("{i}/{n}:{cause};{records}{not_inline}")
+            }
+            Some(Tag::Pass(PassAt::Resolve)) => "resolve".to_owned(),
+            _ => "-".to_owned(),
+        };
+        let _ = writeln!(
+            out,
+            "{host},{},{index},{kind},{},{encoder},{attachments},{},{},{gpu}",
+            capture.seq,
+            capture.queue_label,
+            split.replace(',', ";"),
+            unit.count,
+        );
+    }
+    let lines = state.units.len();
+    drop(state);
+    capture.times.append(&out, lines);
+}
