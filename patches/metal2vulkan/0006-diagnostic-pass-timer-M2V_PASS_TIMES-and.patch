@@ -0,0 +1,1194 @@
+//! LOCAL (Atlas) diagnostic: the pass timer, `M2V_PASS_TIMES=<dir>`. GPU timestamps around each
+//! unit of GPU work the runtime records, read once its command buffer completed, one CSV line per
+//! unit appended to `<dir>/passes-<pid>.csv`. Default off; the whole module can be dropped with its
+//! hooks (each marked `LOCAL (Atlas) diagnostic`).
+//!
+//! - **The switch** is read once. Unset (or empty), nothing changes: no query pool, no command,
+//!   no line; each hook is one check of a `OnceLock`.
+//! - **The window.** Set, a command buffer is captured only where the file `<dir>/on` exists as the
+//!   runtime begins recording it (its first encoder's opening, or its first `VkCommandBuffer`
+//!   handed out): checked once per command buffer. `touch <dir>/on` opens a window, `rm` closes
+//!   it; the first command buffer begun after the close flushes the lines held.
+//! - **Where the timestamps go.** Every routed command passes the recorder's entry points
+//!   (`recorder/thunks.rs`), whatever the runtime records it from (an encoder, its own kernels, a
+//!   pass's steps, a commit's work, the lowering thread), so the units are cut there, on each
+//!   `VkCommandBuffer` the captured command buffer handed out: a render pass instance
+//!   (`vkCmdBeginRenderPass` to `vkCmdEndRenderPass`, each instance of a split pass its own); a run
+//!   of dispatches; a run of transfer commands (copies, blits, clears, fills, updates, query result
+//!   copies). A run goes on while the commands are of its class and its label (below) and the
+//!   barriers and binds between are part of it; another unit, or the `VkCommandBuffer`'s end, ends
+//!   it. Each unit writes a `vkCmdWriteTimestamp` at `ALL_COMMANDS` before its first command and
+//!   after its last, into two queries of a block of the diagnostic's own pools ([`BLOCK`] queries,
+//!   [`POOL_BLOCKS`] blocks a pool), each block reset on the host as a command buffer takes it
+//!   (`hostQueryReset`, which every device the runtime made enables), else by a
+//!   `vkCmdResetQueryPool` before the unit's start. The scheduler's own command buffers of
+//!   barriers (and the runtime's GPU-time timestamps) are no unit.
+//! - **Labels**, all known where the unit is recorded:
+//!   - `kind`: `render-pass` (an instance of a render encoder's pass: inline first, inline after a
+//!     split, or in secondaries; `render/inline_first.rs`, `inline_splits.rs`, `pass_steps.rs`),
+//!     `render-pass-resolve` (the pass's instance of no draws that resolves it), `pass:<site>`
+//!     (another render pass the runtime records, at the place it began it where that goes through
+//!     the device's `Vk` door, else where its `VkRenderPass` was made); `guest-<encoder>` (a
+//!     command of the program's encoder: `EncoderCore::command_*`, a pending dispatch), suffixed
+//!     with its class where that is not the encoder's own (`guest-blit:compute`); else
+//!     `internal:<site>/<command>`, the place that recorded its first command where it went
+//!     through the device's `Vk` door (`device/functions.rs`), else the command alone.
+//!   - `cb_label`: the command queue's label (no program's label reaches the runtime: Metal's
+//!     `label` of a command buffer and of an encoder are not part of Reims's guest protocol, and
+//!     the runtime keeps neither). `encoder_label`: the encoder's kind and place in its command
+//!     buffer (`render#3`), for the `VkCommandBuffer`s handed out while it was the last opened.
+//!   - `attachments`, for a render pass instance: each attachment's role in subpass 0
+//!     (`c0`, `r0`, `ds`, `dsr`, `in0`), format, extent, samples, load/store ops (the stencil's
+//!     too), `memoryless` where its image is a transient attachment, and `@` its image's purpose
+//!     (`image_log.rs`: the program's call that made it, else the place inside the runtime).
+//!   - `split`, for a render encoder's instance: `i/n` among the encoder's instances, the split
+//!     cause that began it (`work_counts::Split`; `first` for the first, `run` past the causes
+//!     counted), how it records (`inline`, `inline-split`, `secondary`), and for the first, why
+//!     the pass's first instance did not record inline (`work_counts::NotInline`).
+//!   - `draws`: the draws of a render pass instance (its secondaries' too), the dispatches of a
+//!     run of them, the commands of a run of transfers.
+//! - **Read as it completed**, in the completion turn after its GPU times (`completion.rs`):
+//!   `vkGetQueryPoolResults` per block, without waiting, a unit whose timestamps are not both
+//!   available (a command buffer that failed or never ran) has no `gpu_ns`. `host_ns` is the
+//!   unit's start on the host's clock (`CLOCK_MONOTONIC_RAW`): placed by the calibration pair the
+//!   command buffer's GPU times took where the device has one, else from its placed GPU start.
+//!   The lines are held and appended every [`FLUSH_LINES`] lines or [`FLUSH_AFTER`] at the next
+//!   completion, as a window closes, and as the device drops.
+
+use crate::command_buffer::CommandBuffer;
+use crate::exit_guard::{self, Call};
+use crate::gpu_time::{GpuClock, Pair};
+use crate::image_log::{self, PassLabel};
+use crate::used_resources::EncoderKind;
+use crate::work_counts::{NotInline, Split};
+use crate::{CommandQueue, Device};
+use ash::vk;
+use ash::vk::Handle;
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::fmt::Write as _;
+use std::io::Write as _;
+use std::panic::Location;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, LazyLock, Mutex, MutexGuard, OnceLock, Weak};
+use std::time::{Duration, Instant};
+
+/// Queries of a block a command buffer takes at once: 32 units.
+const BLOCK: u32 = 64;
+
+/// Blocks of a query pool.
+const POOL_BLOCKS: u32 = 64;
+
+/// Lines held before they are appended.
+const FLUSH_LINES: usize = 256;
+
+/// Time after which the next completion appends the lines held.
+const FLUSH_AFTER: Duration = Duration::from_millis(500);
+
+/// The CSV's columns, its first line.
+const HEADER: &str =
+    "host_ns,cb_seq,unit_seq,kind,cb_label,encoder_label,attachments,split,draws,gpu_ns\n";
+
+/// The directory `M2V_PASS_TIMES` names: read once.
+fn dir() -> Option<&'static Path> {
+    static DIR: OnceLock<Option<PathBuf>> = OnceLock::new();
+    DIR.get_or_init(|| {
+        std::env::var_os("M2V_PASS_TIMES")
+            .filter(|value| !value.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_deref()
+}
+
+/// Whether the pass timer is on.
+#[inline]
+pub(crate) fn on() -> bool {
+    dir().is_some()
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
+    mutex
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// The captures alive: the entry points do nothing more while there is none.
+static LIVE: AtomicUsize = AtomicUsize::new(0);
+
+/// The next captured command buffer's number.
+static NEXT_SEQ: AtomicU64 = AtomicU64::new(0);
+
+/// Each `VkCommandBuffer` a captured command buffer handed out, to its capture.
+static RAWS: LazyLock<Mutex<HashMap<u64, Weak<Capture>>>> = LazyLock::new(Mutex::default);
+
+/// Each captured command buffer, by its address, to its capture.
+static BY_KEY: LazyLock<Mutex<HashMap<usize, Weak<Capture>>>> = LazyLock::new(Mutex::default);
+
+/// What the code recording a unit says it is, on its thread ([`scope`]).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Tag {
+    /// A command of the program's encoder.
+    Guest,
+    /// A render pass instance of a render encoder's pass, begun at the given place.
+    Pass(PassAt),
+}
+
+/// Where a render encoder's pass instance began.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PassAt {
+    /// Its first instance, inline (`render/inline_first.rs`).
+    Inline,
+    /// An instance after a split, inline (`render/inline_splits.rs`).
+    InlineSplit,
+    /// An instance whose draws a secondary holds (`render/pass_steps.rs`).
+    Instance,
+    /// The instance of no draws that resolves the pass (`render/pass_steps.rs`).
+    Resolve,
+}
+
+thread_local! {
+    static SCOPE: Cell<Option<Tag>> = const { Cell::new(None) };
+    static SITE: Cell<Option<&'static Location<'static>>> = const { Cell::new(None) };
+}
+
+/// A tag set on this thread until dropped ([`scope`]).
+pub(crate) struct Scope(Option<Option<Tag>>);
+
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0.take() {
+            SCOPE.with(|scope| scope.set(previous));
+        }
+    }
+}
+
+/// Tag what this thread records with `tag` until the scope drops: the innermost holds.
+pub(crate) fn scope(tag: Tag) -> Scope {
+    if !on() {
+        return Scope(None);
+    }
+    Scope(Some(SCOPE.with(|scope| scope.replace(Some(tag)))))
+}
+
+/// The place `at` records the next command on this thread (`Vk`'s commands,
+/// `device/functions.rs`); the command's entry point takes it.
+#[inline]
+pub(crate) fn site(at: &'static Location<'static>) {
+    if on() {
+        SITE.with(|site| site.set(Some(at)));
+    }
+}
+
+/// A unit's class.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Class {
+    Pass,
+    Compute,
+    Transfer,
+}
+
+/// A slot's own timestamp commands (`recorder/thunks.rs`), which the units record through: into a
+/// deferred command buffer's log as any command, else the driver's.
+#[derive(Clone, Copy)]
+pub(crate) struct Stamps {
+    pub(crate) write:
+        unsafe extern "system" fn(vk::CommandBuffer, vk::PipelineStageFlags, vk::QueryPool, u32),
+    pub(crate) reset: unsafe extern "system" fn(vk::CommandBuffer, vk::QueryPool, u32, u32),
+}
+
+/// A block of queries.
+#[derive(Clone, Copy)]
+struct Block {
+    pool: vk::QueryPool,
+    first: u32,
+}
+
+#[derive(Default)]
+struct Blocks {
+    pools: Vec<vk::QueryPool>,
+    free: Vec<Block>,
+    /// The device refused a pool: no more are asked for.
+    refused: bool,
+}
+
+/// The lines held, and where they go.
+struct Out {
+    path: PathBuf,
+    file: Option<std::fs::File>,
+    held: String,
+    lines: usize,
+    flushed: Instant,
+}
+
+impl Out {
+    fn flush(&mut self) {
+        self.flushed = Instant::now();
+        if self.held.is_empty() {
+            return;
+        }
+        if self.file.is_none() {
+            let opened = std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&self.path);
+            match opened {
+                Ok(mut file) => {
+                    if file.metadata().map(|m| m.len() == 0).unwrap_or(false) {
+                        let _ = file.write_all(HEADER.as_bytes());
+                    }
+                    self.file = Some(file);
+                }
+                Err(error) => {
+                    eprintln!(
+                        "metal2vulkan: M2V_PASS_TIMES: cannot open {:?}: {error}",
+                        self.path
+                    );
+                    self.held.clear();
+                    self.lines = 0;
+                    return;
+                }
+            }
+        }
+        if let Some(file) = self.file.as_mut() {
+            let _ = file.write_all(self.held.as_bytes());
+        }
+        self.held.clear();
+        self.lines = 0;
+    }
+}
+
+/// A device's pass timer: its query pools and its lines (`DeviceShared::pass_times`).
+pub(crate) struct DeviceTimes {
+    host_reset: bool,
+    blocks: Mutex<Blocks>,
+    out: Mutex<Out>,
+}
+
+impl DeviceTimes {
+    /// The pass timer of a device whose queue family writes timestamps where `timestamps`, which
+    /// resets queries on the host where `host_reset`: `None` while the switch is off.
+    pub(crate) fn new(timestamps: bool, host_reset: bool) -> Option<Arc<DeviceTimes>> {
+        let dir = dir()?;
+        if !timestamps {
+            eprintln!("metal2vulkan: M2V_PASS_TIMES: the device's queue writes no timestamps");
+            return None;
+        }
+        let path = dir.join(format!("passes-{}.csv", std::process::id()));
+        Some(Arc::new(DeviceTimes {
+            host_reset,
+            blocks: Mutex::default(),
+            out: Mutex::new(Out {
+                path,
+                file: None,
+                held: String::new(),
+                lines: 0,
+                flushed: Instant::now(),
+            }),
+        }))
+    }
+
+    /// A block of queries, reset: a free one, else one of a pool made now; `None` once the device
+    /// refused a pool.
+    ///
+    /// # Safety
+    ///
+    /// `device` is the live device of this timer.
+    unsafe fn take(&self, device: &ash::Device) -> Option<Block> {
+        let mut blocks = lock(&self.blocks);
+        let block = match blocks.free.pop() {
+            Some(block) => block,
+            None => {
+                if blocks.refused {
+                    return None;
+                }
+                let info = vk::QueryPoolCreateInfo::default()
+                    .query_type(vk::QueryType::TIMESTAMP)
+                    .query_count(BLOCK * POOL_BLOCKS);
+                // SAFETY: the caller's; `info` is valid.
+                let made = unsafe { device.create_query_pool(&info, None) };
+                exit_guard::called(Call::CreateQueryPool);
+                let Ok(pool) = made else {
+                    blocks.refused = true;
+                    eprintln!("metal2vulkan: M2V_PASS_TIMES: the device refused a query pool");
+                    return None;
+                };
+                blocks.pools.push(pool);
+                let rest = (1..POOL_BLOCKS).rev().map(|i| Block {
+                    pool,
+                    first: i * BLOCK,
+                });
+                blocks.free.extend(rest);
+                Block { pool, first: 0 }
+            }
+        };
+        drop(blocks);
+        if self.host_reset {
+            // SAFETY: the device enables `hostQueryReset`; the block is free: its last holder's
+            // work completed, or never ran, and nothing else uses it.
+            unsafe { device.reset_query_pool(block.pool, block.first, BLOCK) };
+            exit_guard::called(Call::ResetQueryPool);
+        }
+        Some(block)
+    }
+
+    fn give_back(&self, blocks: Vec<Block>) {
+        if !blocks.is_empty() {
+            lock(&self.blocks).free.extend(blocks);
+        }
+    }
+
+    fn append(&self, text: &str, lines: usize) {
+        let mut out = lock(&self.out);
+        out.held.push_str(text);
+        out.lines += lines;
+        if out.lines >= FLUSH_LINES || out.flushed.elapsed() >= FLUSH_AFTER {
+            out.flush();
+        }
+    }
+
+    /// Append the lines held.
+    pub(crate) fn flush(&self) {
+        lock(&self.out).flush();
+    }
+
+    /// Release the pools, at the device's teardown, its lines appended first.
+    ///
+    /// # Safety
+    ///
+    /// `device` is the live device of this timer, and none of its command buffers is pending.
+    pub(crate) unsafe fn release(&self, device: &ash::Device) {
+        self.flush();
+        let pools = {
+            let mut blocks = lock(&self.blocks);
+            blocks.free.clear();
+            blocks.refused = true;
+            std::mem::take(&mut blocks.pools)
+        };
+        for pool in pools {
+            // SAFETY: the caller's.
+            unsafe { crate::release::object(device, pool) };
+        }
+    }
+}
+
+impl Drop for DeviceTimes {
+    fn drop(&mut self) {
+        self.flush();
+    }
+}
+
+/// A command buffer's capture, its state's (`State::pass_times`): undecided until it begins
+/// recording, then captured or not.
+#[derive(Default)]
+pub(crate) struct CbSlot {
+    decided: bool,
+    capture: Option<Arc<Capture>>,
+}
+
+impl CbSlot {
+    /// Its capture, taken to be read.
+    pub(crate) fn take(&mut self) -> Option<Arc<Capture>> {
+        self.capture.take()
+    }
+}
+
+/// What an encoder of a captured command buffer told.
+struct EncoderNote {
+    kind: EncoderKind,
+    causes: Vec<Split>,
+    not_inline: Option<NotInline>,
+}
+
+/// A `VkCommandBuffer` of a captured command buffer.
+#[derive(Default)]
+struct RawState {
+    /// The encoder last opened as it was handed out.
+    encoder: Option<u32>,
+    /// Its unit open.
+    open: Option<usize>,
+    /// A secondary's draws not yet in a unit.
+    pending_draws: u32,
+    /// The render pass instance that executed it, a secondary.
+    parent: Option<usize>,
+}
+
+/// A unit of work.
+struct Unit {
+    class: Class,
+    tag: Option<Tag>,
+    site: Option<&'static Location<'static>>,
+    command: &'static str,
+    encoder: Option<u32>,
+    label: Option<PassLabel>,
+    count: u32,
+    /// Its block's index in the capture's and its start query's offset in it.
+    block: usize,
+    offset: u32,
+}
+
+#[derive(Default)]
+struct CaptureState {
+    units: Vec<Unit>,
+    blocks: Vec<Block>,
+    used: u32,
+    out_of_queries: bool,
+    encoders: Vec<EncoderNote>,
+    current: Option<u32>,
+    raws: HashMap<u64, RawState>,
+}
+
+/// A captured command buffer.
+pub(crate) struct Capture {
+    times: Arc<DeviceTimes>,
+    device: Device,
+    seq: u64,
+    key: usize,
+    queue_label: String,
+    state: Mutex<CaptureState>,
+}
+
+impl Drop for Capture {
+    fn drop(&mut self) {
+        let me: *const Capture = self;
+        let state = self
+            .state
+            .get_mut()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        {
+            let mut raws = lock(&RAWS);
+            for raw in state.raws.keys() {
+                if raws.get(raw).is_some_and(|w| std::ptr::eq(w.as_ptr(), me)) {
+                    raws.remove(raw);
+                }
+            }
+        }
+        {
+            let mut keys = lock(&BY_KEY);
+            if keys
+                .get(&self.key)
+                .is_some_and(|w| std::ptr::eq(w.as_ptr(), me))
+            {
+                keys.remove(&self.key);
+            }
+        }
+        self.times.give_back(std::mem::take(&mut state.blocks));
+        LIVE.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+impl CaptureState {
+    /// Two queries for a unit: its block's index and the start's offset.
+    fn queries(&mut self, capture: &Capture) -> Option<(usize, u32)> {
+        if self.out_of_queries {
+            return None;
+        }
+        if self.blocks.is_empty() || self.used + 2 > BLOCK {
+            let device = capture.device.shared().vk();
+            // SAFETY: the capture's device is live.
+            match unsafe { capture.times.take(device) } {
+                Some(block) => {
+                    self.blocks.push(block);
+                    self.used = 0;
+                }
+                None => {
+                    self.out_of_queries = true;
+                    return None;
+                }
+            }
+        }
+        let offset = self.used;
+        self.used += 2;
+        Some((self.blocks.len() - 1, offset))
+    }
+}
+
+/// Begin `slot`'s capture where it is undecided: a capture where the device's timer is on and
+/// `<dir>/on` exists.
+fn decide<'a>(
+    slot: &'a mut CbSlot,
+    device: &Device,
+    queue: &CommandQueue,
+    key: usize,
+) -> Option<&'a Arc<Capture>> {
+    if !slot.decided {
+        slot.decided = true;
+        slot.capture = start(device, queue, key);
+    }
+    slot.capture.as_ref()
+}
+
+fn start(device: &Device, queue: &CommandQueue, key: usize) -> Option<Arc<Capture>> {
+    let times = device.shared().pass_times.as_ref()?;
+    let dir = dir()?;
+    if !dir.join("on").exists() {
+        times.flush();
+        return None;
+    }
+    let label = queue.label().unwrap_or_else(|| "-".to_owned());
+    let capture = Arc::new(Capture {
+        times: Arc::clone(times),
+        device: device.clone(),
+        seq: NEXT_SEQ.fetch_add(1, Ordering::Relaxed),
+        key,
+        queue_label: label.replace(',', ";"),
+        state: Mutex::default(),
+    });
+    LIVE.fetch_add(1, Ordering::Relaxed);
+    lock(&BY_KEY).insert(key, Arc::downgrade(&capture));
+    Some(capture)
+}
+
+/// An encoder of `kind` opens on the command buffer at `key` of `device` and `queue`, whose capture
+/// `slot` holds (`EncoderCore::open`): `VkCommandBuffer`s handed out from now on are its.
+pub(crate) fn encoder_opened(
+    device: &Device,
+    queue: &CommandQueue,
+    key: usize,
+    slot: &mut CbSlot,
+    kind: EncoderKind,
+) {
+    if !on() {
+        return;
+    }
+    let Some(capture) = decide(slot, device, queue, key) else {
+        return;
+    };
+    let mut state = lock(&capture.state);
+    state.current = Some(state.encoders.len() as u32);
+    state.encoders.push(EncoderNote {
+        kind,
+        causes: Vec::new(),
+        not_inline: None,
+    });
+}
+
+/// The command buffer at `key` of `device` and `queue`, whose capture `slot` holds, handed out
+/// `raw` (`CommandBufferShared::allocate_deferred` and kin).
+pub(crate) fn handed_out(
+    device: &Device,
+    queue: &CommandQueue,
+    key: usize,
+    slot: &mut CbSlot,
+    raw: vk::CommandBuffer,
+) {
+    if !on() {
+        return;
+    }
+    let Some(capture) = decide(slot, device, queue, key) else {
+        // A handle a capture still alive handed out before goes to no capture now.
+        if LIVE.load(Ordering::Relaxed) > 0 {
+            lock(&RAWS).remove(&raw.as_raw());
+        }
+        return;
+    };
+    {
+        let mut state = lock(&capture.state);
+        let encoder = state.current;
+        state.raws.insert(
+            raw.as_raw(),
+            RawState {
+                encoder,
+                ..RawState::default()
+            },
+        );
+    }
+    lock(&RAWS).insert(raw.as_raw(), Arc::downgrade(capture));
+}
+
+/// The capture of the command buffer at `key`.
+fn by_key(key: usize) -> Option<Arc<Capture>> {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return None;
+    }
+    lock(&BY_KEY).get(&key)?.upgrade()
+}
+
+/// A render encoder of `command_buffer` split its pass for `cause` (`render.rs`).
+pub(crate) fn note_split(command_buffer: &CommandBuffer, cause: Split) {
+    if !on() {
+        return;
+    }
+    let Some(capture) = by_key(command_buffer.pass_times_key()) else {
+        return;
+    };
+    let mut state = lock(&capture.state);
+    if let Some(at) = state.current {
+        if let Some(note) = state.encoders.get_mut(at as usize) {
+            note.causes.push(cause);
+        }
+    }
+}
+
+/// A render encoder of `command_buffer` did not record its pass's first instance inline, for
+/// `why` (`render.rs`, `render/inline_first.rs`).
+pub(crate) fn note_not_inline(command_buffer: &CommandBuffer, why: NotInline) {
+    if !on() {
+        return;
+    }
+    let Some(capture) = by_key(command_buffer.pass_times_key()) else {
+        return;
+    };
+    let mut state = lock(&capture.state);
+    if let Some(at) = state.current {
+        if let Some(note) = state.encoders.get_mut(at as usize) {
+            note.not_inline.get_or_insert(why);
+        }
+    }
+}
+
+/// The capture `raw` was handed out by.
+fn capture_of(raw: vk::CommandBuffer) -> Option<Arc<Capture>> {
+    lock(&RAWS).get(&raw.as_raw())?.upgrade()
+}
+
+/// Open a unit on `cb`: its start written.
+///
+/// # Safety
+///
+/// `cb` is recording outside a render pass instance, by the caller alone; `st` are its slot's.
+unsafe fn open(
+    st: Stamps,
+    cb: vk::CommandBuffer,
+    capture: &Capture,
+    state: &mut CaptureState,
+    mut unit: Unit,
+) -> Option<usize> {
+    let (block, offset) = state.queries(capture)?;
+    let Block { pool, first } = state.blocks[block];
+    // SAFETY: the caller's; the queries are the capture's, reset on the host or here.
+    unsafe {
+        if !capture.times.host_reset {
+            (st.reset)(cb, pool, first + offset, 2);
+        }
+        (st.write)(
+            cb,
+            vk::PipelineStageFlags::ALL_COMMANDS,
+            pool,
+            first + offset,
+        );
+    }
+    unit.block = block;
+    unit.offset = offset;
+    state.units.push(unit);
+    Some(state.units.len() - 1)
+}
+
+/// Close unit `index` on `cb`: its end written.
+///
+/// # Safety
+///
+/// As [`open`]'s.
+unsafe fn close(st: Stamps, cb: vk::CommandBuffer, state: &CaptureState, index: usize) {
+    let unit = &state.units[index];
+    let Block { pool, first } = state.blocks[unit.block];
+    // SAFETY: the caller's.
+    unsafe {
+        (st.write)(
+            cb,
+            vk::PipelineStageFlags::ALL_COMMANDS,
+            pool,
+            first + unit.offset + 1,
+        )
+    };
+}
+
+/// Before `vkCmdBeginRenderPass` of `begin` on `cb`: the open run closed, a render pass unit
+/// opened.
+///
+/// # Safety
+///
+/// As the command's: `cb` recording outside a render pass, `begin` valid; `st` are its slot's.
+pub(crate) unsafe fn begin_pass(
+    st: Stamps,
+    cb: vk::CommandBuffer,
+    begin: *const vk::RenderPassBeginInfo<'_>,
+) {
+    let site = SITE.with(Cell::take);
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let tag = SCOPE.with(Cell::get);
+    // SAFETY: the caller's.
+    let label = unsafe { begin.as_ref() }.map(|begin| {
+        image_log::pass_label(
+            begin.render_pass,
+            begin.framebuffer,
+            begin.render_area.extent,
+        )
+    });
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(raw) = state.raws.get_mut(&cb.as_raw()) else {
+        return;
+    };
+    let encoder = raw.encoder;
+    if let Some(open) = raw.open.take() {
+        // SAFETY: the caller's.
+        unsafe { close(st, cb, state, open) };
+    }
+    let unit = Unit {
+        class: Class::Pass,
+        tag,
+        site,
+        command: "vkCmdBeginRenderPass",
+        encoder,
+        label,
+        count: 0,
+        block: 0,
+        offset: 0,
+    };
+    // SAFETY: the caller's.
+    let opened = unsafe { open(st, cb, &capture, state, unit) };
+    if let Some(raw) = state.raws.get_mut(&cb.as_raw()) {
+        raw.open = opened;
+    }
+}
+
+/// After `vkCmdEndRenderPass` on `cb`: its render pass unit closed.
+///
+/// # Safety
+///
+/// As the command's; `st` are its slot's.
+pub(crate) unsafe fn end_pass(st: Stamps, cb: vk::CommandBuffer) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(open) = state.raws.get_mut(&cb.as_raw()).and_then(|r| r.open.take()) else {
+        return;
+    };
+    // SAFETY: the caller's: the pass ended.
+    unsafe { close(st, cb, state, open) };
+}
+
+/// Before `vkEndCommandBuffer` of `cb`: its open unit closed.
+///
+/// # Safety
+///
+/// As the command's; `st` are its slot's.
+pub(crate) unsafe fn end(st: Stamps, cb: vk::CommandBuffer) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(open) = state.raws.get_mut(&cb.as_raw()).and_then(|r| r.open.take()) else {
+        return;
+    };
+    // SAFETY: the caller's.
+    unsafe { close(st, cb, state, open) };
+}
+
+/// Before a dispatch or transfer `command` of `class` on `cb`: counted in the open run where it
+/// is of its class and label, else the run closed and another opened.
+///
+/// # Safety
+///
+/// As the command's: `cb` recording outside a render pass instance; `st` are its slot's.
+pub(crate) unsafe fn work(st: Stamps, cb: vk::CommandBuffer, class: Class, command: &'static str) {
+    let site = SITE.with(Cell::take);
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let tag = SCOPE.with(Cell::get);
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(raw) = state.raws.get_mut(&cb.as_raw()) else {
+        return;
+    };
+    let encoder = raw.encoder;
+    // The program's own commands of its encoder's class run on whatever records them; other
+    // work runs by its place.
+    let kind = encoder
+        .and_then(|e| state.encoders.get(e as usize))
+        .map(|n| n.kind);
+    let natural = tag == Some(Tag::Guest) && natural(kind, class);
+    if let Some(at) = raw.open {
+        let unit = &mut state.units[at];
+        let same = unit.class == class
+            && unit.tag == tag
+            && unit.encoder == encoder
+            && (natural || (unit.site == site && unit.command == command));
+        // A command inside a render pass instance (none of these may be) counts in it.
+        if same || unit.class == Class::Pass {
+            unit.count += 1;
+            return;
+        }
+        raw.open = None;
+        // SAFETY: the caller's.
+        unsafe { close(st, cb, state, at) };
+    }
+    let unit = Unit {
+        class,
+        tag,
+        site,
+        command,
+        encoder,
+        label: None,
+        count: 1,
+        block: 0,
+        offset: 0,
+    };
+    // SAFETY: the caller's.
+    let opened = unsafe { open(st, cb, &capture, state, unit) };
+    if let Some(raw) = state.raws.get_mut(&cb.as_raw()) {
+        raw.open = opened;
+    }
+}
+
+/// Before a draw on `cb`: counted in its render pass instance, or the one that executes it.
+pub(crate) fn draw(cb: vk::CommandBuffer) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(raw) = state.raws.get_mut(&cb.as_raw()) else {
+        return;
+    };
+    match raw.open.or(raw.parent) {
+        Some(at) => state.units[at].count += 1,
+        None => raw.pending_draws += 1,
+    }
+}
+
+/// Before `vkCmdExecuteGeneratedCommandsEXT` on `cb`: a draw inside a render pass instance, else a
+/// dispatch.
+///
+/// # Safety
+///
+/// As [`work`]'s.
+pub(crate) unsafe fn generated(st: Stamps, cb: vk::CommandBuffer, command: &'static str) {
+    let in_pass = LIVE.load(Ordering::Relaxed) > 0
+        && capture_of(cb).is_some_and(|capture| {
+            let state = lock(&capture.state);
+            let open = state.raws.get(&cb.as_raw()).and_then(|r| r.open);
+            let in_pass = open.is_some_and(|at| state.units[at].class == Class::Pass);
+            in_pass
+        });
+    match in_pass {
+        true => {
+            SITE.with(Cell::take);
+            draw(cb);
+        }
+        // SAFETY: the caller's.
+        false => unsafe { work(st, cb, Class::Compute, command) },
+    }
+}
+
+/// Before `vkCmdExecuteCommands` of `count` secondaries at `buffers` on `cb`: their draws counted
+/// in its render pass instance, and their later ones.
+///
+/// # Safety
+///
+/// `buffers` points at `count` command buffers.
+pub(crate) unsafe fn execute(cb: vk::CommandBuffer, count: u32, buffers: *const vk::CommandBuffer) {
+    if LIVE.load(Ordering::Relaxed) == 0 || buffers.is_null() {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(at) = state.raws.get(&cb.as_raw()).and_then(|r| r.open) else {
+        return;
+    };
+    // SAFETY: the caller's.
+    let secondaries = unsafe { std::slice::from_raw_parts(buffers, count as usize) };
+    let mut draws = 0;
+    for secondary in secondaries {
+        if let Some(raw) = state.raws.get_mut(&secondary.as_raw()) {
+            draws += std::mem::take(&mut raw.pending_draws);
+            raw.parent = Some(at);
+        }
+    }
+    state.units[at].count += draws;
+}
+
+/// The routed commands' hooks (`recorder/thunks.rs`): `before` a command is logged or called, and
+/// `after`; a command named nowhere here has none.
+macro_rules! hook {
+    (before cmd_begin_render_pass, $st:expr, $cb:ident, $begin:ident, $contents:ident) => {
+        if $crate::pass_times::on() {
+            unsafe { $crate::pass_times::begin_pass($st, $cb, $begin) }
+        }
+    };
+    (after cmd_end_render_pass, $st:expr, $cb:ident) => {
+        if $crate::pass_times::on() {
+            unsafe { $crate::pass_times::end_pass($st, $cb) }
+        }
+    };
+    (before end_command_buffer, $st:expr, $cb:ident) => {
+        if $crate::pass_times::on() {
+            unsafe { $crate::pass_times::end($st, $cb) }
+        }
+    };
+    (before cmd_execute_commands, $st:expr, $cb:ident, $count:ident, $buffers:ident) => {
+        if $crate::pass_times::on() {
+            unsafe { $crate::pass_times::execute($cb, $count, $buffers) }
+        }
+    };
+    (before cmd_execute_generated_commands, $st:expr, $cb:ident $(, $a:ident)*) => {
+        if $crate::pass_times::on() {
+            unsafe {
+                $crate::pass_times::generated($st, $cb, "vkCmdExecuteGeneratedCommandsEXT")
+            }
+        }
+    };
+    (before cmd_draw, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_indexed, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_indirect, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_indexed_indirect, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_mesh_tasks, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_mesh_tasks_indirect, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_draw_mesh_tasks_indirect_count, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@draw $cb)
+    };
+    (before cmd_dispatch, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Compute, "vkCmdDispatch")
+    };
+    (before cmd_dispatch_indirect, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Compute, "vkCmdDispatchIndirect")
+    };
+    (before cmd_preprocess_generated_commands, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Compute, "vkCmdPreprocessGeneratedCommandsEXT")
+    };
+    (before cmd_copy_buffer, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdCopyBuffer")
+    };
+    (before cmd_copy_image, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdCopyImage")
+    };
+    (before cmd_blit_image, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdBlitImage")
+    };
+    (before cmd_copy_buffer_to_image, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdCopyBufferToImage")
+    };
+    (before cmd_copy_image_to_buffer, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdCopyImageToBuffer")
+    };
+    (before cmd_update_buffer, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdUpdateBuffer")
+    };
+    (before cmd_fill_buffer, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdFillBuffer")
+    };
+    (before cmd_clear_color_image, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdClearColorImage")
+    };
+    (before cmd_clear_depth_stencil_image, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdClearDepthStencilImage")
+    };
+    (before cmd_copy_query_pool_results, $st:expr, $cb:ident $(, $a:ident)*) => {
+        $crate::pass_times::hook!(@work $st, $cb, Transfer, "vkCmdCopyQueryPoolResults")
+    };
+    (@draw $cb:ident) => {
+        if $crate::pass_times::on() {
+            $crate::pass_times::draw($cb)
+        }
+    };
+    (@work $st:expr, $cb:ident, $class:ident, $name:literal) => {
+        if $crate::pass_times::on() {
+            unsafe { $crate::pass_times::work($st, $cb, $crate::pass_times::Class::$class, $name) }
+        }
+    };
+    ($phase:ident $command:ident, $($rest:tt)*) => {};
+}
+pub(crate) use hook;
