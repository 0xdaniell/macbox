+    pub(super) fn read_pass_times(&self) {
+        let mut state = lock(&self.state);
+        let Some(capture) = state.pass_times.take() else {
+            return;
+        };
+        let start = match (state.times.stamped, state.times.gpu) {
+            (Stamped::Read(Some((ticks, _))), Some((host, _))) => Some((ticks, host)),
+            _ => None,
+        };
+        let pair = state.times.pair.map(|reading| reading.pair);
+        let completed = state.times.completed;
+        drop(state);
+        let placement = crate::pass_times::Placement {
+            clock: self.device.shared().timing.clock(),
+            pair,
+            start,
+            completed,
+        };
+        crate::pass_times::read(capture, placement);
