@@ -0,0 +1,925 @@
+//! LOCAL (Atlas) diagnostic: the image census, `M2V_IMAGE_LOG=<file>`, and the registry of the
+//! objects a render pass instance names, which the pass timer (`pass_times.rs`) labels its
+//! attachments from. Default off; the whole module can be dropped with its hooks (each marked
+//! `LOCAL (Atlas) diagnostic`).
+//!
+//! - **The switch** is read once. Unset (or empty), nothing is recorded, no line is formatted, and
+//!   no Vulkan call is added. Set, the census appends to the file it names (made if missing).
+//! - **What the census writes.** One CSV line per event, every line the same columns
+//!   ([`HEADER`]), written as it happens (a `write` per line: image creation is rare next to the
+//!   work it serves, and the lines survive the process being killed):
+//!   - `create`, per `VkImage` the runtime makes (`creation::image`, `creation::image_or_refusal`,
+//!     the one door to `vkCreateImage`; the device's priming makes its own and is not logged): the
+//!     image, its purpose (`api`: the program's call that made it where one is on the stack,
+//!     `texture`, `heap-texture`, `buffer-texture`, `iosurface-plane`; `origin`: where the
+//!     texture paths' image making was called from, with the texture's storage mode; `site`: the
+//!     call of `creation::image` itself), format, extent, mip levels, array layers, samples,
+//!     tiling (and the DRM format modifier or modifier list chained), usage, create flags, the
+//!     chained `VkImageFormatListCreateInfo` (`-` where none is chained, else its view formats),
+//!     the external memory handle types chained, any other structure chained, and the image's
+//!     memory requirements (size, alignment, memory types; `vkGetImageMemoryRequirements`, not
+//!     asked of a `DISJOINT` image).
+//!   - `bind`, per `vkBindImageMemory` (`creation::bind_image`): the memory and offset, and what
+//!     the memory is as the runtime allocated it (`creation::allocate_memory`): an import of host
+//!     pages (`host-pages`), of a dma-buf (`dma-buf`) or another fd, an export, or its own, and
+//!     whether dedicated to an image.
+//!   - `destroy`, per `vkDestroyImage` (`release::object`).
+//! - **The registry** (kept while either switch is on): each image's extent, usage and purpose,
+//!   each view's image and base level, each render pass's attachments (subpass 0's roles) and its
+//!   making's site, each framebuffer's extent and views, and each memory's kind; entries go as
+//!   their objects are released. A handle the driver reuses is registered again as it is made.
+
+use ash::vk;
+use ash::vk::Handle;
+use std::cell::Cell;
+use std::collections::HashMap;
+use std::fmt::Write as _;
+use std::io::Write as _;
+use std::panic::Location;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, LazyLock, Mutex, OnceLock};
+
+/// The census's columns, its file's first line.
+pub(crate) const HEADER: &str = "host_ns,event,image,api,origin,site,storage,format,width,height,\
+depth,mips,layers,samples,tiling,drm_modifier,usage,flags,format_list,external,chained,mem_size,\
+mem_align,mem_types,bind_memory,bind_offset,memory_kind\n";
+
+/// The census file, where `M2V_IMAGE_LOG` names one: read once.
+fn census_path() -> Option<&'static Path> {
+    static PATH: OnceLock<Option<PathBuf>> = OnceLock::new();
+    PATH.get_or_init(|| {
+        std::env::var_os("M2V_IMAGE_LOG")
+            .filter(|value| !value.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_deref()
+}
+
+/// Whether the census is on.
+pub(crate) fn census_on() -> bool {
+    census_path().is_some()
+}
+
+/// Whether the registry is kept: either diagnostic is on.
+pub(crate) fn registry_on() -> bool {
+    census_on() || crate::pass_times::on()
+}
+
+/// The host's clock now, in nanoseconds (`CLOCK_MONOTONIC_RAW`, the runtime's GPU times' clock).
+#[cfg(not(unix))]
+pub(crate) fn host_ns() -> u64 {
+    0
+}
+
+/// The host's clock now, in nanoseconds (`CLOCK_MONOTONIC_RAW`, the runtime's GPU times' clock).
+#[cfg(unix)]
+pub(crate) fn host_ns() -> u64 {
+    let mut now = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: `now` is a valid timespec for the call to fill.
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC_RAW, &mut now) } != 0 {
+        return 0;
+    }
+    (now.tv_sec as u64) * 1_000_000_000 + now.tv_nsec as u64
+}
+
+/// `file:line` of `at`, its path from the crate's `src/` on.
+pub(crate) fn short(at: &Location<'_>) -> String {
+    let file = at.file();
+    let file = match file.rfind("/src/") {
+        Some(i) => &file[i + 5..],
+        None => file,
+    };
+    format!("{file}:{}", at.line())
+}
+
+/// The bits of `raw` by their registry names in `known`, less `prefix` and `_BIT`, `|`-joined;
+/// bits no name holds in hex; `0` for none. (`ash` is built without its `Debug` impls.)
+fn flag_names<'a>(raw: u32, known: impl Iterator<Item = (u32, &'a str)>, prefix: &str) -> String {
+    if raw == 0 {
+        return "0".to_owned();
+    }
+    let mut names = Vec::new();
+    let mut rest = raw;
+    for (bit, name) in known {
+        if bit.count_ones() == 1 && rest & bit != 0 {
+            names.push(name.trim_start_matches(prefix).replace("_BIT", ""));
+            rest &= !bit;
+        }
+    }
+    if rest != 0 {
+        names.push(format!("0x{rest:x}"));
+    }
+    names.join("|")
+}
+
+/// `format`'s registry name less `VK_FORMAT_`, else its number.
+pub(crate) fn format_name(format: vk::Format) -> String {
+    match metal2vulkan::vk::Format::from_raw(format.as_raw()).name() {
+        Some(name) => name.trim_start_matches("VK_FORMAT_").to_owned(),
+        None => format!("format{}", format.as_raw()),
+    }
+}
+
+fn tiling_name(tiling: vk::ImageTiling) -> String {
+    match metal2vulkan::vk::ImageTiling::from_raw(tiling.as_raw()).name() {
+        Some(name) => name.trim_start_matches("VK_IMAGE_TILING_").to_owned(),
+        None => format!("tiling{}", tiling.as_raw()),
+    }
+}
+
+fn usage_names(usage: vk::ImageUsageFlags) -> String {
+    let known = metal2vulkan::vk::ImageUsageFlags::KNOWN.iter();
+    flag_names(
+        usage.as_raw(),
+        known.map(|(v, n)| (v.as_raw(), *n)),
+        "VK_IMAGE_USAGE_",
+    )
+}
+
+fn create_names(flags: vk::ImageCreateFlags) -> String {
+    let known = metal2vulkan::vk::ImageCreateFlags::KNOWN.iter();
+    flag_names(
+        flags.as_raw(),
+        known.map(|(v, n)| (v.as_raw(), *n)),
+        "VK_IMAGE_CREATE_",
+    )
+}
+
+fn external_names(types: vk::ExternalMemoryHandleTypeFlags) -> String {
+    use vk::ExternalMemoryHandleTypeFlags as T;
+    let known = [
+        (T::OPAQUE_FD, "OPAQUE_FD"),
+        (T::OPAQUE_WIN32, "OPAQUE_WIN32"),
+        (T::OPAQUE_WIN32_KMT, "OPAQUE_WIN32_KMT"),
+        (T::D3D11_TEXTURE, "D3D11_TEXTURE"),
+        (T::D3D11_TEXTURE_KMT, "D3D11_TEXTURE_KMT"),
+        (T::D3D12_HEAP, "D3D12_HEAP"),
+        (T::D3D12_RESOURCE, "D3D12_RESOURCE"),
+        (T::HOST_ALLOCATION_EXT, "HOST_ALLOCATION"),
+        (
+            T::HOST_MAPPED_FOREIGN_MEMORY_EXT,
+            "HOST_MAPPED_FOREIGN_MEMORY",
+        ),
+        (T::DMA_BUF_EXT, "DMA_BUF"),
+    ];
+    flag_names(
+        types.as_raw(),
+        known.iter().map(|(v, n)| (v.as_raw(), *n)),
+        "",
+    )
+}
+
+fn load_name(op: vk::AttachmentLoadOp) -> String {
+    match op {
+        vk::AttachmentLoadOp::LOAD => "LOAD".into(),
+        vk::AttachmentLoadOp::CLEAR => "CLEAR".into(),
+        vk::AttachmentLoadOp::DONT_CARE => "DONT_CARE".into(),
+        vk::AttachmentLoadOp::NONE_KHR => "NONE".into(),
+        other => format!("load{}", other.as_raw()),
+    }
+}
+
+fn store_name(op: vk::AttachmentStoreOp) -> String {
+    match op {
+        vk::AttachmentStoreOp::STORE => "STORE".into(),
+        vk::AttachmentStoreOp::DONT_CARE => "DONT_CARE".into(),
+        vk::AttachmentStoreOp::NONE => "NONE".into(),
+        other => format!("store{}", other.as_raw()),
+    }
+}
+
+/// What the registry holds of an image.
+pub(crate) struct ImageEntry {
+    extent: vk::Extent3D,
+    usage: vk::ImageUsageFlags,
+    /// Its purpose, short: the program's call, else the texture path's caller, else the site.
+    purpose: Arc<str>,
+}
+
+/// A render pass attachment's role in subpass 0.
+#[derive(Clone, Copy)]
+enum Role {
+    Color(u32),
+    Resolve(u32),
+    DepthStencil,
+    DepthStencilResolve,
+    Input(u32),
+    Other(u32),
+}
+
+/// A render pass's attachment, as made.
+#[derive(Clone, Copy)]
+struct PassAttachment {
+    role: Role,
+    format: vk::Format,
+    samples: u32,
+    load: vk::AttachmentLoadOp,
+    store: vk::AttachmentStoreOp,
+    stencil_load: vk::AttachmentLoadOp,
+    stencil_store: vk::AttachmentStoreOp,
+}
+
+/// A render pass, as made.
+struct PassEntry {
+    attachments: Vec<PassAttachment>,
+    site: &'static Location<'static>,
+}
+
+/// A framebuffer, as made.
+struct FramebufferEntry {
+    width: u32,
+    height: u32,
+    views: Vec<u64>,
+}
+
+/// The objects registered.
+#[derive(Default)]
+struct Registry {
+    images: HashMap<u64, Arc<ImageEntry>>,
+    views: HashMap<u64, (u64, u32)>,
+    passes: HashMap<u64, Arc<PassEntry>>,
+    framebuffers: HashMap<u64, Arc<FramebufferEntry>>,
+    memories: HashMap<u64, &'static str>,
+}
+
+static REGISTRY: LazyLock<Mutex<Registry>> = LazyLock::new(Mutex::default);
+
+fn registry() -> std::sync::MutexGuard<'static, Registry> {
+    REGISTRY
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+thread_local! {
+    /// The program's call making a texture on this thread, the outermost.
+    static API: Cell<Option<&'static str>> = const { Cell::new(None) };
+    /// Where the texture paths' image making was called from, and the texture's storage mode.
+    static ORIGIN: Cell<Option<(&'static Location<'static>, &'static str)>> =
+        const { Cell::new(None) };
+}
+
+/// A purpose set on this thread until dropped ([`api`], [`origin`]).
+pub(crate) struct PurposeGuard(Option<Restore>);
+
+enum Restore {
+    Api(Option<&'static str>),
+    Origin(Option<(&'static Location<'static>, &'static str)>),
+}
+
+impl Drop for PurposeGuard {
+    fn drop(&mut self) {
+        match self.0.take() {
+            Some(Restore::Api(previous)) => API.with(|api| api.set(previous)),
+            Some(Restore::Origin(previous)) => ORIGIN.with(|origin| origin.set(previous)),
+            None => {}
+        }
+    }
+}
+
+/// The program's call `name` makes textures on this thread until the guard drops: the census's
+/// `api`. The outermost call holds.
+pub(crate) fn api(name: &'static str) -> PurposeGuard {
+    if !registry_on() {
+        return PurposeGuard(None);
+    }
+    let previous = API.with(|api| api.get());
+    if previous.is_some() {
+        return PurposeGuard(None);
+    }
+    API.with(|api| api.set(Some(name)));
+    PurposeGuard(Some(Restore::Api(previous)))
+}
+
+/// The texture paths' image making called from `at`, for a texture of `storage` mode, until the
+/// guard drops: the census's `origin`. The innermost holds.
+pub(crate) fn origin(at: &'static Location<'static>, storage: &'static str) -> PurposeGuard {
+    if !registry_on() {
+        return PurposeGuard(None);
+    }
+    let previous = ORIGIN.with(|origin| origin.replace(Some((at, storage))));
+    PurposeGuard(Some(Restore::Origin(previous)))
+}
+
+/// The census's line writer.
+static CENSUS: Mutex<Option<std::fs::File>> = Mutex::new(None);
+
+/// Append `line` to the census, opening it (and heading a new one) at the first.
+fn census_line(line: &str) {
+    let Some(path) = census_path() else {
+        return;
+    };
+    let mut file = CENSUS
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if file.is_none() {
+        let opened = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path);
+        match opened {
+            Ok(mut opened) => {
+                if opened.metadata().map(|m| m.len() == 0).unwrap_or(false) {
+                    let _ = opened.write_all(HEADER.as_bytes());
+                }
+                *file = Some(opened);
+            }
+            Err(error) => {
+                eprintln!("metal2vulkan: M2V_IMAGE_LOG: cannot open {path:?}: {error}");
+                return;
+            }
+        }
+    }
+    if let Some(file) = file.as_mut() {
+        let _ = file.write_all(line.as_bytes());
+    }
+}
+
+/// The structures chained to `next`, as a walk of their headers.
+///
+/// # Safety
+///
+/// `next` is null or a valid chain of Vulkan structures.
+unsafe fn chain(mut next: *const std::ffi::c_void) -> Vec<*const vk::BaseInStructure<'static>> {
+    let mut all = Vec::new();
+    while !next.is_null() {
+        let base = next.cast::<vk::BaseInStructure<'static>>();
+        all.push(base);
+        // SAFETY: the caller's.
+        next = unsafe { (*base).p_next }.cast();
+    }
+    all
+}
+
+/// A slice of `count` from `ptr`, empty where null.
+///
+/// # Safety
+///
+/// `ptr` is null or points at `count` valid values.
+unsafe fn slice<'a, T>(ptr: *const T, count: u32) -> &'a [T] {
+    match ptr.is_null() || count == 0 {
+        true => &[],
+        // SAFETY: the caller's.
+        false => unsafe { std::slice::from_raw_parts(ptr, count as usize) },
+    }
+}
+
+/// Note `image`, made of `info` by `device` at `site` (`creation::image`): registered, and in the
+/// census its `create` line.
+///
+/// # Safety
+///
+/// `info` and its chain are valid; `image` is `device`'s, live.
+pub(crate) unsafe fn image_made(
+    device: &ash::Device,
+    info: &vk::ImageCreateInfo<'_>,
+    image: vk::Image,
+    site: &'static Location<'static>,
+) {
+    if !registry_on() {
+        return;
+    }
+    let api = API.with(|api| api.get());
+    let origin = ORIGIN.with(|origin| origin.get());
+    let site = short(site);
+    let origin_at = origin.map(|(at, _)| short(at));
+    let purpose: Arc<str> = match (api, &origin_at) {
+        (Some(api), _) => api.into(),
+        (None, Some(at)) => format!("<{at}").into(),
+        (None, None) => site.clone().into(),
+    };
+    let entry = ImageEntry {
+        extent: info.extent,
+        usage: info.usage,
+        purpose,
+    };
+    registry().images.insert(image.as_raw(), Arc::new(entry));
+    if !census_on() {
+        return;
+    }
+    let mut format_list = "-".to_owned();
+    let mut external = "0".to_owned();
+    let mut drm_modifier = "-".to_owned();
+    let mut chained = Vec::new();
+    // SAFETY: the caller's: `info`'s chain is valid.
+    for base in unsafe { chain(info.p_next) } {
+        // SAFETY: each is a valid structure of its `s_type`.
+        unsafe {
+            match (*base).s_type {
+                vk::StructureType::IMAGE_FORMAT_LIST_CREATE_INFO => {
+                    let list = &*base.cast::<vk::ImageFormatListCreateInfo<'static>>();
+                    let formats = slice(list.p_view_formats, list.view_format_count);
+                    let names: Vec<String> = formats.iter().map(|f| format_name(*f)).collect();
+                    format_list = format!("{}:{}", formats.len(), names.join("|"));
+                }
+                vk::StructureType::EXTERNAL_MEMORY_IMAGE_CREATE_INFO => {
+                    let ext = &*base.cast::<vk::ExternalMemoryImageCreateInfo<'static>>();
+                    external = external_names(ext.handle_types);
+                }
+                vk::StructureType::IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT => {
+                    let explicit =
+                        &*base.cast::<vk::ImageDrmFormatModifierExplicitCreateInfoEXT<'static>>();
+                    drm_modifier = format!(
+                        "0x{:x}:planes={}",
+                        explicit.drm_format_modifier, explicit.drm_format_modifier_plane_count
+                    );
+                }
+                vk::StructureType::IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT => {
+                    let list =
+                        &*base.cast::<vk::ImageDrmFormatModifierListCreateInfoEXT<'static>>();
+                    let all = slice(list.p_drm_format_modifiers, list.drm_format_modifier_count);
+                    let names: Vec<String> = all.iter().map(|m| format!("0x{m:x}")).collect();
+                    drm_modifier = format!("list:{}", names.join("|"));
+                }
+                other => chained.push(format!("sType{}", other.as_raw())),
+            }
+        }
+    }
+    let requirements = match info.flags.contains(vk::ImageCreateFlags::DISJOINT) {
+        true => None,
+        // SAFETY: `image` is `device`'s, live, not disjoint.
+        false => Some(unsafe { device.get_image_memory_requirements(image) }),
+    };
+    crate::exit_guard::called(crate::exit_guard::Call::GetImageMemoryRequirements);
+    let (size, align, types) = match requirements {
+        Some(r) => (
+            r.size.to_string(),
+            r.alignment.to_string(),
+            format!("0x{:x}", r.memory_type_bits),
+        ),
+        None => ("-".into(), "-".into(), "-".into()),
+    };
+    let chained = match chained.is_empty() {
+        true => "-".to_owned(),
+        false => chained.join("|").replace(',', ";"),
+    };
+    let (origin_at, storage) = match origin {
+        Some((_, storage)) => (origin_at.unwrap_or_default(), storage),
+        None => ("-".to_owned(), "-"),
+    };
+    let mut line = String::with_capacity(256);
+    let _ = writeln!(
+        line,
+        "{},create,0x{:x},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},,,",
+        host_ns(),
+        image.as_raw(),
+        api.unwrap_or("-"),
+        origin_at,
+        site,
+        storage,
+        format_name(info.format),
+        info.extent.width,
+        info.extent.height,
+        info.extent.depth,
+        info.mip_levels,
+        info.array_layers,
+        info.samples.as_raw(),
+        tiling_name(info.tiling),
+        drm_modifier,
+        usage_names(info.usage),
+        create_names(info.flags),
+        format_list,
+        external,
+        chained,
+        size,
+        align,
+        types,
+    );
+    census_line(&line);
+}
+
+/// Note `memory`, allocated of `info` (`creation::allocate_memory`): its kind registered.
+///
+/// # Safety
+///
+/// `info` and its chain are valid.
+pub(crate) unsafe fn memory_made(info: &vk::MemoryAllocateInfo<'_>, memory: vk::DeviceMemory) {
+    if !census_on() {
+        return;
+    }
+    let mut kind = "own";
+    let mut dedicated = false;
+    // SAFETY: the caller's.
+    for base in unsafe { chain(info.p_next) } {
+        // SAFETY: each is a valid structure of its `s_type`.
+        unsafe {
+            match (*base).s_type {
+                vk::StructureType::IMPORT_MEMORY_HOST_POINTER_INFO_EXT => kind = "host-pages",
+                vk::StructureType::IMPORT_MEMORY_FD_INFO_KHR => {
+                    let fd = &*base.cast::<vk::ImportMemoryFdInfoKHR<'static>>();
+                    kind = match fd.handle_type {
+                        vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT => "dma-buf",
+                        _ => "fd-import",
+                    };
+                }
+                vk::StructureType::EXPORT_MEMORY_ALLOCATE_INFO if kind == "own" => {
+                    kind = "own-export"
+                }
+                vk::StructureType::MEMORY_DEDICATED_ALLOCATE_INFO => {
+                    let info = &*base.cast::<vk::MemoryDedicatedAllocateInfo<'static>>();
+                    dedicated = info.image != vk::Image::null();
+                }
+                _ => {}
+            }
+        }
+    }
+    let kind = match (kind, dedicated) {
+        ("own", true) => "own-dedicated",
+        ("own-export", true) => "own-export-dedicated",
+        ("dma-buf", true) => "dma-buf-dedicated",
+        ("host-pages", true) => "host-pages-dedicated",
+        (kind, _) => kind,
+    };
+    registry().memories.insert(memory.as_raw(), kind);
+}
+
+/// Note `image` bound to `memory` at `offset` (`creation::bind_image`): the census's `bind` line.
+pub(crate) fn image_bound(image: vk::Image, memory: vk::DeviceMemory, offset: vk::DeviceSize) {
+    if !census_on() {
+        return;
+    }
+    let kind = registry()
+        .memories
+        .get(&memory.as_raw())
+        .copied()
+        .unwrap_or("unknown");
+    let line = format!(
+        "{},bind,0x{:x},,,,,,,,,,,,,,,,,,,,,,0x{:x},{},{}\n",
+        host_ns(),
+        image.as_raw(),
+        memory.as_raw(),
+        offset,
+        kind
+    );
+    census_line(&line);
+}
+
+/// Note `view`, made of `info` (`creation::image_view`).
+pub(crate) fn view_made(info: &vk::ImageViewCreateInfo<'_>, view: vk::ImageView) {
+    if !registry_on() {
+        return;
+    }
+    let entry = (info.image.as_raw(), info.subresource_range.base_mip_level);
+    registry().views.insert(view.as_raw(), entry);
+}
+
+/// Note `pass`, made of `info` (`creation::render_pass`) at `site`.
+///
+/// # Safety
+///
+/// `info` is valid.
+pub(crate) unsafe fn render_pass_made(
+    info: &vk::RenderPassCreateInfo<'_>,
+    pass: vk::RenderPass,
+    site: &'static Location<'static>,
+) {
+    if !crate::pass_times::on() {
+        return;
+    }
+    // SAFETY: the caller's.
+    let (descriptions, subpasses) = unsafe {
+        (
+            slice(info.p_attachments, info.attachment_count),
+            slice(info.p_subpasses, info.subpass_count),
+        )
+    };
+    let mut roles: Vec<Option<Role>> = vec![None; descriptions.len()];
+    if let Some(subpass) = subpasses.first() {
+        // SAFETY: the caller's: subpass 0's references are valid.
+        unsafe {
+            let colors = slice(subpass.p_color_attachments, subpass.color_attachment_count);
+            note_roles(&mut roles, colors.iter().map(|r| r.attachment), Role::Color);
+            if !subpass.p_resolve_attachments.is_null() {
+                let resolves = slice(
+                    subpass.p_resolve_attachments,
+                    subpass.color_attachment_count,
+                );
+                note_roles(
+                    &mut roles,
+                    resolves.iter().map(|r| r.attachment),
+                    Role::Resolve,
+                );
+            }
+            let inputs = slice(subpass.p_input_attachments, subpass.input_attachment_count);
+            note_roles(&mut roles, inputs.iter().map(|r| r.attachment), Role::Input);
+            if let Some(depth) = subpass.p_depth_stencil_attachment.as_ref() {
+                note_role(&mut roles, depth.attachment, Role::DepthStencil);
+            }
+        }
+    }
+    let attachments = descriptions
+        .iter()
+        .enumerate()
+        .map(|(i, d)| PassAttachment {
+            role: roles[i].unwrap_or(Role::Other(i as u32)),
+            format: d.format,
+            samples: d.samples.as_raw(),
+            load: d.load_op,
+            store: d.store_op,
+            stencil_load: d.stencil_load_op,
+            stencil_store: d.stencil_store_op,
+        })
+        .collect();
+    let entry = PassEntry { attachments, site };
+    registry().passes.insert(pass.as_raw(), Arc::new(entry));
+}
+
+/// Note `pass`, made of `info` (`creation::render_pass2`) at `site`.
+///
+/// # Safety
+///
+/// `info` and its subpasses' chains are valid.
+pub(crate) unsafe fn render_pass2_made(
+    info: &vk::RenderPassCreateInfo2<'_>,
+    pass: vk::RenderPass,
+    site: &'static Location<'static>,
+) {
+    if !crate::pass_times::on() {
+        return;
+    }
+    // SAFETY: the caller's.
+    let (descriptions, subpasses) = unsafe {
+        (
+            slice(info.p_attachments, info.attachment_count),
+            slice(info.p_subpasses, info.subpass_count),
+        )
+    };
+    let mut roles: Vec<Option<Role>> = vec![None; descriptions.len()];
+    if let Some(subpass) = subpasses.first() {
+        // SAFETY: the caller's: subpass 0's references and chain are valid.
+        unsafe {
+            let colors = slice(subpass.p_color_attachments, subpass.color_attachment_count);
+            note_roles(&mut roles, colors.iter().map(|r| r.attachment), Role::Color);
+            if !subpass.p_resolve_attachments.is_null() {
+                let resolves = slice(
+                    subpass.p_resolve_attachments,
+                    subpass.color_attachment_count,
+                );
+                note_roles(
+                    &mut roles,
+                    resolves.iter().map(|r| r.attachment),
+                    Role::Resolve,
+                );
+            }
+            let inputs = slice(subpass.p_input_attachments, subpass.input_attachment_count);
+            note_roles(&mut roles, inputs.iter().map(|r| r.attachment), Role::Input);
+            if let Some(depth) = subpass.p_depth_stencil_attachment.as_ref() {
+                note_role(&mut roles, depth.attachment, Role::DepthStencil);
+            }
+            for base in chain(subpass.p_next) {
+                if (*base).s_type == vk::StructureType::SUBPASS_DESCRIPTION_DEPTH_STENCIL_RESOLVE {
+                    let resolve =
+                        &*base.cast::<vk::SubpassDescriptionDepthStencilResolve<'static>>();
+                    if let Some(at) = resolve.p_depth_stencil_resolve_attachment.as_ref() {
+                        note_role(&mut roles, at.attachment, Role::DepthStencilResolve);
+                    }
+                }
+            }
+        }
+    }
+    let attachments = descriptions
+        .iter()
+        .enumerate()
+        .map(|(i, d)| PassAttachment {
+            role: roles[i].unwrap_or(Role::Other(i as u32)),
+            format: d.format,
+            samples: d.samples.as_raw(),
+            load: d.load_op,
+            store: d.store_op,
+            stencil_load: d.stencil_load_op,
+            stencil_store: d.stencil_store_op,
+        })
+        .collect();
+    let entry = PassEntry { attachments, site };
+    registry().passes.insert(pass.as_raw(), Arc::new(entry));
+}
+
+/// Give each attachment of `indices` its role, `role` of its place among them.
+fn note_roles(
+    roles: &mut [Option<Role>],
+    indices: impl Iterator<Item = u32>,
+    role: impl Fn(u32) -> Role,
+) {
+    for (place, index) in indices.enumerate() {
+        note_role(roles, index, role(place as u32));
+    }
+}
+
+/// Give attachment `index` `role`, where it is one and has none yet.
+fn note_role(roles: &mut [Option<Role>], index: u32, role: Role) {
+    if let Some(slot) = roles.get_mut(index as usize) {
+        slot.get_or_insert(role);
+    }
+}
+
+/// Note `framebuffer`, made of `info` (`creation::framebuffer`).
+///
+/// # Safety
+///
+/// `info` is valid.
+pub(crate) unsafe fn framebuffer_made(
+    info: &vk::FramebufferCreateInfo<'_>,
+    framebuffer: vk::Framebuffer,
+) {
+    if !crate::pass_times::on() {
+        return;
+    }
+    let imageless = info.flags.contains(vk::FramebufferCreateFlags::IMAGELESS);
+    let views = match imageless {
+        true => Vec::new(),
+        // SAFETY: the caller's.
+        false => unsafe { slice(info.p_attachments, info.attachment_count) }
+            .iter()
+            .map(|view| view.as_raw())
+            .collect(),
+    };
+    let entry = FramebufferEntry {
+        width: info.width,
+        height: info.height,
+        views,
+    };
+    registry()
+        .framebuffers
+        .insert(framebuffer.as_raw(), Arc::new(entry));
+}
+
+/// Forget the object `raw` released by `call` (`release::object`); an image's release is the
+/// census's `destroy` line.
+pub(crate) fn released(call: crate::exit_guard::Call, raw: u64) {
+    use crate::exit_guard::Call;
+    if !registry_on() {
+        return;
+    }
+    let mut registry = registry();
+    match call {
+        Call::DestroyImage => {
+            registry.images.remove(&raw);
+            drop(registry);
+            if census_on() {
+                census_line(&format!(
+                    "{},destroy,0x{raw:x},,,,,,,,,,,,,,,,,,,,,,,,\n",
+                    host_ns()
+                ));
+            }
+        }
+        Call::DestroyImageView => {
+            registry.views.remove(&raw);
+        }
+        Call::DestroyRenderPass => {
+            registry.passes.remove(&raw);
+        }
+        Call::DestroyFramebuffer => {
+            registry.framebuffers.remove(&raw);
+        }
+        Call::FreeMemory => {
+            registry.memories.remove(&raw);
+        }
+        _ => {}
+    }
+}
+
+/// One attachment of a render pass instance, resolved as it begins.
+struct Attached {
+    pass: PassAttachment,
+    extent: Option<(u32, u32)>,
+    memoryless: bool,
+    purpose: Option<Arc<str>>,
+}
+
+/// What the pass timer records of a render pass instance's objects as it begins: its attachments,
+/// each with its image's extent, whether it is memoryless (a transient attachment) and its purpose,
+/// and where its pass was made. Formatted only once its command buffer completed ([`format`]).
+pub(crate) struct PassLabel {
+    attached: Vec<Attached>,
+    site: Option<&'static Location<'static>>,
+    extent: (u32, u32),
+}
+
+impl PassLabel {
+    /// Where the pass was made, short.
+    pub(crate) fn site(&self) -> Option<String> {
+        self.site.map(short)
+    }
+
+    /// The attachments, `|`-joined: each its role, format, extent, samples, load/store (and the
+    /// stencil's where it has one), `memoryless`, and `@` its image's purpose.
+    pub(crate) fn format(&self) -> String {
+        let mut out = String::new();
+        for (i, a) in self.attached.iter().enumerate() {
+            if i > 0 {
+                out.push('|');
+            }
+            let p = &a.pass;
+            let _ = match p.role {
+                Role::Color(j) => write!(out, "c{j}"),
+                Role::Resolve(j) => write!(out, "r{j}"),
+                Role::DepthStencil => write!(out, "ds"),
+                Role::DepthStencilResolve => write!(out, "dsr"),
+                Role::Input(j) => write!(out, "in{j}"),
+                Role::Other(j) => write!(out, "a{j}"),
+            };
+            let (w, h) = a.extent.unwrap_or(self.extent);
+            let _ = write!(
+                out,
+                ":{}:{w}x{h}:s{}:{}/{}",
+                format_name(p.format),
+                p.samples,
+                load_name(p.load),
+                store_name(p.store)
+            );
+            if matches!(p.role, Role::DepthStencil | Role::DepthStencilResolve)
+                && has_stencil(p.format)
+            {
+                let _ = write!(
+                    out,
+                    ":st={}/{}",
+                    load_name(p.stencil_load),
+                    store_name(p.stencil_store)
+                );
+            }
+            if a.memoryless {
+                out.push_str(":memoryless");
+            }
+            if let Some(purpose) = &a.purpose {
+                let _ = write!(out, "@{purpose}");
+            }
+        }
+        if out.is_empty() {
+            out.push('-');
+        }
+        out.replace(',', ";")
+    }
+}
+
+/// Whether `format` has a stencil aspect.
+fn has_stencil(format: vk::Format) -> bool {
+    matches!(
+        format,
+        vk::Format::S8_UINT
+            | vk::Format::D16_UNORM_S8_UINT
+            | vk::Format::D24_UNORM_S8_UINT
+            | vk::Format::D32_SFLOAT_S8_UINT
+    )
+}
+
+/// The label of a render pass instance of `pass` and `framebuffer`, of `area`, as it begins.
+pub(crate) fn pass_label(
+    pass: vk::RenderPass,
+    framebuffer: vk::Framebuffer,
+    area: vk::Extent2D,
+) -> PassLabel {
+    let registry = registry();
+    let pass = registry.passes.get(&pass.as_raw()).cloned();
+    let framebuffer = registry.framebuffers.get(&framebuffer.as_raw()).cloned();
+    let extent = framebuffer
+        .as_ref()
+        .map_or((area.width, area.height), |f| (f.width, f.height));
+    let Some(pass) = pass else {
+        return PassLabel {
+            attached: Vec::new(),
+            site: None,
+            extent,
+        };
+    };
+    let attached = pass
+        .attachments
+        .iter()
+        .enumerate()
+        .map(|(i, attachment)| {
+            let view = framebuffer.as_ref().and_then(|f| f.views.get(i)).copied();
+            let image = view.and_then(|v| registry.views.get(&v)).copied();
+            let entry = image.and_then(|(image, mip)| {
+                registry
+                    .images
+                    .get(&image)
+                    .map(|entry| (Arc::clone(entry), mip))
+            });
+            match entry {
+                Some((entry, mip)) => Attached {
+                    pass: *attachment,
+                    extent: Some((
+                        (entry.extent.width >> mip).max(1),
+                        (entry.extent.height >> mip).max(1),
+                    )),
+                    memoryless: entry
+                        .usage
+                        .contains(vk::ImageUsageFlags::TRANSIENT_ATTACHMENT),
+                    purpose: Some(Arc::clone(&entry.purpose)),
+                },
+                None => Attached {
+                    pass: *attachment,
+                    extent: None,
+                    memoryless: false,
+                    purpose: None,
+                },
+            }
+        })
+        .collect();
+    PassLabel {
+        attached,
+        site: Some(pass.site),
+        extent,
+    }
+}
