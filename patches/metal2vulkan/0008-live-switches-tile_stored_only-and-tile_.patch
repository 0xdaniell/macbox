--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/render/tile_writes.rs
@@ -0,0 +1,136 @@
+//! LOCAL (Atlas): less work around a tile dispatch, under live switches, both off by default.
+//!
+//! - **`tile_stored_only`.** Three of the five tile functions a Tahoe WindowServer frame runs read
+//!   the imageblock and write only a texture of their own: the translator stores no cell of such a
+//!   function (`lower::access::tile`'s `Pass::Store` skips a slot it did not store), so the scratch
+//!   holds what was copied into it, and its copy back rewrites the attachment's own texels. Under
+//!   the switch a dispatch that writes no staged image copies nothing back. Decided from the
+//!   stage's final SPIR-V ([`writes_staged`]), conservatively: only where every image the module
+//!   writes is of `Unknown` format, which a staged attachment never is
+//!   (`lower::access::tile::storage_format` declares its format), and nothing takes a texel
+//!   pointer. A function that stores the pass's imageblock cells writes through its own storage,
+//!   which the copies do not touch: it keeps them, as it does any attachment staged beside.
+//! - **`tile_narrow_barriers`.** A dispatch's copies and scratch sat between four barriers from
+//!   everything to everything. The first orders everything before against everything after, its
+//!   second scope holding the copies and the dispatch; the last orders the dispatch's and the
+//!   copies' writes against everything after. The two between need only move the scratch's bytes:
+//!   transfer writes to the dispatch's shader accesses, and its shader writes to the copies back.
+//!   Under the switch they are those. The first and the last stay.
+//!
+//! The switches are read as a dispatch is encoded; the dispatch keeps what it read.
+
+/// What a dispatch does around itself (the module docs).
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Economy {
+    /// The scratch is copied back after the dispatch.
+    pub(super) copies_back: bool,
+    /// The two barriers inside the dispatch's copies are narrowed.
+    pub(super) narrow: bool,
+}
+
+impl Economy {
+    /// The dispatch of a stage of `spirv`, `cells` where it stages the pass's imageblock storage.
+    pub(super) fn now(spirv: &[u32], cells: bool) -> Economy {
+        let stored_only = crate::live::on("tile_stored_only", false);
+        Economy {
+            copies_back: !stored_only || cells || writes_staged(spirv),
+            narrow: crate::live::on("tile_narrow_barriers", false),
+        }
+    }
+}
+
+const OP_TYPE_IMAGE: u32 = 25;
+const OP_LOAD: u32 = 61;
+const OP_IMAGE_TEXEL_POINTER: u32 = 60;
+const OP_IMAGE_WRITE: u32 = 99;
+/// `ImageFormat::Unknown`.
+const FORMAT_UNKNOWN: u32 = 0;
+
+/// Whether a module of `spirv` may write an image of a declared format, or reach one's texels
+/// through a pointer: `true` wherever the walk cannot tell, a staged attachment's image being one
+/// of a declared format (the module docs).
+pub(super) fn writes_staged(spirv: &[u32]) -> bool {
+    use std::collections::{HashMap, HashSet};
+    let Some(mut rest) = spirv.get(5..) else {
+        return true;
+    };
+    // The image types of no declared format, and the loads of them.
+    let mut unknown = HashSet::new();
+    let mut loaded = HashMap::new();
+    let mut written = Vec::new();
+    while let Some(&head) = rest.first() {
+        let (words, op) = ((head >> 16) as usize, head & 0xffff);
+        if words == 0 || words > rest.len() {
+            return true;
+        }
+        let at = &rest[..words];
+        match op {
+            OP_TYPE_IMAGE if words >= 9 => {
+                if at[8] == FORMAT_UNKNOWN {
+                    unknown.insert(at[1]);
+                }
+            }
+            OP_LOAD if words >= 4 => {
+                loaded.insert(at[2], at[1]);
+            }
+            OP_IMAGE_WRITE if words >= 2 => written.push(at[1]),
+            OP_IMAGE_TEXEL_POINTER => return true,
+            _ => {}
+        }
+        rest = &rest[words..];
+    }
+    written
+        .iter()
+        .any(|image| !loaded.get(image).is_some_and(|ty| unknown.contains(ty)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::writes_staged;
+
+    fn op(code: u32, operands: &[u32]) -> Vec<u32> {
+        let mut words = vec![((operands.len() as u32 + 1) << 16) | code];
+        words.extend(operands);
+        words
+    }
+
+    fn module(format: u32, write: Vec<u32>) -> Vec<u32> {
+        let mut m = vec![0x0723_0203, 0x0001_0500, 0, 100, 0];
+        // %1 = OpTypeImage %2 2D 0 0 0 2 <format>
+        m.extend(op(25, &[1, 2, 1, 0, 0, 0, 2, format]));
+        // %3 = OpLoad %1 %4
+        m.extend(op(61, &[1, 3, 4]));
+        m.extend(write);
+        m
+    }
+
+    #[test]
+    fn a_write_of_a_declared_format_counts() {
+        assert!(writes_staged(&module(33, op(99, &[3, 5, 6]))));
+    }
+
+    #[test]
+    fn a_write_of_no_declared_format_does_not() {
+        assert!(!writes_staged(&module(0, op(99, &[3, 5, 6]))));
+    }
+
+    #[test]
+    fn no_write_does_not() {
+        assert!(!writes_staged(&module(33, Vec::new())));
+    }
+
+    #[test]
+    fn an_image_it_cannot_trace_counts() {
+        assert!(writes_staged(&module(0, op(99, &[9, 5, 6]))));
+    }
+
+    #[test]
+    fn a_texel_pointer_counts() {
+        assert!(writes_staged(&module(0, op(60, &[7, 8, 3, 5, 6]))));
+    }
+
+    #[test]
+    fn a_torn_module_counts() {
+        assert!(writes_staged(&[0x0723_0203, 0, 0, 0, 0, 5 << 16]));
+    }
+}
