diff --git a/crates/metal2vulkan-validation/src/runtime_lane/gpu_cost.rs b/crates/metal2vulkan-validation/src/runtime_lane/gpu_cost.rs
new file mode 100644
index 00000000..ead4119f
--- /dev/null
+++ b/crates/metal2vulkan-validation/src/runtime_lane/gpu_cost.rs
@@ -0,0 +1,195 @@
+//! LOCAL (Atlas): what the parts of a WindowServer frame's full-target work cost on the device the
+//! cfg selects, and what the switches of `render/tile_writes.rs` change: report only, run by name.
+//!
+//! `GPU-COST` lines give the median GPU time of one command buffer of one pass.
+//!
+//! - **The render area**: a 40x40 scissored draw into a 3200x1800 target, loaded and stored, against
+//!   the same draw into a 64x64 one: the most a smaller render area could save.
+//! - **A memoryless color**: the same pass with a 3200x1800 memoryless `RGBA16Float` beside it,
+//!   which no draw writes.
+//! - **A tile dispatch** over 960x1856 pixels of 16x16 tiles, read-only (`cfb_tn_read4`) and
+//!   writing (`cfb_tn_round4`), under each setting.
+
+use super::no_copy_textures::{blending, floats, staged};
+use super::tile_states::on_device;
+use crate::air_library::AirLibrary;
+use metal2vulkan::metal::{PixelFormat, PrimitiveType, TextureUsage};
+use metal2vulkan::pipeline::{StageSource, TileRenderPipelineDescriptor};
+use metal2vulkan_devtools::{engine_dir, llvm_assemble};
+use metal2vulkan_runtime::{
+    live, CommandQueue, CpuCacheMode, HazardTrackingMode, Device, LoadAction, PipelineOptions, RenderPassDescriptor,
+    RenderPipelineState, ResourceOptions, ScissorRect, Size, StorageMode, StoreAction, Texture,
+    TextureDescriptor,
+};
+use std::time::Duration;
+
+const WAIT: Duration = Duration::from_secs(10);
+const WARM: usize = 8;
+const RUNS: usize = 60;
+
+fn median(mut values: Vec<f64>) -> f64 {
+    values.sort_by(f64::total_cmp);
+    values[values.len() / 2]
+}
+
+/// The median GPU time in microseconds of a command buffer `encode` fills.
+fn timed(
+    queue: &CommandQueue,
+    mut encode: impl FnMut(&metal2vulkan_runtime::CommandBuffer),
+) -> f64 {
+    let mut times = Vec::new();
+    for run in 0..WARM + RUNS {
+        let command_buffer = queue.command_buffer().unwrap();
+        encode(&command_buffer);
+        command_buffer.commit().unwrap();
+        command_buffer.wait_until_completed_for(WAIT).unwrap();
+        assert_eq!(command_buffer.error(), None);
+        if run >= WARM {
+            times.push(
+                (command_buffer.gpu_end_time().unwrap() - command_buffer.gpu_start_time().unwrap()) * 1e6,
+            );
+        }
+    }
+    median(times)
+}
+
+fn target(device: &Device, format: PixelFormat, w: u64, h: u64, mode: Option<StorageMode>) -> Texture {
+    let mut d = TextureDescriptor::texture_2d(format, w, h, false);
+    d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    d.resource_options = ResourceOptions::private();
+    if mode == Some(StorageMode::Memoryless) {
+        d.usage = TextureUsage::RENDER_TARGET;
+        d.resource_options = ResourceOptions::new(
+            StorageMode::Memoryless,
+            CpuCacheMode::DefaultCache,
+            HazardTrackingMode::Default,
+        );
+    }
+    device.new_texture(&d).unwrap()
+}
+
+/// The target a linear image of the device's own memory, as an in-place surface's form.
+fn linear(device: &Device, w: u64, h: u64) -> Texture {
+    let row = w * 4;
+    let own = device.new_buffer(row * h, ResourceOptions::private()).unwrap();
+    let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, w, h, false);
+    d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    d.resource_options = own.resource_options();
+    own.new_texture(&d, 0, row).unwrap()
+}
+
+#[test]
+#[ignore = "a release-mode measurement: run by name"]
+fn gpu_cost_probe() {
+    on_device(|device: &Device| {
+        let queue = device.new_command_queue().unwrap();
+        let blend = blending(device, PixelFormat::BGRA8Unorm);
+        let whole = staged(device, &floats([-1.0, -1.0, 1.0, 1.0]));
+        let color = staged(device, &floats([0.2, 0.4, 0.6, 0.5]));
+        let big = target(device, PixelFormat::BGRA8Unorm, 3200, 1800, None);
+        let small = target(device, PixelFormat::BGRA8Unorm, 64, 64, None);
+        let flat = linear(device, 3200, 1800);
+        let held = target(
+            device,
+            PixelFormat::RGBA16Float,
+            3200,
+            1800,
+            Some(StorageMode::Memoryless),
+        );
+        let run = |name: &str, c0: &Texture, c1: Option<&Texture>, draw: Option<u64>| {
+            let us = timed(&queue, |command_buffer| {
+                let mut pass = RenderPassDescriptor::new();
+                let a = &mut pass.color_attachments[0];
+                a.texture = Some(c0.clone());
+                a.load_action = LoadAction::Load;
+                a.store_action = StoreAction::Store;
+                if let Some(c1) = c1 {
+                    let a = &mut pass.color_attachments[1];
+                    a.texture = Some(c1.clone());
+                    a.load_action = LoadAction::Clear;
+                    a.store_action = StoreAction::DontCare;
+                }
+                let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+                encoder.set_render_pipeline_state(&blend).unwrap();
+                encoder.set_vertex_buffer(Some(&whole), 0, 0).unwrap();
+                encoder.set_fragment_buffer(Some(&color), 0, 0).unwrap();
+                if let Some(side) = draw {
+                    encoder
+                        .set_scissor_rect(ScissorRect {
+                            x: 0,
+                            y: 0,
+                            width: side,
+                            height: side,
+                        })
+                        .unwrap();
+                }
+                encoder
+                    .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+                    .unwrap();
+                encoder.end_encoding().unwrap();
+            });
+            eprintln!("GPU-COST {name}: {us:.1} us");
+        };
+        for round in 0..2 {
+            eprintln!("GPU-COST round {round}");
+            run("64x64 target, 40x40 draw", &small, None, Some(40));
+            run("3200x1800 target, 40x40 draw", &big, None, Some(40));
+            run("3200x1800 linear target, 40x40 draw", &flat, None, Some(40));
+            run("3200x1800 + memoryless, 40x40 draw", &big, Some(&held), Some(40));
+            run("3200x1800 linear + memoryless, 40x40 draw", &flat, Some(&held), Some(40));
+            run("3200x1800 target, full blend", &big, None, None);
+            run("3200x1800 linear target, full blend", &flat, None, None);
+        }
+
+        let tile = |entry: &str| -> RenderPipelineState {
+            let bitcode = llvm_assemble(&engine_dir().join("cfb_tile_norm.ll")).unwrap();
+            let library = device.new_library_with_air(&bitcode).unwrap();
+            let function = library.new_function_with_name(entry).unwrap();
+            let mut d = TileRenderPipelineDescriptor::new(StageSource::Function(
+                function.function_descriptor(),
+            ));
+            d.color_attachment_formats[0] = Some(PixelFormat::RGBA8Unorm);
+            d.threadgroup_size_matches_tile_size = true;
+            device
+                .new_tile_render_pipeline_state(&d, &PipelineOptions::default())
+                .unwrap()
+        };
+        let (w, h) = (960u64, 1856u64);
+        let attachment = target(device, PixelFormat::RGBA8Unorm, w, h, None);
+        let cells = device
+            .new_buffer(16 * (16 * h + w + 64), ResourceOptions::private())
+            .unwrap();
+        for round in 0..3 {
+            for (entry, state) in [
+                ("cfb_tn_read4", tile("cfb_tn_read4")),
+                ("cfb_tn_round4", tile("cfb_tn_round4")),
+            ] {
+                for (stored, narrow) in [("0", "0"), ("1", "0"), ("0", "1"), ("1", "1")] {
+                    live::set("tile_stored_only", Some(stored));
+                    live::set("tile_narrow_barriers", Some(narrow));
+                    let us = timed(&queue, |command_buffer| {
+                        let mut pass = RenderPassDescriptor::new();
+                        let a = &mut pass.color_attachments[0];
+                        a.texture = Some(attachment.clone());
+                        a.load_action = LoadAction::Load;
+                        a.store_action = StoreAction::Store;
+                        pass.tile_width = 16;
+                        pass.tile_height = 16;
+                        let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+                        encoder.set_render_pipeline_state(&state).unwrap();
+                        encoder.set_tile_buffer(Some(&cells), 0, 0).unwrap();
+                        encoder
+                            .dispatch_threads_per_tile(Size::new(16, 16, 1))
+                            .unwrap();
+                        encoder.end_encoding().unwrap();
+                    });
+                    eprintln!(
+                        "GPU-COST tile round {round} {entry} stored_only={stored} narrow={narrow}: {us:.1} us"
+                    );
+                }
+            }
+        }
+        live::set("tile_stored_only", None);
+        live::set("tile_narrow_barriers", None);
+    });
+}
