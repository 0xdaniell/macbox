+#[test]
+fn surface_coherent_off_touches_no_page() {
+    on_surface(true, |case| {
+        live::set("surface_coherent", None);
+        let buffer = case.other_import();
+        let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, WIDTH, HEIGHT, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = buffer.resource_options();
+        let plane = IoSurfacePlane::new(0, ROW, false);
+        let texture = buffer.new_texture_with_iosurface_plane(&d, plane).unwrap();
+        let color = staged(case.device, &floats4(RED));
+        let command_buffer = case.queue.command_buffer().unwrap();
+        pass(&command_buffer, &texture, &case.opaque, std::slice::from_ref(&case.rect), &color, None);
+        run(&command_buffer);
+        assert_eq!(case.behind(5, 5), RED_TEXEL);
+        assert!(case.fake.pages.lock().unwrap().is_empty());
+    });
+}
+
+impl Case<'_> {
+    fn other_import(&self) -> Buffer {
+        surface_buffer(self.device, &self.mapping, self.len)
+    }
+
+    /// One command buffer of a pass that loads nothing, as a pass that replaces what it draws does.
+    fn draw_replacing(&self, color: [f32; 4], damage: Option<ScissorRect>) {
+        let color = staged(self.device, &floats4(color));
+        let mut descriptor = RenderPassDescriptor::new();
+        let attachment = &mut descriptor.color_attachments[0];
+        attachment.texture = self.texture.clone();
+        attachment.load_action = LoadAction::DontCare;
+        attachment.store_action = StoreAction::Store;
+        let command_buffer = self.queue.command_buffer().unwrap();
+        let mut encoder = command_buffer.render_command_encoder(&descriptor).unwrap();
+        encoder.set_render_pipeline_state(&self.opaque).unwrap();
+        encoder.set_fragment_buffer(Some(&color), 0, 0).unwrap();
+        if let Some(damage) = damage {
+            encoder.set_scissor_rect(damage).unwrap();
+        }
+        encoder.set_vertex_buffer(Some(&self.rect), 0, 0).unwrap();
+        encoder.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0).unwrap();
+        encoder.end_encoding().unwrap();
+        run(&command_buffer);
+    }
+}
