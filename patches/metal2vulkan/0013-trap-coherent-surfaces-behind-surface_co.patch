+/// Each sync reads the image through the host's caches, so the next reads what the GPU wrote since
+/// or a line kept from the last: a read after every write, in the worst order, reads the write.
+#[test]
+fn surface_coherent_no_sync_reads_a_line_of_an_earlier_one() {
+    on_surface(true, |case| {
+        live::set("surface_coherent_demote_pct", Some("100000"));
+        live::set("surface_coherent_demote_hz", Some("1000000"));
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        for frame in 0..600u64 {
+            let (color, texel) = match frame % 2 {
+                0 => (GREEN, GREEN_TEXEL),
+                _ => (RED, RED_TEXEL),
+            };
+            // A rectangle moved each frame: small, whole-row and tile-crossing ones.
+            let (x, y) = (frame * 37 % (WIDTH - 64), frame * 13 % (HEIGHT - 40));
+            let (width, height) = (1 + frame * 7 % 64, 1 + frame * 3 % 40);
+            case.draw(color, scissor(x, y, width, height));
+            assert_eq!(case.read(x, y), texel, "frame {frame}'s first texel");
+            let (last_x, last_y) = (x + width - 1, y + height - 1);
+            assert_eq!(case.read(last_x, last_y), texel, "frame {frame}'s last texel");
+        }
+        live::set("surface_coherent_demote_pct", None);
+        live::set("surface_coherent_demote_hz", None);
+    });
+}
