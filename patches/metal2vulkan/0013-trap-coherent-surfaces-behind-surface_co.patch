+use std::time::{Duration, Instant};
+
+const WIDTH: u64 = 1024;
+const HEIGHT: u64 = 256;
+const ROW: u64 = 4096;
+const BEFORE: u8 = 0x55;
+const PAGE: u64 = 4096;
+const RED: [f32; 4] = [1.0, 0.0, 0.0, 1.0];
+const GREEN: [f32; 4] = [0.0, 1.0, 0.0, 1.0];
+const RED_TEXEL: [u8; 4] = [0, 0, 255, 255];
+const GREEN_TEXEL: [u8; 4] = [0, 255, 0, 255];
+const SOON: Duration = Duration::from_secs(3);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Mark {
+    Held,
+    Armed,
+    Open,
+    Frozen,
+}
+
+/// QEMU's page states, without the guest.
+#[derive(Default)]
+struct Fake {
+    pages: Mutex<BTreeMap<u64, Mark>>,
+    /// Pages to answer as reached while their markers moved.
+    came: Mutex<Vec<u64>>,
+    /// Pages the next `arm` answers as reached, and leaves held.
+    refused: Mutex<Vec<u64>>,
+    /// Every page each `arm` and `hold` moved, for the counts of what moved.
+    armed: Mutex<u64>,
+}
+
+impl Pages for Fake {
+    fn track(&self, start: u64, len: u64) -> bool {
+        let mut pages = self.pages.lock().unwrap();
+        for page in (start..start + len).step_by(PAGE as usize) {
+            pages.entry(page).or_insert(Mark::Held);
+        }
+        true
+    }
+
+    fn untrack(&self, start: u64) {
+        let _ = start;
+        self.pages.lock().unwrap().clear();
+    }
+
+    fn arm(&self, list: &[u64]) -> Vec<u64> {
+        let mut pages = self.pages.lock().unwrap();
+        let mut refused = self.refused.lock().unwrap();
+        for page in list {
+            if pages.get(page) == Some(&Mark::Held) && !refused.contains(page) {
+                pages.insert(*page, Mark::Armed);
+                *self.armed.lock().unwrap() += 1;
+            }
+        }
+        std::mem::take(&mut *refused)
+    }
+
+    fn hold(&self, list: &[u64], open_too: bool) -> Vec<u64> {
+        let mut pages = self.pages.lock().unwrap();
+        for page in list {
+            let at = pages.get(page).copied();
+            if at == Some(Mark::Armed) || (open_too && at == Some(Mark::Open)) {
+                pages.insert(*page, Mark::Held);
+            }
+        }
+        std::mem::take(&mut *self.came.lock().unwrap())
+    }
+
+    fn open(&self, page: u64) {
+        let mut pages = self.pages.lock().unwrap();
+        if pages.get(&page) == Some(&Mark::Held) {
+            pages.insert(page, Mark::Open);
+        }
+    }
+
+    fn freeze(&self, list: &[u64]) {
+        let mut pages = self.pages.lock().unwrap();
+        for page in list {
+            if pages.get(page) == Some(&Mark::Open) {
+                pages.insert(*page, Mark::Frozen);
+            }
+        }
+    }
+
+    fn thaw(&self, list: &[u64]) {
+        let mut pages = self.pages.lock().unwrap();
+        for page in list {
+            if pages.get(page) == Some(&Mark::Frozen) {
+                pages.insert(*page, Mark::Open);
+            }
+        }
+    }
+}
+
+impl Fake {
+    fn mark(&self, page: u64) -> Option<Mark> {
+        self.pages.lock().unwrap().get(&page).copied()
+    }
+
+    fn armed_pages(&self) -> usize {
+        (self.pages.lock().unwrap().values()).filter(|mark| **mark == Mark::Armed).count()
+    }
+}
+
+struct Case<'d> {
+    device: &'d Device,
+    queue: CommandQueue,
+    mapping: Mapping,
+    len: usize,
+    row: u64,
+    buffer: Buffer,
+    texture: Option<Texture>,
+    opaque: RenderPipelineState,
+    rect: Buffer,
+    fake: Arc<Fake>,
+}
+
+impl Case<'_> {
+    fn base(&self) -> u64 {
+        self.mapping.pointer().as_ptr() as u64
+    }
+
+    fn range(&self) -> std::ops::Range<u64> {
+        self.base()..self.base() + self.len as u64
+    }
+
+    fn texture(&self) -> &Texture {
+        self.texture.as_ref().unwrap()
+    }
+
+    fn draw(&self, color: [f32; 4], damage: Option<ScissorRect>) {
+        let command_buffer = self.queue.command_buffer().unwrap();
+        self.pass(&command_buffer, color, damage);
+        run(&command_buffer);
+    }
+
+    fn pass(&self, command_buffer: &CommandBuffer, color: [f32; 4], damage: Option<ScissorRect>) {
+        let color = staged(self.device, &floats4(color));
+        let rects = std::slice::from_ref(&self.rect);
+        pass(command_buffer, self.texture(), &self.opaque, rects, &color, damage);
+    }
+
+    /// The pages' bytes at `x`, `y`, with no guest in the way: what an untrapped read would see.
+    fn behind(&self, x: u64, y: u64) -> [u8; 4] {
+        let at = (y * self.row + x * 4) as usize;
+        self.mapping.read(at..at + 4).try_into().unwrap()
+    }
+
+    /// The guest reads the texel: a marked page stops it first.
+    fn read(&self, x: u64, y: u64) -> [u8; 4] {
+        let addr = self.base() + y * self.row + x * 4;
+        self.touch(addr, false);
+        self.behind(x, y)
+    }
+
+    /// The guest writes the texel, as the page's marks let it.
+    fn write(&self, x: u64, y: u64, texel: [u8; 4]) {
+        let addr = self.base() + y * ROW + x * 4;
+        self.touch(addr, false);
+        self.touch(addr, true);
+        let at = (y * ROW + x * 4) as usize;
+        self.mapping.write(at, &texel);
+    }
+
+    fn touch(&self, addr: u64, write: bool) {
+        let page = addr & !(PAGE - 1);
+        match (self.fake.mark(page), write) {
+            (Some(Mark::Armed | Mark::Frozen), false) => shadow_coherent::fault(addr, false),
+            (Some(Mark::Armed | Mark::Frozen | Mark::Held), true) => {
+                shadow_coherent::fault(addr, true);
+            }
+            _ => {}
+        }
+    }
+
+    /// What the texture's image holds at `x`, `y`, its alpha gone: a pass that blends nothing over
+    /// every texel loads the image and stores it, and the guest's read then fetches that.
+    fn through_image(&self, x: u64, y: u64) -> [u8; 4] {
+        let color = staged(self.device, &floats4([0.0; 4]));
+        let rects = std::slice::from_ref(&self.rect);
+        let blending = rects_blending(self.device);
+        let command_buffer = self.queue.command_buffer().unwrap();
+        pass(&command_buffer, self.texture(), &blending, rects, &color, None);
+        run(&command_buffer);
+        self.read(x, y)
+    }
+
+    /// A count of the surface's report line.
+    fn count(&self, name: &str) -> u64 {
+        let report = shadow_coherent::report("lane");
+        let key = format!("\"{name}\":");
+        let line = report.lines().last().unwrap_or_default();
+        let at = line.find(&key).map_or(line.len(), |at| at + key.len());
+        let digits: String = line[at..].chars().take_while(char::is_ascii_digit).collect();
+        digits.parse().unwrap_or(0)
+    }
+}
+
+fn rects_blending(device: &Device) -> RenderPipelineState {
+    rects(device, PixelFormat::BGRA8Unorm, true)
+}
+
+fn floats4(values: [f32; 4]) -> Vec<u8> {
+    values.iter().flat_map(|v| v.to_ne_bytes()).collect()
+}
+
+fn switches(coherent: bool) {
+    live::set("surface_lazy", Some("1"));
+    live::set("surface_lazy_min_texels", Some("1"));
+    live::set("surface_lazy_resync_ms", Some("0"));
+    live::set("surface_lazy_scoped", Some("1"));
+    live::set("surface_coherent", coherent.then_some("1"));
+    live::set("surface_coherent_hold_s", Some("1"));
+    live::set("surface_lazy_present", (!coherent).then_some("1"));
+    live::set("surface_lazy_present_all", (!coherent).then_some("1"));
+    live::set("surface_lazy_present_max_ms", Some("10"));
+}
+
+fn scissor(x: u64, y: u64, width: u64, height: u64) -> Option<ScissorRect> {
+    Some(ScissorRect { x, y, width, height })
+}
+
+/// Leaves no surface or switch behind, whatever a lane did.
+struct Clean;
+
+impl Drop for Clean {
+    fn drop(&mut self) {
+        shadow_coherent::reset();
+        shadow_coherent::set_pages(None);
+        for switch in [
+            "surface_lazy",
+            "surface_lazy_min_texels",
+            "surface_lazy_resync_ms",
+            "surface_lazy_scoped",
+            "surface_coherent",
+            "surface_coherent_hold_s",
+            "surface_lazy_present",
+            "surface_lazy_present_all",
+            "surface_lazy_present_max_ms",
+        ] {
+            live::set(switch, None);
+        }
+    }
+}
+
+/// `test` on a surface whose bytes are [`BEFORE`], marks in place where `coherent`.
+fn on_surface(coherent: bool, test: impl FnOnce(Case<'_>)) {
+    on_surface_of([WIDTH, HEIGHT, ROW], coherent, true, test);
+}
+
+fn on_surface_of(
+    [width, height, row]: [u64; 3],
+    coherent: bool,
+    lazy: bool,
+    test: impl FnOnce(Case<'_>),
+) {
+    let fake = Arc::new(Fake::default());
+    shadow_coherent::set_pages(coherent.then(|| fake.clone() as Arc<dyn Pages>));
+    switches(coherent);
+    live::set("surface_lazy", lazy.then_some("1"));
+    let _clean = Clean;
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    {
+        let device = validated_device_with(TEST_DEVICE, &messages, cache.path(), |o| {
+            o.policy.host_page_textures = HostPageTexturePolicy::InPlace;
+        })
+        .unwrap();
+        assert!(device.settle_in_place_checks(CHECK_WAIT));
+        let len = ((row * height) as usize).next_multiple_of(16384);
+        let mapping = Mapping::anonymous(len);
+        mapping.fill(BEFORE);
+        let buffer = surface_buffer(&device, &mapping, len);
+        let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, width, height, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = buffer.resource_options();
+        let texture = buffer
+            .new_texture_with_iosurface_plane(&d, IoSurfacePlane::new(0, row, false))
+            .unwrap();
+        let rect = [-1.0f32, -1.0, 1.0, 1.0].iter().flat_map(|v| v.to_ne_bytes());
+        test(Case {
+            device: &device,
+            queue: device.new_command_queue().unwrap(),
+            len,
+            row,
+            buffer,
+            texture: Some(texture),
+            opaque: rects(&device, PixelFormat::BGRA8Unorm, false),
+            rect: staged(&device, &rect.collect::<Vec<_>>()),
+            mapping,
+            fake,
+        });
+    }
+    let reported = messages.take();
+    assert!(reported.is_empty(), "the layer reported: {reported:#?}");
+}
+
+#[test]
+fn surface_coherent_a_stale_page_traps_and_reads_the_writes() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.behind(5, 5), [BEFORE; 4], "nothing copied");
+        assert!(case.fake.armed_pages() > 0, "armed at completion");
+        assert_eq!(case.read(5, 5), RED_TEXEL);
+        assert_eq!(case.behind(WIDTH - 1, HEIGHT - 1), RED_TEXEL, "one trap brings all of it");
+        assert_eq!(case.fake.armed_pages(), 0);
+        assert_eq!(case.count("traps"), 1);
+        assert_eq!(case.count("regions"), 1);
+        assert_eq!(case.count("flushes"), 0, "no GPU work");
+    });
+}
+
+#[test]
+fn surface_coherent_no_reader_copies_nothing() {
+    on_surface(true, |case| {
+        for frame in 0..20 {
+            case.draw(if frame % 2 == 0 { RED } else { GREEN }, None);
+        }
+        assert_eq!(case.behind(5, 5), [BEFORE; 4]);
+        assert_eq!(case.count("traps"), 0);
+        assert_eq!(case.count("flushes"), 0);
+        assert_eq!(case.count("copy_ins"), 1, "the first use's alone");
+        assert_eq!(case.read(5, 5), GREEN_TEXEL);
+    });
+}
