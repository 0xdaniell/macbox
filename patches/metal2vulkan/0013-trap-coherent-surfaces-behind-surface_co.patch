+/// A write before the command buffer that holds a GPU write completes: the merge keeps it.
+#[test]
+fn surface_coherent_a_cpu_write_outlasts_a_write_in_flight() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        case.read(0, 0);
+        let command_buffer = case.queue.command_buffer().unwrap();
+        case.pass(&command_buffer, GREEN, scissor(0, 7, 64, 1));
+        case.write(9, 7, [1, 2, 3, 4]);
+        assert_eq!(case.fake.mark(case.base() + 7 * PAGE), Some(Mark::Open));
+        run(&command_buffer);
+        assert_eq!(case.fake.mark(case.base() + 7 * PAGE), Some(Mark::Frozen), "merged at a touch");
+        assert_eq!(case.read(9, 7), [1, 2, 3, 4], "the CPU's texel");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the GPU's around it");
+        assert_eq!(case.count("merges"), 1);
+    });
+}
