+#[test]
+fn surface_coherent_a_partial_region_moves_that_alone() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        case.read(0, 0);
+        let bytes = case.count("bytes_detiled");
+        case.draw(GREEN, scissor(100, 100, 16, 8));
+        assert_eq!(case.fake.armed_pages(), 8, "the rectangle's rows' pages");
+        assert_eq!(case.behind(100, 100), RED_TEXEL);
+        assert_eq!(case.read(104, 104), GREEN_TEXEL);
+        assert_eq!(case.count("bytes_detiled") - bytes, 16 * 8 * 4);
+        assert_eq!(case.behind(99, 100), RED_TEXEL);
+        assert_eq!(case.behind(116, 100), RED_TEXEL);
+    });
+}
