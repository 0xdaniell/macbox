+        let start = Instant::now();
+        assert!(!shadow_coherent::unmapping(case.range()), "work runs");
+        assert_eq!(case.behind(5, 5), RED_TEXEL, "what is done landed");
+        assert!(start.elapsed() < Duration::from_millis(500), "nothing waited");
+        hold.set_signaled_value(1);
+        command_buffer.wait_until_completed_for(SOON).unwrap();
+        assert!(shadow_coherent::unmapping(case.range()));
+        assert_eq!(case.behind(5, 5), GREEN_TEXEL);
+    });
