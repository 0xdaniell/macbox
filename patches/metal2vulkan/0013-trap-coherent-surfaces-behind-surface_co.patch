+            read(&c.trap_ns_max),
+            read(&c.timed),
+            read(&c.arm_ns),
+            read(&c.arms),
+            read(&c.hold_ns),
+            read(&c.demotions),
+            read(&c.eager),
+            read(&c.merges),
+            read(&c.came),
+            read(&c.probes),
+            read(&c.flushes),
