diff --git a/crates/metal2vulkan-runtime/src/shadow_coherent.rs b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
new file mode 100644
index 00000000..22172ac7
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
@@ -0,0 +1,1076 @@
+//! LOCAL (Atlas): a lazy surface (`shadow_lazy.rs`) whose pages trap, under the live switch
+//! `surface_coherent` (default off) and with a [`Pages`] installed: QEMU's census view
+//! (`accel/kvm/census.c` in Reims' QEMU), or a lane's. Installed by nothing and switched off,
+//! nothing here runs.
+//!
+//! A surface's writes stay in its optimal image, where nothing copies them, until something
+//! touches their pages: the display samples the image itself, so no present copies either. Each
+//! page of a tracked surface is:
+//!
+//! - **held**: write-protected, the page and the image agree; reads pass, a write traps.
+//! - **armed**: poisoned, the image is ahead; any access of the guest, in any mode, traps first.
+//! - **open**: the guest's CPU wrote it, and the image is stale there ([`State::guest`]).
+//! - **frozen**: an open page poisoned, while a sync merges into it.
+//!
+//! **A write's record** goes open (recording), running (committed), done (completed).
+//! [`completing`] runs before the command buffer's completed handlers, so a page is armed before
+//! the guest can learn the work ended. A read before that may read the older bytes, as Metal lets
+//! it: nothing promises a command's writes to the CPU before its completion.
+//!
+//! **A sync** ([`Coherent::sync_done`]) copies every done rectangle at once on the host
+//! (`VK_EXT_host_image_copy`), so the first trap in a surface brings all of it, then holds the
+//! pages. It queues no GPU work and waits for none, and its lock is never held across a GPU wait.
+//! A running record stays out of it: its pages stay as they are until it completes and arms them.
+//! So a sync moves only completed work, and may tear with a write still in flight over the same
+//! texels (the image's bytes are then partly new): that is a read racing a running command, which
+//! Metal leaves undefined too, and the running record, still pending, syncs those texels again
+//! once it completes. Completed work is never lost: a batch's writes are visible to the host at
+//! its completion (`tracker.rs`), and the record is dropped only after its copy.
+//!
+//! **A CPU write** never loses to a sync. The write stops before it lands, so the page's snapshot
+//! is what the guest overwrote: a later sync over the open page keeps every texel that differs
+//! from the snapshot ([`Coherent::merge`]). A GPU copy back over an open page cannot merge, so
+//! [`Coherent::before_flush`] waits for the records, a bounded time, and syncs on the CPU; past
+//! the bound it counts `overwrite_risk`. Writing also demotes the surface to the shadow's own keep
+//! and merge.
+//!
+//! **The next command's copy in** takes the open pages' rectangle alone, and holds them first, so
+//! a later write opens them again ([`Coherent::taking`]).
+//!
+//! **Adaptive**: a surface synced in more than `surface_coherent_demote_pct` percent of a window of
+//! its frames, or more than `surface_coherent_demote_hz` times a second (a Simulator's per-frame
+//! reader), goes back to a copy back per frame for `surface_coherent_hold_s` seconds, doubling to
+//! [`HOLD_MAX_S`] while it keeps coming back.
+//!
+//! **Unmap** ([`unmapping`]) syncs, while the pages are still the guest's, and lets go of what
+//! pending writes hold; a surface with work running answers busy, as any surface with a command
+//! running over it does. Nothing is pooled across surfaces: each image is its texture's.
+//!
+//! The report ([`report`]) gives per surface what detection, sync and fetch cost per present,
+//! beside what the copies they replace would have.
+
+use super::shadow::bounding;
+use super::shadow_lazy::Lazy;
+use std::collections::{BTreeMap, HashSet};
+use std::ops::Range;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, OnceLock, RwLock, Weak};
+use std::time::{Duration, Instant};
+
+/// The live switch.
+const SWITCH: &str = "surface_coherent";
+/// The display samples a surface's image instead of its pages.
+const DISPLAY: &str = "surface_coherent_display";
+pub(crate) const PAGE: u64 = 4096;
+const HOLD_MAX_S: u64 = 30;
+/// Records apart at most: past it the done ones join, as the image holds every texel between.
+const RECORDS: usize = 8;
+const PROBE_GIVEN_UP: Duration = Duration::from_millis(1);
+const DEFAULT_WAIT_MS: u64 = 50;
+/// The closed surfaces' lines kept between reports.
+const ENDED_KEPT: usize = 256;
+/// A GPU copy of a surface, per MiB: 2.97 ms for 5.76 Mtexels of 4 bytes (`STUDY-virt.md`).
+const DEFAULT_COPY_NS_PER_MIB: u64 = 135_000;
+
+/// What marks a surface's pages. Addresses are the surface's own mapping's, whole pages, ascending,
+/// one surface to a call; each call comes under the surface's lock, which [`fault`] takes.
+pub trait Pages: Send + Sync {
+    /// Every page held from now on: whether it can be, this surface.
+    fn track(&self, start: u64, len: u64) -> bool;
+    /// Every marker off the surface around `start`.
+    fn untrack(&self, start: u64);
+    /// Held pages armed: the next access traps. Others stay. The pages a CPU reached as their
+    /// markers moved come back, still held, and they may hold a write: the caller has them.
+    fn arm(&self, pages: &[u64]) -> Vec<u64>;
+    /// Armed pages, and open ones with `open_too`, held; the pages a CPU may have reached as the
+    /// markers moved come back.
+    fn hold(&self, pages: &[u64], open_too: bool) -> Vec<u64>;
+    /// A held page opened to the guest's write.
+    fn open(&self, page: u64);
+    /// Open pages poisoned, while a sync merges into them.
+    fn freeze(&self, pages: &[u64]);
+    /// Frozen pages open again.
+    fn thaw(&self, pages: &[u64]);
+}
+
+static PAGES: RwLock<Option<Arc<dyn Pages>>> = RwLock::new(None);
+
+/// The last words of the surfaces that went since the last report.
+fn ended() -> &'static Mutex<Vec<String>> {
+    static ENDED: OnceLock<Mutex<Vec<String>>> = OnceLock::new();
+    ENDED.get_or_init(Mutex::default)
+}
+
+/// Every tracked surface, by which a fault finds its own.
+fn all() -> &'static RwLock<Vec<Arc<Coherent>>> {
+    static ALL: OnceLock<RwLock<Vec<Arc<Coherent>>>> = OnceLock::new();
+    ALL.get_or_init(RwLock::default)
+}
+
+/// Install what marks the pages (one call at start, a lane's `None` after).
+pub fn set_pages(pages: Option<Arc<dyn Pages>>) {
+    *PAGES.write().unwrap() = pages;
+}
+
+fn pages() -> Option<Arc<dyn Pages>> {
+    PAGES.read().unwrap().clone()
+}
+
+/// Whether a surface made now traps.
+pub(crate) fn enabled() -> bool {
+    crate::live::on(SWITCH, false) && PAGES.read().unwrap().is_some()
+}
+
+fn knob(name: &str, default: u64) -> u64 {
+    crate::live::get(name).and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+/// Copies an image's rectangle `[x0, y0, x1, y1)` to bytes laid out in rows of the given texels,
+/// on the host: whether it did.
+pub(crate) type Reader = Box<dyn Fn([u32; 4], *mut u8, u32) -> bool + Send + Sync>;
+
+/// A surface's texels in host pages.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Layout {
+    /// The host address of the first texel's byte.
+    pub(crate) base: u64,
+    pub(crate) row: u64,
+    pub(crate) texel: u64,
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+}
+
+impl Layout {
+    fn whole(&self) -> [u32; 4] {
+        [0, 0, self.width, self.height]
+    }
+
+    fn first_page(&self) -> u64 {
+        self.base & !(PAGE - 1)
+    }
+
+    fn end(&self) -> u64 {
+        (self.base + self.row * u64::from(self.height)).next_multiple_of(PAGE)
+    }
+
+    /// The pages `area`'s texels lie in, ascending.
+    fn pages_of(&self, area: [u32; 4]) -> Vec<u64> {
+        let [x0, y0, x1, y1] = area;
+        let mut found = Vec::new();
+        if x0 >= x1 || y0 >= y1 {
+            return found;
+        }
+        let (x0, x1) = (u64::from(x0) * self.texel, u64::from(x1) * self.texel);
+        let mut last = None;
+        for y in u64::from(y0)..u64::from(y1) {
+            let row = self.base + y * self.row;
+            let (first, end) = ((row + x0) & !(PAGE - 1), row + x1);
+            let mut page = first;
+            while page < end {
+                if last.is_none_or(|last| page > last) {
+                    found.push(page);
+                    last = Some(page);
+                }
+                page += PAGE;
+            }
+        }
+        found
+    }
+
+    /// The rectangle of every texel of the row-spans `page` holds any byte of.
+    fn area_of(&self, page: u64) -> Option<[u32; 4]> {
+        let start = page.max(self.base) - self.base;
+        let end = (page + PAGE).checked_sub(self.base)?.min(self.row * u64::from(self.height));
+        (start < end).then(|| {
+            let (y0, y1) = (start / self.row, (end - 1) / self.row + 1);
+            let (x0, x1) = match y1 - y0 {
+                1 => (
+                    (start % self.row / self.texel).min(u64::from(self.width)),
+                    ((end - 1) % self.row / self.texel + 1).min(u64::from(self.width)),
+                ),
+                _ => (0, u64::from(self.width)),
+            };
+            [x0 as u32, y0 as u32, x1 as u32, y1 as u32]
+        })
+    }
+
+    fn at(&self, x: u32, y: u32) -> u64 {
+        self.base + u64::from(y) * self.row + u64::from(x) * self.texel
+    }
+}
+
+fn meet(a: [u32; 4], b: [u32; 4]) -> bool {
+    a[0] < b[2] && b[0] < a[2] && a[1] < b[3] && b[1] < a[3]
+}
+
+fn holds(outer: [u32; 4], inner: [u32; 4]) -> bool {
+    outer[0] <= inner[0] && outer[1] <= inner[1] && inner[2] <= outer[2] && inner[3] <= outer[3]
+}
+
+fn texels(area: [u32; 4]) -> u64 {
+    u64::from(area[2] - area[0]) * u64::from(area[3] - area[1])
+}
+
+/// One write left in the image.
+#[derive(Clone, Copy, Debug)]
+struct Record {
+    /// The command buffer's identity (`shadow::ShadowCarry::id`), 0 once several joined.
+    id: u64,
+    /// Its place among records committed: what a GPU copy back moved it by.
+    seq: u64,
+    area: [u32; 4],
+}
+
+/// One surface's counts.
+#[derive(Default)]
+struct Counts {
+    presents: AtomicU64,
+    defers: AtomicU64,
+    /// Bytes the encoders left ahead: what a copy back per encoder would have moved.
+    deferred_bytes: AtomicU64,
+    traps: AtomicU64,
+    writes: AtomicU64,
+    unique_pages: AtomicU64,
+    regions: AtomicU64,
+    bytes_detiled: AtomicU64,
+    sync_ns: AtomicU64,
+    trap_ns: AtomicU64,
+    trap_ns_max: AtomicU64,
+    timed: AtomicU64,
+    arm_ns: AtomicU64,
+    arms: AtomicU64,
+    hold_ns: AtomicU64,
+    demotions: AtomicU64,
+    eager: AtomicU64,
+    merges: AtomicU64,
+    came: AtomicU64,
+    flushes: AtomicU64,
+    flushed_bytes: AtomicU64,
+    copy_ins: AtomicU64,
+    copy_in_bytes: AtomicU64,
+    probes: AtomicU64,
+    overwrite_risk: AtomicU64,
+    sync_errors: AtomicU64,
+}
+
+#[derive(Default)]
+struct State {
+    /// The surface's pages are marked.
+    tracked: bool,
+    /// Not trapping any more: the switch went off, a fuse, a reset, an unmap.
+    closed: bool,
+    open: Vec<Record>,
+    running: Vec<Record>,
+    done: Vec<Record>,
+    /// Records of a sequence up to this went back by a GPU copy that completed.
+    flushed_to: u64,
+    /// A GPU copy back in flight, up to this sequence: 0 for none.
+    flushing: u64,
+    seq: u64,
+    /// Rectangles whose pages are armed: nothing to do for what one holds.
+    armed: Vec<[u32; 4]>,
+    /// A probe armed every held page: the next fault holds them again.
+    /// Probes whose write has not named its page yet, and when the last began. A probe of another
+    /// surface's write leaves this one's count up, and `PROBE_GIVEN_UP` ends it.
+    probing: u32,
+    probed_at: Option<Instant>,
+    /// Where the guest's CPU wrote, which the image misses.
+    guest: Option<[u32; 4]>,
+    /// Each open page, as it was before the guest's write.
+    snapshots: BTreeMap<u64, Box<[u8]>>,
+    frozen: Vec<u64>,
+    /// When the last write was: the surface keeps and merges for the hold after it.
+    wrote_at: Option<Instant>,
+    /// Copies back per frame until then.
+    eager_until: Option<Instant>,
+    hold_s: u64,
+    window_start: Option<Instant>,
+    window_defers: u64,
+    window_syncs: u64,
+    seen: HashSet<u64>,
+}
+
+/// A surface's trap coherence, beside its [`Lazy`].
+pub(crate) struct Coherent {
+    state: Mutex<State>,
+    /// Tells [`Coherent::wait_settled`] a record moved.
+    moved: Condvar,
+    layout: Layout,
+    read: Reader,
+    lazy: Weak<Lazy>,
+    counts: Counts,
+    made: Instant,
+}
+
+impl Coherent {
+    pub(crate) fn new(layout: Layout, read: Reader, lazy: Weak<Lazy>) -> Arc<Coherent> {
+        Arc::new(Coherent {
+            state: Mutex::default(),
+            moved: Condvar::new(),
+            layout,
+            read,
+            lazy,
+            counts: Counts::default(),
+            made: Instant::now(),
+        })
+    }
+
+    fn lock(&self) -> MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// Whether it still answers for its pages.
+    pub(crate) fn is_live(&self) -> bool {
+        !self.lock().closed
+    }
+
+    pub(crate) fn range(&self) -> Range<u64> {
+        self.layout.first_page()..self.layout.end()
+    }
+
+    fn all_pages(&self) -> Vec<u64> {
+        (self.range().step_by(PAGE as usize)).collect()
+    }
+
+    /// Whether the surface traps now, tracking it at its first use: its pages are held before any
+    /// copy in reads them, so nothing the guest writes after that goes unseen.
+    pub(crate) fn tracks(self: &Arc<Self>) -> bool {
+        let mut state = self.lock();
+        if state.closed {
+            return false;
+        }
+        if state.tracked {
+            return true;
+        }
+        let range = self.range();
+        let live = crate::live::on(SWITCH, false);
+        let marked = pages().is_some_and(|p| live && p.track(range.start, range.end - range.start));
+        if !marked {
+            state.closed = true;
+            return false;
+        }
+        state.tracked = true;
+        all().write().unwrap().push(self.clone());
+        true
+    }
+
+    /// Whether it writes back as a shadow keeping and merging: a CPU write came lately.
+    pub(crate) fn wants_merge(&self) -> bool {
+        let state = self.lock();
+        state.tracked && !state.closed && state.wrote_at.is_some_and(|at| at.elapsed() < self.hold())
+    }
+
+    fn hold(&self) -> Duration {
+        Duration::from_secs(knob("surface_coherent_hold_s", 2))
+    }
+
+    /// Whether an encoder of `id` leaves `area` ahead; if so it is recorded.
+    pub(crate) fn defers(&self, id: u64, area: Option<[u32; 4]>) -> bool {
+        let mut state = self.lock();
+        if state.closed || !state.tracked {
+            return false;
+        }
+        let now = Instant::now();
+        state.window_defers += 1;
+        self.roll_window(&mut state, now);
+        match state.eager_until {
+            Some(until) if now < until => {
+                self.counts.eager.fetch_add(1, Ordering::Relaxed);
+                return false;
+            }
+            Some(_) => state.eager_until = None,
+            None => {}
+        }
+        if state.wrote_at.is_some_and(|at| at.elapsed() < self.hold()) {
+            return false;
+        }
+        let whole = self.layout.whole();
+        let area = area.unwrap_or(whole);
+        match state.open.iter_mut().find(|record| record.id == id) {
+            Some(record) => {
+                let joined = bounding(Some(record.area), Some(area));
+                record.area = joined.unwrap_or(whole);
+            }
+            None => state.open.push(Record { id, seq: 0, area }),
+        }
+        self.counts.defers.fetch_add(1, Ordering::Relaxed);
+        let bytes = texels(area) * self.layout.texel;
+        self.counts.deferred_bytes.fetch_add(bytes, Ordering::Relaxed);
+        true
+    }
+
+    /// The window of frames closes: too many syncs in it send the surface back to copies per frame.
+    fn roll_window(&self, state: &mut State, now: Instant) {
+        let start = *state.window_start.get_or_insert(now);
+        let frames = knob("surface_coherent_demote_window", 32);
+        let elapsed = now.duration_since(start);
+        if state.window_defers < frames && elapsed < Duration::from_secs(1) {
+            return;
+        }
+        let pct = knob("surface_coherent_demote_pct", 50);
+        let hz = knob("surface_coherent_demote_hz", 64);
+        let by_frames = state.window_defers >= frames
+            && state.window_syncs * 100 >= state.window_defers * pct;
+        let by_rate = state.window_syncs as f64 >= hz as f64 * elapsed.as_secs_f64().max(0.25);
+        if by_frames || by_rate {
+            self.demote(state, now);
+        }
+        state.window_start = Some(now);
+        state.window_defers = 0;
+        state.window_syncs = 0;
+        state.seen.clear();
+    }
+
+    fn demote(&self, state: &mut State, now: Instant) {
+        let last = state.eager_until;
+        let first = knob("surface_coherent_hold_s", 2).max(1);
+        state.hold_s = match last {
+            Some(until) if now < until + Duration::from_secs(state.hold_s.max(first)) => {
+                (state.hold_s * 2).clamp(first, HOLD_MAX_S)
+            }
+            _ => first,
+        };
+        state.eager_until = Some(now + Duration::from_secs(state.hold_s));
+        self.counts.demotions.fetch_add(1, Ordering::Relaxed);
+        // What is pending goes now, and what is running at its completion.
+        self.sync_done(state);
+    }
+
+    /// The commit of `id` returned: its record may go back by a copy ordered after it.
+    pub(crate) fn committed(&self, id: u64) {
+        let mut state = self.lock();
+        if let Some(at) = state.open.iter().position(|record| record.id == id) {
+            let mut record = state.open.swap_remove(at);
+            state.seq += 1;
+            record.seq = state.seq;
+            state.running.push(record);
+        }
+        self.settle_pending(&state);
+    }
+
+    /// The command buffer `id` is done, before anything tells the guest: its pages trap from here.
+    pub(crate) fn completing(&self, id: u64) {
+        let mut state = self.lock();
+        let found = match state.running.iter().position(|record| record.id == id) {
+            Some(at) => Some(state.running.swap_remove(at)),
+            // Its commit has not returned yet.
+            None => (state.open.iter().position(|record| record.id == id)).map(|at| {
+                let mut record = state.open.swap_remove(at);
+                state.seq += 1;
+                record.seq = state.seq;
+                record
+            }),
+        };
+        if let Some(record) = found {
+            if record.seq > state.flushed_to {
+                self.finish_record(&mut state, record);
+            }
+            self.moved.notify_all();
+        }
+        self.settle_pending(&state);
+    }
+
+    fn finish_record(&self, state: &mut State, record: Record) {
+        if state.closed || !state.tracked {
+            return;
+        }
+        if state.done.len() >= RECORDS {
+            let mut joined = record;
+            for other in state.done.drain(..) {
+                joined.area = bounding(Some(joined.area), Some(other.area)).unwrap_or(joined.area);
+                joined.seq = joined.seq.max(other.seq);
+                joined.id = 0;
+            }
+            state.done.push(joined);
+        } else {
+            state.done.push(record);
+        }
+        let Some(pages_mark) = pages() else {
+            return;
+        };
+        if state.eager_until.is_some_and(|until| Instant::now() < until) {
+            self.sync_done(state);
+            return;
+        }
+        if state.armed.iter().any(|armed| holds(*armed, record.area)) {
+            return;
+        }
+        let start = Instant::now();
+        let list = self.layout.pages_of(record.area);
+        let refused = pages_mark.arm(&list);
+        // A page the guest wrote takes the rectangle too, by the merge.
+        let open: Vec<u64> = (state.snapshots.keys())
+            .filter(|page| list.binary_search(page).is_ok())
+            .copied()
+            .collect();
+        if !open.is_empty() {
+            pages_mark.freeze(&open);
+            state.frozen.extend(open);
+            state.frozen.sort_unstable();
+            state.frozen.dedup();
+        }
+        if state.armed.len() == RECORDS {
+            state.armed.clear();
+        }
+        state.armed.push(record.area);
+        let spent = start.elapsed().as_nanos() as u64;
+        self.counts.arm_ns.fetch_add(spent, Ordering::Relaxed);
+        self.counts.arms.fetch_add(1, Ordering::Relaxed);
+        // No trap comes for these: the sync is now, before anyone hears of this completion. A CPU
+        // write in the rectangle raced the GPU's; one beside it stays, and the image takes it.
+        if !refused.is_empty() {
+            self.sync_done(state);
+            self.note_came(state, refused);
+        }
+    }
+
+    /// Copy every done rectangle into the pages, and hold them.
+    fn sync_done(&self, state: &mut State) {
+        if state.done.is_empty() {
+            self.thaw_all(state);
+            return;
+        }
+        let Some(pages_mark) = pages() else {
+            return;
+        };
+        let start = Instant::now();
+        let done = std::mem::take(&mut state.done);
+        let mut list = Vec::new();
+        for record in &done {
+            let area = record.area;
+            let moved = match state.snapshots.is_empty() {
+                true => self.detile(area),
+                false => self.merge(state, &pages_mark, area),
+            };
+            if !moved {
+                self.counts.sync_errors.fetch_add(1, Ordering::Relaxed);
+                eprintln!("surface_coherent: a sync of {area:?} failed");
+            }
+            self.counts.regions.fetch_add(1, Ordering::Relaxed);
+            let bytes = texels(area) * self.layout.texel;
+            self.counts.bytes_detiled.fetch_add(bytes, Ordering::Relaxed);
+            list.extend(self.layout.pages_of(area));
+        }
+        state.window_syncs += 1;
+        list.sort_unstable();
+        list.dedup();
+        self.thaw_all(state);
+        let held = Instant::now();
+        let came = pages_mark.hold(&list, false);
+        self.counts.hold_ns.fetch_add(held.elapsed().as_nanos() as u64, Ordering::Relaxed);
+        self.note_came(state, came);
+        state.armed.clear();
+        let spent = start.elapsed().as_nanos() as u64;
+        self.counts.sync_ns.fetch_add(spent, Ordering::Relaxed);
+        self.settle_pending(state);
+    }
+
+    /// A page the guest reached as its markers moved may hold a write: the image takes it again.
+    fn note_came(&self, state: &mut State, came: Vec<u64>) {
+        self.counts.came.fetch_add(came.len() as u64, Ordering::Relaxed);
+        for page in came {
+            if let Some(area) = self.layout.area_of(page) {
+                state.guest = Some(match state.guest {
+                    Some(guest) => bounding(Some(guest), Some(area)).unwrap_or(guest),
+                    None => area,
+                });
+            }
+        }
+    }
+
+    fn thaw_all(&self, state: &mut State) {
+        if !state.frozen.is_empty() {
+            if let Some(pages_mark) = pages() {
+                pages_mark.thaw(&state.frozen);
+            }
+            state.frozen.clear();
+        }
+    }
+
+    fn detile(&self, area: [u32; 4]) -> bool {
+        let to = self.layout.at(area[0], area[1]) as *mut u8;
+        (self.read)(area, to, (self.layout.row / self.layout.texel) as u32)
+    }
+
+    /// `area` into the pages, keeping what the guest wrote in open pages: every texel of them that
+    /// differs from the page's snapshot. Those pages stay frozen meanwhile, and the snapshot takes
+    /// the texels the sync moved.
+    fn merge(&self, state: &mut State, pages_mark: &Arc<dyn Pages>, area: [u32; 4]) -> bool {
+        let [x0, y0, x1, y1] = area;
+        let texel = self.layout.texel as usize;
+        let (width, height) = ((x1 - x0) as usize, (y1 - y0) as usize);
+        let row = width * texel;
+        let mut scratch = vec![0u8; row * height];
+        if !(self.read)(area, scratch.as_mut_ptr(), width as u32) {
+            return false;
+        }
+        let list = self.layout.pages_of(area);
+        let opened: Vec<u64> = (state.snapshots.keys())
+            .filter(|page| list.binary_search(page).is_ok() && !state.frozen.contains(page))
+            .copied()
+            .collect();
+        pages_mark.freeze(&opened);
+        state.frozen.extend(&opened);
+        state.frozen.sort_unstable();
+        self.counts.merges.fetch_add(1, Ordering::Relaxed);
+        for (y, line) in (y0..y1).zip(scratch.chunks_exact(row)) {
+            for (x, source) in (x0..x1).zip(line.chunks_exact(texel)) {
+                let at = self.layout.at(x, y);
+                // SAFETY: `at` lies in the surface's mapping, whole texels of it; the guest's CPU
+                // does not reach a frozen page, and a page with no snapshot is armed or held.
+                unsafe {
+                    let bytes = std::slice::from_raw_parts_mut(at as *mut u8, texel);
+                    let page = at & !(PAGE - 1);
+                    let offset = (at - page) as usize;
+                    match state.snapshots.get_mut(&page) {
+                        Some(snapshot) => {
+                            let was = &mut snapshot[offset..(offset + texel).min(PAGE as usize)];
+                            if bytes[..was.len()] == *was {
+                                bytes[..was.len()].copy_from_slice(&source[..was.len()]);
+                                was.copy_from_slice(&source[..was.len()]);
+                            }
+                        }
+                        None => bytes.copy_from_slice(source),
+                    }
+                }
+            }
+        }
+        true
+    }
+
+    /// Wait, with the lock let go, until no GPU copy back runs and, with `area`, no record it
+    /// overlaps does, or the bound: whether none does. The caller stopped a vCPU or an encoder, and
+    /// nothing it holds blocks the GPU.
+    fn wait_settled<'a>(
+        &'a self,
+        mut state: MutexGuard<'a, State>,
+        area: Option<[u32; 4]>,
+    ) -> (MutexGuard<'a, State>, bool) {
+        let until = Instant::now() + Duration::from_millis(knob("surface_coherent_wait_ms", DEFAULT_WAIT_MS));
+        loop {
+            let overlaps = |area| state.running.iter().any(|record| meet(record.area, area));
+            let busy = state.flushing != 0 || area.is_some_and(overlaps);
+            if !busy {
+                return (state, true);
+            }
+            let left = until.saturating_duration_since(Instant::now());
+            if left.is_zero() {
+                return (state, false);
+            }
+            let (guard, _) = self.moved.wait_timeout(state, left).unwrap_or_else(|e| e.into_inner());
+            state = guard;
+        }
+    }
+
+    /// The guest touched `page`.
+    fn fault(&self, page: u64, write: bool) {
+        let mut state = self.lock();
+        if !state.tracked {
+            return;
+        }
+        self.counts.traps.fetch_add(1, Ordering::Relaxed);
+        if state.seen.insert(page) {
+            self.counts.unique_pages.fetch_add(1, Ordering::Relaxed);
+        }
+        self.sync_done(&mut state);
+        let mark = pages();
+        // Another vCPU's probe may be about to rerun on these pages: only the last of them, which
+        // lets it name its page, ends the probing.
+        let over = state.probed_at.is_some_and(|at| at.elapsed() >= PROBE_GIVEN_UP);
+        if state.probing > 0 && (over || (write && state.probing == 1)) {
+            state.probing = 0;
+            state.probed_at = None;
+            if let Some(mark) = &mark {
+                let came = mark.hold(&self.all_pages(), false);
+                self.note_came(&mut state, came);
+            }
+            state.armed.clear();
+        } else if write {
+            state.probing = state.probing.saturating_sub(1);
+        }
+        if !write {
+            if let Some(mark) = &mark {
+                let came = mark.hold(&[page], false);
+                self.note_came(&mut state, came);
+            }
+            return;
+        }
+        self.counts.writes.fetch_add(1, Ordering::Relaxed);
+        if let Some(area) = self.layout.area_of(page) {
+            // A running write needs no wait: the merge at its completion keeps this one. A GPU
+            // copy back already on its way cannot merge.
+            let (settled, clear) = self.wait_settled(state, None);
+            state = settled;
+            self.sync_done(&mut state);
+            if !clear {
+                self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
+            }
+            state.guest = Some(match state.guest {
+                Some(guest) => bounding(Some(guest), Some(area)).unwrap_or(guest),
+                None => area,
+            });
+        }
+        state.wrote_at = Some(Instant::now());
+        if !state.snapshots.contains_key(&page) {
+            // SAFETY: the page lies in the surface's mapping; the guest's write stopped before it.
+            let was = unsafe { std::slice::from_raw_parts(page as *const u8, PAGE as usize) };
+            state.snapshots.insert(page, was.into());
+        }
+        if let Some(mark) = &mark {
+            mark.hold(&[page], false);
+            mark.open(page);
+        }
+    }
+
+    /// An encoder is about to use the image: where the guest wrote is stale in it, and comes back
+    /// for this command's copy in. With no standing (`whole`) the copy in reads every texel. The
+    /// pages hold everything done first, and are held before the copy in can read them.
+    pub(crate) fn taking(&self, whole: bool) -> Option<[u32; 4]> {
+        let mut state = self.lock();
+        if !state.tracked {
+            return None;
+        }
+        if !whole && state.guest.is_none() {
+            return None;
+        }
+        let mut stale = state.guest;
+        if whole {
+            stale = Some(self.layout.whole());
+        }
+        if let Some(area) = stale {
+            // The copy in runs after what is running here, and reads pages that lack it: a running
+            // write's texels must reach the pages first. Over no CPU write, a refused standing's
+            // copy back (`shadow_lazy::met_by`) does that without a wait.
+            if !state.snapshots.is_empty() {
+                let (settled, clear) = self.wait_settled(state, Some(area));
+                state = settled;
+                if !clear {
+                    self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
+                }
+            }
+            self.sync_done(&mut state);
+            let list: Vec<u64> = state.snapshots.keys().copied().collect();
+            if let Some(mark) = pages() {
+                let came = mark.hold(&list, true);
+                state.guest = None;
+                self.note_came(&mut state, came);
+            }
+            state.snapshots.clear();
+            if whole {
+                state.guest = None;
+            }
+        }
+        stale
+    }
+
+    /// A GPU copy back of what ran is about to record: everything done went on the CPU, and what
+    /// is still running goes by the copy, up to the sequence given. `None` where nothing runs. The
+    /// lock is not held while it records.
+    pub(crate) fn before_flush(&self) -> Option<u64> {
+        let mut state = self.lock();
+        self.sync_done(&mut state);
+        if state.running.is_empty() {
+            return None;
+        }
+        if !state.snapshots.is_empty() {
+            let area = state.guest.unwrap_or(self.layout.whole());
+            let (settled, clear) = self.wait_settled(state, Some(area));
+            state = settled;
+            self.sync_done(&mut state);
+            if state.running.is_empty() {
+                return None;
+            }
+            if !clear {
+                self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
+            }
+        }
