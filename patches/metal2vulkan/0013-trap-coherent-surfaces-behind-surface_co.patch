+#[test]
+fn surface_coherent_cpu_write_then_gpu_read() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        case.write(7, 7, [1, 2, 3, 4]);
+        assert_eq!(case.fake.mark(case.base() + 7 * PAGE), Some(Mark::Open));
+        assert_eq!(case.through_image(7, 7), [1, 2, 3, 0], "the image took the write");
+        assert_eq!(case.through_image(8, 7), [0, 0, 255, 0], "and the page's other texels hold");
+        // A later write opens it again.
+        case.write(7, 7, [5, 6, 7, 8]);
+        assert_eq!(case.through_image(7, 7), [5, 6, 7, 0]);
+        // Its rectangle alone: the first use's and the pages' own rows.
+        assert_eq!(case.count("copy_ins"), 3);
+    });
