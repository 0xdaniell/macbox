+fn find(addr: u64) -> Option<Arc<Coherent>> {
+    (all().read().unwrap().iter()).find(|one| one.range().contains(&addr)).cloned()
+}
+
+fn tracked() -> Vec<Arc<Coherent>> {
+    all().read().unwrap().clone()
+}
+
+/// The guest touched the page at `addr`, of a surface's mapping: answered once its bytes are
+/// current. A write leaves it open.
+pub fn fault(addr: u64, write: bool) {
+    let page = addr & !(PAGE - 1);
+    match find(addr) {
+        Some(surface) => surface.fault(page, write),
+        None => {
+            if let Some(mark) = pages() {
+                mark.untrack(addr);
+            }
+        }
+    }
+}
+
+/// From a stop at `addr` to the access's rerun.
+pub fn timed(addr: u64, ns: u64) {
+    if let Some(surface) = find(addr) {
+        surface.timed(ns);
+    }
+}
+
+/// A write hit a held page no one named: every held page armed, to name it.
+pub fn probe() {
+    for surface in tracked() {
+        surface.probe();
+    }
+}
+
+/// Everything back in its pages and untracked: the markers are about to go.
+pub fn abandon() {
+    for surface in tracked() {
+        surface.abandon();
+    }
+}
+
+/// The guest resets: every surface goes, nothing written. The vCPUs are stopped.
+pub fn reset() {
+    for surface in tracked() {
+        let mut state = surface.lock();
+        surface.close(&mut state, false);
+        state.running.clear();
+        state.open.clear();
+        surface.settle_pending(&state);
+    }
+}
+
+/// Before an unmap of the surface over `bytes`: whether it may go on (the module docs).
+pub fn unmapping(bytes: Range<u64>) -> bool {
+    tracked().iter().filter(|s| s.range().start < bytes.end && bytes.start < s.range().end).all(|s| s.unmapping())
+}
+
+/// The surface over `bytes` was unmapped: QEMU already dropped the marks.
+pub fn unmapped(bytes: Range<u64>) {
+    for surface in tracked() {
+        if surface.range().start < bytes.end && bytes.start < surface.range().end {
+            let mut state = surface.lock();
+            surface.close(&mut state, false);
+        }
+    }
+}
+
+/// Whether any surface is tracked, one lock: while none is, a completion does nothing here.
+pub(crate) fn surfaces_tracked() -> bool {
+    !all().read().unwrap().is_empty()
+}
+
+/// One line a surface: what [`Coherent::line`] says, under `label`. A surface that went comes once.
+pub fn report(label: &str) -> String {
+    let mut lines: String = std::mem::take(&mut *ended().lock().unwrap_or_else(|e| e.into_inner())).concat();
+    for surface in tracked() {
+        lines.push_str(&surface.line(label, &surface.lock()));
+    }
+    lines
+}
