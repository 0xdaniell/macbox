+/// With the switch off and marks installed, a surface runs as `surface_lazy` alone.
+/// What a frame costs at 3200x1800, with the display sampling the surface and, where `read`, the
+/// guest's CPU reading what changed: eager copies, `surface_lazy_present_all`, and this.
+#[test]
+fn surface_coherent_cost_of_a_frame() {
+    const W: u64 = 3200;
+    const H: u64 = 1800;
+    const R: u64 = 12800;
+    const WARM: usize = 30;
+    const FRAMES: usize = 120;
+    #[derive(Clone, Copy, Debug, PartialEq)]
+    enum Mode {
+        Eager,
+        LazyPresent,
+        Coherent,
+    }
+    fn median(mut values: Vec<f64>) -> f64 {
+        values.sort_by(f64::total_cmp);
+        values[values.len() / 2]
+    }
+    for (name, damage, read) in [
+        ("1x1", scissor(1000, 700, 1, 1), false),
+        ("400x300", scissor(1000, 700, 400, 300), false),
+        ("1600x900", scissor(400, 400, 1600, 900), false),
+        ("whole", None, false),
+        ("400x300 cpu read", scissor(1000, 700, 400, 300), true),
+    ] {
+        for mode in [Mode::Eager, Mode::LazyPresent, Mode::Coherent] {
+            on_surface_of([W, H, R], mode == Mode::Coherent, mode != Mode::Eager, |case| {
+                let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, W, H, false);
+                d.usage = TextureUsage::SHADER_READ;
+                d.resource_options = case.buffer.resource_options();
+                let plane = IoSurfacePlane::new(0, R, false);
+                let other = case.other_import().new_texture_with_iosurface_plane(&d, plane).unwrap();
+                let (samples, nearest) = bgra8_sampling(case.device);
+                let [mut drew, mut shown, mut gpu] = [Vec::new(), Vec::new(), Vec::new()];
+                for i in 0..WARM + FRAMES {
+                    let color = if i % 2 == 0 { RED } else { GREEN };
+                    let start = Instant::now();
+                    let command_buffer = case.queue.command_buffer().unwrap();
+                    case.pass(&command_buffer, color, damage);
+                    run(&command_buffer);
+                    let middle = Instant::now();
+                    let display = other.surface_presented().unwrap_or_else(|| other.clone());
+                    drawn_small(&case.queue, &samples, &nearest, &display);
+                    if read {
+                        let [x, y] = damage.map_or([0, 0], |d| [d.x, d.y]);
+                        assert_eq!(case.read(x, y), if color == RED { RED_TEXEL } else { GREEN_TEXEL });
+                    }
+                    if i >= WARM {
+                        drew.push((middle - start).as_secs_f64() * 1e3);
+                        shown.push(middle.elapsed().as_secs_f64() * 1e3);
+                        let ends = command_buffer.gpu_end_time().unwrap();
+                        gpu.push((ends - command_buffer.gpu_start_time().unwrap()) * 1e3);
+                    }
+                }
+                let [drew, shown, gpu] = [median(drew), median(shown), median(gpu)];
+                eprintln!("cost {name}: {mode:?} draw {drew:.2} ms (gpu {gpu:.2}), then {shown:.2} ms");
+                if mode == Mode::Coherent {
+                    let report = shadow_coherent::report("cost");
+                    eprintln!("cost {name}: {}", report.lines().last().unwrap_or_default());
+                }
+            });
+        }
+    }
+}
