diff --git a/crates/metal2vulkan-validation/src/runtime_lane/surface_present.rs b/crates/metal2vulkan-validation/src/runtime_lane/surface_present.rs
new file mode 100644
index 00000000..bf273946
--- /dev/null
+++ b/crates/metal2vulkan-validation/src/runtime_lane/surface_present.rs
@@ -0,0 +1,336 @@
+//! LOCAL (Atlas): a surface that leaves its writes ahead in its image under the switch
+//! `surface_lazy_present` (`shadow_lazy.rs`). A texture of the surface renders through a shadow
+//! kept across command buffers; these check what its pages hold, and what every other way to its
+//! bytes reads, before and after each thing that copies the writes back.
+
+use super::first_use_writes::CHECK_WAIT;
+use super::host_memory::{gpu_read, run, Mapping};
+use super::host_rt_frames::{pass, surface_buffer};
+use super::no_copy_textures::{rects, staged};
+use super::{validated_device_with, Messages, ScratchCache};
+use crate::gpu::TEST_DEVICE;
+use metal2vulkan::device::HostPageTexturePolicy;
+use metal2vulkan::metal::{PixelFormat, TextureUsage};
+use metal2vulkan_runtime::shadow_lazy::{ahead_counts, counts};
+use metal2vulkan_runtime::{
+    live, Buffer, CommandQueue, Device, IoSurfacePlane, Region, RenderPipelineState, ScissorRect,
+    Texture, TextureDescriptor,
+};
+use std::time::{Duration, Instant};
+
+const WIDTH: u64 = 1024;
+const HEIGHT: u64 = 256;
+const ROW: u64 = 4096;
+const BEFORE: u8 = 0x55;
+const RED: [f32; 4] = [1.0, 0.0, 0.0, 1.0];
+const GREEN: [f32; 4] = [0.0, 1.0, 0.0, 1.0];
+const RED_TEXEL: [u8; 4] = [0, 0, 255, 255];
+const GREEN_TEXEL: [u8; 4] = [0, 255, 0, 255];
+/// A bound no case's copy back should near.
+const SOON: Duration = Duration::from_secs(3);
+
+/// A surface under the switches, its texture and what draws into it.
+struct Case<'d> {
+    device: &'d Device,
+    queue: CommandQueue,
+    mapping: Mapping,
+    len: usize,
+    buffer: Buffer,
+    texture: Texture,
+    opaque: RenderPipelineState,
+    rect: Buffer,
+}
+
+impl Case<'_> {
+    /// One command buffer of a pass filling `damage`, or everything, with `color`, run to its end.
+    fn draw(&self, color: [f32; 4], damage: Option<ScissorRect>) {
+        let command_buffer = self.queue.command_buffer().unwrap();
+        self.pass(&command_buffer, color, damage);
+        run(&command_buffer);
+    }
+
+    fn pass(
+        &self,
+        command_buffer: &metal2vulkan_runtime::CommandBuffer,
+        color: [f32; 4],
+        damage: Option<ScissorRect>,
+    ) {
+        let color = staged(self.device, &floats4(color));
+        let rects = std::slice::from_ref(&self.rect);
+        pass(command_buffer, &self.texture, &self.opaque, rects, &color, damage);
+    }
+
+    /// The texel at `x`, `y` of the pages.
+    fn page_texel(&self, x: u64, y: u64) -> [u8; 4] {
+        let at = (y * ROW + x * 4) as usize;
+        self.mapping.read(at..at + 4).try_into().unwrap()
+    }
+
+    /// A new buffer over the same pages, as another import of the surface is.
+    fn other_import(&self) -> Buffer {
+        surface_buffer(self.device, &self.mapping, self.len)
+    }
+
+    /// Wait until the pages hold `texel` at `x`, `y`.
+    fn pages_become(&self, x: u64, y: u64, texel: [u8; 4]) {
+        let start = Instant::now();
+        while self.page_texel(x, y) != texel {
+            assert!(
+                start.elapsed() < SOON,
+                "the pages hold {:?} at {x}, {y}, not {texel:?}",
+                self.page_texel(x, y)
+            );
+            std::thread::sleep(Duration::from_millis(2));
+        }
+    }
+}
+
+fn floats4(values: [f32; 4]) -> Vec<u8> {
+    values.iter().flat_map(|v| v.to_ne_bytes()).collect()
+}
+
+fn switches(present: bool, all: bool, scoped: bool, max_ms: u64) {
+    let on = |yes: bool| if yes { "1" } else { "0" };
+    live::set("surface_lazy", Some("1"));
+    live::set("surface_lazy_min_texels", Some("1"));
+    live::set("surface_lazy_resync_ms", Some("0"));
+    live::set("surface_lazy_present", Some(on(present)));
+    live::set("surface_lazy_present_all", Some(on(all)));
+    live::set("surface_lazy_scoped", Some(on(scoped)));
+    live::set("surface_lazy_present_max_ms", Some(&max_ms.to_string()));
+}
+
+/// Run `test` on a new surface whose every byte is [`BEFORE`], on a validated device that takes
+/// textures over host pages in place, as the product's does.
+fn on_surface(test: impl FnOnce(Case<'_>)) {
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    {
+        let device = validated_device_with(TEST_DEVICE, &messages, cache.path(), |o| {
+            o.policy.host_page_textures = HostPageTexturePolicy::InPlace;
+        })
+        .unwrap();
+        assert!(device.settle_in_place_checks(CHECK_WAIT));
+        let len = ((ROW * HEIGHT) as usize).next_multiple_of(16384);
+        let mapping = Mapping::anonymous(len);
+        mapping.fill(BEFORE);
+        let buffer = surface_buffer(&device, &mapping, len);
+        let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, WIDTH, HEIGHT, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = buffer.resource_options();
+        let texture = buffer
+            .new_texture_with_iosurface_plane(&d, IoSurfacePlane::new(0, ROW, false))
+            .unwrap();
+        // SAFETY: the handle is only tested, while the texture lives.
+        assert!(unsafe { texture.vk_image() }.is_none(), "not a shadow");
+        let rect = [-1.0f32, -1.0, 1.0, 1.0].iter().flat_map(|v| v.to_ne_bytes());
+        test(Case {
+            device: &device,
+            queue: device.new_command_queue().unwrap(),
+            len,
+            buffer,
+            texture,
+            opaque: rects(&device, PixelFormat::BGRA8Unorm, false),
+            rect: staged(&device, &rect.collect::<Vec<_>>()),
+            mapping,
+        });
+    }
+    live::set("surface_lazy", None);
+    live::set("surface_lazy_present", None);
+    live::set("surface_lazy_present_all", None);
+    live::set("surface_lazy_scoped", None);
+    let reported = messages.take();
+    assert!(reported.is_empty(), "the layer reported: {reported:#?}");
+}
+
+#[test]
+fn surface_present_a_presented_surface_copies_back_at_its_presents() {
+    switches(true, false, false, 60_000);
+    on_surface(|case| {
+        // Not presented yet: its copy back goes as ever.
+        case.draw(RED, None);
+        assert_eq!(case.page_texel(5, 5), RED_TEXEL);
+        case.texture.surface_presented();
+        let before = ahead_counts();
+        case.draw(GREEN, None);
+        assert_eq!(ahead_counts().deferred, before.deferred + 1);
+        assert_eq!(case.page_texel(5, 5), RED_TEXEL, "left ahead");
+        case.draw(RED, None);
+        case.draw(GREEN, None);
+        assert_eq!(case.page_texel(5, 5), RED_TEXEL, "left ahead");
+        case.texture.surface_presented();
+        case.pages_become(5, 5, GREEN_TEXEL);
+        assert_eq!(ahead_counts().flushes, before.flushes + 1, "once for three");
+    });
+}
+
+#[test]
+fn surface_present_a_reader_through_another_import_reads_the_writes() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        case.draw(RED, None);
+        assert_eq!(case.page_texel(5, 5), [BEFORE; 4], "left ahead");
+        let read = gpu_read(&case.queue, &case.other_import(), 0..4);
+        assert_eq!(read, RED_TEXEL);
+        // And a blit of the surface's own buffer, on its own queue.
+        case.draw(GREEN, None);
+        let queue = case.device.new_command_queue().unwrap();
+        assert_eq!(gpu_read(&queue, &case.buffer, 0..4), GREEN_TEXEL);
+    });
+}
+
+#[test]
+fn surface_present_a_later_encoder_of_the_writer_reads_the_writes() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        let other = case.other_import();
+        let copy = case
+            .device
+            .new_buffer(4, metal2vulkan_runtime::ResourceOptions::shared())
+            .unwrap();
+        let command_buffer = case.queue.command_buffer().unwrap();
+        case.pass(&command_buffer, RED, None);
+        let mut blit = command_buffer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&other, 0, &copy, 0, 4)
+            .unwrap();
+        blit.end_encoding().unwrap();
+        run(&command_buffer);
+        // SAFETY: a `Shared` buffer no command uses now.
+        let read = unsafe { std::slice::from_raw_parts(copy.contents().unwrap().as_ptr(), 4) };
+        assert_eq!(read, RED_TEXEL);
+    });
+}
+
+#[test]
+fn surface_present_passes_of_one_command_buffer_end_in_the_pages() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        let command_buffer = case.queue.command_buffer().unwrap();
+        case.pass(&command_buffer, RED, None);
+        let half = ScissorRect { x: 0, y: 0, width: WIDTH / 2, height: HEIGHT };
+        case.pass(&command_buffer, GREEN, Some(half));
+        run(&command_buffer);
+        case.texture.surface_presented();
+        case.pages_become(5, 5, GREEN_TEXEL);
+        assert_eq!(case.page_texel(WIDTH - 5, 5), RED_TEXEL);
+    });
+}
+
+#[test]
+fn surface_present_the_clock_copies_back_after_the_guest_goes_idle() {
+    switches(true, true, false, 20);
+    on_surface(|case| {
+        case.draw(RED, None);
+        case.pages_become(5, 5, RED_TEXEL);
+    });
+}
+
+#[test]
+fn surface_present_cpu_calls_see_and_keep_the_truth() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        case.draw(RED, None);
+        let mut read = [0u8; 4];
+        case.texture
+            .get_bytes(&mut read, ROW, 0, Region::new_2d(5, 5, 1, 1), 0, 0)
+            .unwrap();
+        assert_eq!(read, RED_TEXEL);
+        case.draw(GREEN, None);
+        case.texture
+            .replace_region(Region::new_2d(1, 1, 1, 1), 0, 0, &[1, 2, 3, 4], ROW, 0)
+            .unwrap();
+        assert_eq!(case.page_texel(5, 5), GREEN_TEXEL, "copied back first");
+        assert_eq!(case.page_texel(1, 1), [1, 2, 3, 4]);
+        // The next pass leaves the CPU's texel where it does not draw.
+        let right = ScissorRect { x: WIDTH / 2, y: 0, width: WIDTH / 2, height: HEIGHT };
+        case.draw(RED, Some(right));
+        case.texture.surface_presented();
+        case.pages_become(WIDTH - 5, 5, RED_TEXEL);
+        assert_eq!(case.page_texel(1, 1), [1, 2, 3, 4]);
+    });
+}
+
+#[test]
+fn surface_present_a_copy_back_covers_the_union_of_the_scissors() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        let at = |x| ScissorRect { x, y: 0, width: 100, height: 50 };
+        // The image holds every texel from here on, so no pass copies in.
+        case.draw(RED, None);
+        case.texture.surface_presented();
+        case.pages_become(250, 5, RED_TEXEL);
+        let before = ahead_counts();
+        case.draw(GREEN, Some(at(0)));
+        case.draw(GREEN, Some(at(100)));
+        case.texture.surface_presented();
+        case.pages_become(150, 5, GREEN_TEXEL);
+        let after = ahead_counts();
+        assert_eq!(case.page_texel(50, 5), GREEN_TEXEL);
+        assert_eq!(case.page_texel(250, 5), RED_TEXEL);
+        assert_eq!(after.flushes, before.flushes + 1);
+        assert_eq!(after.whole, before.whole, "bounded");
+        assert_eq!(after.texels - before.texels, 200 * 50);
+    });
+}
+
+#[test]
+fn surface_present_a_released_texture_writes_nothing_over_its_pages() {
+    switches(true, true, false, 20);
+    on_surface(|case| {
+        let before = ahead_counts();
+        let Case { device, queue, mapping, buffer, texture, opaque, rect, len } = case;
+        let case = Case { device, queue, mapping, len, buffer, texture, opaque, rect };
+        case.draw(RED, None);
+        let Case { mapping, texture, buffer, .. } = case;
+        drop((texture, buffer));
+        let start = Instant::now();
+        while ahead_counts().discarded == before.discarded {
+            assert!(start.elapsed() < SOON, "not dropped: {:?}", ahead_counts());
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        assert_eq!(mapping.read(20..24), [BEFORE; 4]);
+    });
+}
+
+/// How many takes a remap of `elsewhere` refuses.
+fn refused_by_remap(case: &Case<'_>, elsewhere: &Mapping) -> u64 {
+    case.draw(RED, None);
+    case.draw(GREEN, None);
+    let (_, before, _) = counts();
+    case.device
+        .host_range_remapped(elsewhere.pointer(), 16384);
+    case.draw(RED, None);
+    counts().1 - before
+}
+
+#[test]
+fn surface_lazy_scoped_a_remap_elsewhere_keeps_the_standing() {
+    let elsewhere = Mapping::anonymous(16384);
+    switches(false, false, true, 60_000);
+    on_surface(|case| assert_eq!(refused_by_remap(&case, &elsewhere), 0));
+    // A remap of its own pages drops it all the same.
+    switches(false, false, true, 60_000);
+    on_surface(|case| {
+        case.draw(RED, None);
+        case.draw(GREEN, None);
+        let (_, before, _) = counts();
+        case.device.host_range_remapped(case.mapping.pointer(), 16384);
+        case.draw(RED, None);
+        assert_eq!(counts().1 - before, 1);
+    });
+}
+
+#[test]
+fn surface_lazy_off_the_new_switches_change_nothing() {
+    let elsewhere = Mapping::anonymous(16384);
+    switches(false, false, false, 60_000);
+    on_surface(|case| {
+        let before = ahead_counts();
+        case.texture.surface_presented();
+        case.draw(RED, None);
+        assert_eq!(case.page_texel(5, 5), RED_TEXEL);
+        assert_eq!(ahead_counts().deferred, before.deferred);
+        // Unscoped, any remap refuses the next take.
+        assert_eq!(refused_by_remap(&case, &elsewhere), 1);
+    });
+}
