+
+    /// LOCAL (Atlas): [`finish`](Self::finish) at an encoder's own end, where a surface may leave
+    /// what it wrote ahead in its image instead (`shadow_lazy.rs`): one alone in the encoder over
+    /// its bytes, with nothing kept to merge.
+    pub(super) fn finish_leaving_ahead(&mut self) -> Vec<ShadowCopy<M>> {
+        let mut copies = Vec::new();
+        for i in 0..self.entries.len() {
+            if !self.entries[i].dirty {
+                continue;
+            }
+            let entry = &self.entries[i];
+            let alone = (self.entries.iter().enumerate())
+                .all(|(j, other)| j == i || !other.copies.shares_truth(&entry.copies));
+            let left = alone
+                && entry.merge.is_none()
+                && !entry.two_ways
+                && (entry.copies.lazy.as_ref())
+                    .is_some_and(|lazy| lazy.defer(&entry.copies, entry.area, self.carry.id));
+            match left {
+                true => {
+                    let entry = &mut self.entries[i];
+                    entry.dirty = false;
+                    entry.area = None;
+                }
+                false => self.copy_back(i, &mut copies),
+            }
+        }
+        copies
+    }
 }
