+/// Note a change of the pages under `bytes` without a command (`Device::host_range_remapped`).
+pub(crate) fn remapped(bytes: Range<usize>) {
+    if !ANY.load(Ordering::Relaxed) {
+        return;
+    }
+    if !crate::live::on(SCOPED, false) {
+        EPOCH.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    for lazy in surfaces() {
+        if lazy.over(&bytes) {
+            lazy.written.fetch_add(1, Ordering::Relaxed);
+        }
