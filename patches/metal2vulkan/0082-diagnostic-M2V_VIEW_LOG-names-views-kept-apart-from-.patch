From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Sun, 8 Nov 2026 21:04:44 +0000
Subject: [PATCH 82/92] diagnostic: M2V_VIEW_LOG names views kept apart from
 their image

---
 crates/metal2vulkan-runtime/src/texture.rs | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/crates/metal2vulkan-runtime/src/texture.rs b/crates/metal2vulkan-runtime/src/texture.rs
index 43c8b18f..797a3dbf 100644
--- a/crates/metal2vulkan-runtime/src/texture.rs
+++ b/crates/metal2vulkan-runtime/src/texture.rs
@@ -5466,7 +5466,20 @@ impl Texture {
             Storage::Image(image)
             | Storage::Alias { image, .. }
             | Storage::Shadow { image, .. } => {
-                !self.device().image_takes_view(image, record.pixel_format)
+                let apart = !self.device().image_takes_view(image, record.pixel_format);
+                // LOCAL (Atlas) diagnostic, `M2V_VIEW_LOG`: why a view is not a Vulkan view of its
+                // texture's image (the first 40).
+                if apart && std::env::var_os("M2V_VIEW_LOG").is_some() {
+                    static N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                    if N.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 40 {
+                        let p = image.plan();
+                        eprintln!(
+                            "m2v-view-log: view {:?} usage {:?} of image {:?} {:?} flags {:?} usage {:?} views {:?}",
+                            record.pixel_format, record.usage, p.pixel_format, p.format, p.flags, p.usage, p.view_formats
+                        );
+                    }
+                }
+                apart
             }
         };
         let mut record = record;
