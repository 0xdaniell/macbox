             }
             if !clear {
                 self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
+                self.counts.risk_by[6].fetch_add(1, Ordering::Relaxed);
             }
         }
         let held = (state.running.iter())
@@ -2050,7 +2067,7 @@ impl Coherent {
              \"probes\":{},\"flushes\":{},\"flushed_bytes\":{},\"copy_ins\":{},\"copy_in_bytes\":{},\
