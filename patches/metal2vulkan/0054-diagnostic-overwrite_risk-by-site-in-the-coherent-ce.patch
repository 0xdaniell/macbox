              \"total\":{total:.0},\"eager_would\":{eager:.0}}},\"pays\":{}}}\n",
             self.layout.first_page(),
@@ -2098,6 +2115,7 @@ impl Coherent {
             read(&c.late_compare_ns),
             read(&c.late_compare_ns_max),
             read(&c.late_beside),
+            c.risk_by.iter().map(|n| read(n).to_string()).collect::<Vec<_>>().join(","),
             state.done.len(),
             state.snapshots.len(),
             read(&c.spent_ns) < read(&c.saved_ns),
