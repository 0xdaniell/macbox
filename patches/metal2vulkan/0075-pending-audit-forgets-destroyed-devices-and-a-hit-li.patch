+/// A `vkDestroyDevice` of `device`, before it: it is no longer read through, and what it
+/// submitted is forgotten.
+pub(crate) fn device_destroyed(device: &ash::Device) {
+    if !*ON {
+        return;
+    }
+    let mut state = STATE.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut devices = DEVICES.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut dead = DEAD.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let found = (devices.iter().enumerate())
+        .position(|(i, d)| !dead.contains(&i) && d.handle() == device.handle());
+    if let Some(at) = found {
+        // Keep the indices of the others: a destroyed device's slot reads nothing.
+        state.subs.retain(|_, sub| sub.device != at);
+        dead.push(at);
+    }
+    drop(dead);
+    drop(devices);
+}
+
+/// The indices in [`DEVICES`] of devices destroyed.
+static DEAD: LazyLock<Mutex<Vec<usize>>> = LazyLock::new(|| Mutex::new(Vec::new()));
+
