+/// A `vkAllocateCommandBuffers` from `pool` that made `buffers`.
+pub(crate) fn allocated(pool: vk::CommandPool, buffers: &[vk::CommandBuffer]) {
+    if !*ON {
+        return;
+    }
+    let mut state = STATE.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let list = state.pools.entry(vk::Handle::as_raw(pool)).or_default();
+    list.extend(buffers.iter().map(|&b| key(b)));
+}
+
+/// A release (`release.rs`) of the object `raw` by `call`, before it: a command pool's command
+/// buffers are checked as by a reset and forgotten (their handles may be made again); a
+/// semaphore is no longer read.
+pub(crate) fn released(call: crate::exit_guard::Call, raw: u64) {
+    if !*ON {
+        return;
+    }
+    use crate::exit_guard::Call;
+    let mut state = STATE.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    match call {
+        Call::DestroyCommandPool => {
+            let Some(buffers) = state.pools.remove(&raw) else {
+                return;
+            };
+            for buffer in buffers {
+                check_and_forget(&mut state, buffer, "pool destroy");
+                state.generation.remove(&buffer);
+                state.executed_by.remove(&buffer);
+                state.executes.remove(&buffer);
+                state.subs.remove(&buffer);
+            }
+        }
+        Call::DestroySemaphore => {
+            state.seen.remove(&raw);
+        }
+        _ => {}
+    }
+}
