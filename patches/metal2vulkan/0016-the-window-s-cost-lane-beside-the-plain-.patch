---
 .../src/runtime_lane/surface_coherent.rs             | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs b/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
index 07688b3c..143ca0a8 100644
--- a/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
+++ b/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
@@ -897,8 +897,16 @@ fn surface_coherent_cost_of_a_window() {
         values.sort_by(f64::total_cmp);
         values[values.len() / 2]
     }
-    for (name, coherent, demote) in [("off", false, "1"), ("stays", true, "0"), ("demoted", true, "1")] {
-        on_surface_of([W, H, R], coherent, coherent, |case| {
+    let modes = [
+        ("demoted", true, true, "1"),
+        ("off", false, true, "1"),
+        ("eager", false, false, "1"),
+        ("stays", true, true, "0"),
+        ("demoted again", true, true, "1"),
+        ("off again", false, true, "1"),
+    ];
+    for (name, coherent, lazy, demote) in modes {
+        on_surface_of([W, H, R], coherent, lazy, |case| {
             live::set("surface_coherent_demote", Some(demote));
             live::set("surface_coherent_copy_ns_per_mib", Some(COPIES_COST_NOTHING));
             live::set("surface_coherent_hold_s", Some("60"));
