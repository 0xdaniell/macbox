# Pinned sources for `macbox build`. With the patches in patches/ they make the build that has run day
# to day since 2026-11-09 on an Intel Arrow Lake iGPU (Core Ultra 200S, Mesa 26.2.4 ANV), "production I":
# Reims vGPU 7198fe6 + src/patches/reims-vgpu, its QEMU at bd95509 + src/patches/qemu, and metal2vulkan's
# development branch at 0db5825a + src/patches/metal2vulkan. `macbox build --upstream` takes Reims's
# master instead, with no patches.
REIMS_REPO=https://github.com/steelbrain/reims-vgpu
REIMS_REF=7198fe60c9df14593e86d090cb4640c3e45ac65b
# vendor/qemu (github.com/steelbrain/qemu-reims-vgpu)
QEMU_REF=bd95509aa307f48b13fe8497d8a1b64267cb4c3e
M2V_REPO=https://github.com/steelbrain/metal2vulkan
M2V_REF=0db5825a6092ed6ab52e0a3b6e0f10d6e92928dd
# The browser stream of the Mac's screen (pip, in a venv under MACBOX_HOME).
SELKIES_VERSION=2.1.0
