diff --git a/crates/metal2vulkan-runtime/src/shadow_lazy.rs b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
new file mode 100644
index 00000000..e05af1f8
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
@@ -0,0 +1,226 @@
+//! LOCAL (Atlas): a large surface over host pages rendered in an optimal image kept across command
+//! buffers, under the live switch `surface_lazy` (default off).
+//!
+//! `host_rt_in_place` renders the macOS desktop and a Simulator's display surface straight into
+//! their pages as a linear image, where a pass costs far more than into an optimal one (a whole
+//! 3200x1800 surface blended, Arrow Lake: 5.1 ms against 1.5). The plain shadow (`shadow.rs`) pays
+//! instead a copy in and a keep and merge at every command buffer, and WindowServer's command
+//! buffers hold about one pass each: the copies cost more than the linear image.
+//!
+//! Under the switch a texture over a surface's plane of at least `surface_lazy_min_texels`
+//! (default 2,000,000) texels is a shadow ([`takes_surface`]), and three things change for it:
+//!
+//! - **No copy in where the image still holds the bytes.** An encoder's end leaves the image's
+//!   standing ([`Lazy::stand`]), as `shadow::ShadowCarry` leaves it to the command buffer's later
+//!   encoders; a later command buffer's encoder takes it ([`Lazy::take`]), so it copies in nothing,
+//!   where nothing wrote the bytes since. Every write a command records of them, through anything
+//!   else over them (`shadow::ShadowCopies::meets`, an alias of the same pages too) drops it
+//!   ([`note_writes`]), as do a remap of host pages and a CPU write through a texture
+//!   ([`everything_written`]).
+//! - **No keep and merge.** Its copy back writes the rectangle the commands wrote in, where their
+//!   scissors bound it, or every texel. A CPU write inside that rectangle while the command buffer
+//!   runs is lost, where the merge keeps it: the guest's CPU does not write a surface it renders
+//!   into at the same time.
+//! - **Copy back as ever: at each encoder's end**, in the command buffer, so before its completion
+//!   reaches the guest. So the guest's CPU, a screenshot, ScreenCaptureKit and the display read the
+//!   pages as they read them shadowed or in place, at every command buffer's completion, and a
+//!   later command's read through another import is ordered after the copy by the tracker.
+//!
+//! **What it cannot see**: a write of the guest's CPU into the pages between command buffers, which
+//! reaches the host through no call. Metal shows it to a later command buffer. Here the image misses
+//! it until the next copy in: at least every `surface_lazy_resync_ms` (default 250, 0 never) a
+//! surface's next encoder takes no standing and copies in as the plain shadow does.
+//!
+//! The switch is read as a texture is made and as an encoder ends: a texture keeps its form.
+//!
+//! **Command buffers encoded out of order**: a standing is taken only from a command buffer already
+//! committed ([`committed`]), whose commands Metal orders before the taker's.
+
+use super::resource::ResourceKey;
+use super::tracker::{Use, UseRange};
+use std::collections::VecDeque;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, OnceLock, RwLock, Weak};
+use std::time::Instant;
+
+/// The live switch.
+const SWITCH: &str = "surface_lazy";
+const DEFAULT_MIN_TEXELS: u64 = 2_000_000;
+const DEFAULT_RESYNC_MS: u64 = 250;
+/// The committed command buffers remembered: an older one's standing is not taken.
+const COMMITTED_KEPT: usize = 256;
+
+/// Moved on by what may have written any surface's bytes without a command.
+static EPOCH: AtomicU64 = AtomicU64::new(0);
+/// Whether any surface is registered: every hook returns at once while none is.
+static ANY: AtomicBool = AtomicBool::new(false);
+static TAKEN: AtomicU64 = AtomicU64::new(0);
+static REFUSED: AtomicU64 = AtomicU64::new(0);
+static RESYNCS: AtomicU64 = AtomicU64::new(0);
+static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+
+fn registry() -> &'static RwLock<Vec<Weak<Lazy>>> {
+    static ALL: OnceLock<RwLock<Vec<Weak<Lazy>>>> = OnceLock::new();
+    ALL.get_or_init(RwLock::default)
+}
+
+fn committed_ids() -> &'static Mutex<VecDeque<u64>> {
+    static IDS: OnceLock<Mutex<VecDeque<u64>>> = OnceLock::new();
+    IDS.get_or_init(Mutex::default)
+}
+
+/// Whether a texture over host pages of `texels` stays a shadow to render lazily (`host_rt.rs`).
+pub(crate) fn takes_surface(texels: u64) -> bool {
+    crate::live::on(SWITCH, false)
+        && texels
+            >= crate::live::get("surface_lazy_min_texels")
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(DEFAULT_MIN_TEXELS)
+}
+
+/// Note that what may hold any surface's bytes changed without a command.
+pub(crate) fn everything_written() {
+    if ANY.load(Ordering::Relaxed) {
+        EPOCH.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Note the command buffer of identity `id` committed.
+pub(crate) fn committed(id: u64) {
+    if !ANY.load(Ordering::Relaxed) {
+        return;
+    }
+    let mut ids = committed_ids().lock().unwrap();
+    if ids.len() == COMMITTED_KEPT {
+        ids.pop_front();
+    }
+    ids.push_back(id);
+}
+
+/// Note a recorded command with `uses` (the host memory's among them): each of its writes of a
+/// surface's truth drops that surface's standing. A surface's own copy back counts too: its
+/// encoder's end reads the count after it ([`Lazy::stand`]).
+pub(super) fn note_writes(uses: &[Use<ResourceKey>]) {
+    if !ANY.load(Ordering::Relaxed) {
+        return;
+    }
+    let all = registry().read().unwrap();
+    for used in uses.iter().filter(|used| !used.write.is_empty()) {
+        for lazy in all.iter().filter_map(Weak::upgrade) {
+            if lazy.meets(used) {
+                lazy.written.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+    }
+}
+
+/// The counts so far, for a lane or a stderr line: standings taken, refused, and resyncs.
+pub fn counts() -> (u64, u64, u64) {
+    (
+        TAKEN.load(Ordering::Relaxed),
+        REFUSED.load(Ordering::Relaxed),
+        RESYNCS.load(Ordering::Relaxed),
+    )
+}
+
+/// What an encoder's end left of the image.
+#[derive(Clone, Copy)]
+struct Stood {
+    /// The command buffer's identity (`shadow::ShadowCarry::id`).
+    id: u64,
+    /// `ShadowCopies::touched` as the encoder left it.
+    touched: u64,
+    held: Option<[u32; 4]>,
+    stale: Option<[u32; 4]>,
+    written: u64,
+    epoch: u64,
+}
+
+/// One surface's standing.
+pub(super) struct Lazy {
+    truth: OnceLock<(ResourceKey, Option<ResourceKey>, UseRange)>,
+    written: AtomicU64,
+    stood: Mutex<Option<Stood>>,
+    resynced: Mutex<Instant>,
+}
+
+impl Lazy {
+    /// The state of a new shadow of `texels` texels with `surface` as its backing, where the switch
+    /// takes it.
+    pub(super) fn of(surface: bool, texels: u64) -> Option<Arc<Lazy>> {
+        (surface && takes_surface(texels)).then(|| {
+            Arc::new(Lazy {
+                truth: OnceLock::new(),
+                written: AtomicU64::new(0),
+                stood: Mutex::new(None),
+                resynced: Mutex::new(Instant::now()),
+            })
+        })
+    }
+
+    fn meets(&self, used: &Use<ResourceKey>) -> bool {
+        self.truth.get().is_some_and(|(key, alias, range)| {
+            (used.key == *key || Some(used.key) == *alias) && used.range.overlaps(range)
+        })
+    }
+
+    /// Leave the image's standing: `id`'s encoder ended with the image holding the truth, inside
+    /// `held` where given, stale inside `stale`. Its own copies back are behind it.
+    pub(super) fn stand(
+        self: &Arc<Self>,
+        (key, alias, range): (ResourceKey, Option<ResourceKey>, UseRange),
+        id: u64,
+        touched: u64,
+        held: Option<[u32; 4]>,
+        stale: Option<[u32; 4]>,
+    ) {
+        if self.truth.set((key, alias, range)).is_ok() {
+            let mut all = registry().write().unwrap();
+            all.retain(|lazy| lazy.strong_count() > 0);
+            all.push(Arc::downgrade(self));
+            ACTIVE.store(all.len(), Ordering::Relaxed);
+            ANY.store(true, Ordering::Relaxed);
+        }
+        *self.stood.lock().unwrap() = Some(Stood {
+            id,
+            touched,
+            held,
+            stale,
+            written: self.written.load(Ordering::Relaxed),
+            epoch: EPOCH.load(Ordering::Relaxed),
+        });
+    }
+
+    /// The encoder's end left the image not holding the truth.
+    pub(super) fn fall(&self) {
+        *self.stood.lock().unwrap() = None;
+    }
+
+    /// Where the image stands for an encoder that met `touched`, of a command buffer of identity
+    /// `id`: `Some((held, stale))` where it needs no copy in (the module docs).
+    pub(super) fn take(&self, id: u64, touched: u64) -> Option<(Option<[u32; 4]>, Option<[u32; 4]>)> {
+        let stood = (*self.stood.lock().unwrap())?;
+        let current = stood.touched == touched
+            && stood.written == self.written.load(Ordering::Relaxed)
+            && stood.epoch == EPOCH.load(Ordering::Relaxed)
+            && stood.id != id
+            && committed_ids().lock().unwrap().contains(&stood.id);
+        if !current {
+            REFUSED.fetch_add(1, Ordering::Relaxed);
+            return None;
+        }
+        let every = crate::live::get("surface_lazy_resync_ms")
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(DEFAULT_RESYNC_MS);
+        if every > 0 {
+            let mut resynced = self.resynced.lock().unwrap();
+            if resynced.elapsed().as_millis() as u64 >= every {
+                *resynced = Instant::now();
+                RESYNCS.fetch_add(1, Ordering::Relaxed);
+                return None;
+            }
+        }
+        TAKEN.fetch_add(1, Ordering::Relaxed);
+        Some((stood.held, stood.stale))
+    }
+}
