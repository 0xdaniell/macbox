+/// A CPU writer down the whole surface stops once: a probe per page would stall it for a surface
+/// this size, and on a real guest every probe walks every tracked surface.
+#[test]
+fn surface_coherent_a_cpu_writer_stops_once() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        case.read(0, 0);
+        case.draw(GREEN, None);
+        for y in 0..HEIGHT {
+            case.write(1, y, [1, 2, 3, 4]);
+        }
+        assert_eq!(case.count("writes"), 1);
+        assert_eq!(case.through_image(1, 0), [1, 2, 3, 0], "the image took the writes");
+        assert_eq!(case.through_image(1, HEIGHT - 1), [1, 2, 3, 0]);
+        assert_eq!(case.through_image(0, HEIGHT - 1), [0, 255, 0, 0], "and what the GPU made holds");
+    });
+}
