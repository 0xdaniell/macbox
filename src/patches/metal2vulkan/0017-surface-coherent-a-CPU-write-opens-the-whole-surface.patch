+        // A running write needs no wait: the merge at its completion keeps this one. A GPU copy
+        // back already on its way cannot merge.
+        let (settled, clear) = self.wait_settled(state, None);
+        state = settled;
+        self.sync_done(&mut state, SyncBy::Trap);
+        if !clear {
+            self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
