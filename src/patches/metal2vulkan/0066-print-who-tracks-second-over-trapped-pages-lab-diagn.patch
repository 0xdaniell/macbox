From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Sun, 8 Nov 2026 12:38:24 +0000
Subject: [PATCH 66/92] print who tracks second over trapped pages (lab
 diagnostics)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/metal2vulkan-runtime/src/shadow_coherent.rs | 14 ++++++++++++++
 crates/metal2vulkan-runtime/src/shadow_lazy.rs     |  5 +++++
 2 files changed, 19 insertions(+)

diff --git a/crates/metal2vulkan-runtime/src/shadow_coherent.rs b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
index ca151e3d..e3edc4c9 100644
--- a/crates/metal2vulkan-runtime/src/shadow_coherent.rs
+++ b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
@@ -757,6 +757,20 @@ impl Coherent {
         {
             let mut list = all().write().unwrap();
             if list.iter().any(meets) {
+                // LOCAL (Atlas, lab diagnostics): who tracks second over pages another traps.
+                static SHOWN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                if SHOWN.fetch_add(1, Ordering::Relaxed) < 8 {
+                    let other = list.iter().find(|one| meets(one)).map(|one| {
+                        let lazy = one.lazy.upgrade();
+                        (one.range(), lazy.map(|l| l.size_and_taken()))
+                    });
+                    let me = self.lazy.upgrade().map(|l| l.size_and_taken());
+                    eprintln!(
+                        "m2v-overlap-closed: me {:?} {:?} age {:?} other {:?}\n{}",
+                        range, me, self.made.elapsed(), other,
+                        std::backtrace::Backtrace::force_capture()
+                    );
+                }
                 state.closed = true;
                 count(Fallback::ClosedByOverlap);
                 return false;
diff --git a/crates/metal2vulkan-runtime/src/shadow_lazy.rs b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
index 33013ce9..95222b09 100644
--- a/crates/metal2vulkan-runtime/src/shadow_lazy.rs
+++ b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
@@ -1302,6 +1302,11 @@ impl Lazy {
         self.coherent.get().filter(|coherent| coherent.is_live())
     }
 
+    /// LOCAL (Atlas, lab diagnostics): the takes of its standing so far.
+    pub(crate) fn size_and_taken(&self) -> ([u32; 2], u64) {
+        (self.size, self.taken.load(Ordering::Relaxed))
+    }
+
     /// Whether its image must stay whole: a trapping surface's copies back are any rectangle.
     pub(super) fn whole_image(&self) -> bool {
         self.coherent.get().is_some_and(|coherent| coherent.is_live())
