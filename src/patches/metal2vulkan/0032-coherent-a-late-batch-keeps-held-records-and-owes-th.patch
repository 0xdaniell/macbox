+    /// LOCAL (Atlas): the copies in a late batch's copy back left this command buffer owing
+    /// (`shadow_lazy::owed_copies_in`), at the start of batch `range`'s first part, as
+    /// [`record_late_copies_in`](Self::record_late_copies_in) records its own.
+    fn record_owed_copies_in(
+        &self,
+        state: &mut State,
+        range: std::ops::Range<usize>,
+    ) -> Result<(), CommandBufferError> {
+        if range.is_empty() || !crate::shadow_coherent::owes_copies_in() {
+            return Ok(());
+        }
+        let Some(id) = state.shadow_carry.as_ref().map(|carry| carry.id()) else {
+            return Ok(());
+        };
+        let copies = crate::shadow_lazy::owed_copies_in(id);
+        if copies.is_empty() {
+            return Ok(());
+        }
+        let device = &self.device;
+        let mut uses = Vec::new();
+        for copy in &copies {
+            uses.extend(copy.uses_with(None));
+        }
+        let mut aliased = Vec::new();
+        if device.shared().aliases.augment_into(&uses, &mut aliased) {
+            uses = aliased;
+        }
+        let raw = self.record_raw(state, |_, buffer| {
+            let vk = device.shared().vk();
+            // SAFETY: as `record_late_copies_in`'s.
+            unsafe {
+                for copy in &copies {
+                    copy.record(vk, buffer, None);
+                }
+                Barrier::everything().record(vk, buffer);
+            }
+            Ok(())
+        })?;
+        let first = &mut state.recorded[range.start];
+        first.raws.insert(0, raw);
+        first.summary.join(Summary::outside_encoders(uses));
+        state.retained.push(Box::new(copies));
+        Ok(())
+    }
