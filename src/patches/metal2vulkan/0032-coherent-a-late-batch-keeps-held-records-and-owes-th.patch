+/// LOCAL (Atlas): the copies in the batch of the command buffer `id` going now takes first, of
+/// each trapping surface a late batch's copy back kept a record of it for
+/// ([`Coherent::before_late_batch`]): what other command buffers wrote through other imports
+/// since, in parts the scheduler planned (path 4's `Lazy::beside_since`, `Coherent::taking_beside`).
+/// Its record's landing at completion then carries them. Under the scheduler's lock.
+pub(crate) fn owed_copies_in(id: u64) -> Vec<ShadowCopy> {
+    let mut list = Vec::new();
+    if !crate::shadow_coherent::owes_copies_in() {
+        return list;
+    }
+    for lazy in surfaces() {
+        let Some(coherent) = lazy.coherent() else {
+            continue;
+        };
+        let Some(since) = coherent.take_owed_in(id) else {
+            continue;
+        };
+        let held = (lazy.pending.lock().unwrap().as_ref()).map(|left| left.copies.clone());
+        let Some(Ok(copies)) = held.map(|held| held.downcast::<ShadowCopies>()) else {
             count(Fallback::PlanLeftPlanned);
+            continue;
+        };
+        let beside = lazy.beside_since(since, id, coherent);
+        let areas = coherent.taking_beside(id, false, beside);
+        if areas.is_empty() {
+            continue;
+        }
+        count(Fallback::PlanOwedCopyIn);
+        let mut texels = 0;
+        for area in areas {
+            let copy = ShadowCopy {
+                copies: Arc::clone(&copies),
+                step: Step::Into,
+                kept: false,
+                area: Some(area),
+                cause: Some(CopyCause::Bounded),
+                moves: None,
+            };
+            texels += copy.texels_copied_in();
+            list.push(copy);
         }
+        lazy.copied_in(CopyCause::Bounded, texels);
     }
-    before
+    list
 }
 
