+    /// LOCAL (Atlas): what the command buffer `id`, its uses `uses`, wrote of its bytes through
+    /// other imports, as [`Beside`] kept it.
+    fn writes_of(&self, id: u64, uses: &[&Use<ResourceKey>]) -> crate::shadow_coherent::Writes {
+        use crate::shadow_coherent::Writes;
+        if !uses.iter().any(|used| !used.write.is_empty() && self.meets(used)) {
+            return Writes::None;
+        }
+        let beside = self.beside.lock().unwrap();
+        match (beside.writes.iter()).filter(|write| write.id == id).map(|write| write.count).min() {
+            // A joined entry's count is its last write's: the one before it is past its first.
+            Some(count) => {
+                let before = (beside.writes.iter())
+                    .take_while(|write| write.count < count)
+                    .map(|write| write.count)
+                    .last();
+                Writes::Since(before.unwrap_or(beside.lost))
+            }
+            None => Writes::Unknown,
+        }
+    }
+
