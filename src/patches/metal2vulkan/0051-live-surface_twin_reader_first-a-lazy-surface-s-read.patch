+    /// Whether a texture of `usage` (checked as `layout`) over `texels` is a lazy surface's reader
+    /// made before any shadow of it: with the live switch `surface_twin_reader_first` on, it is
+    /// made the surface's first shadow, planned with a writer's usage too, so the writer made
+    /// after it binds it as a later reader binds a writer's ([`surface_twin`](Self::surface_twin))
+    /// instead of making a shadow beside the reader's image in place, whose bytes the writer's
+    /// copies would bring back every frame. Off: the module's order.
+    pub(super) fn surface_reader_first(
+        &self,
+        texels: &Texels,
+        layout: &TextureLayout,
+        usage: TextureUsage,
+    ) -> bool {
+        if !crate::live::on(SWITCH, true) || !crate::live::on("surface_twin_reader_first", false) {
+            return false;
+        }
+        if usage.intersects(TextureUsage::RENDER_TARGET | TextureUsage::SHADER_WRITE | TextureUsage::SHADER_ATOMIC)
+            || !texels.lies_lazily()
+            || texels.buffer.detached()
+            || crate::in_place::checking()
+            || surface_depth_unit(layout.pixel_format).is_some()
+        {
+            return false;
+        }
+        let Some(key) = texels.surface_key() else {
+            return false;
+        };
+        let twins = lock(&self.shared().textures.twins.0);
+        let first = twins.get(&key).is_some_and(|first| first.texels.strong_count() > 0);
+        if !first {
+            crate::shadow_lazy::reader_first();
+        }
+        !first
+    }
+
