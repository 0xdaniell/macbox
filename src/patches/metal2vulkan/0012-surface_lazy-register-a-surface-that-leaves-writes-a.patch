+#[test]
+fn surface_present_two_textures_of_a_surface_see_each_others_writes() {
+    switches(true, true, false, 60_000);
+    on_surface(|case| {
+        let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, WIDTH, HEIGHT, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = case.buffer.resource_options();
+        let other = case
+            .buffer
+            .new_texture_with_iosurface_plane(&d, IoSurfacePlane::new(0, ROW, false))
+            .unwrap();
+        let left = ScissorRect { x: 0, y: 0, width: WIDTH / 2, height: HEIGHT };
+        let right = ScissorRect { x: WIDTH / 2, y: 0, width: WIDTH / 2, height: HEIGHT };
+        let red = staged(case.device, &floats4(RED));
+        let green = staged(case.device, &floats4(GREEN));
+        let rects = std::slice::from_ref(&case.rect);
+        // Across command buffers, then inside one, each texture over what the other wrote.
+        for apart in [true, false] {
+            let mut command_buffer = case.queue.command_buffer().unwrap();
+            for (texture, color, damage) in [
+                (&case.texture, &red, left),
+                (&other, &green, right),
+                (&case.texture, &green, left),
+                (&other, &red, right),
+            ] {
+                pass(&command_buffer, texture, &case.opaque, rects, color, Some(damage));
+                if apart {
+                    run(&command_buffer);
+                    command_buffer = case.queue.command_buffer().unwrap();
+                }
+            }
+            run(&command_buffer);
+            case.texture.surface_presented();
+            other.surface_presented();
+            case.pages_become(5, 5, GREEN_TEXEL);
+            case.pages_become(WIDTH - 5, 5, RED_TEXEL);
+            // The next round's writes start from these.
+            case.draw(RED, Some(left));
+            case.draw(GREEN, Some(right));
+            let read = gpu_read(&case.queue, &case.other_import(), 0..ROW);
+            assert_eq!(read[..4], RED_TEXEL);
+            assert_eq!(read[read.len() - 4..], GREEN_TEXEL);
+        }
+    });
+}
