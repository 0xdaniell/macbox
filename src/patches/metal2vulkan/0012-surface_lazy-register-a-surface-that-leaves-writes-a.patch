+/// Note a copy back recorded past [`note_writes`]: a command of an unordered encoder. A standing of
+/// another texture's image over the bytes must drop with it, which `surface_lazy` alone leaves to
+/// the next resync: the new switches close that.
+pub(crate) fn note_copy_back(uses: &[Use<ResourceKey>]) {
+    if ANY.load(Ordering::Relaxed)
+        && (crate::live::on(SCOPED, false) || crate::live::on(PRESENT, false))
+    {
+        note_writes(uses);
+    }
+}
