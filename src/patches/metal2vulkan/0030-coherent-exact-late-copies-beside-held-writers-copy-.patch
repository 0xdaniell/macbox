+    /// after it; what runs, planned, the batch copies back first (`Some((mark, through))`, landed at
+    /// its completion). What runs held for an event is not ordered before the batch by Metal
+    /// either, and lands at its completion as ever; open snapshots ask a wait, which the
+    /// scheduler's lock cannot take: both left, counted.
+    pub(crate) fn before_late_batch(&self, id: u64) -> Option<(u64, u64)> {
+        let mut state = self.lock();
+        if state.closed || !state.tracked {
+            return None;
+        }
+        if !state.done.is_empty() {
+            count(Fallback::PlanSync);
+            self.sync_done(&mut state, SyncBy::GpuReader);
+        }
+        let flushed_to = state.flushed_to;
+        let others = |record: &&Record| record.id != id && record.seq > flushed_to;
+        if !state.running.iter().any(|record| others(&record)) {
+            return None;
+        }
+        if !state.snapshots.is_empty() {
+            count(Fallback::PlanLeft);
+            return None;
+        }
+        let held = (state.running.iter())
+            .filter(others)
+            .filter(|record| super::shadow_lazy::unplanned(record.id))
+            .map(|record| record.seq)
+            .min();
+        let mark = state.seq;
+        let through = held.map_or(mark, |seq| seq - 1);
+        if through <= flushed_to {
+            count(Fallback::PlanLeft);
