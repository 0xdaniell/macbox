+        }
+        waiting.commit().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let writer = other.command_buffer().unwrap();
+        writer.encode_wait_for_event((&gate).into(), 1).unwrap();
+        let bytes: Vec<u8> = (0..16).flat_map(|_| [1u8, 2, 3, 4]).collect();
+        let source = staged(case.device, &bytes);
+        let mut blit = writer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&source, 0, &other_buffer, 100 * ROW, 64).unwrap();
+        blit.end_encoding().unwrap();
+        writer.commit().unwrap();
+        hold.set_signaled_value(1);
+        gate.set_signaled_value(1);
+        for command_buffer in [&writer, &waiting] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        let after = shadow_coherent::fallback_counts();
+        let read = case.read(9, 100);
+        eprintln!(
+            "LATEBATCH sync/back/left={}/{}/{} (9,100)={read:?} (0,200)={:?}",
+            after.plan_syncs - before.plan_syncs,
+            after.plan_copies_back - before.plan_copies_back,
+            after.plan_left - before.plan_left,
+            case.read(0, 200),
+        );
+        assert!(read == [1, 2, 3, 4] || read == [0, 0, 255, 0], "one order, whole: {read:?}");
+        assert_eq!(case.read(0, 0), [0, 0, 255, 0], "the blend");
+        assert_eq!(case.read(0, 200), GREEN_TEXEL, "the reader's passes");
+        let report = shadow_coherent::report("late-batch");
+        assert!(!report.contains("\"sync_errors\":1"), "{report}");
+    });
+}
