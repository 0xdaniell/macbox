     /// orders them after earlier writers, and a barrier after them, before the part's own work.
     /// Nothing, and no command buffer, where the CPU wrote nothing (counted:
     /// `CoherentFallbackCounts::late_copies_in`).
+    fn record_copies_back_before(
+        &self,
+        state: &mut State,
+        range: std::ops::Range<usize>,
+    ) -> Result<(), CommandBufferError> {
+        let Some(id) = state.shadow_carry.as_ref().map(|carry| carry.id()) else {
+            return Ok(());
+        };
+        if range.is_empty() {
+            return Ok(());
+        }
+        let copies = {
+            let recorded = &state.recorded[range.clone()];
+            crate::shadow_lazy::before_late_batch(id, || {
+                (recorded.iter()).flat_map(|part| part.summary.lazy_uses()).collect()
+            })
+        };
+        if copies.is_empty() {
+            return Ok(());
+        }
+        let device = &self.device;
+        let mut uses = Vec::new();
+        let mut planned = Vec::new();
+        for (copy, _) in &copies {
+            let dispatched = copy.dispatched(device);
+            let rows = match dispatched {
+                Some(_) => None,
+                None => copy.staged_back(device),
+            };
+            match &dispatched {
+                Some(_) => uses.extend(copy.dispatched_uses()),
+                None => uses.extend(copy.uses_with(rows.as_ref())),
+            }
+            planned.push((dispatched, rows));
+        }
+        let mut aliased = Vec::new();
+        if device.shared().aliases.augment_into(&uses, &mut aliased) {
+            uses = aliased;
+        }
+        let raw = self.record_raw(state, |_, buffer| {
+            let vk = device.shared().vk();
+            // SAFETY: the command buffer is recording; the images and the buffers over the pages
+            // are live (the copies and their holds, kept with the command buffer), in `GENERAL`;
+            // the barrier the tracker plans before the part orders the copies after the records'
+            // writes, and this one the part's work after them.
+            unsafe {
+                for ((copy, _), (dispatched, rows)) in copies.iter().zip(&planned) {
+                    match dispatched {
+                        Some(back) => back.record(vk, buffer),
+                        None => copy.record(vk, buffer, rows.as_ref()),
+                    }
+                }
+                Barrier::everything().record(vk, buffer);
+            }
+            Ok(())
+        })?;
+        let first = &mut state.recorded[range.start];
+        first.raws.insert(0, raw);
+        first.summary.join(Summary::outside_encoders(uses));
+        for (dispatched, rows) in planned {
+            if let Some(back) = dispatched {
+                state.retained.push(Box::new(back));
+            }
+            if let Some(sets) = rows.and_then(|rows| rows.retained()) {
+                state.retained.push(Box::new(sets));
+            }
+        }
+        state.retained.push(Box::new(copies));
+        Ok(())
+    }
+
     fn record_late_copies_in(
         &self,
         state: &mut State,
