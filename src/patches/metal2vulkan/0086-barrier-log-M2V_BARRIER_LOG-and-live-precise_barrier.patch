+//! LOCAL (Atlas) diagnostic: the barrier log, `M2V_BARRIER_LOG=1`. Counts each global memory
+//! barrier the runtime records through [`Barrier::record`](crate::tracker::Barrier) by the place
+//! that recorded it and its masks, and each barrier a batch's barrier command buffer carries as the
+//! batch is submitted (kept or recorded: `command_buffer/submit.rs`), and logs every 10 s the rates
+//! of the 30 most frequent, with the device's counts of command buffers begun by kind, submissions
+//! and finales. Unset (or `0`), each hook is one check of a `OnceLock`.
+
+use std::collections::HashMap;
+use std::panic::Location;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+/// Whether the log is on: read once.
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("M2V_BARRIER_LOG").is_ok_and(|v| !v.is_empty() && v != "0"))
+}
+
+/// The place, a label, and the masks: src stages, dst stages, src access, dst access.
+type Key = (&'static str, u32, &'static str, u64, u64, u64, u64);
+
+static TABLE: Mutex<Option<HashMap<Key, u64>>> = Mutex::new(None);
+
+fn start() -> Instant {
+    static START: OnceLock<Instant> = OnceLock::new();
+    *START.get_or_init(Instant::now)
+}
+
+/// Counts one barrier recorded or submitted at `site` (`label` says which).
+pub(crate) fn note(site: &'static Location<'static>, label: &'static str, masks: [u64; 4]) {
+    let _ = start();
+    let key = (site.file(), site.line(), label, masks[0], masks[1], masks[2], masks[3]);
+    if let Ok(mut table) = TABLE.lock() {
+        *table.get_or_insert_with(HashMap::new).entry(key).or_insert(0) += 1;
+    }
+}
+
+/// Logs the table and `counts` once 10 s passed since the last log; called on the scheduler's
+/// thread as batches are submitted.
+pub(crate) fn tick(counts: &crate::work_counts::Counters) {
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let now = start().elapsed().as_millis() as u64;
+    let last = LAST.load(Ordering::Relaxed);
+    if now.saturating_sub(last) < 10_000
+        || LAST.compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed).is_err()
+    {
+        return;
+    }
+    let secs = (now - last).max(1) as f64 / 1000.0;
+    let rows: Vec<(Key, u64)> = match TABLE.lock() {
+        Ok(mut table) => table.take().map(|t| t.into_iter().collect()).unwrap_or_default(),
+        Err(_) => return,
+    };
+    let mut rows = rows;
+    rows.sort_by(|a, b| b.1.cmp(&a.1));
+    let total: u64 = rows.iter().map(|r| r.1).sum();
+    let mut text = format!(
+        "m2v barrier log: {:.0}/s barriers over {:.1} s; {}\n",
+        total as f64 / secs,
+        secs,
+        counts.barrier_log_line()
+    );
+    for ((file, line, label, ss, ds, sa, da), n) in rows.iter().take(30) {
+        let file = file.rsplit("src/").next().unwrap_or(file);
+        text += &format!(
+            "m2v barrier log:   {:8.0}/s {label} {file}:{line} src {ss:#x}/{sa:#x} dst {ds:#x}/{da:#x}\n",
+            *n as f64 / secs
+        );
+    }
+    eprint!("{text}");
+}
