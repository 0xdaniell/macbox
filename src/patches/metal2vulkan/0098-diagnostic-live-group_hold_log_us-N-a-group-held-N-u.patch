@@ -387,10 +387,12 @@ impl SchedulerShared {
         match asleep {
             Asleep::OnCondvar => {
                 self.wakings[woken as usize].fetch_add(1, Ordering::Relaxed);
+                super::command_buffer::SCHED_WAKES[woken as usize].fetch_add(1, Ordering::Relaxed);
                 self.wake.notify_all();
             }
             Asleep::Nudged => {
                 self.wakings[woken as usize].fetch_add(1, Ordering::Relaxed);
+                super::command_buffer::SCHED_WAKES[woken as usize].fetch_add(1, Ordering::Relaxed);
             }
             Asleep::No | Asleep::OnGpu => {
                 self.spared.fetch_add(1, Ordering::Relaxed);
@@ -927,6 +929,7 @@ fn run(shared: &SchedulerShared) {
             state.asleep = false;
             if waited.timed_out() {
                 shared.wakings[Woken::Slice as usize].fetch_add(1, Ordering::Relaxed);
+            super::command_buffer::SCHED_WAKES[Woken::Slice as usize].fetch_add(1, Ordering::Relaxed);
                 if super::command_buffer::kept_wake() {
                     state.dirty = true;
                 }
@@ -998,12 +1001,14 @@ fn wait_for_gpu<'a>(
     match waited {
         Some(Ok(())) if !by_waker => {
             shared.wakings[Woken::Completion as usize].fetch_add(1, Ordering::Relaxed);
+            super::command_buffer::SCHED_WAKES[Woken::Completion as usize].fetch_add(1, Ordering::Relaxed);
             state.dirty = true;
         }
         // Nudged: the waker counted the waking and marked the state.
         Some(Ok(())) => {}
         Some(Err(vk::Result::TIMEOUT)) => {
             shared.wakings[Woken::Slice as usize].fetch_add(1, Ordering::Relaxed);
+            super::command_buffer::SCHED_WAKES[Woken::Slice as usize].fetch_add(1, Ordering::Relaxed);
             if super::command_buffer::kept_wake() {
                 state.dirty = true;
             }
@@ -1050,7 +1055,13 @@ fn run_work(kind: Kind, work: Work) -> bool {
 fn round(shared: &SchedulerShared, left: &mut Left<Work>, passed: &mut Passed) -> bool {
     (shared.inbox).pass(|state, commits| {
         shared.passes.fetch_add(1, Ordering::Relaxed);
+        // LOCAL (Atlas, lab): for `group.rs`'s long-hold line.
+        let began = crate::gpu_time::host_nanos();
+        super::command_buffer::SCHED_PASSES.fetch_add(1, Ordering::Relaxed);
+        super::command_buffer::SCHED_PASS_AT.store(began, Ordering::Relaxed);
         pass(state, commits, (&mut *passed, &mut *left), &shared.awaits);
+        super::command_buffer::SCHED_PASS_NS_MAX
+            .fetch_max(crate::gpu_time::host_nanos().saturating_sub(began), Ordering::Relaxed);
         !passed.exiting && left.is_empty() && !passed.more
     });
     passed.more = false;
