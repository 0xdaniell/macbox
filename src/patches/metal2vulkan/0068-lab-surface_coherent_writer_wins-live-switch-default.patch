         {
@@ -1379,6 +1413,29 @@ impl Coherent {
         self.close(&mut state, true);
     }
 
+    /// LOCAL (Atlas): give its pages up to another image over them that writes
+    /// (`surface_coherent_writer_wins`): only where it never left a write ahead and has nothing
+    /// running, so its image holds nothing the pages lack; what it settled lands as `retire`'s.
+    fn try_yield(&self) -> bool {
+        let mut state = self.lock();
+        if !state.tracked || state.closed {
+            return false;
+        }
+        // Anything it holds that the pages lack, or the pages hold that its image lacks, keeps it.
+        let busy = !state.running.is_empty() || !state.open.is_empty() || state.flushing != 0
+            || !state.owed.is_empty() || !state.owed_in.is_empty();
+        if self.counts.defers.load(Ordering::Relaxed) > 0 || busy || state.guest.is_some() {
+            return false;
+        }
+        self.sync_done(&mut state, SyncBy::Unmap);
+        self.close(&mut state, true);
+        drop(state);
+        if let Some(lazy) = self.lazy.upgrade() {
+            lazy.forget_standing();
+        }
+        true
+    }
