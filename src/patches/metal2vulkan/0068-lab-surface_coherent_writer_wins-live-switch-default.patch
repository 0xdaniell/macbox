+        // LOCAL (Atlas): live `surface_coherent_writer_wins` (default off). Two textures over one
+        // surface race to trap its pages at their first use; where the one that won never left a
+        // write ahead and has nothing running, and this use writes, it yields the pages to this
+        // one, as a dead surface's image retires above: the writer's copies back per encoder are
+        // what the trap saves. The yielding image goes on lazy alone, copying in when it is used.
+        if WRITER.with(std::cell::Cell::get) && crate::live::on("surface_coherent_writer_wins", false) {
