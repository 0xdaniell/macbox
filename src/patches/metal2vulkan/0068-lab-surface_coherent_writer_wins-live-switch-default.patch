+thread_local! {
+    /// LOCAL (Atlas): whether the shadow use being planned on this thread writes its texture
+    /// ([`as_writer`]), read by [`Coherent::tracks`] under `surface_coherent_writer_wins`.
+    static WRITER: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// LOCAL (Atlas): run `f` (a shadow entry's planning, which may track a surface) as a use that
+/// writes the texture or not.
+pub(crate) fn as_writer<R>(writes: bool, f: impl FnOnce() -> R) -> R {
+    let before = WRITER.with(|w| w.replace(writes));
+    let out = f();
+    WRITER.with(|w| w.set(before));
+    out
+}
+
+/// LOCAL (Atlas): owners that yielded their pages to a writer (`surface_coherent_writer_wins`).
+pub(crate) static YIELDED: AtomicU64 = AtomicU64::new(0);
+
 pub(crate) fn count(what: Fallback) {
     FALLBACK[what as usize].fetch_add(1, Ordering::Relaxed);
 }
