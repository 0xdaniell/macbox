From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Sun, 8 Nov 2026 02:16:09 +0000
Subject: [PATCH 55/92] diagnostic: M2V_TWIN_LOG says why a texture over a lazy
 surface binds no twin

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/texture/surface_twin.rs               | 51 +++++++++++++++++--
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/crates/metal2vulkan-runtime/src/texture/surface_twin.rs b/crates/metal2vulkan-runtime/src/texture/surface_twin.rs
index 6a09fb3c..14978604 100644
--- a/crates/metal2vulkan-runtime/src/texture/surface_twin.rs
+++ b/crates/metal2vulkan-runtime/src/texture/surface_twin.rs
@@ -57,10 +57,27 @@ impl Device {
         if surface_depth_unit(layout.pixel_format).is_some() {
             return None;
         }
-        let (image, first, copies) = {
+        let found = {
             let twins = lock(&self.shared().textures.twins.0);
-            let found = twins.get(&texels.surface_key()?)?;
-            (found.image.upgrade()?, found.texels.upgrade()?, found.copies.upgrade()?)
+            twins.get(&texels.surface_key()?).and_then(|found| {
+                Some((found.image.upgrade()?, found.texels.upgrade()?, found.copies.upgrade()?))
+            })
+        };
+        let Some((image, first, copies)) = found else {
+            if std::env::var_os("M2V_TWIN_LOG").is_some() {
+                static M: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                if M.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 80 {
+                    eprintln!(
+                        "m2v-twin-first: {:?} usage {:?} {}x{} at {:?} (no first shadow yet)",
+                        layout.pixel_format,
+                        descriptor.usage,
+                        layout.extent[0],
+                        layout.extent[1],
+                        texels.surface_key(),
+                    );
+                }
+            }
+            return None;
         };
         let facts = self.shared().textures.facts(self.compile_device().profile());
         let usage = texture_usage(descriptor.usage, descriptor.swizzle);
@@ -78,6 +95,34 @@ impl Device {
             && first.same_place(texels)
             && !copies.converts()
             && self.image_takes_view(&image, layout.pixel_format);
+        // LOCAL (Atlas) diagnostic: why a texture over a lazy surface's pages binds no image of
+        // its own surface's, where `M2V_TWIN_LOG` is set (the first 80).
+        if !takes && std::env::var_os("M2V_TWIN_LOG").is_some() {
+            static N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+            if N.fetch_add(1, std::sync::atomic::Ordering::Relaxed) < 80 {
+                eprintln!(
+                    "m2v-twin-refused: {:?} usage {:?} (plan usage {:?} flags {:?} extent {:?} levels {} layers {} samples {:?}) vs first {:?} usage {:?} flags {:?} extent {:?} levels {} layers {} views {:?}: same {same} place {} converts {} view {}",
+                    layout.pixel_format,
+                    descriptor.usage,
+                    plan.usage,
+                    plan.flags,
+                    plan.extent,
+                    plan.levels,
+                    plan.layers,
+                    plan.samples,
+                    theirs.pixel_format,
+                    theirs.usage,
+                    theirs.flags,
+                    theirs.extent,
+                    theirs.levels,
+                    theirs.layers,
+                    theirs.view_formats,
+                    first.same_place(texels),
+                    copies.converts(),
+                    self.image_takes_view(&image, layout.pixel_format),
+                );
+            }
+        }
         takes.then(|| {
             crate::shadow_lazy::twin_bound();
