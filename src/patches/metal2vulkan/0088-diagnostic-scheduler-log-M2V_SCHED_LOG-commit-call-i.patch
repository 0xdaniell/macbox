+//! LOCAL (Atlas) diagnostic: the scheduler log, `M2V_SCHED_LOG=1`. Where a command buffer waits
+//! between its commit call and the scheduler's first submission of its work, per logical queue:
+//! the call to the inbox post (`commit` settling ends, queued commits), the post to a pass taking
+//! it into the order (the scheduler's thread busy or asleep), and the take to the submission's
+//! start (event and binary waits, the queue's earlier batches, gates, checks, the pass's cap).
+//! Logged every 10 s for each queue with 20 or more command buffers in the window. Unset (or
+//! `0`), each hook is one check of a `OnceLock`.
+
+use crate::gpu_time::{host_nanos, KernelTimes};
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+/// Whether the log is on: read once.
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("M2V_SCHED_LOG").is_ok_and(|v| !v.is_empty() && v != "0"))
+}
+
+/// Stores the host time into `at` where the log is on.
+pub(crate) fn mark(at: &AtomicU64) {
+    if on() {
+        at.store(host_nanos(), Ordering::Release);
+    }
+}
+
+/// Per logical queue: its `VkQueue` and the waits in microseconds, call->post, post->take,
+/// take->begin.
+type Table = HashMap<u64, (usize, [Vec<u32>; 3])>;
+
+static TABLE: Mutex<Option<Table>> = Mutex::new(None);
+static LAST: AtomicU64 = AtomicU64::new(0);
+
+/// The scheduler began submitting the first batch of a command buffer of logical queue `queue`
+/// on `VkQueue` `vk_queue`, whose marks `kernel` holds.
+pub(crate) fn note(queue: u64, vk_queue: usize, kernel: &KernelTimes) {
+    if !on() {
+        return;
+    }
+    let now = host_nanos();
+    let called = kernel.called.load(Ordering::Acquire);
+    let posted = kernel.posted.load(Ordering::Acquire);
+    let taken = kernel.taken.load(Ordering::Acquire);
+    let us = |a: u64, b: u64| -> u32 {
+        if a == 0 || b == 0 {
+            u32::MAX
+        } else {
+            (b.saturating_sub(a) / 1000).min(u64::from(u32::MAX - 1)) as u32
+        }
+    };
+    let row = [us(called, posted), us(posted, taken), us(taken, now)];
+    let Ok(mut table) = TABLE.lock() else { return };
+    let entry = table
+        .get_or_insert_with(HashMap::new)
+        .entry(queue)
+        .or_insert_with(|| (vk_queue, [Vec::new(), Vec::new(), Vec::new()]));
+    for (list, value) in entry.1.iter_mut().zip(row) {
+        if value != u32::MAX {
+            list.push(value);
+        }
+    }
+    let last = LAST.load(Ordering::Relaxed);
+    if last == 0 {
+        LAST.store(now, Ordering::Relaxed);
+        return;
+    }
+    if now.saturating_sub(last) < 10_000_000_000 {
+        return;
+    }
+    LAST.store(now, Ordering::Relaxed);
+    let secs = now.saturating_sub(last) as f64 / 1e9;
+    let Some(rows) = table.take() else { return };
+    drop(table);
+    let mut rows: Vec<(u64, (usize, [Vec<u32>; 3]))> = rows.into_iter().collect();
+    rows.sort_by_key(|(_, (_, lists))| std::cmp::Reverse(lists[2].len()));
+    let mut text = format!("m2v sched log: {secs:.1} s window\n");
+    for (queue, (vk_queue, mut lists)) in rows {
+        let n = lists[2].len();
+        if n < 20 {
+            continue;
+        }
+        text += &format!("m2v sched log:   queue {queue} vk {vk_queue} n {n} ({:.0}/s)", n as f64 / secs);
+        for (name, list) in ["call>post", "post>take", "take>begin"].iter().zip(lists.iter_mut()) {
+            list.sort_unstable();
+            let at = |p: usize| list.get((list.len() * p / 100).min(list.len().saturating_sub(1))).copied().unwrap_or(0) as f64 / 1000.0;
+            text += &format!(
+                " | {name} p50 {:.2} p90 {:.2} p99 {:.2} max {:.2}",
+                at(50),
+                at(90),
+                at(99),
+                list.last().copied().unwrap_or(0) as f64 / 1000.0
+            );
+        }
+        text += " ms\n";
+    }
+    eprint!("{text}");
+}
