+/// A window: its whole surface drawn and a compositor sampling it through its own import, each
+/// frame. What a demoted surface costs beside a surface that never trapped: its image stays in
+/// memory placed for host reads. `--nocapture`.
+#[test]
+fn surface_coherent_cost_of_a_window() {
+    const W: u64 = 3160;
+    const H: u64 = 1680;
+    const R: u64 = 12640;
+    fn median(mut values: Vec<f64>) -> f64 {
+        values.sort_by(f64::total_cmp);
+        values[values.len() / 2]
+    }
+    for (name, coherent, demote) in [("off", false, "1"), ("stays", true, "0"), ("demoted", true, "1")] {
+        on_surface_of([W, H, R], coherent, coherent, |case| {
+            live::set("surface_coherent_demote", Some(demote));
+            live::set("surface_coherent_copy_ns_per_mib", Some(COPIES_COST_NOTHING));
+            live::set("surface_coherent_hold_s", Some("60"));
+            let other = case.other_import();
+            let [mut frames, mut gpu] = [Vec::new(), Vec::new()];
+            for i in 0..150 {
+                let start = Instant::now();
+                let command_buffer = case.queue.command_buffer().unwrap();
+                case.pass(&command_buffer, if i % 2 == 0 { RED } else { GREEN }, None);
+                run(&command_buffer);
+                gpu_read(&case.queue, &other, 0..4);
+                if i >= 30 {
+                    frames.push(start.elapsed().as_secs_f64() * 1e3);
+                    let ends = command_buffer.gpu_end_time().unwrap();
+                    gpu.push((ends - command_buffer.gpu_start_time().unwrap()) * 1e3);
+                }
+            }
+            let [frames, gpu] = [median(frames), median(gpu)];
+            let (demotions, syncs) = (case.count("demotions"), case.count("regions"));
+            eprintln!("\nwindow {name}: frame {frames:.2} ms, gpu {gpu:.2} ms, demotions {demotions}, syncs {syncs}");
+        });
+    }
+}
