From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Mon, 9 Nov 2026 10:52:42 +0000
Subject: [PATCH 90/92] live checks_first=1: a left submission check runs
 before the thread drains commits that keep coming (desktop batches starved
 behind a Simulator's commits)

---
 crates/metal2vulkan-runtime/src/scheduler/left.rs | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/crates/metal2vulkan-runtime/src/scheduler/left.rs b/crates/metal2vulkan-runtime/src/scheduler/left.rs
index 366e43e0..801fc455 100644
--- a/crates/metal2vulkan-runtime/src/scheduler/left.rs
+++ b/crates/metal2vulkan-runtime/src/scheduler/left.rs
@@ -64,6 +64,11 @@ impl<W> Left<W> {
         self.ordered = self.work.len();
     }
 
+    /// LOCAL (Atlas): the oldest piece's kind.
+    fn front_kind(&self) -> Option<Kind> {
+        self.work.front().map(|(kind, _)| *kind)
+    }
+
     /// The oldest piece, taken out.
     fn pop(&mut self) -> Option<(Kind, W)> {
         let work = self.work.pop_front()?;
@@ -97,7 +102,15 @@ pub(crate) fn work_through<S, C, W>(
     while !left.is_empty() {
         // A commit left to this thread meanwhile goes before the next piece of work, as does one
         // left to it during the round that took that one in.
-        while inbox.holds_commits() {
+        // LOCAL (Atlas), live `checks_first=1`: not before a submission check. Under a program
+        // that commits without pause (a Simulator, ~9k command buffers a second), the commits
+        // kept coming during every round, so a checked batch of another queue (the Mac desktop's,
+        // every one of whose command buffers Reims checks) waited 1 to 5 ms for a round without
+        // a commit (`sched_log.rs`, 2026-11-09). A check is a short call of the program's; the
+        // commits it delays wait for it alone, and the next round takes them in with the batch.
+        let checks_first =
+            left.front_kind() == Some(Kind::Check) && crate::live::on("checks_first", false);
+        while !checks_first && inbox.holds_commits() {
             if !round(left) {
                 return None;
             }
