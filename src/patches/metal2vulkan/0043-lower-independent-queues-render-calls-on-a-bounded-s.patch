+/// LOCAL (Atlas, DEEP-CPU): two command queues on different lowering lanes
+/// (`render/lowering_worker.rs`) lower at once and keep the device's one commit order: with
+/// queue A's pass's lowering held, queue B's pass is lowered whole by its lane while its commit
+/// waits behind A's, and A's queue's event (signalled behind A's pass) still gates B's copy. Every
+/// result is the same under `AtCall`: each pass's color, the word B copied after its wait, each
+/// queue's handlers in its commit order, both completed. Then with A's commit work failing: A completes with
+/// `CallRefused` of `commit`, and A's signal and B's pass still complete after it, in order. A
+/// work-counts drain made with both lanes busy returns, and the device's teardown joins both lanes.
+/// Where the host gives one lane alone there is nothing to overlap.
+#[test]
+fn independent_queues_lower_at_once_and_keep_the_commit_order() {
+    let lanes = crate::render::lowering_lanes();
+    if lanes < 2 {
+        eprintln!("one lowering lane on this host: nothing to overlap");
+        return;
+    }
+    let scratch = Scratch::new("deferred-lanes");
+    let red = u32::from_le_bytes([255, 0, 0, 255]);
+    let filled = u32::from_le_bytes([0x5a; 4]);
+    let completed = (CommandBufferStatus::Completed, None);
+    let mut results = Vec::new();
+    for policy in POLICIES {
+        let device = device(&scratch.0, policy, &[], &Heard::default());
+        let result = two_queues(&device, policy, false);
+        assert!(
+            result.0.iter().all(|&w| w == PACKED),
+            "{policy:?} A {:x?}",
+            &result.0[..4]
+        );
+        assert!(
+            result.1.iter().all(|&w| w == red),
+            "{policy:?} B {:x?}",
+            &result.1[..4]
+        );
+        assert_eq!(result.2, [filled], "{policy:?}: B's copy after A's event");
+        assert_eq!(result.3, ["a", "a-signal", "b"], "{policy:?}");
+        assert_eq!(
+            result.4,
+            [completed.clone(), completed.clone()],
+            "{policy:?}"
+        );
+        let counts = device.work_counts();
+        eprintln!(
+            "{policy:?} lanes {lanes}: batches thread/program {}/{} ends {}/{} commits {}/{} waits {}",
+            counts.render_log_batches_by_thread,
+            counts.render_log_batches_by_program,
+            counts.render_log_ends_by_thread,
+            counts.render_log_ends_by_program,
+            counts.render_log_commits_by_thread,
+            counts.render_log_commits_by_program,
+            counts.render_log_waits
+        );
+        if policy == RenderLoweringPolicy::Worker {
+            // B's end by its lane (`lowered_all` above); A's by its lane or, once the hold ended,
+            // by the work counts' drain, which takes what the lane has not. Each once.
+            let ends = counts.render_log_ends_by_thread + counts.render_log_ends_by_program;
+            let commits =
+                counts.render_log_commits_by_thread + counts.render_log_commits_by_program;
+            assert!(counts.render_log_ends_by_thread >= 1, "B's end by a lane");
+            assert_eq!(
+                (ends, commits),
+                (2, 3),
+                "each end and each queued commit ran once"
+            );
+            let worker = device.shared().deferred.started_for_test();
+            assert_eq!(worker.map(|w| w.threads_started()), Some(2));
+        }
+        results.push(result);
+        drop(device);
+    }
+    assert_eq!(results[0], results[1], "Worker against AtCall");
+    // Queue A's commit refused, under Worker: later work on both queues still runs.
+    let device = device(
+        &scratch.0,
+        RenderLoweringPolicy::Worker,
+        &[],
+        &Heard::default(),
+    );
+    let (_, b, copied, order, [a, b_status]) =
+        two_queues(&device, RenderLoweringPolicy::Worker, true);
+    let commit = EncoderCall {
+        selector: "commit",
+        index: 0,
+    };
+    assert_eq!(
+        a,
+        (
+            CommandBufferStatus::Error,
+            Some(CommandBufferError::CallRefused(commit))
+        )
+    );
+    assert_eq!(b_status, completed);
+    assert!(b.iter().all(|&w| w == red), "B {:x?}", &b[..4]);
+    assert_eq!(copied, [filled]);
+    assert_eq!(order, ["a", "a-signal", "b"]);
+}
