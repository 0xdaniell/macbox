+/// What [`two_queues`] reads: the pass of each queue's words, the word queue B's command buffer
+/// copied after it waited for queue A's event, the completed handlers in the order they ran on
+/// each queue (queue A's first), and
+/// the passes' command buffers' statuses and errors.
+type TwoQueues = (
+    Vec<u32>,
+    Vec<u32>,
+    Vec<u32>,
+    Vec<&'static str>,
+    [(CommandBufferStatus, Option<CommandBufferError>); 2],
+);
+
+/// LOCAL (Atlas, DEEP-CPU): the two queues' work of
+/// [`independent_queues_lower_at_once_and_keep_the_commit_order`] on `device`, which lowers as
+/// `policy` says; `refuse` injects an out of memory into the commit work of queue A's pass. Under
+/// Worker, with queue A's slot's lowering held so its lane's thread waits inside it: queue B's
+/// batches and end are lowered (by its own lane: nothing else lowers them), while its commit waits
+/// behind queue A's, and a read of the work counts made meanwhile on another thread returns once
+/// the hold ends.
+fn two_queues(device: &Device, policy: RenderLoweringPolicy, refuse: bool) -> TwoQueues {
+    let state = rectangle_state(device);
+    let lanes = crate::render::lowering_lanes();
+    let qa = device.new_command_queue().unwrap();
+    let mut qb = device.new_command_queue().unwrap();
+    while qb.lowering_lane() % lanes == qa.lowering_lane() % lanes {
+        qb = device.new_command_queue().unwrap();
+    }
+    let order = Arc::new(Mutex::new(Vec::new()));
+    let handler = |name: &'static str| {
+        let ran = Arc::clone(&order);
+        Box::new(move |_: &CommandBuffer| ran.lock().unwrap().push(name))
+    };
+    let (ta, tb) = (target(device), target(device));
+    let word = device.new_buffer(4, ResourceOptions::shared()).unwrap();
+    let copied = device.new_buffer(4, ResourceOptions::shared()).unwrap();
+    let event = device.new_shared_event().unwrap();
+    // Queue A: its pass, held under Worker.
+    let pass_a = qa.command_buffer().unwrap();
+    let mut ea = pass_a.render_command_encoder(&pass(&ta)).unwrap();
+    let held = match policy {
+        RenderLoweringPolicy::Worker => {
+            let slots = device.shared().deferred.taken();
+            let [slot] = &slots[..] else {
+                panic!("{} encoders' slots taken, not one", slots.len());
+            };
+            Some(Arc::clone(slot))
+        }
+        _ => None,
+    };
+    let color_b = bytes_of(&[1.0f32, 0.0, 0.0, 1.0], f32::to_le_bytes);
+    // Queue A's pass in one batch, handed at its end, which its lane takes and waits in; queue
+    // B's in several, its lane lowering each and the end.
+    let (draws_a, draws_b) = (4, BATCH_CALLS);
+    let encode = || {
+        rectangle(&state, &mut ea);
+        ea.set_fragment_bytes(&bytes_of(&COLOR, f32::to_le_bytes), 0)
+            .unwrap();
+        for _ in 0..draws_a {
+            ea.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+                .unwrap();
+        }
+        ea.end_encoding().unwrap();
+        pass_a.add_completed_handler(handler("a")).unwrap();
+        if refuse {
+            pass_a.fail_commit_work(2);
+        }
+        if let Some(slot) = &held {
+            // Its lane's thread took the pass's batches and waits for the held lowering.
+            until("queue A's lane takes the held slot", || slot.handed() == 0);
+        }
+        pass_a.commit().unwrap();
+        // Queue A, behind its pass: a fill, then the event queue B waits for.
+        let signal = qa.command_buffer().unwrap();
+        let mut fill = signal.blit_command_encoder().unwrap();
+        fill.fill_buffer(&word, 0..4, 0x5a).unwrap();
+        fill.end_encoding().unwrap();
+        signal
+            .encode_signal_event(EventRef::from(&event), 1)
+            .unwrap();
+        signal.add_completed_handler(handler("a-signal")).unwrap();
+        signal.commit().unwrap();
+        // Queue B: waits for queue A's event, copies the word, then its own pass.
+        let pass_b = qb.command_buffer().unwrap();
+        pass_b
+            .encode_wait_for_event(EventRef::from(&event), 1)
+            .unwrap();
+        let mut copy = pass_b.blit_command_encoder().unwrap();
+        copy.copy_from_buffer_to_buffer(&word, 0, &copied, 0, 4)
+            .unwrap();
+        copy.end_encoding().unwrap();
+        let mut eb = pass_b.render_command_encoder(&pass(&tb)).unwrap();
+        let slot_b = held.as_ref().map(|held| {
+            let slots = device.shared().deferred.taken();
+            let other = slots.iter().find(|slot| !Arc::ptr_eq(slot, held));
+            Arc::clone(other.expect("queue B's slot"))
+        });
+        rectangle(&state, &mut eb);
+        eb.set_fragment_bytes(&color_b, 0).unwrap();
+        for _ in 0..draws_b {
+            eb.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+                .unwrap();
+        }
+        eb.end_encoding().unwrap();
+        pass_b.add_completed_handler(handler("b")).unwrap();
+        pass_b.commit().unwrap();
+        if let Some(slot_b) = &slot_b {
+            // The overlap: queue A's lane waits inside its slot; queue B's lowers all of B's.
+            until("queue B's lane lowers its slot with queue A's held", || {
+                slot_b.lowered_all()
+            });
+            // The device's commit order: B's commit waits behind A's.
+            assert_eq!(pass_b.status(), CommandBufferStatus::Committed);
+            assert!(
+                order.lock().unwrap().is_empty(),
+                "a handler ran with A held"
+            );
+        }
+        (pass_b, signal)
+    };
+    let (pass_b, signal, drained) = match &held {
+        Some(slot) => {
+            let (done, drained) = mpsc::channel();
+            let ((pass_b, signal), reading) = slot.while_held(|| {
+                let made = encode();
+                // A device-wide drain, made while both lanes hold work: it returns after the
+                // hold, with every lane's lowering done.
+                let reading = std::thread::spawn({
+                    let device = device.clone();
+                    move || {
+                        let _ = device.work_counts();
+                        done.send(()).unwrap();
+                    }
+                });
+                (made, reading)
+            });
+            let drained = drained.recv_timeout(WAIT).is_ok();
+            reading.join().unwrap();
+            (pass_b, signal, drained)
+        }
+        None => {
+            let (pass_b, signal) = encode();
+            (pass_b, signal, true)
+        }
+    };
+    assert!(drained, "{policy:?}: the work counts' drain returned");
+    for command_buffer in [&pass_a, &signal, &pass_b] {
+        command_buffer.wait_until_completed_for(WAIT).unwrap();
+    }
+    let read = |target: &Texture| {
+        let command_buffer = qb.command_buffer().unwrap();
+        let back = copy_back(device, &command_buffer, target);
+        committed(&command_buffer, &back)
+    };
+    let statuses = [&pass_a, &pass_b].map(|cb| (cb.status(), cb.error()));
+    // Each queue's handlers in its order; Metal orders no queue's completions against another's.
+    let mut order = order.lock().unwrap().clone();
+    order.sort_by_key(|name| name.starts_with('b'));
+    (read(&ta), read(&tb), words_of(&copied), order, statuses)
+}
