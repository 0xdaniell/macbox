+//! LOCAL (Atlas): one image for one surface's bytes. A program's textures of one IOSurface plane
+//! (each over a no-copy buffer of the surface's pages, `host_aliases.rs`) were one image each: the
+//! surface's first texture, which renders, a shadow that holds its writes ahead (`shadow_lazy.rs`),
+//! and a later texture that only reads, a linear image in place over the pages. A compositor that
+//! samples such a texture meets the bytes every frame, so the first one's writes went back whole
+//! every frame. Sim 3x: 1 such read a frame, of one of three surfaces in turn, and the Sim's own
+//! rate on Tahoe rose to 60 fps with it gone.
+//!
+//! - **Which.** A texture made over the same host pages as the live first shadow of a lazy
+//!   surface ([`Twins`]), at the same offset and rows, of the same extent, levels, layers, sample
+//!   count, type and hazard tracking, whose declared usage the image has, and of a pixel format
+//!   the image takes a view of (`Device::image_takes_view`: the same one, its sRGB twin, one of
+//!   its list). Any other keeps today's path: an image of its own, in place or a shadow.
+//! - **What it binds.** The first texture's image and copies, under its own record: its format,
+//!   swizzle and usage are its views' (`binding_view`), the image's flags and usage are fixed by
+//!   the first texture's plan, which is why the check above stands. Its own texels stay, for what
+//!   the CPU and the program ask of it. To every encoder it is that image: one resource key for
+//!   the tracker's barriers across textures, one entry of `ShadowSync`, one standing, no
+//!   `beside_another`.
+//! - **Lifetime.** It holds the image, the copies and the first texture's texels (the copies name
+//!   that buffer): the first texture may go first, and the surface's trapping and standing go on
+//!   as they did. The display finds any live one ([`Lazy::owned_by`]).
+//! - **One device.** The tasks of a guest share one `VkDevice`; a table is a device's, so a task
+//!   on another device keeps today's path.
+//! - **Order.** Only what comes after the first shadow binds it: a reader made first stays in
+//!   place, and the shadow made after it stays beside it, as before.
+
+use super::*;
+
+/// The live switch.
+const SWITCH: &str = "surface_twin";
+
+/// A surface's first shadow, weakly: it goes with its last texture.
+struct First {
+    image: Weak<Image>,
+    texels: Weak<Texels>,
+    copies: Weak<ShadowCopies>,
+}
+
+/// A device's first shadow of each surface plane, by the first host address of its bytes and its
+/// offset in them.
+#[derive(Default)]
+pub(super) struct Twins(Mutex<HashMap<(usize, u64), First>>);
+
+impl Device {
+    /// The storage of a texture of `descriptor` (checked as `layout`) over `texels` that binds a
+    /// lazy surface's first shadow (the module docs), where one takes it.
+    pub(super) fn surface_twin(
+        &self,
+        texels: &Arc<Texels>,
+        descriptor: &TextureDescriptor,
+        layout: &TextureLayout,
+    ) -> Option<Storage> {
+        if !crate::live::on(SWITCH, true) || !texels.lies_lazily() || texels.buffer.detached() {
+            return None;
+        }
+        if surface_depth_unit(layout.pixel_format).is_some() {
+            return None;
+        }
+        let (image, first, copies) = {
+            let twins = lock(&self.shared().textures.twins.0);
+            let found = twins.get(&texels.surface_key()?)?;
+            (found.image.upgrade()?, found.texels.upgrade()?, found.copies.upgrade()?)
+        };
+        let facts = self.shared().textures.facts(self.compile_device().profile());
+        let usage = texture_usage(descriptor.usage, descriptor.swizzle);
+        let plan = plan_image(layout, usage, false, &facts).ok()?;
+        let theirs = image.plan();
+        let same = plan.extent == theirs.extent
+            && plan.levels == theirs.levels
+            && plan.layers == theirs.layers
+            && plan.samples == theirs.samples
+            && plan.image_type == theirs.image_type
+            && plan.unavailable == theirs.unavailable
+            && theirs.usage.contains(plan.usage)
+            && theirs.flags.contains(plan.flags);
+        let takes = same
+            && first.same_place(texels)
+            && !copies.converts()
+            && self.image_takes_view(&image, layout.pixel_format);
+        takes.then(|| {
+            crate::shadow_lazy::twin_bound();
+            Storage::Shadow {
+                image,
+                texels: Arc::clone(texels),
+                copies,
+                first: Some(first),
+            }
+        })
+    }
+
+    /// Note `storage`, a new texture's, where it is the first shadow of a lazy surface.
+    pub(super) fn note_surface_first(&self, storage: &Storage) {
+        let Storage::Shadow { image, texels, copies, first: None } = storage else {
+            return;
+        };
+        let Some(key) = texels.surface_key().filter(|_| copies.lazy.is_some()) else {
+            return;
+        };
+        let mut twins = lock(&self.shared().textures.twins.0);
+        twins.retain(|_, first| first.texels.strong_count() > 0);
+        twins.entry(key).or_insert_with(|| First {
+            image: Arc::downgrade(image),
+            texels: Arc::downgrade(texels),
+            copies: Arc::downgrade(copies),
+        });
+    }
+}
