+/// A compositor's texture over the surface it reads, made after the texture that renders it: one
+/// image for the bytes (`surface_twin.rs`), so its read meets no bytes.
+#[test]
+fn surface_twin_a_reader_takes_the_surfaces_image() {
+    on_surface(true, |case| {
+        let twins = shadow_lazy::ahead_counts().twins;
+        let reader = case.reader(PixelFormat::BGRA8Unorm);
+        assert_eq!(shadow_lazy::ahead_counts().twins, twins + 1);
+        case.draw(RED, None);
+        assert_eq!(sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT)[..4], RED_TEXEL);
+        assert_eq!(case.behind(5, 5), [BEFORE; 4], "nothing went back for the read");
+        assert_eq!(case.count("flushes"), 0);
+        case.draw(GREEN, None);
+        assert_eq!(sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT)[..4], GREEN_TEXEL);
+        assert_eq!(case.behind(5, 5), [BEFORE; 4], "still");
+        assert_eq!(case.read(5, 5), GREEN_TEXEL, "and the guest reads what lay ahead");
+    });
+}
+
+/// The reader on a queue of its own, as a compositor's task has, while the write it reads is in
+/// flight: the one image's key orders them.
+#[test]
+fn surface_twin_a_read_waits_for_a_write_on_another_queue() {
+    on_surface(true, |case| {
+        let reader = case.reader(PixelFormat::BGRA8Unorm);
+        let other = case.device.new_command_queue().unwrap();
+        for (color, texel) in [(RED, RED_TEXEL), (GREEN, GREEN_TEXEL), (RED, RED_TEXEL)] {
+            let command_buffer = case.queue.command_buffer().unwrap();
+            case.pass(&command_buffer, color, None);
+            command_buffer.commit().unwrap();
+            assert_eq!(sampled_bgra8(&other, &reader, WIDTH, HEIGHT)[..4], texel);
+        }
+    });
+}
+
+/// What the guest writes reaches a reader of the image through its traps.
+#[test]
+fn surface_twin_a_reader_reads_a_cpu_write() {
+    on_surface(true, |case| {
+        let reader = case.reader(PixelFormat::BGRA8Unorm);
+        case.draw(RED, None);
+        assert_eq!(sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT)[..4], RED_TEXEL);
+        case.write(0, 0, [1, 2, 3, 255]);
+        assert_eq!(sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT)[..4], [1, 2, 3, 255]);
+    });
+}
+
+/// A reader's format is its own view of the image: the sRGB twin decodes what the first stored.
+#[test]
+fn surface_twin_a_reader_views_the_image_in_its_own_format() {
+    on_surface(true, |case| {
+        let twins = shadow_lazy::ahead_counts().twins;
+        let reader = case.reader(PixelFormat::BGRA8UnormSRGB);
+        assert_eq!(shadow_lazy::ahead_counts().twins, twins + 1);
+        case.draw([0.5, 0.5, 0.5, 1.0], None);
+        let read = sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT);
+        // 0x80 decodes to 0.2158.
+        assert!(read[0].abs_diff(55) <= 1, "decoded to {}", read[0]);
+        assert_eq!(read[3], 255);
+    });
+}
+
+/// A reader's swizzle is its own too: the texture that renders keeps its channels.
+#[test]
+fn surface_twin_a_reader_keeps_its_swizzle() {
+    on_surface(true, |case| {
+        let mut d = case.reader_descriptor(PixelFormat::BGRA8Unorm);
+        d.swizzle = TextureSwizzleChannels {
+            red: TextureSwizzle::Blue,
+            green: TextureSwizzle::Green,
+            blue: TextureSwizzle::Red,
+            alpha: TextureSwizzle::Alpha,
+        };
+        let reader = case.over_other_import(&d);
+        case.draw(RED, None);
+        assert_eq!(sampled_bgra8(&case.queue, &reader, WIDTH, HEIGHT)[..4], [255, 0, 0, 255]);
+        assert_eq!(sampled_bgra8(&case.queue, case.texture(), WIDTH, HEIGHT)[..4], RED_TEXEL);
+    });
+}
+
+/// The display finds the image through the reader once the texture it was made for went.
+#[test]
+fn surface_twin_the_display_finds_the_image_through_a_reader() {
+    on_surface(true, |case| {
+        let mapping = Mapping::anonymous(case.len);
+        mapping.fill(BEFORE);
+        let first_bytes = surface_buffer(case.device, &mapping, case.len);
+        let mut d = case.reader_descriptor(PixelFormat::BGRA8Unorm);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        let plane = IoSurfacePlane::new(0, ROW, false);
+        let first = first_bytes.new_texture_with_iosurface_plane(&d, plane).unwrap();
+        d.usage = TextureUsage::SHADER_READ;
+        let other = surface_buffer(case.device, &mapping, case.len);
+        let reader = other.new_texture_with_iosurface_plane(&d, plane).unwrap();
+        case.draw_on(&first, RED);
+        drop(first);
+        let shown = reader.surface_presented().expect("the reader stands for the first");
+        assert_eq!(sampled_bgra8(&case.queue, &shown, WIDTH, HEIGHT)[..4], RED_TEXEL);
+        assert_eq!(mapping.read(0..4), [BEFORE; 4], "and it copied nothing");
+    });
+}
+
+/// A format the image takes no view of keeps a texture of its own, and reads the right texels.
+#[test]
+fn surface_twin_a_format_the_image_does_not_list_stays_apart() {
+    on_surface(true, |case| {
