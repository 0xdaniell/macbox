+/// Whether a tracked surface holds writes of a command buffer not completed yet, open or running,
+/// which its pages show only once that completion arms them: a signal submitted now is seen at
+/// its completion turn alone (`event_timeline.rs`). Called by a submission, under the scheduler's
+/// lock: it waits for no lock, and a lock another thread holds answers yes.
+pub(crate) fn unarmed() -> bool {
+    let Ok(all) = all().try_read() else {
+        return true;
+    };
+    let holds = |state: &State| {
+        state.tracked && !state.closed && !(state.open.is_empty() && state.running.is_empty())
+    };
+    all.iter().any(|surface| match surface.state.try_lock() {
+        Ok(state) => holds(&state),
+        Err(std::sync::TryLockError::Poisoned(state)) => holds(&state.into_inner()),
+        Err(std::sync::TryLockError::WouldBlock) => true,
+    })
+}
