+/// The guest reads the texel at `offset` of the pages from `base` on another thread (a listener's):
+/// a marked page stops it first, as [`Case::read`]'s.
+fn guest_read_at(fake: &Fake, base: u64, offset: u64) -> [u8; 4] {
+    let addr = base + offset;
+    if matches!(
+        fake.mark(addr & !(PAGE - 1)),
+        Some(Mark::Armed | Mark::Frozen)
+    ) {
+        shadow_coherent::fault(addr, false);
+    }
+    // SAFETY: the case's mapping outlives every listener the lanes post (each waits for it).
+    unsafe { std::ptr::read_volatile(addr as *const [u8; 4]) }
+}
+
+/// E1: a shared event signalled by a command buffer after the one that wrote, on the queue, whose
+/// completion has not been seen yet (a completed handler of an earlier command buffer holds the
+/// completions back): once the value is seen, by a read of the counter, a host wait or a listener,
+/// the writes are in the pages. Before, the value rose with the semaphore and the completion turn
+/// saw the signal before it armed the writer's pages, which stayed held with the older bytes.
+#[test]
+fn surface_coherent_a_signal_after_the_writer_reads_its_writes() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(5, 5), RED_TEXEL);
+        let (go, gate) = std::sync::mpsc::channel::<()>();
+        let first = case.queue.command_buffer().unwrap();
+        (first.add_completed_handler(Box::new(move |_: &CommandBuffer| {
+            let _ = gate.recv_timeout(SOON);
+        })))
+        .unwrap();
+        first.commit().unwrap();
+        let writer = case.queue.command_buffer().unwrap();
+        case.pass(&writer, GREEN, None);
+        writer.commit().unwrap();
+        let signal = case.device.new_shared_event().unwrap();
+        let listener = SharedEventListener::new();
+        let (heard, hear) = std::sync::mpsc::channel();
+        let (fake, base) = (case.fake.clone(), case.base());
+        signal.notify_listener(
+            &listener,
+            1,
+            Box::new(move |_: &SharedEvent, _| {
+                let _ = heard.send(guest_read_at(&fake, base, 5 * ROW + 5 * 4));
+            }),
+        );
+        let signaller = case.queue.command_buffer().unwrap();
+        signaller.encode_signal_event((&signal).into(), 1).unwrap();
+        signaller.commit().unwrap();
+        let start = Instant::now();
+        let mut early = None;
+        while start.elapsed() < Duration::from_millis(300) {
+            if signal.signaled_value() >= 1 {
+                early = Some(case.read(5, 5));
+                break;
+            }
+            std::thread::yield_now();
+        }
+        let _ = go.send(());
+        assert!(
+            signal.wait_until_signaled_value(1, SOON),
+            "the GPU reached the signal"
+        );
+        let late = case.read(5, 5);
+        let listened = hear.recv_timeout(SOON).unwrap();
+        for command_buffer in [&first, &writer, &signaller] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        assert_eq!(
+            early.unwrap_or(GREEN_TEXEL),
+            GREEN_TEXEL,
+            "the counter showed the signal"
+        );
+        assert_eq!(listened, GREEN_TEXEL, "the listener heard the signal");
+        assert_eq!(late, GREEN_TEXEL, "a host wait returned for the signal");
+    });
+}
+
+/// E1 through a plain event: the writer signals an `MTLEvent` after its pass and then waits; a
+/// command buffer on another queue waits for that event and signals a shared one. The shared
+/// event's value promises the writer's pass, whose command buffer has not completed.
+#[test]
+fn surface_coherent_a_plain_event_chain_reads_the_writes() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(5, 5), RED_TEXEL);
+        let plain = case.device.new_event().unwrap();
+        let signal = case.device.new_shared_event().unwrap();
+        let hold = case.device.new_shared_event().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let writer = case.queue.command_buffer().unwrap();
+        case.pass(&writer, GREEN, None);
+        writer.encode_signal_event((&plain).into(), 1).unwrap();
+        writer.encode_wait_for_event((&hold).into(), 1).unwrap();
+        writer.commit().unwrap();
+        let relay = other.command_buffer().unwrap();
+        relay.encode_wait_for_event((&plain).into(), 1).unwrap();
+        relay.encode_signal_event((&signal).into(), 1).unwrap();
+        relay.commit().unwrap();
+        let seen = signal.wait_until_signaled_value(1, SOON);
+        let read = case.read(5, 5);
+        hold.set_signaled_value(1);
+        writer.wait_until_completed_for(SOON).unwrap();
+        relay.wait_until_completed_for(SOON).unwrap();
+        assert!(seen, "the relay signalled");
+        assert_eq!(read, GREEN_TEXEL, "what the chain promised");
+    });
+}
+
+/// E1, the other way: a command buffer committed to wait for a shared event before it draws over
+/// the surface; the guest writes a texel, then sets the event. Metal's draw sees the write, so its
+/// copy in must come after the wait, not as the command was encoded. Open: the encoder's copy in
+/// is decided as it is encoded, so the write lands in the pages (kept by the merge) but the draw
+/// never sees it; a fix needs a copy in recorded as the held batch is submitted.
+#[test]
+#[ignore = "open (E1 copy in): fails at 76ab0722 and after the signal fix; run by name"]
+fn surface_coherent_a_cpu_write_before_a_signal_reaches_a_waiting_command() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let color = staged(case.device, &floats4([0.0; 4]));
+        let rects = std::slice::from_ref(&case.rect);
+        let blending = rects_blending(case.device);
+        let command_buffer = case.queue.command_buffer().unwrap();
+        command_buffer
+            .encode_wait_for_event((&hold).into(), 1)
+            .unwrap();
+        pass(
+            &command_buffer,
+            case.texture(),
+            &blending,
+            rects,
+            &color,
+            None,
+        );
+        command_buffer.commit().unwrap();
+        case.write(0, 0, [1, 2, 3, 4]);
+        hold.set_signaled_value(1);
+        command_buffer.wait_until_completed_for(SOON).unwrap();
+        assert_eq!(
+            case.read(0, 0),
+            [1, 2, 3, 0],
+            "the draw blended over the guest's write"
+        );
+        assert_eq!(
+            case.read(1, 0),
+            [0, 0, 255, 0],
+            "and over the GPU's texels beside it"
+        );
+    });
+}
