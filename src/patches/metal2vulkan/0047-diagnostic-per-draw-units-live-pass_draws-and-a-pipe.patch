+/// Close the draw unit open on `cb`, where one is.
+///
+/// # Safety
+///
+/// `cb` is recording, by the caller alone; `st` are its slot's.
+unsafe fn close_draw(st: Stamps, cb: vk::CommandBuffer, state: &mut CaptureState) {
+    if let Some(open) = state.raws.get_mut(&cb.as_raw()).and_then(|r| r.draw_open.take()) {
+        // SAFETY: the caller's.
+        unsafe { close(st, cb, state, open) };
+    }
+}
+
+/// Before `vkCmdEndRenderPass` or `vkCmdExecuteCommands` on `cb`: its draw unit closed.
+///
+/// # Safety
+///
+/// As the command's; `st` are its slot's.
+pub(crate) unsafe fn draws_end(st: Stamps, cb: vk::CommandBuffer) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    // SAFETY: the caller's.
+    unsafe { close_draw(st, cb, &mut guard) };
+}
+
+/// Before `vkCmdBindPipeline` of a graphics `pipeline`, or `vkCmdSetScissor` of `scissor`, on
+/// `cb`: kept for its next draws' descriptions.
+pub(crate) fn draw_state(cb: vk::CommandBuffer, pipeline: Option<u64>, scissor: Option<[i64; 4]>) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    if !capture.draws {
+        return;
+    }
+    let mut state = lock(&capture.state);
+    if let Some(raw) = state.raws.get_mut(&cb.as_raw()) {
+        if let Some(pipeline) = pipeline {
+            raw.pipeline = pipeline;
+        }
+        if scissor.is_some() {
+            raw.scissor = scissor;
+        }
+    }
+}
+
+/// Before a draw `what` of `count` vertices, indices or indirect draws and `instances` on `cb`:
+/// counted as [`draw`], and where the capture times draws, its own unit opened (the last one on
+/// `cb` closed).
+///
+/// # Safety
+///
+/// As the command's: `cb` recording inside a render pass instance (or a secondary of one), by the
+/// caller alone; `st` are its slot's.
+pub(crate) unsafe fn draw_at(st: Stamps, cb: vk::CommandBuffer, what: &'static str, count: u32, instances: u32) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let Some(capture) = capture_of(cb) else {
+        return;
+    };
+    let mut guard = lock(&capture.state);
+    let state = &mut *guard;
+    let Some(raw) = state.raws.get_mut(&cb.as_raw()) else {
+        return;
+    };
+    match raw.open.or(raw.parent) {
+        Some(at) => state.units[at].count += 1,
+        None => raw.pending_draws += 1,
+    }
+    if !capture.draws {
+        return;
+    }
+    let scissor = raw.scissor.map_or_else(|| "-".to_owned(), |[x, y, w, h]| format!("{x}+{y}+{w}x{h}"));
+    let note = format!("{what}:{count}x{instances};pipe={:#x};sc={scissor}", raw.pipeline);
+    let (encoder, parent) = (raw.encoder, raw.open);
+    // SAFETY: the caller's.
+    unsafe { close_draw(st, cb, state) };
+    let unit = Unit {
+        class: Class::Draw,
+        tag: None,
+        site: None,
+        command: what,
+        encoder,
+        label: None,
+        count: 1,
+        block: 0,
+        offset: 0,
+        note: Some(note),
+        raw: cb.as_raw(),
+        parent,
+    };
+    // SAFETY: the caller's; the capture times draws only where the device resets its queries on
+    // the host, so `open` records no reset inside the render pass instance.
+    let opened = unsafe { open(st, cb, &capture, state, unit) };
+    if let Some(raw) = state.raws.get_mut(&cb.as_raw()) {
+        raw.draw_open = opened;
+    }
+}
