+/// LOCAL (Atlas) diagnostic: the pipeline census, while the pass timer is on: one line per
+/// graphics pipeline made, appended to `<dir>/pipes-<pid>.csv` (its handle, which the draw units
+/// name, its color blend states, its pass's shape and its stages' SPIR-V digests), and each stage's
+/// SPIR-V written once to `<dir>/spv/<digest>.spv`.
+pub(crate) fn pipeline_made(
+    raw: vk::Pipeline,
+    blends: &[vk::PipelineColorBlendAttachmentState],
+    pass: &dyn std::fmt::Debug,
+    topology: &dyn std::fmt::Debug,
+    stages: &[(&str, &str, &[u32])],
+) {
+    let Some(dir) = dir() else {
+        return;
+    };
+    static OUT: LazyLock<Mutex<Option<std::fs::File>>> = LazyLock::new(Mutex::default);
+    static WRITTEN: LazyLock<Mutex<std::collections::HashSet<u64>>> = LazyLock::new(Mutex::default);
+    let fnv = |words: &[u32]| {
+        words.iter().fold(0xcbf2_9ce4_8422_2325_u64, |h, w| {
+            w.to_le_bytes()
+                .iter()
+                .fold(h, |h, b| (h ^ u64::from(*b)).wrapping_mul(0x0100_0000_01b3))
+        })
+    };
+    let mut line = format!("{:#x},{:?}", raw.as_raw(), topology);
+    line.push(',');
+    for (i, b) in blends.iter().enumerate() {
+        let _ = write!(
+            line,
+            "{}{i}:{}/m{:x}/{}-{}-{}/{}-{}-{}",
+            if i > 0 { "|" } else { "" },
+            b.blend_enable,
+            b.color_write_mask.as_raw(),
+            b.src_color_blend_factor.as_raw(),
+            b.dst_color_blend_factor.as_raw(),
+            b.color_blend_op.as_raw(),
+            b.src_alpha_blend_factor.as_raw(),
+            b.dst_alpha_blend_factor.as_raw(),
+            b.alpha_blend_op.as_raw(),
+        );
+    }
+    let _ = write!(line, ",{}", format!("{pass:?}").replace(',', ";").replace('\n', " "));
+    let spv = dir.join("spv");
+    for (stage, entry, words) in stages {
+        let digest = fnv(words);
+        let _ = write!(line, ",{stage}:{entry}:{digest:016x}");
+        if lock(&WRITTEN).insert(digest) {
+            let _ = std::fs::create_dir_all(&spv);
+            let bytes: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+            let _ = std::fs::write(spv.join(format!("{digest:016x}.spv")), bytes);
+        }
+    }
+    line.push('\n');
+    let mut out = lock(&OUT);
+    if out.is_none() {
+        let path = dir.join(format!("pipes-{}.csv", std::process::id()));
+        *out = std::fs::OpenOptions::new().create(true).append(true).open(path).ok();
+    }
+    if let Some(file) = out.as_mut() {
+        let _ = file.write_all(line.as_bytes());
+    }
+}
