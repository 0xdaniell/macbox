+    /// LOCAL (Atlas): the copies in of trapping surfaces whose standing an encoder of the batch of
+    /// encoders `range` took after a wait for a shared event (`shadow::LateCopies`): each of what
+    /// the guest's CPU wrote since, in one command buffer at the start of the batch's first part,
+    /// after its waits, its uses joined to that part's summary so the barrier planned before it
+    /// orders them after earlier writers, and a barrier after them, before the part's own work.
+    /// Nothing, and no command buffer, where the CPU wrote nothing (counted:
+    /// `CoherentFallbackCounts::late_copies_in`).
+    fn record_late_copies_in(
+        &self,
+        state: &mut State,
+        range: std::ops::Range<usize>,
+    ) -> Result<(), CommandBufferError> {
+        let Some(carry) = state.shadow_carry.as_mut() else {
+            return Ok(());
+        };
+        let recorded = &state.recorded[range.clone()];
+        let shadows = carry.take_late(|copies| {
+            (recorded.iter()).any(|part| {
+                (part.summary.lazy_uses())
+                    .any(|used| used.key == copies.shadow_key || copies.meets(used))
+            })
+        });
+        if shadows.is_empty() || range.is_empty() {
+            return Ok(());
+        }
+        let id = carry.id();
+        let copies: Vec<_> = (shadows.iter())
+            .filter_map(|copies| crate::shadow_lazy::late_copy_in(copies, id))
+            .collect();
+        if copies.is_empty() {
+            return Ok(());
+        }
+        let device = &self.device;
+        let mut uses = Vec::new();
+        for copy in &copies {
+            uses.extend(copy.uses_with(None));
+        }
+        let mut aliased = Vec::new();
+        if device.shared().aliases.augment_into(&uses, &mut aliased) {
+            uses = aliased;
+        }
+        let raw = self.record_raw(state, |_, buffer| {
+            let vk = device.shared().vk();
+            // SAFETY: the command buffer is recording; the textures' images and the buffers over
+            // the pages are live (the copies hold them, kept with the command buffer), in
+            // `GENERAL`; the barrier the tracker plans before the part orders the copies after
+            // earlier writers, and this one the part's work after them.
+            unsafe {
+                for copy in &copies {
+                    copy.record(vk, buffer, None);
+                }
+                Barrier::everything().record(vk, buffer);
+            }
+            Ok(())
+        })?;
+        let first = &mut state.recorded[range.start];
+        first.raws.insert(0, raw);
+        first.summary.join(Summary::outside_encoders(uses));
+        state.retained.push(Box::new(copies));
+        Ok(())
+    }
+
