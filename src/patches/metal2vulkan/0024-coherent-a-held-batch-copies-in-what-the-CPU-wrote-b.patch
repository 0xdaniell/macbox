+    /// The pages hold everything done, then the open ones are held: the copy in about to read
+    /// them reads all the guest wrote, and its next write traps.
+    fn take_guest(&self, state: &mut State) {
+        self.sync_done(state, SyncBy::CopyIn);
+        let list: Vec<u64> = state.snapshots.keys().copied().collect();
+        if let Some(mark) = pages() {
+            let came = mark.hold(&list, true);
+            state.guest = None;
+            self.note_came(state, came);
+        }
+        state.snapshots.clear();
+        state.opened = false;
+    }
+
+    /// A held batch of the command buffer `id` is about to go, whose encoders took the image's
+    /// standing as they were encoded ([`taking`](Self::taking)): where the guest's CPU wrote
+    /// since, before the signal the batch waited for, the rectangle its copy in takes, recorded
+    /// at the batch's start (`command_buffer/submit.rs`). Called under the scheduler's lock, it
+    /// waits for no record: a write of another command buffer still running over the rectangle
+    /// is counted (`overwrite_risk`, [`Fallback::LateCopyInBusy`]), as a bounded wait past its
+    /// bound is. The command buffer's own records run after the copy.
+    pub(crate) fn taking_late(&self, id: u64) -> Option<[u32; 4]> {
+        let mut state = self.lock();
+        if !state.tracked || state.closed {
+            return None;
+        }
+        let area = state.guest?;
+        let busy = state.flushing != 0
+            || (state.running.iter()).any(|record| record.id != id && meet(record.area, area));
+        if busy && !state.snapshots.is_empty() {
+            self.counts.overwrite_risk.fetch_add(1, Ordering::Relaxed);
+            count(Fallback::LateCopyInBusy);
+        }
+        self.take_guest(&mut state);
+        count(Fallback::LateCopyIn);
+        Some(area)
+    }
