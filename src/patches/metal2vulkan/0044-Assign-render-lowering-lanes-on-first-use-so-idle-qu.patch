From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Fri, 6 Nov 2026 12:56:13 +0000
Subject: [PATCH 44/92] Assign render lowering lanes on first use so idle
 queues cannot consume them

---
 crates/metal2vulkan-runtime/src/queue.rs      | 19 +++++++++++--------
 .../src/render/deferral.rs                    |  8 ++++----
 .../src/render/lowering_worker.rs             |  5 +++--
 .../src/tests/deferred_calls.rs               | 12 ++++++++----
 4 files changed, 26 insertions(+), 18 deletions(-)

diff --git a/crates/metal2vulkan-runtime/src/queue.rs b/crates/metal2vulkan-runtime/src/queue.rs
index d2e1869d..6ffac9fe 100644
--- a/crates/metal2vulkan-runtime/src/queue.rs
+++ b/crates/metal2vulkan-runtime/src/queue.rs
@@ -60,7 +60,7 @@ use super::error::{Error, Invalid, Problem};
 use super::texture::copy_images::CopyImages;
 use super::texture::kept_image::KeptImages;
 use std::sync::atomic::{AtomicUsize, Ordering};
-use std::sync::{Arc, Condvar, Mutex, MutexGuard};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard, OnceLock};
 use std::time::Instant;
 
 /// The uncompleted command buffers a queue holds when made with `new_command_queue`: Metal's
@@ -85,9 +85,9 @@ struct QueueShared {
     id: u64,
     /// The index of the device's `VkQueue` the queue submits to.
     vk_queue: usize,
-    /// LOCAL (Atlas, DEEP-CPU): the lanes' turn its encoders' calls are lowered on under
-    /// `RenderLoweringPolicy::Worker` (`render/lowering_worker.rs`).
-    lowering_lane: usize,
+    /// LOCAL (Atlas, DEEP-CPU): assigned when the queue first hands render work to
+    /// Worker, then stable for its life. Paging and AtCall-only queues consume no lane.
+    lowering_lane: OnceLock<usize>,
     label: Mutex<Option<String>>,
     /// The slots its uncompleted command buffers hold.
     slots: Arc<Slots>,
@@ -278,7 +278,7 @@ impl Device {
             device: self.clone(),
             id,
             vk_queue,
-            lowering_lane: self.shared().deferred.next_queue_lane(),
+            lowering_lane: OnceLock::new(),
             label: Mutex::new(None),
             slots: Slots::new(count, Arc::clone(&self.shared().uncommitted)),
             latest_gpu_end: Mutex::new(0),
@@ -382,10 +382,13 @@ impl CommandQueue {
         self.0.id
     }
 
-    /// LOCAL (Atlas, DEEP-CPU): the lanes' turn its encoders' calls are lowered on
-    /// (`render/lowering_worker.rs`).
+    /// LOCAL (Atlas, DEEP-CPU): the lanes' turn this queue takes on its first render
+    /// lowering, unchanged thereafter (`render/lowering_worker.rs`).
     pub(crate) fn lowering_lane(&self) -> usize {
-        self.0.lowering_lane
+        *self
+            .0
+            .lowering_lane
+            .get_or_init(|| self.0.device.shared().deferred.next_queue_lane())
     }
 
     /// The index of the device's `VkQueue` the queue submits to.
diff --git a/crates/metal2vulkan-runtime/src/render/deferral.rs b/crates/metal2vulkan-runtime/src/render/deferral.rs
index 27ac4980..c1a7d589 100644
--- a/crates/metal2vulkan-runtime/src/render/deferral.rs
+++ b/crates/metal2vulkan-runtime/src/render/deferral.rs
@@ -502,14 +502,14 @@ impl LoweringSlot {
 pub(crate) struct DeferredEncoders {
     slots: Mutex<Vec<Arc<LoweringSlot>>>,
     worker: OnceLock<Option<LoweringWorker>>,
-    /// LOCAL (Atlas, DEEP-CPU): the device's command queues made, which take the lowering lanes
-    /// in turn (`render/lowering_worker.rs`).
+    /// LOCAL (Atlas, DEEP-CPU): the device's queues that started render lowering, which
+    /// take the lowering lanes in turn (`render/lowering_worker.rs`).
     queues: AtomicUsize,
 }
 
 impl DeferredEncoders {
-    /// LOCAL (Atlas, DEEP-CPU): the lanes' turn of a command queue made now, which its
-    /// encoders' slots are handed to for the queue's life (`render/lowering_worker.rs`).
+    /// LOCAL (Atlas, DEEP-CPU): the lanes' turn of a queue starting render lowering,
+    /// kept for its life (`render/lowering_worker.rs`).
     pub(crate) fn next_queue_lane(&self) -> usize {
         self.queues.fetch_add(1, Ordering::Relaxed)
     }
diff --git a/crates/metal2vulkan-runtime/src/render/lowering_worker.rs b/crates/metal2vulkan-runtime/src/render/lowering_worker.rs
index b3a91261..744f9717 100644
--- a/crates/metal2vulkan-runtime/src/render/lowering_worker.rs
+++ b/crates/metal2vulkan-runtime/src/render/lowering_worker.rs
@@ -2,8 +2,9 @@
 //! device's render encoders hand them, while the program goes on.
 //!
 //! - **Lanes.** LOCAL (Atlas, DEEP-CPU): the device lowers on up to [`lanes`] threads, one per
-//!   lane. Each command queue keeps one lane for its life, the queues taking the lanes in turn as
-//!   they are made (`DeferredEncoders::next_queue_lane`), and its encoders' slots are handed to that
+//!   lane. A command queue takes a lane at its first render lowering and keeps it for its
+//!   life (`DeferredEncoders::next_queue_lane`); paging and AtCall-only queues take none.
+//!   Its encoders' slots are handed to that
 //!   lane alone. So one queue's slots are lowered one at a time, in the order they were handed, as
 //!   on the single thread before; only slots of queues on different lanes are lowered at once, as
 //!   the program's threads of different queues lower theirs at once under
diff --git a/crates/metal2vulkan-runtime/src/tests/deferred_calls.rs b/crates/metal2vulkan-runtime/src/tests/deferred_calls.rs
index d08ccc0d..b8651f69 100644
--- a/crates/metal2vulkan-runtime/src/tests/deferred_calls.rs
+++ b/crates/metal2vulkan-runtime/src/tests/deferred_calls.rs
@@ -1120,10 +1120,14 @@ fn two_queues(device: &Device, policy: RenderLoweringPolicy, refuse: bool) -> Tw
     let state = rectangle_state(device);
     let lanes = crate::render::lowering_lanes();
     let qa = device.new_command_queue().unwrap();
-    let mut qb = device.new_command_queue().unwrap();
-    while qb.lowering_lane() % lanes == qa.lowering_lane() % lanes {
-        qb = device.new_command_queue().unwrap();
-    }
+    // Paging and other non-rendering queues must not consume lowering lanes. With
+    // creation-time assignment these queues put B on A's lane, leaving the other
+    // lanes idle and preventing the overlap checked below. Keep them alive for
+    // the whole run, as Reims keeps each task's paging queue.
+    let _paging_queues: Vec<_> = (1..lanes)
+        .map(|_| device.new_command_queue().unwrap())
+        .collect();
+    let qb = device.new_command_queue().unwrap();
     let order = Arc::new(Mutex::new(Vec::new()));
     let handler = |name: &'static str| {
         let ran = Arc::clone(&order);
