 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/crates/metal2vulkan-runtime/src/scheduler/mod.rs b/crates/metal2vulkan-runtime/src/scheduler/mod.rs
index b5e50b3d..8fb340aa 100644
--- a/crates/metal2vulkan-runtime/src/scheduler/mod.rs
+++ b/crates/metal2vulkan-runtime/src/scheduler/mod.rs
@@ -1731,7 +1731,7 @@ fn check_heads(state: &mut State, behind: &[u64], left: &mut Left<Work>, awaits:
                 return false;
             }
             if due {
-                left.push(Kind::Check, (held.buffer.hold(), held.index));
