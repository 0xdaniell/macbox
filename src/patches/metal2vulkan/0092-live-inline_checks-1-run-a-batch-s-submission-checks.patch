     landing
 }
 
+/// LOCAL (Atlas), live `inline_checks=1`: run a batch's submission checks here, under the
+/// scheduler's lock, inside the pass's section, so the batch goes in this pass, not in the next
+/// round after the check ran off the lock. Each command buffer's events chain on the one before
+/// (Reims's FIFO order, `encodeSignalEventScheduled`), so each checked link of the chain cost a
+/// round, 1-4 ms under a Simulator's commits (`sched_log.rs`, 2026-11-09). Only for a program
+/// whose check takes no lock of the runtime's but a command buffer's, which the lock order
+/// allows after the scheduler's (Reims's: its own registry and command-buffer locks, then
+/// `Submission::uses`), and holds no command buffer's last handle (the scheduler holds the
+/// batch's). Off: left to the thread, as upstream.
+fn check_now_or_leave(held: &Held, left: &mut Left<Work>) {
+    if crate::live::on("inline_checks", false) {
+        held.buffer.run_checks(held.index);
+    } else {
+        left.push(Kind::Check, (held.buffer.hold(), held.index));
+    }
+}
+
