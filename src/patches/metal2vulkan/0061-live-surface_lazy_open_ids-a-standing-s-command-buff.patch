+/// LOCAL (Atlas): live `surface_lazy_open_ids` (default off): whether a standing's command buffer
+/// committed is asked of the command buffers that left a standing and have not committed or gone
+/// yet, exactly, instead of the last [`COMMITTED_KEPT`] committed. Those let a standing go stale
+/// after 256 commits of every process, a fraction of a second with several Sims and the desktop,
+/// so a surface idle that long (the desktop's, a triple buffer's) copied its whole bytes in again
+/// as `uncommitted` (2026-11-08 loadlab: 57564 such, 64802 whole copies in).
+const OPEN_IDS: &str = "surface_lazy_open_ids";
+/// The open command buffers kept at most: past it the exact answer is given up for good.
+const OPEN_KEPT: usize = 1 << 16;
+static OPEN_OVERFLOW: AtomicBool = AtomicBool::new(false);
+
+fn open_ids() -> &'static Mutex<HashSet<u64>> {
+    static IDS: OnceLock<Mutex<HashSet<u64>>> = OnceLock::new();
+    IDS.get_or_init(Mutex::default)
+}
+
+fn open_exact() -> bool {
+    crate::live::on(OPEN_IDS, false) && !OPEN_OVERFLOW.load(Ordering::Relaxed)
+}
+
+/// Whether the command buffer `id`, whose encoder left a standing, has committed (or gone).
+fn was_committed(id: u64) -> bool {
+    if open_exact() {
+        !open_ids().lock().unwrap().contains(&id)
+    } else {
+        committed_ids().lock().unwrap().contains(&id)
+    }
+}
+
+/// Note an encoder of the command buffer `id` left a standing while it encodes.
+fn note_open(id: u64) {
+    if !crate::live::on(OPEN_IDS, false) || committed_ids().lock().unwrap().contains(&id) {
+        return;
+    }
+    let mut open = open_ids().lock().unwrap();
+    if open.len() >= OPEN_KEPT {
+        OPEN_OVERFLOW.store(true, Ordering::Relaxed);
+        return;
+    }
+    open.insert(id);
+}
+
+/// LOCAL (Atlas): the command buffer `id` went without a commit: it holds no standing open.
+pub(crate) fn dropped(id: u64) {
+    open_ids().lock().unwrap().remove(&id);
+}
+
