From: macbox <macbox@localhost>
Date: Tue, 3 Nov 2026 18:36:18 +0000
Subject: [PATCH 28/34] coherent lanes: a standing after a wait and a later GPU
 write through another import (path 4)

Six lanes: a command buffer waits for a shared event, then blends nothing over the whole
surface (its encoder takes the image's standing as it is encoded; "own": after a pass of its
own over a row). Encoded after it, on another queue, a command buffer writes texels of the
surface through another import (a second MTLTexture over the IOSurface, or an MTLBuffer of its
own over the pages, by a blit); the event is set after that write, by the writer on the GPU or
by the CPU once it completed. Metal orders the write before the blend through the event alone.

At bc15b13e four of six fail (lanes-p4a, 2026-11-03 18:27Z): the buffer write (both signals,
own too) and the texture write signalled by the GPU leave the blend out of the pages, its
alpha 255 at (0,0); the write through the other import is in the pages, as the blend's record
never reached them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/runtime_lane/surface_coherent.rs      | 111 ++++++++++++++++++
 1 file changed, 111 insertions(+)

diff --git a/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs b/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
index d8070e0c..15551a37 100644
--- a/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
+++ b/crates/metal2vulkan-validation/src/runtime_lane/surface_coherent.rs
@@ -1836,3 +1836,114 @@ fn surface_coherent_a_late_copy_in_keeps_the_command_buffers_own_writes() {
     });
 }
 
+
+/// What writes the surface's bytes through another import in [`gpu_write_through_another_import`].
+#[derive(Clone, Copy, Debug)]
+enum OtherImport {
+    /// A second `MTLTexture` over the IOSurface, which draws.
+    Texture,
+    /// An `MTLBuffer` of its own over the pages, which a blit writes.
+    Buffer,
+}
+
+/// The fourth path the late copies in left (`shadow::LateCopies`): a command buffer waits for a
+/// shared event and then blends nothing over the whole surface, so its encoder took the image's
+/// standing as it was encoded (`own`: after a pass of its own over a row, whose standing it then
+/// takes). Encoded after it, on another queue, a command buffer writes texels of the surface
+/// through another import; the event is set after that write (`by_gpu`: signalled by the writer
+/// on the GPU, else by the CPU once the writer completed). Metal orders the write before the
+/// blend through the event alone, so the blend keeps it, and the pass before the wait stays too.
+fn gpu_write_through_another_import(import: OtherImport, own: bool, by_gpu: bool) {
+    on_surface(true, |case| {
+        let second = matches!(import, OtherImport::Texture).then(|| case.second_texture());
+        let other_buffer = matches!(import, OtherImport::Buffer).then(|| case.other_import());
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        if own {
+            case.pass(&waiting, GREEN, scissor(0, 7, 64, 1));
+        }
+        blend_after(&case, &waiting, &hold, None);
+        waiting.commit().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let writer = other.command_buffer().unwrap();
+        let wrote = match import {
+            OtherImport::Texture => {
+                let blue = staged(case.device, &floats4([0.0, 0.0, 1.0, 1.0]));
+                let rects = std::slice::from_ref(&case.rect);
+                let second = second.as_ref().unwrap();
+                pass(&writer, second, &case.opaque, rects, &blue, scissor(0, 100, 16, 1));
+                [255, 0, 0, 0]
+            }
+            OtherImport::Buffer => {
+                let bytes: Vec<u8> = (0..16).flat_map(|_| [1u8, 2, 3, 4]).collect();
+                let source = staged(case.device, &bytes);
+                let mut blit = writer.blit_command_encoder().unwrap();
+                let to = other_buffer.as_ref().unwrap();
+                blit.copy_from_buffer_to_buffer(&source, 0, to, 100 * ROW, 64).unwrap();
+                blit.end_encoding().unwrap();
+                [1, 2, 3, 0]
+            }
+        };
+        if by_gpu {
+            writer.encode_signal_event((&hold).into(), 1).unwrap();
+        }
+        writer.commit().unwrap();
+        let mut writer_first = true;
+        if !by_gpu {
+            writer_first = writer.wait_until_completed_for(SOON).is_ok();
+            hold.set_signaled_value(1);
+        }
+        for command_buffer in [&writer, &waiting] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        let counts = shadow_coherent::fallback_counts();
+        eprintln!("PATH4 report {}", shadow_coherent::report("p4"));
+        eprintln!(
+            "PATH4 {import:?} own={own} by_gpu={by_gpu} writer_first={writer_first} \
+             late={} busy={} (9,100)={:?} (8,7)={:?} (0,0)={:?} behind(9,100)={:?}",
+            counts.late_copies_in,
+            counts.late_copies_in_busy,
+            case.read(9, 100),
+            case.read(8, 7),
+            case.read(0, 0),
+            case.behind(9, 100),
+        );
+        assert!(writer_first, "Metal orders nothing between the two but the event");
+        assert_eq!(case.read(9, 100), wrote, "the write through the other import");
+        let first = if own { [0, 255, 0, 0] } else { [0, 0, 255, 0] };
+        assert_eq!(case.read(8, 7), first, "the pass before the wait");
+        assert_eq!(case.read(0, 0), [0, 0, 255, 0], "the older texels");
+    });
+}
+
+#[test]
+fn surface_coherent_a_standing_after_a_wait_keeps_a_later_texture_write_before_the_signal() {
+    gpu_write_through_another_import(OtherImport::Texture, false, false);
+}
+
+#[test]
+fn surface_coherent_a_standing_after_a_wait_keeps_a_later_texture_write_signalled_by_the_gpu() {
+    gpu_write_through_another_import(OtherImport::Texture, false, true);
+}
+
+#[test]
+fn surface_coherent_an_own_standing_after_a_wait_keeps_a_later_texture_write() {
+    gpu_write_through_another_import(OtherImport::Texture, true, false);
+}
+
+#[test]
+fn surface_coherent_a_standing_after_a_wait_keeps_a_later_buffer_write_before_the_signal() {
+    gpu_write_through_another_import(OtherImport::Buffer, false, false);
+}
+
+#[test]
+fn surface_coherent_a_standing_after_a_wait_keeps_a_later_buffer_write_signalled_by_the_gpu() {
+    gpu_write_through_another_import(OtherImport::Buffer, false, true);
+}
+
+#[test]
+fn surface_coherent_an_own_standing_after_a_wait_keeps_a_later_buffer_write() {
+    gpu_write_through_another_import(OtherImport::Buffer, true, true);
+}
