@@ -923,3 +923,18 @@ pub(crate) fn pass_label(
         extent,
     }
 }
+
+/// LOCAL (Atlas) diagnostic: `image` as the pass timer names a copy's (`pass_times.rs`): its
+/// extent, usage bits and purpose, where the registry knows it.
+pub(crate) fn image_note(image: vk::Image) -> String {
+    match registry().images.get(&image.as_raw()) {
+        Some(e) => format!(
+            "{}x{}:u{:x}:{}",
+            e.extent.width,
+            e.extent.height,
+            e.usage.as_raw(),
+            e.purpose
+        ),
+        None => format!("{:#x}?", image.as_raw()),
+    }
+}
