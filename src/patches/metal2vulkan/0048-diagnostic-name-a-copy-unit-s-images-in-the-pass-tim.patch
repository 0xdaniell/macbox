+/// Before a copy into `dst` (from `src`, an image or null) of `count` regions, the first of
+/// `extent`: its description, for the unit it opens, where any capture is live.
+pub(crate) fn copy_note(src: vk::Image, dst: vk::Image, count: u32, extent: Option<(u32, u32)>) {
+    if LIVE.load(Ordering::Relaxed) == 0 {
+        return;
+    }
+    let (w, h) = extent.unwrap_or((0, 0));
+    let from = match src == vk::Image::null() {
+        true => "buffer".to_owned(),
+        false => image_log::image_note(src),
+    };
+    let note = format!("{count}r:{w}x{h}:{from}>{}", image_log::image_note(dst));
+    COPY_NOTE.with(|n| *n.borrow_mut() = Some(note));
+}
