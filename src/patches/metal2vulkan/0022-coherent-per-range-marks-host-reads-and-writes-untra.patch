+        shadow_coherent::unmapped(case.range());
+        case.fake.unmapped();
+        case.texture = None;
+        case.mapping.fill(BEFORE);
+        let bytes = case.other_import();
+        let mut d = TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, WIDTH, HEIGHT, false);
+        d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+        d.resource_options = bytes.resource_options();
+        let plane = IoSurfacePlane::new(0, ROW, false);
+        case.texture = Some(bytes.new_texture_with_iosurface_plane(&d, plane).unwrap());
+        let before = shadow_coherent::fallback_counts();
+        case.draw(GREEN, scissor(0, 0, 8, 8));
+        let after = shadow_coherent::fallback_counts();
+        assert_eq!(after.closed_by_overlap, before.closed_by_overlap, "the old one left no claim");
+        assert!(case.fake.armed_pages() > 0, "the new surface traps");
+        assert_eq!(case.read(1, 1), GREEN_TEXEL);
+        assert_eq!(case.read(100, 100), [BEFORE; 4], "and none of the old one's writes came back");
+    });
+}
+
+/// A reader of the pages on another device (another task's, as `device_lend` makes): its commit
+/// must bring what lies ahead, as one on the writer's device does.
+#[test]
+fn surface_coherent_a_reader_on_another_device_reads_the_writes() {
+    on_surface(true, |case| {
+        let cache = ScratchCache::new().unwrap();
+        let messages = Messages::default();
+        let other = validated_device_with(TEST_DEVICE, &messages, cache.path(), |o| {
+            o.policy.host_page_textures = HostPageTexturePolicy::InPlace;
+        })
+        .unwrap();
+        case.draw(RED, None);
+        let bytes = surface_buffer(&other, &case.mapping, case.len);
+        let queue = other.new_command_queue().unwrap();
+        assert_eq!(gpu_read(&queue, &bytes, 0..4), RED_TEXEL);
+        drop(bytes);
+        drop(queue);
+        drop(other);
+        let reported = messages.take();
+        assert!(reported.is_empty(), "the layer reported: {reported:#?}");
+    });
+}
