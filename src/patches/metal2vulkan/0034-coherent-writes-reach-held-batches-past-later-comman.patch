+/// The event separates the GPU write from a CPU write that restores its original value.
+#[test]
+fn surface_coherent_a_cpu_write_restoring_the_old_value_after_a_gpu_signal_is_visible() {
+    on_surface(true, |case| {
+        live::set("surface_coherent_hold_s", Some("0"));
+        live::set("surface_coherent_demote", Some("0"));
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let old = [1, 2, 3, 4];
+        case.write(9, 100, old);
+        let signal = case.device.new_shared_event().unwrap();
+        let hold = case.device.new_shared_event().unwrap();
+        let command = case.queue.command_buffer().unwrap();
+        let deferred = shadow_lazy::ahead_counts().deferred;
+        case.pass(&command, GREEN, scissor(9, 100, 1, 1));
+        assert!(shadow_lazy::ahead_counts().deferred > deferred, "GPU write must stay in the shadow");
+        command.encode_signal_event((&signal).into(), 1).unwrap();
+        blend_after(&case, &command, &hold, scissor(0, 64, WIDTH, HEIGHT - 64));
+        command.commit().unwrap();
+        assert!(signal.wait_until_signaled_value(1, SOON), "GPU write reached the signal");
+        case.write(9, 100, old);
+        hold.set_signaled_value(1);
+        command.wait_until_completed_for(SOON).unwrap();
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "the later CPU write under the blend");
+    });
+}
