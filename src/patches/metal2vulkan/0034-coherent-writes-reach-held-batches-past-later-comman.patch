+/// A GPU write through another import invalidates the standing before a later command buffer
+/// of the held batch's queue is encoded. Both writes precede the held batch's signal.
+#[test]
+fn surface_coherent_a_cpu_write_reaches_a_held_batch_when_the_later_standing_was_invalidated() {
+    on_surface(true, |case| {
+        let other_buffer = case.other_import();
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        blend_after(&case, &waiting, &hold, scissor(0, 64, WIDTH, HEIGHT - 64));
+        waiting.commit().unwrap();
+        case.write(9, 100, [1, 2, 3, 4]);
+        let other = case.device.new_command_queue().unwrap();
+        let writer = other.command_buffer().unwrap();
+        let source = staged(case.device, &[9u8, 8, 7, 6]);
+        let mut blit = writer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&source, 0, &other_buffer, 200 * ROW + 9 * 4, 4).unwrap();
+        blit.end_encoding().unwrap();
+        writer.commit().unwrap();
+        writer.wait_until_completed_for(SOON).unwrap();
+        let after = case.queue.command_buffer().unwrap();
+        case.pass(&after, GREEN, scissor(0, 7, 64, 1));
+        after.commit().unwrap();
+        hold.set_signaled_value(1);
+        waiting.wait_until_completed_for(SOON).unwrap();
+        after.wait_until_completed_for(SOON).unwrap();
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "CPU write under the blend");
+        assert_eq!(case.read(9, 200), [9, 8, 7, 0], "other import under the blend");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the later draw");
+    });
+}
