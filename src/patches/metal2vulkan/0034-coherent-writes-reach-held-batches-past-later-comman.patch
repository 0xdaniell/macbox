+/// A held batch whose encoder left no record: a CPU write just before it, within the hold, makes
+/// the surface keep and merge instead of deferring (`Coherent::wants_merge`; else
+/// `Fallback::DeferWrote`), so the blend copies back as it goes. A
+/// second CPU write made while the batch waits, then a later command buffer of its queue over
+/// another row, committed before the signal: the blend sees both writes, under it, not lost to
+/// the eager copy back or to the later command buffer's take.
+#[test]
+fn surface_coherent_a_cpu_write_reaches_a_held_batch_whose_blend_left_no_record() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        case.write(9, 100, [1, 2, 3, 4]);
+        let defers = case.count("defers");
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        blend_after(&case, &waiting, &hold, scissor(0, 64, WIDTH, HEIGHT - 64));
+        waiting.commit().unwrap();
+        let records = case.count("defers") - defers;
+        case.write(9, 101, [5, 6, 7, 8]);
+        let after = case.queue.command_buffer().unwrap();
+        case.pass(&after, GREEN, scissor(8, 7, 1, 1));
+        after.commit().unwrap();
+        hold.set_signaled_value(1);
+        for command_buffer in [&waiting, &after] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        eprintln!(
+            "NO-RECORD records {records} (9,100)={:?} (9,101)={:?} (8,7)={:?}",
+            case.read(9, 100),
+            case.read(9, 101),
+            case.read(8, 7)
+        );
+        assert_eq!(records, 0, "the write within the hold left the blend no record");
+        assert_eq!(case.read(9, 101), [5, 6, 7, 0], "the write while held, under the blend");
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "the write before, under the blend");
+        assert_eq!(case.read(0, 100), [0, 0, 255, 0], "the older texels, blended");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the later draw");
+    });
+}
+
+/// A done record whose rectangle bounds texels it never wrote: one encoder on another queue
+/// draws at (0,100) and (20,100), the CPU wrote (9,100) before. A held command buffer of that
+/// queue keeps a record of its own running, so the next take on the first queue (a draw at
+/// (8,7)) syncs the done record while another batch is held: its copy back of the rectangle must
+/// not put the image's older bytes over the CPU write between the two draws.
+#[test]
+fn surface_coherent_a_cpu_write_survives_a_done_record_synced_by_a_later_take() {
+    on_surface(true, |case| {
+        // Defer at once, a CPU write just before or not: the draws leave records.
+        live::set("surface_coherent_hold_s", Some("0"));
+        live::set("surface_coherent_demote", Some("0"));
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        case.write(9, 100, [1, 2, 3, 4]);
+        let other = case.device.new_command_queue().unwrap();
+        let green = staged(case.device, &floats4(GREEN));
+        let two = other.command_buffer().unwrap();
+        let mut descriptor = RenderPassDescriptor::new();
+        let attachment = &mut descriptor.color_attachments[0];
+        attachment.texture = case.texture.clone();
+        attachment.load_action = LoadAction::Load;
+        attachment.store_action = StoreAction::Store;
+        let mut encoder = two.render_command_encoder(&descriptor).unwrap();
+        encoder.set_render_pipeline_state(&case.opaque).unwrap();
+        encoder.set_fragment_buffer(Some(&green), 0, 0).unwrap();
+        encoder.set_vertex_buffer(Some(&case.rect), 0, 0).unwrap();
+        for x in [0, 20] {
+            encoder.set_scissor_rect(ScissorRect { x, y: 100, width: 1, height: 1 }).unwrap();
+            encoder.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0).unwrap();
+        }
+        encoder.end_encoding().unwrap();
+        two.commit().unwrap();
+        two.wait_until_completed_for(SOON).unwrap();
+        let gate = case.device.new_shared_event().unwrap();
+        let held = other.command_buffer().unwrap();
+        held.encode_wait_for_event((&gate).into(), 1).unwrap();
+        case.pass(&held, GREEN, scissor(0, 200, 16, 1));
+        held.commit().unwrap();
+        let later = case.queue.command_buffer().unwrap();
+        case.pass(&later, GREEN, scissor(8, 7, 1, 1));
+        later.commit().unwrap();
+        gate.set_signaled_value(1);
+        for command_buffer in [&held, &later] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        eprintln!(
+            "DONE-RECORD (9,100)={:?} behind={:?} (0,100)={:?} (20,100)={:?}",
+            case.read(9, 100),
+            case.behind(9, 100),
+            case.read(0, 100),
+            case.read(20, 100)
+        );
+        assert_eq!(case.read(9, 100), [1, 2, 3, 4], "the CPU write between the two draws");
+        assert_eq!(case.read(0, 100), GREEN_TEXEL, "the first draw");
+        assert_eq!(case.read(20, 100), GREEN_TEXEL, "the second draw");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the later take's draw");
+        assert_eq!(case.read(9, 200), GREEN_TEXEL, "the held draw");
+    });
+}
