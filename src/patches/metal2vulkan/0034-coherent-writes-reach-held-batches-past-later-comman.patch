+/// The bytes at `at` of a `Shared` buffer no command uses now.
+fn shared_texel(buffer: &Buffer, at: usize) -> [u8; 4] {
+    // SAFETY: a `Shared` buffer of at least `at + 4` bytes, no command using it.
+    let bytes = unsafe { std::slice::from_raw_parts(buffer.contents().unwrap().as_ptr(), at + 4) };
+    bytes[at..at + 4].try_into().unwrap()
+}
