+        assert!(before_signal, "the read waits for nothing held");
+        assert_eq!(read, GREEN_TEXEL, "the read saw the draw before it on its queue");
+        assert_eq!(case.read(0, 7), [0, 255, 0, 0], "the blend after the signal, over the draw");
+        assert_eq!(case.read(1, 7), [0, 0, 255, 0], "the older texels, blended");
+    });
