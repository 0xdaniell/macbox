+/// A held batch's blend has a record running; then the standing is refused for a reason other
+/// than a write (`shadow_lazy`'s `EPOCH` moved: a CPU upload into an unrelated texture, the
+/// switch `surface_lazy_scoped` off), with a CPU write open. The next encoder of the queue copies
+/// in the whole surface: it must neither wait out the held record (a bounded wait of ~50 ms)
+/// nor lose the blend or the CPU write (the guest area kept for the held batch, `held_guest`).
+#[test]
+fn surface_coherent_a_refused_standing_past_a_held_batch_keeps_its_blend() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        blend_after(&case, &waiting, &hold, scissor(0, 64, WIDTH, HEIGHT - 64));
+        waiting.commit().unwrap();
+        case.write(9, 100, [1, 2, 3, 4]);
+        // Refuse the standing by the epoch: an upload into a texture over no surface, unscoped.
+        let unrelated = case
+            .device
+            .new_texture(&TextureDescriptor::texture_2d(PixelFormat::BGRA8Unorm, 4, 4, false))
+            .unwrap();
+        live::set("surface_lazy_scoped", None);
+        unrelated.replace_region(Region::new_2d(0, 0, 1, 1), 0, 0, &[7u8; 4], 4, 0).unwrap();
+        live::set("surface_lazy_scoped", Some("1"));
+        let green = staged(case.device, &floats4(GREEN));
+        let rects = std::slice::from_ref(&case.rect);
+        let after = case.queue.command_buffer().unwrap();
+        let start = Instant::now();
+        pass(&after, case.texture(), &case.opaque, rects, &green, scissor(0, 7, 64, 1));
+        after.commit().unwrap();
+        let spent = start.elapsed();
+        hold.set_signaled_value(1);
+        for command_buffer in [&waiting, &after] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
+        }
+        eprintln!(
+            "REFUSED-PAST-HELD spent={spent:?} (9,100)={:?} (0,100)={:?} (8,7)={:?} report {}",
+            case.read(9, 100),
+            case.read(0, 100),
+            case.read(8, 7),
+            shadow_coherent::report("refused")
+        );
+        assert_eq!(case.read(9, 100), [1, 2, 3, 0], "the CPU write, under the blend");
+        assert_eq!(case.read(0, 100), [0, 0, 255, 0], "the held blend");
+        assert_eq!(case.read(8, 7), GREEN_TEXEL, "the later draw");
+        assert!(spent < Duration::from_millis(25), "the later encoder waited {spent:?}");
+    });
+}
