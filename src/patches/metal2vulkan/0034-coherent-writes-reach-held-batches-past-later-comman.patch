+/// A read through another import, on another queue, of a texel a draw of that queue wrote just
+/// before, while a batch of the first queue is held for an event with a blend over the surface:
+/// nothing waits for the held batch, so the read completes before the signal and sees the draw.
+/// The planned write's copy back must not wait behind, or be lost to, the held record.
+#[test]
+fn surface_coherent_an_import_read_past_a_held_batch_sees_a_planned_write() {
+    on_surface(true, |case| {
+        let other_buffer = case.other_import();
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let hold = case.device.new_shared_event().unwrap();
+        let waiting = case.queue.command_buffer().unwrap();
+        blend_after(&case, &waiting, &hold, None);
+        waiting.commit().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let drawn = other.command_buffer().unwrap();
+        case.pass(&drawn, GREEN, scissor(0, 7, 1, 1));
+        let staging = case.device.new_buffer(4, ResourceOptions::shared()).unwrap();
+        let reader = other.command_buffer().unwrap();
+        let mut blit = reader.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&other_buffer, 7 * ROW, &staging, 0, 4).unwrap();
+        blit.end_encoding().unwrap();
+        drawn.commit().unwrap();
+        reader.commit().unwrap();
+        let before_signal = reader.wait_until_completed_for(SOON).is_ok();
+        let read = shared_texel(&staging, 0);
+        hold.set_signaled_value(1);
+        for command_buffer in [&drawn, &reader, &waiting] {
+            command_buffer.wait_until_completed_for(SOON).unwrap();
