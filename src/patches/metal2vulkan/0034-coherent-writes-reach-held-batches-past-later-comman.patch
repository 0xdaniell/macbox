+        let staging = case.device.new_buffer(4, ResourceOptions::shared()).unwrap();
+        let reader = case.queue.command_buffer().unwrap();
+        let mut blit = reader.blit_command_encoder().unwrap();
+        blit.copy_from_texture_to_buffer(
