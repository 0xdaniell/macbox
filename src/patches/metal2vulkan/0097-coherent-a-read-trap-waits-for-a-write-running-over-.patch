+++ b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
@@ -598,6 +598,12 @@ struct Counts {
     merges: AtomicU64,
     came: AtomicU64,
     refused_reads: AtomicU64,
+    /// LOCAL (Atlas): read traps that found a write running over the surface and waited for it
+    /// (`surface_coherent_trap_wait`, [`Coherent::fault`]), those the bound cut short, and the ns
+    /// they waited.
+    trap_waits: AtomicU64,
+    trap_wait_timeouts: AtomicU64,
+    trap_wait_ns: AtomicU64,
     flushes: AtomicU64,
     flushed_bytes: AtomicU64,
     copy_ins: AtomicU64,
@@ -1312,6 +1318,32 @@ impl Coherent {
             self.counts.unique_pages.fetch_add(1, Ordering::Relaxed);
         }
         self.sync_done(&mut state, SyncBy::Trap);
+        // LOCAL (Atlas): a read that finds a write running over the surface waits for it, a bounded
+        // time, and takes it too, as IOSurfaceLock waits for the GPU's pending writes on a Mac.
+        // Without it the read takes the completed frame while the next one runs; that one's
+        // completion arms the pages again, and the rest of the read, a few ms later, traps into the
+        // newer frame: one screenshot of two frames, split at a page (a Simulator screen read while
+        // it is rendered). A record held for an event is not waited for: its signal may come from
+        // the guest. Live switch `surface_coherent_trap_wait=1`; off, a read takes what completed.
+        if !write && crate::live::on("surface_coherent_trap_wait", false) {
+            let whole = self.layout.whole();
+            let running = (state.running.iter())
+                .any(|record| meet(record.area, whole) && !Self::held_for_event(&state, record.id));
+            if running {
+                let start = Instant::now();
+                self.counts.trap_waits.fetch_add(1, Ordering::Relaxed);
+                let (settled, clear) = self.wait_settled(state, Some(whole), true);
+                state = settled;
+                if !clear {
+                    self.counts.trap_wait_timeouts.fetch_add(1, Ordering::Relaxed);
+                }
+                self.counts.trap_wait_ns.fetch_add(start.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                if !state.tracked {
+                    return;
+                }
+                self.sync_done(&mut state, SyncBy::Trap);
+            }
+        }
         let mark = pages();
         // Another vCPU's probe may be about to rerun on these pages: only the last of them, which
         // lets it name its page, ends the probing.
@@ -2146,7 +2178,7 @@ impl Coherent {
