diff --git a/crates/metal2vulkan-runtime/src/tests/coherent_trap_wait.rs b/crates/metal2vulkan-runtime/src/tests/coherent_trap_wait.rs
new file mode 100644
index 000000000..61a354005
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/coherent_trap_wait.rs
@@ -0,0 +1,98 @@
+//! LOCAL (Atlas): a CPU read trap of a trapping surface while the next frame's write runs over it
+//! (`shadow_coherent::Coherent::fault`, live `surface_coherent_trap_wait`). No GPU: the surface's
+//! image is a frame number its reader writes into every texel, and the marks are a stub.
+
+use crate::shadow_coherent::{self, Coherent, Layout, Pages};
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+use std::time::Duration;
+
+/// The marks: everything given, nothing refused.
+struct Marks;
+
+impl Pages for Marks {
+    fn track(&self, _: u64, _: u64) -> bool {
+        true
+    }
+    fn untrack(&self, _: u64) {}
+    fn arm(&self, _: &[u64]) -> Vec<u64> {
+        Vec::new()
+    }
+    fn hold(&self, _: &[u64], _: bool) -> Vec<u64> {
+        Vec::new()
+    }
+    fn probe(&self, _: &[u64]) -> Vec<u64> {
+        Vec::new()
+    }
+    fn open(&self, _: &[u64]) {}
+    fn freeze(&self, _: &[u64]) {}
+    fn thaw(&self, _: &[u64]) {}
+}
+
+const PAGE: u64 = 4096;
+/// One page a row: 1024 texels of 4 bytes, 8 rows.
+const ROWS: u32 = 8;
+static SERIAL: Mutex<()> = Mutex::new(());
+
+/// A read of the surface's first and last rows as frame 1 has completed and frame 2 runs over the
+/// whole surface, completing 20 ms after the first page traps: the frame each row shows.
+fn read_while_the_next_frame_runs(wait: bool, ids: [u64; 2]) -> [u8; 2] {
+    // Kept for the process: the surface stays in the list of tracked ones, by its address.
+    let memory: &'static mut [u8] = Box::leak(vec![0u8; ((ROWS as u64 + 1) * PAGE) as usize].into_boxed_slice());
+    let base = (memory.as_ptr() as u64).next_multiple_of(PAGE);
+    let layout = Layout { base, row: PAGE, texel: 4, width: 1024, height: ROWS };
+    let frame = Arc::new(AtomicU8::new(1));
+    let image = frame.clone();
+    let reader = Box::new(move |area: [u32; 4], to: *mut u8, row_texels: u32| {
+        let value = image.load(Ordering::SeqCst);
+        for y in 0..(area[3] - area[1]) as usize {
+            let width = ((area[2] - area[0]) * 4) as usize;
+            // SAFETY: `to` is the area's first texel in the surface's rows, which the test owns.
+            unsafe { std::ptr::write_bytes(to.add(y * row_texels as usize * 4), value, width) };
+        }
+        true
+    });
+    crate::live::set("surface_coherent", Some("1"));
+    crate::live::set("surface_coherent_trap_wait", wait.then_some("1"));
+    shadow_coherent::set_pages(Some(Arc::new(Marks)));
+    let surface = Coherent::new(layout, reader, Weak::new());
+    assert!(surface.tracks());
+    let [first, second] = ids;
+    assert!(surface.defers(first, None));
+    surface.committed(first);
+    surface.completing(first);
+    assert!(surface.defers(second, None));
+    surface.committed(second);
+    let running = surface.clone();
+    let gpu = std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_millis(20));
+        frame.store(2, Ordering::SeqCst);
+        running.completing(second);
+    });
+    let row = |y: u64| -> u8 {
+        // SAFETY: inside the surface's rows.
+        unsafe { *((base + y * PAGE) as *const u8) }
+    };
+    shadow_coherent::fault(base, false);
+    let top = row(0);
+    gpu.join().unwrap();
+    // The rest of the read reaches the last page: armed again where frame 2 completed meanwhile.
+    shadow_coherent::fault(base + u64::from(ROWS - 1) * PAGE, false);
+    let bottom = row(u64::from(ROWS - 1));
+    crate::live::set("surface_coherent_trap_wait", None);
+    crate::live::set("surface_coherent", None);
+    shadow_coherent::set_pages(None);
+    [top, bottom]
+}
+
+#[test]
+fn a_read_that_takes_only_completed_frames_tears_at_a_page() {
+    let _one = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    assert_eq!(read_while_the_next_frame_runs(false, [u64::MAX - 101, u64::MAX - 102]), [1, 2]);
+}
+
+#[test]
+fn a_read_waits_for_the_frame_running_and_shows_one() {
+    let _one = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+    assert_eq!(read_while_the_next_frame_runs(true, [u64::MAX - 103, u64::MAX - 104]), [2, 2]);
+}
