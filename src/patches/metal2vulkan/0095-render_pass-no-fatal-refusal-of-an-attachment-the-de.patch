+//! Color attachments whose image the device makes no attachment of, as a pass takes them.
+//!
+//! - **A texture without `RenderTarget` usage of a format the device renders through its word**
+//!   (`metal::format::WordAttachment`: `RGB9E5Float`, the 8-bit sRGB and packed 16-bit formats on
+//!   a device that samples them and does not render them, `E5B9G9R9_UFLOAT_PACK32` and `R8_SRGB`
+//!   on ANV) renders through a stand-in in the word's format (`render_pass::stood_format`), as a
+//!   texture of the format with `RenderTarget` usage renders through its word view: a pass that
+//!   loads, clears and draws leaves the two textures the same bytes. A stand-in in the image's own
+//!   format was an image the device makes none of, and the pass was refused naming an image size
+//!   limit of 0 (`TextureSize`, `MaxImageDimension2D` available 0), which ended a QEMU vGPU host.
+//! - **A texture of a compressed format** (BC, ETC2, EAC, ASTC, PVRTC), with `RenderTarget` usage
+//!   or without, as a color attachment: the encoder is answered nil
+//!   (`RenderPassProblem::CompressedColorAttachment`), and the command buffer goes on: a pass after
+//!   it on the same command buffer runs, and the command buffer completes.
+//! - **No pass is refused naming an image limit of 0**: every color format, at 1 and 4 samples and
+//!   with and without `RenderTarget` usage, opens, is answered nil, or is refused naming what the
+//!   device lacks.
+//!
+//! A device test: compiled only under the validation crate's GPU safety cfgs (`m2v_gpu`,
+//! `m2v_cpu_icd`), on the kind of device the cfg selects, asking for the validation layer: an
+//! attachment view of a format the device does not render, or a copy between images it does not
+//! copy, is a failing message. What the claim of the layer's silence holds is what the device's
+//! instance enabled of the layer it asked for (`tests/layer_claim.rs`). The render pipeline is the
+//! owned fixture `validation/fixtures/public/examples/runtime_examples.ll` (`llvm-as`), as the
+//! examples run it.
+
+use super::blit_holds::WAIT;
+use super::layer_claim::Watched;
+use crate::render_pass::RenderPassProblem;
+use crate::{
+    BlitOption, Buffer, ClearColor, CommandBufferStatus, Device, DeviceKind, DeviceOptions, Error,
+    LoadAction, Origin, PipelineOptions, Problem, RenderPassDescriptor, RenderPipelineState,
+    ResourceOptions, ShaderCacheOptions, Size, StoreAction, Texture, TextureDescriptor,
+};
+use metal2vulkan::metal::format::{block_extent, is_depth_stencil, WordAttachment};
+use metal2vulkan::metal::{PixelFormat, PrimitiveType, TextureType, TextureUsage};
+use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
+use std::path::{Path, PathBuf};
+
+/// The attachments' side.
+const SIDE: u32 = 16;
+
+/// The formats with a word layout (`WordAttachment::layout`), and their bytes a texel.
+const WORDS: [(PixelFormat, u32); 8] = [
+    (PixelFormat::RGB9E5Float, 4),
+    (PixelFormat::R8UnormSRGB, 1),
+    (PixelFormat::RG8UnormSRGB, 2),
+    (PixelFormat::B5G6R5Unorm, 2),
+    (PixelFormat::A1BGR5Unorm, 2),
+    (PixelFormat::ABGR4Unorm, 2),
+    (PixelFormat::BGRA4Unorm, 2),
+    (PixelFormat::BGR5A1Unorm, 2),
+];
+
+/// A scratch directory for the device's shader cache, removed when dropped.
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new() -> Scratch {
+        let path = std::env::temp_dir().join(format!(
+            "m2v-unrenderable-attachments-{}-{:?}",
+            std::process::id(),
+            std::thread::current().id()
+        ));
+        std::fs::create_dir_all(&path).unwrap();
+        Scratch(path)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// The device the cfg selects, its shader cache in `cache`, asking for the validation layer, and
+/// what its instance had the layer report.
+fn watched(cache: &Path) -> (Device, Watched) {
+    let watched = Watched::default();
+    let sink = watched.sink(|_| {});
+    let options = DeviceOptions {
+        kinds: match cfg!(m2v_cpu_icd) {
+            true => vec![DeviceKind::Cpu],
+            false => vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ],
+        },
+        shader_cache: ShaderCacheOptions {
+            directory: Some(cache.to_owned()),
+            ..ShaderCacheOptions::default()
+        },
+        layers: watched.layers(),
+        messages: Some(sink),
+        ..DeviceOptions::default()
+    };
+    let device = Device::system_default_with(&options).unwrap();
+    (device, watched)
+}
+
+/// A private 2D texture of `pf`, `side` square, of `samples` and `usage`, where the device makes
+/// one.
+fn texture(
+    device: &Device,
+    pf: PixelFormat,
+    side: u32,
+    samples: u32,
+    usage: TextureUsage,
+) -> Option<Texture> {
+    device
+        .new_texture(&TextureDescriptor {
+            texture_type: match samples {
+                1 => TextureType::Type2D,
+                _ => TextureType::Type2DMultisample,
+            },
+            pixel_format: pf,
+            width: side.into(),
+            height: side.into(),
+            sample_count: samples.into(),
+            usage,
+            resource_options: ResourceOptions::private(),
+            ..TextureDescriptor::default()
+        })
+        .ok()
+}
+
+/// A shared buffer of `values`.
+fn floats(device: &Device, values: impl IntoIterator<Item = f32>) -> Buffer {
+    let bytes: Vec<u8> = values.into_iter().flat_map(f32::to_le_bytes).collect();
+    device
+        .new_buffer_with_bytes(&bytes, ResourceOptions::shared())
+        .unwrap()
+}
+
+/// The fixture's render pipeline state: `colored_vertex` and `colored_fragment`, writing each
+/// vertex's color into a color 0 of `pf`.
+fn state(device: &Device, pf: PixelFormat) -> RenderPipelineState {
+    let ll = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/fixtures/public/examples/runtime_examples.ll");
+    let bitcode = metal2vulkan_devtools::llvm_assemble(&ll).unwrap();
+    let library = metal2vulkan::library::Library::from_air(&bitcode).unwrap();
+    let library = device.new_library_with_compile_library(library);
+    let vertex = library.new_function_with_name("colored_vertex").unwrap();
+    let fragment = library.new_function_with_name("colored_fragment").unwrap();
+    let mut descriptor =
+        RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+    descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+    descriptor.color_attachments[0] = Some(ColorAttachmentDescriptor::new(pf));
+    device
+        .new_render_pipeline_state(&descriptor, &PipelineOptions::default())
+        .unwrap()
+}
+
+/// Run `encode` on a command buffer of `device`'s `queue`, commit it and wait: it completes.
+fn run(queue: &crate::CommandQueue, what: &str, encode: impl FnOnce(&crate::CommandBuffer)) {
+    let command_buffer = queue.command_buffer().unwrap();
+    encode(&command_buffer);
+    command_buffer.commit().unwrap();
+    command_buffer.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(
+        command_buffer.status(),
+        CommandBufferStatus::Completed,
+        "{what}: {:?}",
+        command_buffer.error()
+    );
+}
+
+/// `texture`'s texels, `bytes` a texel, read by a blit.
+fn read(device: &Device, queue: &crate::CommandQueue, texture: &Texture, bytes: u32) -> Vec<u8> {
+    let row = u64::from(SIDE * bytes);
+    let len = row * u64::from(SIDE);
+    let out = device.new_buffer(len, ResourceOptions::shared()).unwrap();
+    run(queue, "the read", |command_buffer| {
+        let mut blit = command_buffer.blit_command_encoder().unwrap();
+        let whole = Size::new(SIDE.into(), SIDE.into(), 1);
+        blit.copy_from_texture_to_buffer(
+            texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            whole,
+            &out,
+            0,
+            row,
+            len,
+            BlitOption::None,
+        )
+        .unwrap();
+        blit.end_encoding().unwrap();
+    });
+    // SAFETY: the command buffer completed; nothing else writes the buffer.
+    unsafe { std::slice::from_raw_parts(out.contents().unwrap().as_ptr(), len as usize) }.to_vec()
+}
+
+/// Write `bytes`, a texel each `texel` bytes, into `texture` by a blit.
+fn write(
+    device: &Device,
+    queue: &crate::CommandQueue,
+    texture: &Texture,
+    texel: u32,
+    bytes: &[u8],
+) {
+    let row = u64::from(SIDE * texel);
+    let from = device
+        .new_buffer_with_bytes(bytes, ResourceOptions::shared())
+        .unwrap();
+    run(queue, "the write", |command_buffer| {
+        let mut blit = command_buffer.blit_command_encoder().unwrap();
+        let whole = Size::new(SIDE.into(), SIDE.into(), 1);
+        blit.copy_from_buffer_to_texture(
+            &from,
+            0,
+            row,
+            row * u64::from(SIDE),
+            whole,
+            texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            BlitOption::None,
+        )
+        .unwrap();
+        blit.end_encoding().unwrap();
+    });
+}
+
+/// A pass over `texture` as color 0, loading by `load`, that draws `state`'s quad over its left
+/// half in orange and stores it.
+fn draw_left_half(
+    device: &Device,
+    queue: &crate::CommandQueue,
+    texture: &Texture,
+    state: &RenderPipelineState,
+    load: LoadAction,
+) {
+    let positions = floats(
+        device,
+        [[-1.0, 1.0], [0.0, 1.0], [-1.0, -1.0], [0.0, -1.0]]
+            .into_iter()
+            .flatten(),
+    );
+    let colors = floats(device, (0..4).flat_map(|_| [1.0, 0.375, 0.125, 0.5]));
+    let mut pass = RenderPassDescriptor::new();
+    let color = &mut pass.color_attachments[0];
+    color.texture = Some(texture.clone());
+    color.load_action = load;
+    color.store_action = StoreAction::Store;
+    color.clear_color = ClearColor::new(0.25, 0.5, 0.75, 1.0);
+    run(queue, "the pass", |command_buffer| {
+        let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+        encoder.set_render_pipeline_state(state).unwrap();
+        encoder.set_vertex_buffer(Some(&positions), 0, 0).unwrap();
+        encoder.set_vertex_buffer(Some(&colors), 0, 1).unwrap();
+        encoder
+            .draw_primitives(PrimitiveType::TriangleStrip, 0, 4, 1, 0)
+            .unwrap();
+        encoder.end_encoding().unwrap();
+    });
+}
+
+/// A texture without `RenderTarget` usage of a format the device renders through its word renders
+/// as a render target of the format does: a pass that clears and draws, and one that loads and
+/// draws, leave it the bytes they leave the render target, the loaded texels untouched.
+#[test]
+fn a_texture_without_render_target_usage_renders_through_its_word() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let profile = device.compile_device().profile();
+    let mut worded = Vec::new();
+    for (pf, texel) in WORDS {
+        let Some(word) = WordAttachment::of(pf, profile) else {
+            eprintln!("{pf:?}: the device renders it, or holds no texture of it: not worded");
+            continue;
+        };
+        let stood = texture(&device, pf, SIDE, 1, TextureUsage::SHADER_READ).unwrap();
+        let target = texture(
+            &device,
+            pf,
+            SIDE,
+            1,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        )
+        .unwrap();
+        let state = state(&device, pf);
+        // Cleared and drawn: the clear's word right of the quad, the draw's left of it.
+        for t in [&stood, &target] {
+            draw_left_half(&device, &queue, t, &state, LoadAction::Clear);
+        }
+        let cleared = read(&device, &queue, &stood, texel);
+        assert_eq!(
+            cleared,
+            read(&device, &queue, &target, texel),
+            "{pf:?} through {:?}: cleared and drawn",
+            word.word_format()
+        );
+        let first = &cleared[..texel as usize];
+        let last = &cleared[cleared.len() - texel as usize..];
+        assert_ne!(first, last, "{pf:?}: the draw and the clear store apart");
+        // Loaded and drawn: every texel right of the quad keeps the bytes written before.
+        let pattern: Vec<u8> = (0..SIDE * SIDE * texel)
+            .map(|i| (i * 37 + 11) as u8)
+            .collect();
+        for t in [&stood, &target] {
+            write(&device, &queue, t, texel, &pattern);
+            draw_left_half(&device, &queue, t, &state, LoadAction::Load);
+        }
+        let loaded = read(&device, &queue, &stood, texel);
+        assert_eq!(
+            loaded,
+            read(&device, &queue, &target, texel),
+            "{pf:?}: loaded and drawn"
+        );
+        let row = (SIDE * texel) as usize;
+        for (at, (got, want)) in loaded.chunks(row).zip(pattern.chunks(row)).enumerate() {
+            assert_eq!(
+                got[row / 2..],
+                want[row / 2..],
+                "{pf:?}: row {at}, right of the quad"
+            );
+        }
+        worded.push(pf);
+    }
+    eprintln!("worded attachments without RenderTarget usage: {worded:?}");
+    drop((queue, device));
+    watched.layer_reported_nothing("every worded stand-in's pass was valid and nothing leaked");
+}
+
+/// The compressed formats checked: one of each family, and the ASTC format and extent of the
+/// texture whose refused pass ended a QEMU vGPU host.
+const COMPRESSED: [(PixelFormat, u32); 8] = [
+    (PixelFormat::ASTC8x8LDR, 1024),
+    (PixelFormat::ASTC4x4SRGB, 16),
+    (PixelFormat::BC7RGBAUnorm, 16),
+    (PixelFormat::BC1RGBA, 16),
+    (PixelFormat::ETC2RGB8, 16),
+    (PixelFormat::EACR11Unorm, 16),
+    (PixelFormat::PVRTCRGBA4BPP, 16),
+    (PixelFormat::BC6HRGBUfloat, 16),
+];
+
+/// A color attachment of a compressed format, with `RenderTarget` usage or without, at color 0 or
+/// beside another, is answered nil; a pass after it on the same command buffer runs, and the
+/// command buffer completes.
+#[test]
+fn a_compressed_color_attachment_is_answered_nil() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let plain = texture(
+        &device,
+        PixelFormat::RGBA8Unorm,
+        SIDE,
+        1,
+        TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+    )
+    .unwrap();
+    let mut answered = 0;
+    for (pf, side) in COMPRESSED {
+        for usage in [
+            TextureUsage::SHADER_READ,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        ] {
+            let Some(compressed) = texture(&device, pf, side, 1, usage) else {
+                eprintln!("{pf:?} {usage:?}: the device makes no such texture");
+                continue;
+            };
+            for index in [0usize, 1] {
+                let mut pass = RenderPassDescriptor::new();
+                if index == 1 {
+                    let first = &mut pass.color_attachments[0];
+                    first.texture = Some(plain.clone());
+                    first.load_action = LoadAction::Clear;
+                    first.store_action = StoreAction::Store;
+                }
+                let color = &mut pass.color_attachments[index];
+                color.texture = Some(compressed.clone());
+                color.load_action = LoadAction::Load;
+                color.store_action = StoreAction::Store;
+                let command_buffer = queue.command_buffer().unwrap();
+                match command_buffer.render_command_encoder(&pass) {
+                    Err(Error::Nil(nil)) => assert_eq!(
+                        nil.problem,
+                        Problem::RenderPass(RenderPassProblem::CompressedColorAttachment(
+                            crate::Attachment::Color(index as u32)
+                        )),
+                        "{pf:?} {usage:?} at {index}"
+                    ),
+                    Err(other) => panic!("{pf:?} {usage:?} at {index}: refused {other:?}"),
+                    Ok(_) => panic!("{pf:?} {usage:?} at {index}: an encoder"),
+                }
+                // The command buffer goes on: a pass of the plain texture after it runs.
+                let mut after = RenderPassDescriptor::new();
+                let color = &mut after.color_attachments[0];
+                color.texture = Some(plain.clone());
+                color.load_action = LoadAction::Clear;
+                color.store_action = StoreAction::Store;
+                color.clear_color = ClearColor::new(0.0, 1.0, 0.0, 1.0);
+                let encoder = command_buffer.render_command_encoder(&after).unwrap();
+                encoder.end_encoding().unwrap();
+                command_buffer.commit().unwrap();
+                command_buffer.wait_until_completed_for(WAIT).unwrap();
+                assert_eq!(
+                    command_buffer.status(),
+                    CommandBufferStatus::Completed,
+                    "{pf:?} {usage:?} at {index}: {:?}",
+                    command_buffer.error()
+                );
+                let cleared = read(&device, &queue, &plain, 4);
+                assert!(
+                    cleared.chunks(4).all(|t| t == [0, 255, 0, 255]),
+                    "{pf:?} {usage:?} at {index}: the pass after it cleared"
+                );
+                answered += 1;
+            }
+        }
+    }
+    assert!(answered > 0, "the device made no compressed texture");
+    drop((queue, device));
+    watched.layer_reported_nothing("no image was made for a compressed attachment's pass");
+}
+
+/// No color attachment's pass is refused naming an image limit of 0, the device's answer for an
+/// image it makes none of: every color format, at 1 and 4 samples, with and without
+/// `RenderTarget` usage, opens, is answered nil (a compressed format alone), or is refused
+/// naming what the device lacks.
+#[test]
+fn no_pass_is_refused_naming_an_image_limit_of_0() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let mut wrong = Vec::new();
+    let mut opened = 0;
+    for &pf in PixelFormat::ALL {
+        if is_depth_stencil(pf) {
+            continue;
+        }
+        for samples in [1, 4] {
+            for usage in [
+                TextureUsage::SHADER_READ,
+                TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+            ] {
+                let Some(t) = texture(&device, pf, SIDE, samples, usage) else {
+                    continue;
+                };
+                let mut pass = RenderPassDescriptor::new();
+                let color = &mut pass.color_attachments[0];
+                color.texture = Some(t);
+                color.load_action = LoadAction::DontCare;
+                color.store_action = StoreAction::Store;
+                let command_buffer = queue.command_buffer().unwrap();
+                match command_buffer.render_command_encoder(&pass) {
+                    Ok(encoder) => {
+                        encoder.end_encoding().unwrap();
+                        opened += 1;
+                    }
+                    Err(Error::Nil(_)) if block_extent(pf).is_some() => {}
+                    Err(Error::Unsupported(u))
+                        if format!("{:?}", u.needs).contains("available: 0") =>
+                    {
+                        wrong.push(format!("{pf:?} x{samples} {usage:?}: {u:?}"));
+                    }
+                    Err(Error::Nil(nil)) => {
+                        wrong.push(format!("{pf:?} x{samples} {usage:?}: nil {nil:?}"));
+                    }
+                    Err(_) => {}
+                }
+            }
+        }
+    }
+    assert!(opened > 0, "no pass opened");
+    assert!(wrong.is_empty(), "{wrong:#?}");
+    drop((queue, device));
+    watched.layer_reported_nothing("every attachment's pass was valid and nothing leaked");
+}
