+/// The Vulkan format a stand-in renders `which` attachment in, for a texture without
+/// `RenderTarget` usage whose image of `plan` lacks the attachment's usage (`target`,
+/// `attachment_stand_in::stand_in`): the image's own, but for a color format the device samples
+/// and does not render, which renders through its word (`metal::format::WordAttachment`), as a
+/// texture of the format with `RenderTarget` usage does (`attachment_format`): the word's format,
+/// the one the pipeline's fragment function writes and the pass's clear clears to (`layout`), where
+/// it is of the image's texel size, so the stand-in's copies move the texture's words as they are.
+/// A stand-in in the image's own format there would be an image the device makes no attachment of
+/// (`E5B9G9R9_UFLOAT_PACK32` on ANV: its stand-in refused, `image_plan::unmade_combination`).
+fn stood_format(which: Attachment, plan: &ImagePlan, device: &Device) -> metal2vulkan::vk::Format {
+    let Attachment::Color(_) = which else {
+        return plan.format;
+    };
+    let profile = device.compile_device().profile();
+    let size = |format: metal2vulkan::vk::Format| format.block().map(|block| block.size);
+    match metal2vulkan::metal::format::WordAttachment::of(plan.pixel_format, profile) {
+        Some(word) if size(word.word_format()) == size(plan.format) => word.word_format(),
+        _ => plan.format,
+    }
+}
+
+/// Check each color attachment of `descriptor` as [`layout`] checks it before the attachment
+/// takes an image: a `CustomSampleDepthStore` store action (Metal's validation stops it), a
+/// resolve or store action options of an attachment without a texture, a resolve or a load of a
+/// two-plane YCbCr attachment the runtime does not build, a texture another device made, and
+/// Metal's checks of the attachment's subresource ([`check_target`]). Every color is checked
+/// before any takes a stand-in held by the command buffer, or the pass is answered nil for a
+/// compressed one ([`compressed_color`]), so a pass a later color refuses leaves no image behind,
+/// and the refusal is that color's, whatever an earlier one would have taken.
+fn check_colors(
+    call: &'static str,
+    device: &Device,
+    descriptor: &RenderPassDescriptor,
+) -> Result<(), Error> {
+    let not_yet = || Error::NotImplemented(RuntimeGap::Render);
+    for (index, color) in descriptor.color_attachments.iter().enumerate() {
+        let which = Attachment::Color(index as u32);
+        if color.store_action == StoreAction::CustomSampleDepthStore {
+            // Of an attachment without a texture, unmeasured.
+            return Err(match color.texture {
+                Some(_) => invalid(
+                    call,
+                    Problem::RenderPass(RenderPassProblem::CustomSampleDepthStore(which)),
+                ),
+                None => not_yet(),
+            });
+        }
+        let Some(texture) = &color.texture else {
+            // A resolve, or store action options, of an attachment without a texture is
+            // unmeasured.
+            if color.resolve_texture.is_some()
+                || color.store_action.resolves()
+                || color.store_action_options != StoreActionOptions::NONE
+            {
+                return Err(not_yet());
+            }
+            continue;
+        };
+        // A two-plane YCbCr attachment loads, stores and blends as Metal's tile of halves
+        // (`texture/ycbcr_image.rs`); a resolve into or out of one is not measured, nor a load
+        // of one over a surface of a P3 matrix.
+        if ycbcr_renders(texture.pixel_format())
+            && (color.resolve_texture.is_some()
+                || color.store_action.resolves()
+                || (color.load_action == LoadAction::Load && texture.ycbcr_codes_alone()))
+        {
+            return Err(Error::Unsupported(
+                Unsupported::not_implemented(Feature::Format).naming_format(texture.pixel_format()),
+            ));
+        }
+        if !texture.device().same(device) {
+            return Err(invalid(call, Problem::ForeignObject));
+        }
+        let facts = Facts::of(texture.record());
+        let subresource = (color.level, color.slice, color.depth_plane);
+        check_target(
+            call,
+            which,
+            &facts,
+            subresource,
+            descriptor.render_target_array_length,
+        )?;
+    }
+    Ok(())
+}
+
+/// Whether `texture` is of a block-compressed pixel format (a BC, ETC2, EAC, ASTC or PVRTC one),
+/// which no Vulkan device renders as a color attachment, and Apple's pixel format capabilities
+/// give no color rendering either.
+pub(super) fn compressed(texture: &Texture) -> bool {
+    metal2vulkan::metal::format::block_extent(texture.pixel_format()).is_some()
+}
+
+/// Whether `descriptor` attaches a texture of a compressed format as a color ([`compressed`]),
+/// which [`compressed_color`] answers nil.
+pub(super) fn attaches_compressed(descriptor: &RenderPassDescriptor) -> bool {
+    (descriptor.color_attachments.iter())
+        .filter_map(|color| color.texture.as_ref())
+        .any(compressed)
+}
+
+/// Answer nil for a pass of `descriptor` with a color attachment of a block-compressed format
+/// ([`RenderPassProblem::CompressedColorAttachment`], naming the first such color); nothing for
+/// another pass. Called once every color's checks pass ([`check_colors`]: a foreign texture,
+/// Metal's validation of each subresource) and before the pass takes any image, so no image is
+/// made for it. Each such answer is said on the error stream, with the pass's attachments, the
+/// first 16 in full and then at each power of two.
+fn compressed_color(call: &'static str, descriptor: &RenderPassDescriptor) -> Result<(), Error> {
+    let Some((index, color, texture)) =
+        (descriptor.color_attachments.iter().enumerate()).find_map(|(index, color)| {
+            let texture = color.texture.as_ref().filter(|t| compressed(t))?;
+            Some((index, color, texture))
+        })
+    else {
+        return Ok(());
+    };
+    let which = Attachment::Color(index as u32);
+    let facts = Facts::of(texture.record());
+    // LOCAL (Atlas): a pass no image can hold is answered nil rather than refused, which would
+    // end the caller (a QEMU vGPU host aborts on a refused render pass); said here, as no notice
+    // names it.
+    static ANSWERED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let answered = ANSWERED.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+    if answered <= 16 || answered.is_power_of_two() {
+        eprintln!(
+            "m2v-compressed-attachment: {call} answered nil ({answered} so far): {which:?} is a \
+             {:?} {}x{}x{} texture, usage {:?}, {} samples, level {} slice {}; the pass: {}",
+            facts.pixel_format,
+            facts.extent[0],
+            facts.extent[1],
+            facts.extent[2],
+            facts.usage,
+            facts.samples,
+            color.level,
+            color.slice,
+            pass_summary(descriptor),
+        );
+    }
+    Err(nil(
+        call,
+        Problem::RenderPass(RenderPassProblem::CompressedColorAttachment(which)),
+    ))
+}
+
+/// What `descriptor` attaches, for a diagnostic: each attachment's texture's pixel format, extent,
+/// usage and samples, its actions, and its resolve texture's.
+fn pass_summary(descriptor: &RenderPassDescriptor) -> String {
+    let texture = |t: &Texture| {
+        format!(
+            "{:?} {}x{} {:?} x{}",
+            t.pixel_format(),
+            t.width(),
+            t.height(),
+            t.usage(),
+            t.sample_count()
+        )
+    };
+    let mut parts = Vec::new();
+    for (index, color) in descriptor.color_attachments.iter().enumerate() {
+        let Some(t) = &color.texture else { continue };
+        let resolve = color.resolve_texture.as_ref().map(texture);
+        parts.push(format!(
+            "color {index} {} load {:?} store {:?} resolve {resolve:?}",
+            texture(t),
+            color.load_action,
+            color.store_action
+        ));
+    }
+    if let Some(t) = &descriptor.depth_attachment.texture {
+        parts.push(format!("depth {}", texture(t)));
+    }
+    if let Some(t) = &descriptor.stencil_attachment.texture {
+        parts.push(format!("stencil {}", texture(t)));
+    }
+    parts.push(format!(
+        "target {}x{}, array length {}",
+        descriptor.render_target_width,
+        descriptor.render_target_height,
+        descriptor.render_target_array_length
+    ));
+    parts.join("; ")
+}
