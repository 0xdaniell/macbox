+/// The Vulkan format a stand-in renders `which` attachment in, for a texture without
+/// `RenderTarget` usage whose image of `plan` lacks the attachment's usage (`target`,
+/// `attachment_stand_in::stand_in`): the image's own, but for a color format the device samples
+/// and does not render, which renders through its word (`metal::format::WordAttachment`), as a
+/// texture of the format with `RenderTarget` usage does (`attachment_format`): the word's format,
+/// the one the pipeline's fragment function writes and the pass's clear clears to (`layout`), where
+/// it is of the image's texel size, so the stand-in's copies move the texture's words as they are.
+/// A stand-in in the image's own format there would be an image the device makes no attachment of
+/// (`E5B9G9R9_UFLOAT_PACK32` on ANV: its stand-in refused, `image_plan::unmade_combination`).
+fn stood_format(which: Attachment, plan: &ImagePlan, device: &Device) -> metal2vulkan::vk::Format {
+    let Attachment::Color(_) = which else {
+        return plan.format;
+    };
+    let profile = device.compile_device().profile();
+    let size = |format: metal2vulkan::vk::Format| format.block().map(|block| block.size);
+    match metal2vulkan::metal::format::WordAttachment::of(plan.pixel_format, profile) {
+        Some(word) if size(word.word_format()) == size(plan.format) => word.word_format(),
+        _ => plan.format,
+    }
+}
+
+/// Answer nil for `which`, a color attachment of `texture` at `(subresource, length)` in a pass
+/// of `descriptor`, where the texture's format is block-compressed
+/// ([`RenderPassProblem::CompressedColorAttachment`]), after the checks [`target`] makes of any
+/// format first (a foreign texture, Metal's validation of the attachment's subresource); nothing
+/// for any other format. No image is made for the pass. Each such answer is said on the error
+/// stream, with the pass's attachments, the first 16 in full and then at each power of two.
+fn compressed_color(
+    call: &'static str,
+    device: &Device,
+    which: Attachment,
+    texture: &Texture,
+    (subresource, length): ((u64, u64, u64), u64),
+    descriptor: &RenderPassDescriptor,
+) -> Result<(), Error> {
+    let facts = Facts::of(texture.record());
+    if metal2vulkan::metal::format::block_extent(facts.pixel_format).is_none() {
+        return Ok(());
+    }
+    if !texture.device().same(device) {
+        return Err(invalid(call, Problem::ForeignObject));
+    }
+    check_target(call, which, &facts, subresource, length)?;
+    // LOCAL (Atlas): a pass no image can hold is answered nil rather than refused, which would
+    // end the caller (a QEMU vGPU host aborts on a refused render pass); said here, as no notice
+    // names it.
+    static ANSWERED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let answered = ANSWERED.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+    if answered <= 16 || answered.is_power_of_two() {
+        eprintln!(
+            "m2v-compressed-attachment: {call} answered nil ({answered} so far): {which:?} is a \
+             {:?} {}x{}x{} texture, usage {:?}, {} samples, level {} slice {}; the pass: {}",
+            facts.pixel_format,
+            facts.extent[0],
+            facts.extent[1],
+            facts.extent[2],
+            facts.usage,
+            facts.samples,
+            subresource.0,
+            subresource.1,
+            pass_summary(descriptor),
+        );
+    }
+    Err(nil(
+        call,
+        Problem::RenderPass(RenderPassProblem::CompressedColorAttachment(which)),
+    ))
+}
+
+/// What `descriptor` attaches, for a diagnostic: each attachment's texture's pixel format, extent,
+/// usage and samples, its actions, and its resolve texture's.
+fn pass_summary(descriptor: &RenderPassDescriptor) -> String {
+    let texture = |t: &Texture| {
+        format!(
+            "{:?} {}x{} {:?} x{}",
+            t.pixel_format(),
+            t.width(),
+            t.height(),
+            t.usage(),
+            t.sample_count()
+        )
+    };
+    let mut parts = Vec::new();
+    for (index, color) in descriptor.color_attachments.iter().enumerate() {
+        let Some(t) = &color.texture else { continue };
+        let resolve = color.resolve_texture.as_ref().map(texture);
+        parts.push(format!(
+            "color {index} {} load {:?} store {:?} resolve {resolve:?}",
+            texture(t),
+            color.load_action,
+            color.store_action
+        ));
+    }
+    if let Some(t) = &descriptor.depth_attachment.texture {
+        parts.push(format!("depth {}", texture(t)));
+    }
+    if let Some(t) = &descriptor.stencil_attachment.texture {
+        parts.push(format!("stencil {}", texture(t)));
+    }
+    parts.push(format!(
+        "target {}x{}, array length {}",
+        descriptor.render_target_width,
+        descriptor.render_target_height,
+        descriptor.render_target_array_length
+    ));
+    parts.join("; ")
+}
