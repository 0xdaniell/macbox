index 13e3c7b49..484422622 100644
--- a/crates/metal2vulkan-runtime/src/image_plan.rs
+++ b/crates/metal2vulkan-runtime/src/image_plan.rs
@@ -1010,14 +1010,22 @@ fn attachment_flag(depth_stencil: bool, profile: &DeviceProfile) -> ImageUsageFl
 /// Whether a plan's image fits the device's image limits for its format, type, tiling, usage,
 /// and flags (`VkImageFormatProperties`, from `vkGetPhysicalDeviceImageFormatProperties2`).
 ///
-/// Refusals: `TextureSize` naming the device's dimension limit for the image's type (or its
-/// array-layer limit) with the format's own maximum as what is available, and
+/// Refusals: `Format` naming the image's format and the attachment, storage or sampled usage the
+/// plan asks of it where the device makes no image of the combination at all
+/// ([`unmade_combination`]), `TextureSize` naming the device's dimension limit for the image's type
+/// (or its array-layer limit) with the format's own maximum as what is available, and
 /// `TextureSampleCount` naming the framebuffer sample-count property of the format's class.
 pub(super) fn check_image_limits(
     plan: &ImagePlan,
     texture_type: TextureType,
     limits: &vk::ImageFormatProperties,
 ) -> Result<(), Unsupported> {
+    // `vkGetPhysicalDeviceImageFormatProperties2` answers `VK_ERROR_FORMAT_NOT_SUPPORTED` for a
+    // combination the device makes no image of, which `Device::image_limits` reports as properties
+    // all 0: no limit is what is missing, the format in that usage is.
+    if unmade(limits) {
+        return Err(unmade_combination(plan));
+    }
     let dimension = match texture_type {
         TextureType::Type1D | TextureType::Type1DArray | TextureType::TextureBuffer => {
             VkLimit::MaxImageDimension1D
@@ -1082,3 +1090,87 @@ pub(super) fn check_image_limits(
     }
     Ok(())
 }
+
+/// Whether `limits` is the answer for a combination the device makes no image of: the properties
+/// `Device::image_limits` reports for `VK_ERROR_FORMAT_NOT_SUPPORTED`, all 0. A combination the
+/// device supports has at least one level, one array layer and one sample count (Vulkan,
+/// "Image Creation Limits": `maxMipLevels` and `maxArrayLayers` are at least 1, `sampleCounts`
+/// holds `VK_SAMPLE_COUNT_1_BIT`), so a 0 there is never a limit.
+fn unmade(limits: &vk::ImageFormatProperties) -> bool {
+    limits.max_mip_levels == 0 && limits.max_array_layers == 0 && limits.sample_counts.is_empty()
+}
+
+/// The refusal of `plan`'s image, a combination the device makes no image of
+/// (`VK_ERROR_FORMAT_NOT_SUPPORTED`): `Format`, needing its Vulkan format in the first of the
+/// attachment, storage and sampled usages the plan asks for (the sampled where it asks for none of
+/// them), and naming the texture's pixel format by its Metal enumerator name
+/// (`Unsupported::naming_format`), as every refusal of a format names it: a consumer reads that
+/// symbol as a Metal format's name (a QEMU vGPU host's refused render pass, matched against its
+/// YCbCr attachments). The rest of the combination the device was asked about, its flags, view
+/// formats, samples and type, is [`unmade_words`]'s, for the error stream.
+pub(super) fn unmade_combination(plan: &ImagePlan) -> Unsupported {
+    let usage = [
+        (
+            ImageUsageFlags::COLOR_ATTACHMENT,
+            FormatUsage::ColorAttachment,
+        ),
+        (
+            ImageUsageFlags::DEPTH_STENCIL_ATTACHMENT,
+            FormatUsage::DepthStencilAttachment,
+        ),
+        (ImageUsageFlags::STORAGE, FormatUsage::StorageImage),
+    ]
+    .into_iter()
+    .find(|(flag, _)| plan.usage.contains(*flag))
+    .map_or(FormatUsage::SampledImage, |(_, usage)| usage);
+    Unsupported::needs(
+        Feature::Format,
+        Capability::Format {
+            format: plan.format,
+            usage,
+        },
+    )
+    .naming_format(plan.pixel_format)
+}
+
+/// [`check_image_limits`] of an image the runtime is about to make, refused as the runtime's error:
+/// where the device makes no image of the combination at all, the whole combination is said on the
+/// error stream ([`unmade_words`]; the first 16, then at each power of two), as the refusal names
+/// its format and one usage alone ([`unmade_combination`]). The format answers
+/// (`families/formats.rs`), which ask of combinations no image is made of, check without it.
+pub(super) fn check_made_limits(
+    plan: &ImagePlan,
+    texture_type: TextureType,
+    limits: &vk::ImageFormatProperties,
+) -> Result<(), super::error::Error> {
+    check_image_limits(plan, texture_type, limits).map_err(|refusal| {
+        if unmade(limits) {
+            // LOCAL (Atlas): said here, as no notice names it.
+            static SAID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+            let said = SAID.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+            if said <= 16 || said.is_power_of_two() {
+                eprintln!("m2v-unmade-image ({said} so far): {}", unmade_words(plan));
+            }
+        }
+        super::error::Error::Unsupported(refusal)
+    })
+}
+
+/// The whole combination `plan`'s image asked the device about, in words, where the device makes
+/// no image of it ([`unmade_combination`], which names its format and one usage): the Metal and
+/// Vulkan formats, every usage and create flag, the view formats, the sample count and the image
+/// type.
+pub(super) fn unmade_words(plan: &ImagePlan) -> String {
+    format!(
+        "{:?} as {:?} with usage {:?}, flags {:?}, view formats {:?}, {} samples, {:?}: the \
+         device makes no such image (vkGetPhysicalDeviceImageFormatProperties2 answers \
+         VK_ERROR_FORMAT_NOT_SUPPORTED)",
+        plan.pixel_format,
+        plan.format,
+        plan.usage,
+        plan.flags,
+        plan.view_formats,
+        plan.samples.as_raw(),
+        plan.image_type,
+    )
+}
