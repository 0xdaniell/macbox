+            "{pf:?} {usage:?}"
+        );
+        let named = Unsupported::not_implemented(Feature::Format).naming_format(pf);
+        assert_eq!(
+            refused.symbol, named.symbol,
+            "{pf:?} {usage:?}: the Metal format named"
+        );
+        let said = unmade_words(&plan);
+        for part in [
+            format!("{pf:?}"),
+            format!("{:?}", plan.format),
+            format!("{:?}", plan.usage),
+            format!("{:?}", plan.flags),
+            "VK_ERROR_FORMAT_NOT_SUPPORTED".to_owned(),
+        ] {
