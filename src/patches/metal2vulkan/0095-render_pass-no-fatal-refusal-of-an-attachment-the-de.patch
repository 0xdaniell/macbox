+//! Color attachments whose image the device makes no attachment of, as a pass takes them.
+//!
+//! - **A texture without `RenderTarget` usage** of each format with a word layout
+//!   (`metal::format::WordAttachment`) renders as a texture of the format with `RenderTarget`
+//!   usage does: a pass that clears and draws, and one that loads and draws, leave the two
+//!   textures the same bytes, the loaded texels untouched. Of those, a format the device renders
+//!   through its word (`RGB9E5Float`, `R8Unorm_sRGB` and `RG8Unorm_sRGB` on ANV and lavapipe)
+//!   renders through a stand-in in the word's format (`render_pass::stood_format`), the rest
+//!   through one in their own. A stand-in in the image's own format of a worded one was an image
+//!   the device makes none of, and the pass was refused naming an image size limit of 0
+//!   (`TextureSize`, `MaxImageDimension2D` available 0), which ended a QEMU vGPU host.
+//! - **Metal's codes**: such a pass stores, through the stand-in and through the render target,
+//!   the bytes worked out here by hand from Metal's store rules (`metal/format/word.rs`): the 8-bit
+//!   sRGB encoding of known linear values, `RGB9E5Float`'s shared exponent and truncated
+//!   mantissas, and `B5G6R5Unorm`'s rounded fields.
+//! - **Blending**: a blended pipeline draws over a loaded stand-in as over the render target, or
+//!   is refused as it is; a blend of factors one and zero stores Metal's codes.
+//! - **A texture of a compressed format** (BC, ETC2, EAC, ASTC, PVRTC), with `RenderTarget` usage
+//!   or without, as a color attachment: the encoder is answered nil
+//!   (`RenderPassProblem::CompressedColorAttachment`), the texture keeps its blocks, and the
+//!   command buffer goes on: a pass after it on the same command buffer runs, and the command
+//!   buffer completes.
+//! - **The command buffer's checks and every color's come first**: a pass with a compressed color
+//!   is refused while an encoder is open and after the commit as any pass is, and a color's
+//!   refusal (its subresource) is the pass's, whatever an earlier color would have taken or been
+//!   answered.
+//! - **No pass is refused naming an image limit of 0**: every color format, at 1 and 4 samples
+//!   and with and without `RenderTarget` usage, opens or is refused naming what the device lacks,
+//!   and every compressed one is answered nil, nothing else.
+//!
+//! A device test: compiled only under the validation crate's GPU safety cfgs (`m2v_gpu`,
+//! `m2v_cpu_icd`), on the kind of device the cfg selects, asking for the validation layer: an
+//! attachment view of a format the device does not render, or a copy between images it does not
+//! copy, is a failing message. What the claim of the layer's silence holds is what the device's
+//! instance enabled of the layer it asked for (`tests/layer_claim.rs`). The render pipeline is the
+//! owned fixture `validation/fixtures/public/examples/runtime_examples.ll` (`llvm-as`), as the
+//! examples run it.
+
+use super::blit_holds::WAIT;
+use super::layer_claim::Watched;
+use crate::render_pass::RenderPassProblem;
+use crate::{
+    Attachment, BlitOption, Buffer, ClearColor, CommandBufferStatus, CommandQueue, Device,
+    DeviceKind, DeviceOptions, Error, Invalid, LoadAction, Origin, PipelineOptions, Problem,
+    Region, RenderCommandEncoder, RenderPassDescriptor, RenderPipelineState, ResourceOptions,
+    ShaderCacheOptions, Size, StoreAction, Texture, TextureDescriptor,
+};
+use metal2vulkan::metal::format::{block_extent, is_depth_stencil, WordAttachment};
+use metal2vulkan::metal::{BlendFactor, PixelFormat, PrimitiveType, TextureType, TextureUsage};
+use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
+use std::path::{Path, PathBuf};
+
+/// The attachments' side.
+const SIDE: u32 = 16;
+
+/// The pass's clear color: each channel exact in `half`, and none at a rounding tie of any
+/// format below (`R8Unorm_sRGB` 136.96 and `RG8Unorm_sRGB` 99.09 of 255; `B5G6R5Unorm` 7.75,
+/// 7.875 and 23.25).
+const CLEAR: [f64; 4] = [0.25, 0.125, 0.75, 1.0];
+
+/// The draw's color, as [`CLEAR`] (sRGB 255 and 115.14; `B5G6R5Unorm` 31, 10.83 and 1.94).
+const DRAWN: [f32; 4] = [1.0, 0.171875, 0.0625, 0.25];
+
+/// The formats with a word layout (`WordAttachment::layout`), and their bytes a texel.
+const WORDS: [(PixelFormat, u32); 8] = [
+    (PixelFormat::RGB9E5Float, 4),
+    (PixelFormat::R8UnormSRGB, 1),
+    (PixelFormat::RG8UnormSRGB, 2),
+    (PixelFormat::B5G6R5Unorm, 2),
+    (PixelFormat::A1BGR5Unorm, 2),
+    (PixelFormat::ABGR4Unorm, 2),
+    (PixelFormat::BGRA4Unorm, 2),
+    (PixelFormat::BGR5A1Unorm, 2),
+];
+
+/// `RGB9E5Float`'s word of red, green and blue mantissas and a shared exponent.
+const fn e5b9g9r9(red: u32, green: u32, blue: u32, exponent: u32) -> [u8; 4] {
+    (red | green << 9 | blue << 18 | exponent << 27).to_le_bytes()
+}
+
+/// `B5G6R5Unorm`'s texel of its red, green and blue codes.
+const fn b5g6r5(red: u16, green: u16, blue: u16) -> [u8; 2] {
+    (red << 11 | green << 5 | blue).to_le_bytes()
+}
+
+/// Metal's codes of [`CLEAR`] and [`DRAWN`] in a format, worked out by hand (the module docs):
+/// the format, its clear's texel and its draw's.
+///
+/// - 8-bit sRGB: each linear value encoded (`1.055 v^(1/2.4) - 0.055`) times 255, rounded:
+///   0.25 is 136.96, 0.125 is 99.09, 1.0 is 255 and 0.171875 is 115.14.
+/// - `RGB9E5Float`: the shared exponent `floor(log2(largest)) + 16` (0.75 gives 15, 1.0 gives
+///   16) and each mantissa the value over `2^(exponent - 24)`, truncated: 0.25, 0.125 and 0.75
+///   over 2^-9 are 128, 64 and 384; 1.0, 0.171875 and 0.0625 over 2^-8 are 256, 44 and 16.
+/// - `B5G6R5Unorm`: each value times 31, 63 or 31, rounded: 7.75, 7.875 and 23.25 are 8, 8 and
+///   23; 31, 10.83 and 1.94 are 31, 11 and 2.
+const CODES: [(PixelFormat, &[u8], &[u8]); 4] = [
+    (PixelFormat::R8UnormSRGB, &[137], &[255]),
+    (PixelFormat::RG8UnormSRGB, &[137, 99], &[255, 115]),
+    (
+        PixelFormat::RGB9E5Float,
+        &e5b9g9r9(128, 64, 384, 15),
+        &e5b9g9r9(256, 44, 16, 16),
+    ),
+    (
+        PixelFormat::B5G6R5Unorm,
+        &b5g6r5(8, 8, 23),
+        &b5g6r5(31, 11, 2),
+    ),
+];
+
+/// The compressed formats checked, their bytes a block and the side of their texture: one of
+/// each family, and the ASTC format and extent of the texture whose refused pass ended a QEMU
+/// vGPU host.
+const COMPRESSED: [(PixelFormat, u64, u32); 8] = [
+    (PixelFormat::ASTC8x8LDR, 16, 1024),
+    (PixelFormat::ASTC4x4SRGB, 16, SIDE),
+    (PixelFormat::BC7RGBAUnorm, 16, SIDE),
+    (PixelFormat::BC1RGBA, 8, SIDE),
+    (PixelFormat::ETC2RGB8, 8, SIDE),
+    (PixelFormat::EACR11Unorm, 8, SIDE),
+    (PixelFormat::PVRTCRGBA4BPP, 8, SIDE),
+    (PixelFormat::BC6HRGBUfloat, 16, SIDE),
+];
+
+/// A scratch directory for the device's shader cache, removed when dropped.
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new() -> Scratch {
+        let path = std::env::temp_dir().join(format!(
+            "m2v-unrenderable-attachments-{}-{:?}",
+            std::process::id(),
+            std::thread::current().id()
+        ));
+        std::fs::create_dir_all(&path).unwrap();
+        Scratch(path)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// The device the cfg selects, its shader cache in `cache`, asking for the validation layer, and
+/// what its instance had the layer report.
+fn watched(cache: &Path) -> (Device, Watched) {
+    let watched = Watched::default();
+    let sink = watched.sink(|_| {});
+    let options = DeviceOptions {
+        kinds: match cfg!(m2v_cpu_icd) {
+            true => vec![DeviceKind::Cpu],
+            false => vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ],
+        },
+        shader_cache: ShaderCacheOptions {
+            directory: Some(cache.to_owned()),
+            ..ShaderCacheOptions::default()
+        },
+        layers: watched.layers(),
+        messages: Some(sink),
+        ..DeviceOptions::default()
+    };
+    let device = Device::system_default_with(&options).unwrap();
+    (device, watched)
+}
+
+/// A private 2D texture of `pf`, `side` square, of `samples` and `usage`, where the device makes
+/// one.
+fn texture(
+    device: &Device,
+    pf: PixelFormat,
+    side: u32,
+    samples: u32,
+    usage: TextureUsage,
+) -> Option<Texture> {
+    device
+        .new_texture(&TextureDescriptor {
+            texture_type: match samples {
+                1 => TextureType::Type2D,
+                _ => TextureType::Type2DMultisample,
+            },
+            pixel_format: pf,
+            width: side.into(),
+            height: side.into(),
+            sample_count: samples.into(),
+            usage,
+            resource_options: ResourceOptions::private(),
+            ..TextureDescriptor::default()
+        })
+        .ok()
+}
+
+/// A shared texture of the compressed `pf`, of `texture_type`, `side` square, with `levels` and
+/// `slices`, of `usage`, where the device makes one.
+fn compressed(
+    device: &Device,
+    pf: PixelFormat,
+    (texture_type, side, levels, slices): (TextureType, u32, u64, u64),
+    usage: TextureUsage,
+) -> Option<Texture> {
+    device
+        .new_texture(&TextureDescriptor {
+            texture_type,
+            pixel_format: pf,
+            width: side.into(),
+            height: side.into(),
+            mipmap_level_count: levels,
+            array_length: slices,
+            usage,
+            resource_options: ResourceOptions::shared(),
+            ..TextureDescriptor::default()
+        })
+        .ok()
+}
+
+/// Each level and slice of the compressed `texture` (`bytes` a block): its level, its slice, and
+/// its whole region with its row and image of blocks.
+fn levels_and_slices(texture: &Texture, bytes: u64) -> Vec<(u64, u64, Region, u64, u64)> {
+    let [across, down] = block_extent(texture.pixel_format()).unwrap();
+    let slices = match texture.texture_type() {
+        TextureType::Cube | TextureType::CubeArray => 6 * texture.array_length(),
+        _ => texture.array_length(),
+    };
+    let mut all = Vec::new();
+    for level in 0..texture.mipmap_level_count() {
+        let width = (texture.width() >> level).max(1);
+        let height = (texture.height() >> level).max(1);
+        let row = width.div_ceil(across.into()) * bytes;
+        let image = row * height.div_ceil(down.into());
+        for slice in 0..slices {
+            let region = Region::new_2d(0, 0, width, height);
+            all.push((level, slice, region, row, image));
+        }
+    }
+    all
+}
+
+/// Write a pattern of `seed` into every level and slice of the compressed `texture` (`bytes` a
+/// block); the bytes written, each level and slice's.
+fn fill_blocks(texture: &Texture, bytes: u64, seed: u8) -> Vec<Vec<u8>> {
+    levels_and_slices(texture, bytes)
+        .into_iter()
+        .map(|(level, slice, region, row, image)| {
+            let pattern: Vec<u8> = (0..image)
+                .map(|i| (i as u8).wrapping_mul(37).wrapping_add(seed))
+                .collect();
+            texture
+                .replace_region(region, level, slice, &pattern, row, image)
+                .unwrap();
+            pattern
+        })
+        .collect()
+}
+
+/// The bytes of every level and slice of the compressed `texture` (`bytes` a block).
+fn blocks(texture: &Texture, bytes: u64) -> Vec<Vec<u8>> {
+    levels_and_slices(texture, bytes)
+        .into_iter()
+        .map(|(level, slice, region, row, image)| {
+            let mut out = vec![0; image as usize];
+            texture
+                .get_bytes(&mut out, row, image, region, level, slice)
+                .unwrap();
+            out
+        })
+        .collect()
+}
+
+/// A shared buffer of `values`.
+fn floats(device: &Device, values: impl IntoIterator<Item = f32>) -> Buffer {
+    let bytes: Vec<u8> = values.into_iter().flat_map(f32::to_le_bytes).collect();
+    device
+        .new_buffer_with_bytes(&bytes, ResourceOptions::shared())
+        .unwrap()
+}
+
+/// The fixture's `colored_vertex` and `colored_fragment`.
+fn functions(device: &Device) -> (StageSource, StageSource) {
+    let ll = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/fixtures/public/examples/runtime_examples.ll");
+    let bitcode = metal2vulkan_devtools::llvm_assemble(&ll).unwrap();
+    let library = metal2vulkan::library::Library::from_air(&bitcode).unwrap();
+    let library = device.new_library_with_compile_library(library);
+    let vertex = library.new_function_with_name("colored_vertex").unwrap();
+    let fragment = library.new_function_with_name("colored_fragment").unwrap();
+    (
+        StageSource::Function(vertex.function_descriptor()),
+        StageSource::Function(fragment.function_descriptor()),
+    )
+}
+
+/// The fixture's render pipeline state: `colored_vertex` and `colored_fragment`, writing each
+/// vertex's color into a color 0 described by `color`.
+fn state_of(
+    device: &Device,
+    color: ColorAttachmentDescriptor,
+) -> Result<RenderPipelineState, Error> {
+    let (vertex, fragment) = functions(device);
+    let mut descriptor = RenderPipelineDescriptor::new(vertex);
+    descriptor.fragment = Some(fragment);
+    descriptor.color_attachments[0] = Some(color);
+    device.new_render_pipeline_state(&descriptor, &PipelineOptions::default())
+}
+
+/// [`state_of`] a color 0 of `pf`, unblended.
+fn state(device: &Device, pf: PixelFormat) -> RenderPipelineState {
+    state_of(device, ColorAttachmentDescriptor::new(pf)).unwrap()
+}
+
+/// Run `encode` on a command buffer of `queue`, commit it and wait: it completes.
+fn run(queue: &CommandQueue, what: &str, encode: impl FnOnce(&crate::CommandBuffer)) {
+    let command_buffer = queue.command_buffer().unwrap();
+    encode(&command_buffer);
+    command_buffer.commit().unwrap();
+    command_buffer.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(
+        command_buffer.status(),
+        CommandBufferStatus::Completed,
+        "{what}: {:?}",
+        command_buffer.error()
+    );
+}
+
+/// `texture`'s level 0, `side` square, `bytes` a texel, read by a blit.
+fn read_side(
+    device: &Device,
+    queue: &CommandQueue,
+    texture: &Texture,
+    side: u32,
+    bytes: u32,
+) -> Vec<u8> {
+    let row = u64::from(side * bytes);
+    let len = row * u64::from(side);
+    let out = device.new_buffer(len, ResourceOptions::shared()).unwrap();
+    run(queue, "the read", |command_buffer| {
+        let mut blit = command_buffer.blit_command_encoder().unwrap();
+        let whole = Size::new(side.into(), side.into(), 1);
+        blit.copy_from_texture_to_buffer(
+            texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            whole,
+            &out,
+            0,
+            row,
+            len,
+            BlitOption::None,
+        )
+        .unwrap();
+        blit.end_encoding().unwrap();
+    });
+    // SAFETY: the command buffer completed; nothing else writes the buffer.
+    unsafe { std::slice::from_raw_parts(out.contents().unwrap().as_ptr(), len as usize) }.to_vec()
+}
+
+/// [`read_side`] of a texture [`SIDE`] square.
+fn read(device: &Device, queue: &CommandQueue, texture: &Texture, bytes: u32) -> Vec<u8> {
+    read_side(device, queue, texture, SIDE, bytes)
+}
+
+/// Write `bytes`, a texel each `texel` bytes, into `texture` by a blit.
+fn write(device: &Device, queue: &CommandQueue, texture: &Texture, texel: u32, bytes: &[u8]) {
+    let row = u64::from(SIDE * texel);
+    let from = device
+        .new_buffer_with_bytes(bytes, ResourceOptions::shared())
+        .unwrap();
+    run(queue, "the write", |command_buffer| {
+        let mut blit = command_buffer.blit_command_encoder().unwrap();
+        let whole = Size::new(SIDE.into(), SIDE.into(), 1);
+        blit.copy_from_buffer_to_texture(
+            &from,
+            0,
+            row,
+            row * u64::from(SIDE),
+            whole,
+            texture,
+            0,
+            0,
+            Origin::new(0, 0, 0),
+            BlitOption::None,
+        )
+        .unwrap();
+        blit.end_encoding().unwrap();
+    });
+}
+
+/// A pattern of `texel`-byte texels over a texture [`SIDE`] square.
+fn pattern(texel: u32) -> Vec<u8> {
+    (0..SIDE * SIDE * texel)
+        .map(|i| (i * 37 + 11) as u8)
+        .collect()
+}
+
+/// The quad over the left half of the attachments, colored [`DRAWN`]: its positions and colors.
+struct Quad(Buffer, Buffer);
+
+impl Quad {
+    fn new(device: &Device) -> Quad {
+        let positions = floats(
+            device,
+            [[-1.0, 1.0], [0.0, 1.0], [-1.0, -1.0], [0.0, -1.0]]
+                .into_iter()
+                .flatten(),
+        );
+        Quad(positions, floats(device, (0..4).flat_map(|_| DRAWN)))
+    }
+
+    /// Draw it with `state`, refused where setting the state is.
+    fn draw(
+        &self,
+        encoder: &mut RenderCommandEncoder,
+        state: &RenderPipelineState,
+    ) -> Result<(), Error> {
+        encoder.set_render_pipeline_state(state)?;
+        encoder.set_vertex_buffer(Some(&self.0), 0, 0)?;
+        encoder.set_vertex_buffer(Some(&self.1), 0, 1)?;
+        encoder.draw_primitives(PrimitiveType::TriangleStrip, 0, 4, 1, 0)
+    }
+}
+
+/// A color attachment of `texture`, loading by `load`, cleared to [`CLEAR`], stored.
+fn color(pass: &mut RenderPassDescriptor, index: usize, texture: &Texture, load: LoadAction) {
+    let color = &mut pass.color_attachments[index];
+    color.texture = Some(texture.clone());
+    color.load_action = load;
+    color.store_action = StoreAction::Store;
+    color.clear_color = ClearColor::new(CLEAR[0], CLEAR[1], CLEAR[2], CLEAR[3]);
+}
+
+/// A pass over `texture` as color 0, loading by `load`, that draws `quad` with `state` and stores
+/// it; refused where its encoder or the draw is.
+fn draw_left_half(
+    queue: &CommandQueue,
+    texture: &Texture,
+    (state, quad): (&RenderPipelineState, &Quad),
+    load: LoadAction,
+) -> Result<(), Error> {
+    let mut pass = RenderPassDescriptor::new();
+    color(&mut pass, 0, texture, load);
+    let command_buffer = queue.command_buffer().unwrap();
+    let mut encoder = command_buffer.render_command_encoder(&pass)?;
+    let drawn = quad.draw(&mut encoder, state);
+    encoder.end_encoding().unwrap();
+    command_buffer.commit().unwrap();
+    command_buffer.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(
+        command_buffer.status(),
+        CommandBufferStatus::Completed,
+        "the pass: {:?}",
+        command_buffer.error()
+    );
+    drawn
+}
+
+/// Each row of `texels` (`texel` bytes each, [`SIDE`] a row) is `left` texels left of the
+/// middle and `right` ones from it: one texel each, or a row's half of `right`.
+fn assert_halves(texels: &[u8], texel: usize, left: &[u8], right: Halves<'_>, what: &str) {
+    let row = SIDE as usize * texel;
+    assert_eq!(texels.len(), row * SIDE as usize, "{what}");
+    for (at, got) in texels.chunks(row).enumerate() {
+        let (l, r) = got.split_at(row / 2);
+        assert!(
+            l.chunks(texel).all(|t| t == left),
+            "{what}: row {at} left of the middle: {l:?}, want {left:?} each"
+        );
+        match right {
+            Halves::Each(want) => assert!(
+                r.chunks(texel).all(|t| t == want),
+                "{what}: row {at} from the middle: {r:?}, want {want:?} each"
+            ),
+            Halves::Of(whole) => assert_eq!(
+                r,
+                &whole[at * row + row / 2..(at + 1) * row],
+                "{what}: row {at} from the middle"
+            ),
+        }
+    }
+}
+
+/// What a row's right half holds: one texel each, or that of a whole texture's bytes.
+#[derive(Clone, Copy)]
+enum Halves<'a> {
+    Each(&'a [u8]),
+    Of(&'a [u8]),
+}
+
+/// A texture without `RenderTarget` usage of each format with a word layout renders as a render
+/// target of the format does: a pass that clears and draws, and one that loads and draws, leave
+/// it the bytes they leave the render target, the loaded texels untouched. The device renders at
+/// least one of them through its word, and makes a texture of each.
+#[test]
+fn a_texture_without_render_target_usage_renders_as_its_render_target() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let profile = device.compile_device().profile();
+    let quad = Quad::new(&device);
+    let mut worded = Vec::new();
+    let mut own = Vec::new();
+    for (pf, texel) in WORDS {
+        let stood = texture(&device, pf, SIDE, 1, TextureUsage::SHADER_READ)
+            .unwrap_or_else(|| panic!("{pf:?}: no texture without RenderTarget usage"));
+        let target = texture(
+            &device,
+            pf,
+            SIDE,
+            1,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        )
+        .unwrap_or_else(|| panic!("{pf:?}: no render target"));
+        let state = state(&device, pf);
+        let word = WordAttachment::of(pf, profile).map(|w| w.word_format());
+        let what = format!("{pf:?} (word {word:?})");
+        // Cleared and drawn: the clear right of the quad, the draw left of it.
+        for t in [&stood, &target] {
+            draw_left_half(&queue, t, (&state, &quad), LoadAction::Clear)
+                .unwrap_or_else(|e| panic!("{what}: {e:?}"));
+        }
+        let cleared = read(&device, &queue, &stood, texel);
+        assert_eq!(
+            cleared,
+            read(&device, &queue, &target, texel),
+            "{what}: cleared and drawn"
+        );
+        let first = &cleared[..texel as usize];
+        let last = &cleared[cleared.len() - texel as usize..];
+        assert_ne!(first, last, "{what}: the draw and the clear store apart");
+        // Loaded and drawn: every texel right of the quad keeps the bytes written before, and
+        // every one left of it takes what the cleared pass drew.
+        let pattern = pattern(texel);
+        for t in [&stood, &target] {
+            write(&device, &queue, t, texel, &pattern);
+            draw_left_half(&queue, t, (&state, &quad), LoadAction::Load)
+                .unwrap_or_else(|e| panic!("{what}: {e:?}"));
+        }
+        let loaded = read(&device, &queue, &stood, texel);
+        assert_eq!(
+            loaded,
+            read(&device, &queue, &target, texel),
+            "{what}: loaded and drawn"
+        );
+        assert_halves(&loaded, texel as usize, first, Halves::Of(&pattern), &what);
+        match word {
+            Some(word) => worded.push((pf, word)),
+            None => own.push(pf),
+        }
+    }
+    eprintln!("through the word's format: {worded:?}; through their own: {own:?}");
+    assert!(
+        !worded.is_empty(),
+        "no format of WORDS renders through its word here: the stand-in in the word's format \
+         went unchecked"
+    );
+    drop((queue, device));
+    watched.layer_reported_nothing("every stand-in's pass was valid and nothing leaked");
+}
+
+/// A texture without `RenderTarget` usage stores Metal's codes, worked out by hand ([`CODES`]):
+/// cleared and drawn, the draw's left of the quad and the clear's right of it; loaded and drawn,
+/// the draw's left of it and the bytes written before right of it. So does the format's render
+/// target, and so do both under a blend of factors one and zero, which Metal stores the same.
+#[test]
+fn stand_ins_store_metal_s_codes() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let quad = Quad::new(&device);
+    for (pf, cleared, drawn) in CODES {
+        let texel = cleared.len() as u32;
+        let mut blended = ColorAttachmentDescriptor::new(pf);
+        blended.blending_enabled = true;
+        let states = [
+            ("unblended", state(&device, pf)),
+            (
+                "blended one and zero",
+                state_of(&device, blended).unwrap_or_else(|e| panic!("{pf:?}: {e:?}")),
+            ),
+        ];
+        for usage in [
+            TextureUsage::SHADER_READ,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        ] {
+            let t = texture(&device, pf, SIDE, 1, usage).unwrap();
+            for (how, state) in &states {
+                let what = format!("{pf:?} {usage:?} {how}");
+                draw_left_half(&queue, &t, (state, &quad), LoadAction::Clear)
+                    .unwrap_or_else(|e| panic!("{what}: {e:?}"));
+                let got = read(&device, &queue, &t, texel);
+                assert_halves(&got, texel as usize, drawn, Halves::Each(cleared), &what);
+                let pattern = pattern(texel);
+                write(&device, &queue, &t, texel, &pattern);
+                draw_left_half(&queue, &t, (state, &quad), LoadAction::Load)
+                    .unwrap_or_else(|e| panic!("{what}: {e:?}"));
+                let got = read(&device, &queue, &t, texel);
+                assert_halves(&got, texel as usize, drawn, Halves::Of(&pattern), &what);
+            }
+        }
+    }
+    drop((queue, device));
+    watched.layer_reported_nothing("every pass storing Metal's codes was valid");
+}
+
+/// A pipeline blending source alpha over one minus it draws over a loaded texture without
+/// `RenderTarget` usage as over the format's render target: the same bytes, or the same refusal.
+/// A pipeline the device makes none of (a word attachment's blend it does not build) is refused
+/// as it is made, whatever it would draw into. At least one format blends.
+#[test]
+fn a_blend_over_a_stand_in_is_the_render_target_s() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let quad = Quad::new(&device);
+    let mut ran = Vec::new();
+    let mut unmade = Vec::new();
+    for (pf, texel) in WORDS {
+        let mut blend = ColorAttachmentDescriptor::new(pf);
+        blend.blending_enabled = true;
+        blend.source_rgb_blend_factor = BlendFactor::SourceAlpha;
+        blend.source_alpha_blend_factor = BlendFactor::SourceAlpha;
+        blend.destination_rgb_blend_factor = BlendFactor::OneMinusSourceAlpha;
+        blend.destination_alpha_blend_factor = BlendFactor::OneMinusSourceAlpha;
+        let state = match state_of(&device, blend) {
+            Ok(state) => state,
+            Err(e) => {
+                unmade.push(format!("{pf:?}: {e:?}"));
+                continue;
+            }
+        };
+        let pattern = pattern(texel);
+        let blended = |usage: TextureUsage| {
+            let t = texture(&device, pf, SIDE, 1, usage).unwrap();
+            write(&device, &queue, &t, texel, &pattern);
+            draw_left_half(&queue, &t, (&state, &quad), LoadAction::Load)
+                .map(|()| read(&device, &queue, &t, texel))
+        };
+        let stood = blended(TextureUsage::SHADER_READ);
+        let target = blended(TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET);
+        assert_eq!(
+            format!("{stood:?}"),
+            format!("{target:?}"),
+            "{pf:?}: blended over its loaded texels"
+        );
+        if let Ok(texels) = &stood {
+            // Right of the quad the loaded texels, left of it a blend of them.
+            let row = (SIDE * texel) as usize;
+            let rows = texels.chunks(row).zip(pattern.chunks(row));
+            for (at, (got, want)) in rows.enumerate() {
+                assert_eq!(got[row / 2..], want[row / 2..], "{pf:?}: row {at}, right");
+                assert_ne!(got[..row / 2], want[..row / 2], "{pf:?}: row {at}, left");
+            }
+            ran.push(pf);
+        }
+    }
+    eprintln!("blended: {ran:?}; no such pipeline: {unmade:#?}");
+    assert!(!ran.is_empty(), "no blend ran");
+    drop((queue, device));
+    watched.layer_reported_nothing("every blended stand-in's pass was valid");
+}
+
+/// The answer nil naming `index`'s color, of a compressed format.
+fn is_compressed_nil(answer: Result<crate::RenderCommandEncoder, Error>, index: u32, what: &str) {
+    match answer {
+        Err(Error::Nil(nil)) => assert_eq!(
+            nil.problem,
+            Problem::RenderPass(RenderPassProblem::CompressedColorAttachment(
+                Attachment::Color(index)
+            )),
+            "{what}"
+        ),
+        Err(other) => panic!("{what}: refused {other:?}"),
+        Ok(_) => panic!("{what}: an encoder"),
+    }
+}
+
+/// A color attachment of a compressed format, with `RenderTarget` usage or without, at color 0
+/// or beside another, loaded, cleared or neither, is answered nil; the compressed texture keeps
+/// its blocks, a pass after it on the same command buffer runs, and the command buffer completes.
+#[test]
+fn a_compressed_color_attachment_is_answered_nil_and_the_command_buffer_goes_on() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let rgba8 = PixelFormat::RGBA8Unorm;
+    let mut answered = 0;
+    for (pf, bytes, side) in COMPRESSED {
+        let plain = texture(
+            &device,
+            rgba8,
+            side,
+            1,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        )
+        .unwrap();
+        let usages = [
+            TextureUsage::SHADER_READ,
+            TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+        ];
+        for usage in usages {
+            let shape = (TextureType::Type2D, side, 1, 1);
+            let Some(blocks_texture) = compressed(&device, pf, shape, usage) else {
+                eprintln!("{pf:?} {usage:?}: the device makes no such texture");
+                continue;
+            };
+            let written = fill_blocks(&blocks_texture, bytes, 11);
+            for index in [0usize, 1] {
+                for load in [LoadAction::Load, LoadAction::Clear, LoadAction::DontCare] {
+                    let what = format!("{pf:?} {usage:?} at {index}, {load:?}");
+                    let mut pass = RenderPassDescriptor::new();
+                    if index == 1 {
+                        color(&mut pass, 0, &plain, LoadAction::Clear);
+                    }
+                    color(&mut pass, index, &blocks_texture, load);
+                    // The command buffer goes on: a pass of the plain texture after it runs.
+                    let mut after = RenderPassDescriptor::new();
+                    color(&mut after, 0, &plain, LoadAction::Clear);
+                    after.color_attachments[0].clear_color = ClearColor::new(0.0, 1.0, 0.0, 1.0);
+                    run(&queue, &what, |command_buffer| {
+                        let answer = command_buffer.render_command_encoder(&pass);
+                        is_compressed_nil(answer, index as u32, &what);
+                        let encoder = command_buffer.render_command_encoder(&after).unwrap();
+                        encoder.end_encoding().unwrap();
+                    });
+                    let texels = read_side(&device, &queue, &plain, side, 4);
+                    assert!(
+                        texels.chunks(4).all(|t| t == [0, 255, 0, 255]),
+                        "{what}: the pass after it cleared"
+                    );
+                    assert_eq!(
+                        blocks(&blocks_texture, bytes),
+                        written,
+                        "{what}: the blocks"
+                    );
+                    answered += 1;
+                }
+            }
+        }
+    }
+    assert!(answered > 0, "the device made no compressed texture");
+    drop((queue, device));
+    watched.layer_reported_nothing("no image was made for a compressed attachment's pass");
+}
+
+/// The first of [`COMPRESSED`] the device makes a shared texture of with `shape`: its format, its
+/// bytes a block and the texture, its blocks written.
+fn first_compressed(
+    device: &Device,
+    (texture_type, levels, slices): (TextureType, u64, u64),
+) -> (PixelFormat, u64, Texture, Vec<Vec<u8>>) {
+    let side = 2 * SIDE;
+    COMPRESSED
+        .iter()
+        .filter(|(pf, ..)| *pf != PixelFormat::PVRTCRGBA4BPP)
+        .find_map(|&(pf, bytes, _)| {
+            let shape = (texture_type, side, levels, slices);
+            let t = compressed(device, pf, shape, TextureUsage::SHADER_READ)?;
+            let written = fill_blocks(&t, bytes, 23);
+            Some((pf, bytes, t, written))
+        })
+        .expect("the device makes no compressed texture")
+}
+
+/// A compressed attachment of a level and slice of an array, and of a cube's face, beside a color
+/// of the level's extent, is answered nil naming it, and keeps every level and slice's blocks;
+/// one of a level its texture lacks is refused as any attachment's is (`AttachmentSubresource`),
+/// not answered nil.
+#[test]
+fn a_compressed_level_or_slice_is_answered_nil_once_its_subresource_is_checked() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let plain = texture(
+        &device,
+        PixelFormat::RGBA8Unorm,
+        SIDE,
+        1,
+        TextureUsage::RENDER_TARGET,
+    )
+    .unwrap();
+    for (texture_type, slices) in [(TextureType::Type2DArray, 3), (TextureType::Cube, 1)] {
+        let (pf, bytes, t, written) = first_compressed(&device, (texture_type, 2, slices));
+        for (level, slice) in [(1, 2), (2, 2)] {
+            let what = format!("{pf:?} {texture_type:?}: level {level}, slice {slice}");
+            let mut pass = RenderPassDescriptor::new();
+            color(&mut pass, 0, &plain, LoadAction::Clear);
+            color(&mut pass, 1, &t, LoadAction::Load);
+            pass.color_attachments[1].level = level;
+            pass.color_attachments[1].slice = slice;
+            let command_buffer = queue.command_buffer().unwrap();
+            let answer = command_buffer.render_command_encoder(&pass);
+            if level < 2 {
+                is_compressed_nil(answer, 1, &what);
+            } else {
+                match answer {
+                    Err(Error::Invalid(Invalid {
+                        problem:
+                            Problem::RenderPass(RenderPassProblem::AttachmentSubresource(
+                                Attachment::Color(1),
+                            )),
+                        ..
+                    })) => {}
+                    Err(other) => panic!("{what}: {other:?}"),
+                    Ok(_) => panic!("{what}: an encoder"),
+                }
+            }
+            drop(command_buffer);
+            assert_eq!(blocks(&t, bytes), written, "{what}");
+        }
+    }
+    drop((queue, device));
+    watched.layer_reported_nothing("no image was made for a compressed level's pass");
+}
+
+/// A pass with a compressed color meets the command buffer's checks as any pass does: refused
+/// while another encoder is open (`EncoderOpen`), and after the commit (`AlreadyCommitted`), as
+/// a pass of a plain color is.
+#[test]
+fn a_pass_with_a_compressed_color_is_refused_as_any_pass_while_an_encoder_is_open_or_after_commit()
+{
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let plain = texture(
+        &device,
+        PixelFormat::RGBA8Unorm,
+        2 * SIDE,
+        1,
+        TextureUsage::RENDER_TARGET,
+    )
+    .unwrap();
+    let (pf, _, t, _) = first_compressed(&device, (TextureType::Type2D, 1, 1));
+    let mut plain_pass = RenderPassDescriptor::new();
+    color(&mut plain_pass, 0, &plain, LoadAction::Clear);
+    let mut compressed_pass = RenderPassDescriptor::new();
+    color(&mut compressed_pass, 0, &t, LoadAction::Load);
+    let refused = |error: Option<Error>, problem: Problem, what: &str| match error {
+        Some(Error::Invalid(Invalid { problem: p, .. })) if p == problem => {}
+        other => panic!("{pf:?}: {what}: {other:?}, want {problem:?}"),
+    };
+    let command_buffer = queue.command_buffer().unwrap();
+    let open = command_buffer.render_command_encoder(&plain_pass).unwrap();
+    for (pass, what) in [
+        (&compressed_pass, "the compressed pass"),
+        (&plain_pass, "the plain pass"),
+    ] {
+        let error = command_buffer.render_command_encoder(pass).err();
+        refused(
+            error,
+            Problem::EncoderOpen,
+            &format!("{what}, an encoder open"),
+        );
+    }
+    open.end_encoding().unwrap();
+    command_buffer.commit().unwrap();
+    command_buffer.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(command_buffer.status(), CommandBufferStatus::Completed);
+    for (pass, what) in [
+        (&compressed_pass, "the compressed pass"),
+        (&plain_pass, "the plain pass"),
+    ] {
+        let error = command_buffer.render_command_encoder(pass).err();
+        refused(
+            error,
+            Problem::AlreadyCommitted,
+            &format!("{what}, committed"),
+        );
+    }
+    drop(command_buffer);
+    drop((queue, device));
+    watched.layer_reported_nothing("the refused passes left nothing");
+}
+
+/// Every color of a pass is checked before any takes an image, or the pass is answered nil for a
+/// compressed one: a pass whose color 0 renders through a stand-in and whose color 1 is
+/// compressed is answered nil naming color 1; one whose color 1 names a level its texture lacks
+/// is refused naming color 1 (`AttachmentSubresource`), its color 0 a stand-in's or a compressed
+/// one's (no longer answered nil for color 0 before color 1 is checked).
+#[test]
+fn a_pass_checks_every_color_before_any_takes_an_image() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let rgba8 = PixelFormat::RGBA8Unorm;
+    let side = 2 * SIDE;
+    let stood = texture(&device, rgba8, side, 1, TextureUsage::SHADER_READ).unwrap();
+    let (pf, bytes, t, written) = first_compressed(&device, (TextureType::Type2D, 1, 1));
+    let what = format!("a stand-in at 0, {pf:?} at 1");
+    let mut pass = RenderPassDescriptor::new();
+    color(&mut pass, 0, &stood, LoadAction::Clear);
+    color(&mut pass, 1, &t, LoadAction::Load);
+    let command_buffer = queue.command_buffer().unwrap();
+    is_compressed_nil(command_buffer.render_command_encoder(&pass), 1, &what);
+    drop(command_buffer);
+    assert_eq!(blocks(&t, bytes), written, "{what}: the blocks");
+    let past = texture(&device, rgba8, side, 1, TextureUsage::RENDER_TARGET).unwrap();
+    for (first, what) in [(&stood, "a stand-in"), (&t, "a compressed color")] {
+        let mut pass = RenderPassDescriptor::new();
+        color(&mut pass, 0, first, LoadAction::Load);
+        color(&mut pass, 1, &past, LoadAction::Load);
+        pass.color_attachments[1].level = 3;
+        let command_buffer = queue.command_buffer().unwrap();
+        match command_buffer.render_command_encoder(&pass) {
+            Err(Error::Invalid(Invalid {
+                problem:
+                    Problem::RenderPass(RenderPassProblem::AttachmentSubresource(Attachment::Color(1))),
+                ..
+            })) => {}
+            Err(other) => panic!("{what} at 0, color 1 past its levels: {other:?}"),
+            Ok(_) => panic!("{what} at 0, color 1 past its levels: an encoder"),
+        }
+    }
+    drop((queue, device));
+    watched.layer_reported_nothing("every checked pass was valid and nothing leaked");
+}
+
+/// No color attachment's pass is refused naming an image limit of 0, the device's answer for an
+/// image it makes none of: every color format, at 1 and 4 samples, with and without
+/// `RenderTarget` usage, opens or is refused naming what the device lacks, and every compressed
+/// texture the device makes is answered nil (`CompressedColorAttachment`), nothing else nil.
+#[test]
+fn no_pass_is_refused_naming_an_image_limit_of_0() {
+    let cache = Scratch::new();
+    let (device, watched) = watched(&cache.0);
+    let queue = device.new_command_queue().unwrap();
+    let mut wrong = Vec::new();
+    let (mut opened, mut compressed_nil, mut refused) = (0, 0, 0);
+    for &pf in PixelFormat::ALL {
+        if is_depth_stencil(pf) {
+            continue;
+        }
+        for samples in [1, 4] {
+            for usage in [
+                TextureUsage::SHADER_READ,
+                TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+            ] {
+                let Some(t) = texture(&device, pf, SIDE, samples, usage) else {
+                    continue;
+                };
+                let what = format!("{pf:?} x{samples} {usage:?}");
+                let mut pass = RenderPassDescriptor::new();
+                let color = &mut pass.color_attachments[0];
+                color.texture = Some(t);
+                color.load_action = LoadAction::DontCare;
+                color.store_action = StoreAction::Store;
+                let command_buffer = queue.command_buffer().unwrap();
+                match command_buffer.render_command_encoder(&pass) {
+                    Ok(_) if block_extent(pf).is_some() => {
+                        wrong.push(format!("{what}: compressed, an encoder"));
+                    }
+                    Ok(encoder) => {
+                        encoder.end_encoding().unwrap();
+                        opened += 1;
+                    }
+                    Err(Error::Nil(nil))
+                        if nil.problem
+                            == Problem::RenderPass(
+                                RenderPassProblem::CompressedColorAttachment(Attachment::Color(0)),
+                            )
+                            && block_extent(pf).is_some() =>
+                    {
+                        compressed_nil += 1;
+                    }
+                    Err(error) if block_extent(pf).is_some() => {
+                        wrong.push(format!("{what}: compressed, {error:?}"));
+                    }
+                    Err(Error::Unsupported(u))
+                        if format!("{:?}", u.needs).contains("available: 0") =>
+                    {
+                        wrong.push(format!("{what}: {u:?}"));
+                    }
+                    Err(Error::Nil(nil)) => wrong.push(format!("{what}: nil {nil:?}")),
+                    Err(_) => refused += 1,
+                }
+            }
+        }
+    }
+    eprintln!("opened {opened}, compressed answered nil {compressed_nil}, refused {refused}");
+    assert!(wrong.is_empty(), "{wrong:#?}");
+    assert!(opened > 0, "no pass opened");
+    assert!(compressed_nil > 0, "no compressed texture was made");
+    drop((queue, device));
+    watched.layer_reported_nothing("every attachment's pass was valid and nothing leaked");
+}
