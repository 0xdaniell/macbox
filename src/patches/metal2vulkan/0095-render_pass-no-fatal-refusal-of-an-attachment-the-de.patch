+/// A combination the device makes no image of (`VK_ERROR_FORMAT_NOT_SUPPORTED`, which
+/// `Device::image_limits` reports as properties all 0) is refused naming the image's format in the
+/// usage the plan asks of it, and the whole combination, never as an image size limit of 0: the
+/// ANV refusal of an `RGB9E5Float` stand-in's `E5B9G9R9_UFLOAT_PACK32` attachment image read
+/// `TextureSize` needs `MaxImageDimension2D` 1024, available 0.
+#[test]
+fn an_image_the_device_makes_none_of_is_refused_naming_its_format_and_usage() {
+    let (name, desc, device) = committed()
+        .into_iter()
+        .find(|(n, ..)| n == "lavapipe")
+        .unwrap();
+    let facts = facts(&desc, &device);
+    let unmade = vk::ImageFormatProperties::default();
+    for (pf, usage, texture_type, samples, wanted) in [
+        (
+            PixelFormat::RGBA8Unorm,
+            TextureUsage::RENDER_TARGET,
+            TextureType::Type2D,
+            1,
+            FormatUsage::ColorAttachment,
+        ),
+        (
+            PixelFormat::RGBA8Unorm,
+            TextureUsage::RENDER_TARGET,
+            TextureType::Type2DMultisample,
+            4,
+            FormatUsage::ColorAttachment,
+        ),
+        (
+            PixelFormat::Depth32Float,
+            TextureUsage::RENDER_TARGET,
+            TextureType::Type2D,
+            1,
+            FormatUsage::DepthStencilAttachment,
+        ),
+        // A texture without an attachment's usage: storage where its image has it (a texture
+        // the device may store through a view), else sampled.
+        (
+            PixelFormat::R32Float,
+            TextureUsage::SHADER_WRITE,
+            TextureType::Type2D,
+            1,
+            FormatUsage::StorageImage,
+        ),
+        (
+            PixelFormat::RGBA8Unorm,
+            TextureUsage::SHADER_READ,
+            TextureType::Type3D,
+            1,
+            FormatUsage::SampledImage,
+        ),
+    ] {
+        let l = layout(texture_type, pf, samples, 1);
+        let plan = plan_image(&l, usage, false, &facts).expect(&name);
+        let wanted = match wanted {
+            FormatUsage::SampledImage if plan.usage.contains(ImageUsageFlags::STORAGE) => {
+                FormatUsage::StorageImage
+            }
+            wanted => wanted,
+        };
+        let refused = check_image_limits(&plan, texture_type, &unmade).unwrap_err();
+        assert_eq!(refused.feature, Feature::Format, "{pf:?} {usage:?}");
+        assert_eq!(
+            refused.needs,
+            Needs::AnyOf(vec![vec![Capability::Format {
+                format: plan.format,
+                usage: wanted,
+            }]]),
+            "{pf:?} {usage:?}"
+        );
+        let said = refused
+            .symbol
+            .as_ref()
+            .expect("the combination named")
+            .to_string();
+        for part in [
+            format!("{:?}", plan.format),
+            format!("{:?}", plan.usage),
+            format!("{:?}", plan.flags),
+            "VK_ERROR_FORMAT_NOT_SUPPORTED".to_owned(),
+        ] {
+            assert!(
+                said.contains(&part),
+                "{pf:?} {usage:?}: {said} lacks {part}"
+            );
+        }
+    }
+    // A supported combination's answer is never taken for none: one level, one layer and one
+    // sample, at an extent too small, still names the limit.
+    let l = layout(TextureType::Type2D, PixelFormat::RGBA8Unorm, 1, 1);
+    let plan = plan_image(&l, TextureUsage::RENDER_TARGET, false, &facts).expect(&name);
+    let least = vk::ImageFormatProperties {
+        max_extent: vk::Extent3D {
+            width: 1,
+            height: 1,
+            depth: 1,
+        },
+        max_mip_levels: 1,
+        max_array_layers: 1,
+        sample_counts: vk::SampleCountFlags::TYPE_1,
+        max_resource_size: 0,
+    };
+    let refused = check_image_limits(&plan, TextureType::Type2D, &least).unwrap_err();
+    assert_eq!(refused.feature, Feature::TextureSize);
+}
