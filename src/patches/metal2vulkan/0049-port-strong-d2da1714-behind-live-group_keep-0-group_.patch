diff --git a/crates/metal2vulkan-runtime/src/wbs_audit.rs b/crates/metal2vulkan-runtime/src/wbs_audit.rs
new file mode 100644
index 00000000..8e42469a
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/wbs_audit.rs
@@ -0,0 +1,166 @@
+//! LOCAL (Atlas, diagnostic): an audit of waits submitted before their signals.
+//!
+//! With `M2V_WBS_AUDIT=1` (read once per process), every `vkQueueSubmit` and `vkQueueBindSparse`
+//! the runtime makes, and every host `vkSignalSemaphore`, passes its timeline semaphores' waits
+//! and signals here first. A wait for a value above the highest one any submission or host
+//! signal so far asked of that semaphore is a wait before its signal: on a device of one
+//! `VkQueue` (Arrow Lake's ANV) a later submission on that queue can never run before it, so it
+//! holds until i915's fence timeout. Each such wait is written to stderr (at most
+//! [`MOST_LINES`]) with the submitting site; once the signal comes, how long after the wait.
+//! Off, each call is one relaxed load. Semaphores never signalled by a submission seen here (a
+//! caller's own, or one made with a value) are not judged.
+use ash::vk;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{LazyLock, Mutex};
+use std::time::Instant;
+
+/// The most lines written.
+const MOST_LINES: u64 = 400;
+
+static ON: LazyLock<bool> =
+    LazyLock::new(|| std::env::var_os("M2V_WBS_AUDIT").is_some_and(|v| v == "1"));
+static LINES: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Default)]
+struct Seen {
+    /// The highest value asked of each semaphore so far.
+    signalled: HashMap<u64, u64>,
+    /// Waits found early: (semaphore, value) -> (site, when).
+    early: Vec<(u64, u64, &'static str, Instant)>,
+}
+
+static SEEN: LazyLock<Mutex<Seen>> = LazyLock::new(|| Mutex::new(Seen::default()));
+
+fn line(text: String) {
+    if LINES.fetch_add(1, Ordering::Relaxed) < MOST_LINES {
+        eprintln!("m2v-wbs-audit: {text}");
+    }
+}
+
+fn judge(seen: &mut Seen, site: &'static str, waits: &[(vk::Semaphore, u64)]) {
+    for &(semaphore, value) in waits {
+        let key = vk::Handle::as_raw(semaphore);
+        let Some(&highest) = seen.signalled.get(&key) else {
+            continue;
+        };
+        if value > highest {
+            line(format!(
+                "{site}: waits for {key:#x} to reach {value}, asked only {highest} so far"
+            ));
+            seen.early.push((key, value, site, Instant::now()));
+        }
+    }
+}
+
+fn signal(seen: &mut Seen, site: &'static str, signals: &[(vk::Semaphore, u64)]) {
+    for &(semaphore, value) in signals {
+        let key = vk::Handle::as_raw(semaphore);
+        let highest = seen.signalled.entry(key).or_insert(0);
+        *highest = (*highest).max(value);
+        let mut i = 0;
+        while i < seen.early.len() {
+            let (s, v, at, when) = seen.early[i];
+            if s == key && v <= value {
+                line(format!(
+                    "{at}: its early wait for {key:#x} to reach {v} met by {site} {:.1} ms later",
+                    when.elapsed().as_secs_f64() * 1000.0
+                ));
+                seen.early.swap_remove(i);
+            } else {
+                i += 1;
+            }
+        }
+    }
+}
+
+/// # Safety
+/// `count` items at `semaphores`, and `values` either null or `count` items.
+unsafe fn pairs(
+    semaphores: *const vk::Semaphore,
+    values: *const u64,
+    count: u32,
+    values_count: u32,
+) -> Vec<(vk::Semaphore, u64)> {
+    if semaphores.is_null() || values.is_null() || count == 0 || values_count < count {
+        return Vec::new();
+    }
+    let n = count as usize;
+    // SAFETY: the caller's.
+    let (s, v) = unsafe {
+        (std::slice::from_raw_parts(semaphores, n), std::slice::from_raw_parts(values, n))
+    };
+    s.iter().copied().zip(v.iter().copied()).filter(|&(_, v)| v != 0).collect()
+}
+
+/// The timeline info in a `pNext` chain, if any.
+///
+/// # Safety
+/// `next` is a valid Vulkan `pNext` chain.
+unsafe fn timeline(mut next: *const std::ffi::c_void) -> Option<&'static vk::TimelineSemaphoreSubmitInfo<'static>> {
+    while !next.is_null() {
+        // SAFETY: every Vulkan structure starts with sType and pNext.
+        let base = unsafe { &*next.cast::<vk::BaseInStructure<'static>>() };
+        if base.s_type == vk::StructureType::TIMELINE_SEMAPHORE_SUBMIT_INFO {
+            // SAFETY: its type says so.
+            return Some(unsafe { &*next.cast::<vk::TimelineSemaphoreSubmitInfo<'static>>() });
+        }
+        next = base.p_next.cast();
+    }
+    None
+}
+
+/// A `vkQueueSubmit`'s infos, before the call.
+pub(crate) fn submits(site: &'static str, infos: &[vk::SubmitInfo<'_>]) {
+    if !*ON {
+        return;
+    }
+    let mut seen = SEEN.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    for info in infos {
+        // SAFETY: a submission the caller is about to make, so its pointers are valid.
+        let Some(t) = (unsafe { timeline(info.p_next) }) else {
+            continue;
+        };
+        // SAFETY: as above.
+        let (waits, signals) = unsafe {
+            (
+                pairs(info.p_wait_semaphores, t.p_wait_semaphore_values, info.wait_semaphore_count, t.wait_semaphore_value_count),
+                pairs(info.p_signal_semaphores, t.p_signal_semaphore_values, info.signal_semaphore_count, t.signal_semaphore_value_count),
+            )
+        };
+        judge(&mut seen, site, &waits);
+        signal(&mut seen, site, &signals);
+    }
+}
+
+/// A `vkQueueBindSparse`'s infos, before the call.
+pub(crate) fn binds(site: &'static str, infos: &[vk::BindSparseInfo<'_>]) {
+    if !*ON {
+        return;
+    }
+    let mut seen = SEEN.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    for info in infos {
+        // SAFETY: as in `submits`.
+        let Some(t) = (unsafe { timeline(info.p_next) }) else {
+            continue;
+        };
+        // SAFETY: as above.
+        let (waits, signals) = unsafe {
+            (
+                pairs(info.p_wait_semaphores, t.p_wait_semaphore_values, info.wait_semaphore_count, t.wait_semaphore_value_count),
+                pairs(info.p_signal_semaphores, t.p_signal_semaphore_values, info.signal_semaphore_count, t.signal_semaphore_value_count),
+            )
+        };
+        judge(&mut seen, site, &waits);
+        signal(&mut seen, site, &signals);
+    }
+}
+
+/// A host `vkSignalSemaphore`, before the call.
+pub(crate) fn host_signal(site: &'static str, info: &vk::SemaphoreSignalInfo<'_>) {
+    if !*ON {
+        return;
+    }
+    let mut seen = SEEN.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    signal(&mut seen, site, &[(info.semaphore, info.value)]);
+}
