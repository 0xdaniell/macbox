+
+/// A reader's record left out of a late batch's copy back while its command buffer is planned in
+/// part (`shadow_coherent::Fallback::PlanLeftPlanned`): it draws over a row, signals the writer,
+/// then waits for a gate before more work. The writer, released by that signal, writes the row
+/// through another import: Metal orders the write after the draw, and the reader's later work
+/// (another row) after the gate leaves it.
+#[test]
+fn surface_coherent_a_late_batch_keeps_its_write_past_a_reader_planned_in_part() {
+    on_surface(true, |case| {
+        let other_buffer = case.other_import();
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let before = shadow_coherent::fallback_counts();
+        let first = case.device.new_shared_event().unwrap();
+        let gate = case.device.new_shared_event().unwrap();
+        let reader = case.queue.command_buffer().unwrap();
+        case.pass(&reader, GREEN, scissor(0, 100, 16, 1));
+        reader.encode_signal_event((&first).into(), 1).unwrap();
+        reader.encode_wait_for_event((&gate).into(), 1).unwrap();
+        case.pass(&reader, GREEN, scissor(0, 200, 16, 1));
+        reader.commit().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let writer = other.command_buffer().unwrap();
+        writer.encode_wait_for_event((&first).into(), 1).unwrap();
+        let bytes: Vec<u8> = (0..16).flat_map(|_| [1u8, 2, 3, 4]).collect();
+        let source = staged(case.device, &bytes);
+        let mut blit = writer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&source, 0, &other_buffer, 100 * ROW, 64).unwrap();
+        blit.end_encoding().unwrap();
+        writer.commit().unwrap();
+        writer.wait_until_completed_for(SOON).unwrap();
+        gate.set_signaled_value(1);
+        reader.wait_until_completed_for(SOON).unwrap();
+        let after = shadow_coherent::fallback_counts();
+        eprintln!(
+            "PARTLY sync/back/left/left_planned={}/{}/{}/{} busy={} risk {} (9,100)={:?} (9,200)={:?}",
+            after.plan_syncs - before.plan_syncs,
+            after.plan_copies_back - before.plan_copies_back,
+            after.plan_left - before.plan_left,
+            after.plan_left_planned - before.plan_left_planned,
+            after.late_copies_in_busy - before.late_copies_in_busy,
+            shadow_coherent::report("partly").contains("\"overwrite_risk\":0"),
+            case.read(9, 100),
+            case.read(9, 200),
+        );
+        assert_eq!(case.read(9, 100), [1, 2, 3, 4], "the write, after the reader's draw");
+        assert_eq!(case.read(9, 200), GREEN_TEXEL, "the reader's work after the gate");
+    });
+}
+
+/// As above, the reader's work after the gate leaving the surface: no copy in after its wait
+/// takes the write, and the record lands its draw over it at its completion. A known gap, counted
+/// `plan_left_planned`; closing it needs each record's area by part.
+#[test]
+#[ignore = "known gap: plan_left_planned (ADOPT.md, known limits)"]
+fn surface_coherent_a_late_batch_keeps_its_write_past_a_reader_planned_in_part_elsewhere_after() {
+    on_surface(true, |case| {
+        let other_buffer = case.other_import();
+        case.draw(RED, None);
+        assert_eq!(case.read(0, 0), RED_TEXEL);
+        let before = shadow_coherent::fallback_counts();
+        let first = case.device.new_shared_event().unwrap();
+        let gate = case.device.new_shared_event().unwrap();
+        let reader = case.queue.command_buffer().unwrap();
+        case.pass(&reader, GREEN, scissor(0, 100, 16, 1));
+        reader.encode_signal_event((&first).into(), 1).unwrap();
+        reader.encode_wait_for_event((&gate).into(), 1).unwrap();
+        // Its work after the gate leaves the surface: no copy in after the wait.
+        let (from, to) = (staged(case.device, &[7u8; 64]), staged(case.device, &[0u8; 64]));
+        let mut blit = reader.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&from, 0, &to, 0, 64).unwrap();
+        blit.end_encoding().unwrap();
+        reader.commit().unwrap();
+        let other = case.device.new_command_queue().unwrap();
+        let writer = other.command_buffer().unwrap();
+        writer.encode_wait_for_event((&first).into(), 1).unwrap();
+        let bytes: Vec<u8> = (0..16).flat_map(|_| [1u8, 2, 3, 4]).collect();
+        let source = staged(case.device, &bytes);
+        let mut blit = writer.blit_command_encoder().unwrap();
+        blit.copy_from_buffer_to_buffer(&source, 0, &other_buffer, 100 * ROW, 64).unwrap();
+        blit.end_encoding().unwrap();
+        writer.commit().unwrap();
+        writer.wait_until_completed_for(SOON).unwrap();
+        gate.set_signaled_value(1);
+        reader.wait_until_completed_for(SOON).unwrap();
+        let after = shadow_coherent::fallback_counts();
+        eprintln!(
+            "PARTLY-ELSEWHERE sync/back/left/left_planned={}/{}/{}/{} busy={} risk {} (9,100)={:?} (9,200)={:?}",
+            after.plan_syncs - before.plan_syncs,
+            after.plan_copies_back - before.plan_copies_back,
+            after.plan_left - before.plan_left,
+            after.plan_left_planned - before.plan_left_planned,
+            after.late_copies_in_busy - before.late_copies_in_busy,
+            shadow_coherent::report("partly").contains("\"overwrite_risk\":0"),
+            case.read(9, 100),
+            case.read(9, 200),
+        );
+        assert_eq!(case.read(9, 100), [1, 2, 3, 4], "the write, after the reader's draw");
+    });
+}
