     };
-    CopyBack::new(device, *words, part.raw, &region)
+    let back = CopyBack::new(device, *words, part.raw, &region);
+    if back.is_some() {
+        // LOCAL (Atlas): diagnostics.
+        let e = region.image_extent;
+        crate::shadow::count_back_site(2, u64::from(e.width) * u64::from(e.height));
+    }
+    back
 }
 
