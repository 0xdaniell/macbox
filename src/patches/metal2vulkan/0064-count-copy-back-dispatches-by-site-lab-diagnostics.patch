diff --git a/crates/metal2vulkan-runtime/src/shadow.rs b/crates/metal2vulkan-runtime/src/shadow.rs
index 1211c06a..f00d845d 100644
--- a/crates/metal2vulkan-runtime/src/shadow.rs
