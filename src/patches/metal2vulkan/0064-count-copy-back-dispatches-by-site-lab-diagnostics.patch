@@ -196,6 +196,20 @@ pub(crate) const BACK_WHY_NAMES: [&str; 12] = [
     "ahead-not-alone", "ahead-merge", "ahead-no-lazy", "ahead-refused", "other",
 ];
 const BACK_WHY_MIN_TEXELS: u64 = 2_000_000;
+/// LOCAL (Atlas, lab diagnostics): copy-back dispatches recorded, by site
+/// ([`BACK_SITE_NAMES`]): `[large (at least BACK_WHY_MIN_TEXELS moved)?][site]` counts and texels.
+pub(crate) static BACK_SITE: [[std::sync::atomic::AtomicU64; 4]; 2] =
+    [const { [const { std::sync::atomic::AtomicU64::new(0) }; 4] }; 2];
+pub(crate) static BACK_SITE_TEXELS: [[std::sync::atomic::AtomicU64; 4]; 2] =
+    [const { [const { std::sync::atomic::AtomicU64::new(0) }; 4] }; 2];
+pub(crate) const BACK_SITE_NAMES: [&str; 4] = ["encoder", "late-batch", "merge-copy", "other"];
+/// LOCAL (Atlas): count one copy-back dispatch of `texels` texels at `site`.
+pub(crate) fn count_back_site(site: usize, texels: u64) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let large = usize::from(texels >= 1_000_000);
+    BACK_SITE[large][site].fetch_add(1, Relaxed);
+    BACK_SITE_TEXELS[large][site].fetch_add(texels, Relaxed);
+}
 use std::ops::Range;
 use std::sync::atomic::{AtomicU64, Ordering};
 use std::sync::Arc;
diff --git a/crates/metal2vulkan-runtime/src/shadow_lazy.rs b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
index 9061bd11..8ef612fc 100644
--- a/crates/metal2vulkan-runtime/src/shadow_lazy.rs
+++ b/crates/metal2vulkan-runtime/src/shadow_lazy.rs
@@ -1025,6 +1025,18 @@ fn report() {
             eprintln!("copy_back_why {name}: {}", parts.join(" "));
         }
     }
+    for (large, name) in [(1usize, ">=1M"), (0, "<1M")] {
+        let parts: Vec<String> = (0..4)
+            .filter_map(|w| {
+                let n = super::shadow::BACK_SITE[large][w].load(Ordering::Relaxed);
+                let t = super::shadow::BACK_SITE_TEXELS[large][w].load(Ordering::Relaxed);
+                (n > 0).then(|| format!("{} {n}/{}M", super::shadow::BACK_SITE_NAMES[w], t / 1_000_000))
+            })
+            .collect();
+        if !parts.is_empty() {
+            eprintln!("copy_back_site {name}: {}", parts.join(" "));
+        }
+    }
     for lazy in surfaces().iter().take(16) {
         eprintln!(
             "surface_lazy:   {:#x} {}x{} displayed {} taken {} refused {} in {} presents {}",
diff --git a/crates/metal2vulkan-runtime/src/shadow_merge.rs b/crates/metal2vulkan-runtime/src/shadow_merge.rs
