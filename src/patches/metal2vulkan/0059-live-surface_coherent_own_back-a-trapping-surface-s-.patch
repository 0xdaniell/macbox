From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Sun, 8 Nov 2026 04:54:34 +0000
Subject: [PATCH 59/92] live surface_coherent_own_back: a trapping surface's
 encoder-end copy back is its own

Its plain copy back of its own image counted as a write beside the image, so each held batch after
it copied those texels in again over records still running (coherent taking_beside risk, 3 Sims).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/metal2vulkan-runtime/src/encoder.rs | 28 +++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/crates/metal2vulkan-runtime/src/encoder.rs b/crates/metal2vulkan-runtime/src/encoder.rs
index e3a282da..d7cb1ae1 100644
--- a/crates/metal2vulkan-runtime/src/encoder.rs
+++ b/crates/metal2vulkan-runtime/src/encoder.rs
@@ -1588,6 +1588,32 @@ impl EncoderCore {
     /// at the copy in where the device takes it (`shadow_copy_in.rs`), and the rows a copy back
     /// moves out of a staging buffer are a copy of rows (`row_copies.rs`); the command buffer
     /// retains each until it completes.
+    /// LOCAL (Atlas): the encoder's end's copies back, as [`shadow_copies`](Self::shadow_copies)
+    /// records them. With the live switch `surface_coherent_own_back` (default off), a trapping
+    /// lazy surface's plain copy back of its own image records as its own (`Lazy::own`): its
+    /// bytes then hold what the image holds, which no other import wrote, where before it counted
+    /// as a write beside the image (`shadow_lazy::note_writes`), and each held batch after it
+    /// copied those texels in again, over a record still running there (the coherent census's
+    /// `taking_beside` risk, 3 Sims, 2026-11-08). A merge's copy back keeps the CPU's texels and
+    /// still counts.
+    fn end_copies(&mut self, copies: &[ShadowCopy]) {
+        let own = |copy: &ShadowCopy| {
+            (matches!(copy.step, Step::Back))
+                .then(|| copy.copies.lazy.clone())
+                .flatten()
+                .filter(|lazy| lazy.coherent().is_some())
+        };
+        if !crate::live::on("surface_coherent_own_back", false) || !copies.iter().any(|c| own(c).is_some()) {
+            self.shadow_copies(copies);
+            return;
+        }
+        for copy in copies {
+            let lazy = own(copy);
+            let _own = lazy.as_ref().map(|lazy| lazy.own());
+            self.shadow_copies(std::slice::from_ref(copy));
+        }
+    }
+
     pub(super) fn shadow_copies(&mut self, copies: &[ShadowCopy]) {
         let device = self.device().clone();
         let mut run = ShadowRun::default();
@@ -2031,7 +2057,7 @@ impl EncoderCore {
         let copies = self.shadows.finish_leaving_ahead();
         let copies = self.sample_moves(copies);
         self.count_shadow_copies(&copies);
-        self.shadow_copies(&copies);
+        self.end_copies(&copies);
         // Whether it keeps its log, once its last commands, the copies back above among them,
         // named what they name: a copy back may be the only command that names a texture's
         // bytes over host pages (a render pass that clears a shadowed target copies nothing in).
