+    fn reads_itself(&self, load: LoadAction, [x0, y0, x1, y1]: [u64; 4]) {
+        let mut d = RenderPipelineDescriptor::new(function(self.device, "tob_rect", "tob_renders.ll"));
+        d.fragment = Some(function(self.device, "tob_read", "tob_renders.ll"));
+        d.color_attachments[0] = Some(ColorAttachmentDescriptor::new(PixelFormat::BGRA8Unorm));
+        let state = (self.device.new_render_pipeline_state(&d, &PipelineOptions::default())).unwrap();
+        let mut descriptor = RenderPassDescriptor::new();
+        let attachment = &mut descriptor.color_attachments[0];
+        attachment.texture = self.texture.clone();
+        attachment.load_action = load;
+        attachment.store_action = StoreAction::Store;
+        let (x, y) = (
+            |p: u64| p as f32 / WIDTH as f32 * 2.0 - 1.0,
+            |p: u64| 1.0 - p as f32 / HEIGHT as f32 * 2.0,
+        );
+        let command_buffer = self.queue.command_buffer().unwrap();
+        let mut encoder = command_buffer.render_command_encoder(&descriptor).unwrap();
+        encoder.set_render_pipeline_state(&state).unwrap();
+        encoder.set_vertex_bytes(&floats4([x(x0), y(y1), x(x1), y(y0)]), 0).unwrap();
+        encoder.set_fragment_texture(self.texture.as_ref(), 0).unwrap();
+        encoder.draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0).unwrap();
+        encoder.end_encoding().unwrap();
+        run(&command_buffer);
+    }
+
     fn other_import(&self) -> Buffer {
         surface_buffer(self.device, &self.mapping, self.len)
     }
