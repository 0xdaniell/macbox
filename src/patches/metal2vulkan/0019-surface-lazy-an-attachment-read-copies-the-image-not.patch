+/// LOCAL (Atlas): `shadows` with, first, a read of the shadow each copies the image of, inside what
+/// the copy reads, where one does: `None` where none does. Whatever the command does to that image
+/// (a clear takes no copy in, a pass that reaches no tile no use at all), the copy reads it as the
+/// truth, as a copy of the bytes would.
+fn reads_truths(shadows: &[ShadowUse]) -> Option<Vec<ShadowUse>> {
+    if !shadows.iter().any(|shadow| shadow.copies.over().is_some()) {
+        return None;
+    }
+    let mut with = Vec::with_capacity(shadows.len() + 1);
+    for shadow in shadows {
+        if let Some(over) = shadow.copies.over() {
+            let read = ShadowUse {
+                copies: Arc::clone(over),
+                writes: false,
+                overwrites: false,
+                kept: false,
+                area: None,
+                loads: shadow.loads,
+            };
+            join(&mut with, &read);
+        }
+    }
+    for shadow in shadows {
+        join(&mut with, shadow);
+    }
+    Some(with)
+}
