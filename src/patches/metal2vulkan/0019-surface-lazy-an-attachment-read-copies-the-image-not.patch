+/// Without traps the image holds only what its commands asked for: a draw that reads past what its
+/// pass loads gets it all the same.
+#[test]
+fn surface_lazy_a_draw_that_reads_its_surface_reads_past_its_scissor() {
+    on_surface(false, |case| {
+        case.draw(GREEN, None);
+        wait_for_pages(&case, 1, 1, GREEN_TEXEL);
+        case.reads_itself(LoadAction::Load, [4, 4, 8, 8]);
+        case.draw(RED, scissor(4, 4, 4, 4));
+        wait_for_pages(&case, 5, 5, RED_TEXEL);
+        assert_eq!(case.behind(3, 3), GREEN_TEXEL);
+    });
+}
