+/// A draw that reads the surface it renders reads a copy of the image, not of the pages: what lies
+/// ahead in the image stays there, though the draw reads it, and comes back at the guest's read.
+#[test]
+fn surface_coherent_a_draw_that_reads_its_surface_leaves_it_ahead() {
+    on_surface(true, |case| {
+        case.draw(RED, None);
+        assert_eq!(case.read(5, 5), RED_TEXEL);
+        for _ in 0..3 {
+            case.draw(GREEN, None);
+            case.reads_itself(LoadAction::Load, [0, 0, 8, 8]);
+            assert_eq!(case.behind(1, 1), RED_TEXEL, "nothing went through the pages");
+        }
+        assert_eq!(case.count("flushes"), 0, "no GPU work for the pages");
+        assert_eq!(case.read(1, 1), GREEN_TEXEL, "the draw read what lay ahead");
+        assert_eq!(case.read(100, 100), GREEN_TEXEL);
+    });
+}
+
+/// A pass that clears the surface and reads it reads it as it was, a CPU write of it among that:
+/// its image takes the write though the clear would need no copy in.
+#[test]
+fn surface_coherent_a_clear_that_reads_its_surface_reads_a_cpu_write() {
+    on_surface(true, |case| {
+        case.draw(GREEN, None);
+        case.read(0, 0);
+        case.write(7, 7, [1, 2, 3, 4]);
+        case.reads_itself(LoadAction::Clear, [0, 0, 16, 16]);
+        assert_eq!(case.read(7, 7), [1, 2, 3, 4]);
+        assert_eq!(case.read(1, 1), GREEN_TEXEL);
+        assert_eq!(case.read(100, 100), [0, 0, 0, 255], "cleared outside the draw");
+    });
+}
