+/// The bytes reach `texel` at `x`, `y` once the clock copied them back.
+fn wait_for_pages(case: &Case<'_>, x: u64, y: u64, texel: [u8; 4]) {
+    let start = Instant::now();
+    while case.behind(x, y) != texel && start.elapsed() < SOON {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert_eq!(case.behind(x, y), texel);
+}
