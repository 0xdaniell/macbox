+/// LOCAL (Atlas): a shadow of `texture`'s own image, as an attachment read of a lazy surface takes
+/// (`texture/usage_shadow.rs`).
+fn image_of(texture: &Arc<ShadowCopies>) -> Arc<ShadowCopies> {
+    let mut copies = Arc::into_inner(image_shadow(texture.shadow_key, 0, 1)).expect("one holder");
+    if let ShadowSource::Image { over, .. } = &mut copies.source {
+        *over = Some(Arc::clone(texture));
+    }
+    Arc::new(copies)
+}
+
+/// A copy of a shadow's image reads that image as the truth: the image takes the bytes first,
+/// though the command names only the copy, though it clears the image, and wherever the copy reads
+/// past what the command does to the image.
+#[test]
+fn a_copy_of_a_shadows_image_copies_that_shadow_in_first() {
+    let buffer = ResourceKey::new();
+    let t = cut_shadow(buffer, 0..1024);
+    let s = image_of(&t);
+    let mut sync = ShadowSync::default();
+    assert_eq!(
+        command(&mut sync, &[(&s, false)], &[]),
+        [(t.shadow_key, true), (s.shadow_key, true)]
+    );
+
+    let (mut cleared, cleared_use) = through(&t, true);
+    cleared.overwrites = true;
+    let (read, read_use) = through(&s, false);
+    let (shadows, uses) = ([cleared, read], [cleared_use, read_use]);
+    let copies = ShadowSync::<u32>::default()
+        .before(&shadows, &uses, |_, _, _| Ok(0))
+        .unwrap();
+    // A keep follows: such a texture merges what it writes back.
+    assert_eq!(named(&copies[..2]), [(t.shadow_key, true), (s.shadow_key, true)]);
+
+    let (mut drawn, drawn_use) = through(&t, true);
+    (drawn.area, drawn.loads) = (Some([10, 10, 20, 20]), Some([10, 10, 20, 20]));
+    let (mut read, read_use) = through(&s, false);
+    read.loads = Some([9, 9, 21, 21]);
+    let (shadows, uses) = ([drawn, read], [drawn_use, read_use]);
+    let copies = ShadowSync::<u32>::default()
+        .before(&shadows, &uses, |_, _, _| Ok(0))
+        .unwrap();
+    assert_eq!(
+        (copies[0].area, copies[1].area),
+        (Some([9, 9, 21, 21]), Some([9, 9, 21, 21]))
+    );
+}
+
+/// What changes the image goes on to its copy: a write of the bytes reaches the image at its next
+/// copy in, and only that says the copy is behind.
+#[test]
+fn a_copy_in_of_a_shadows_image_leaves_a_copy_of_it_behind() {
+    let buffer = ResourceKey::new();
+    let t = cut_shadow(buffer, 0..1024);
+    let s = image_of(&t);
+    let mut sync = ShadowSync::default();
+    command(&mut sync, &[(&s, false)], &[]);
+    assert_eq!(command(&mut sync, &[(&s, false)], &[]), []);
+    assert_eq!(command(&mut sync, &[], &[bytes(buffer, 0..4, true)]), []);
+    assert_eq!(
+        command(&mut sync, &[(&s, false)], &[]),
+        [(t.shadow_key, true), (s.shadow_key, true)]
+    );
+}
+
+/// A copy of a shadow's image goes to no later encoder: the bytes' writes it would miss there are
+/// that shadow's to see.
+#[test]
+fn a_copy_of_a_shadows_image_is_carried_to_no_later_encoder() {
+    let buffer = ResourceKey::new();
+    let t = cut_shadow(buffer, 0..1024);
+    let s = image_of(&t);
+    let mut sync = ShadowSync::default();
+    command(&mut sync, &[(&s, false)], &[]);
+    let mut next: ShadowSync<u32> = ShadowSync::carrying(sync.ended());
+    next.wrote(&[bytes(buffer, 0..4, true)]);
+    assert_eq!(
+        command(&mut next, &[(&s, false)], &[]),
+        [(t.shadow_key, true), (s.shadow_key, true)]
+    );
+}
