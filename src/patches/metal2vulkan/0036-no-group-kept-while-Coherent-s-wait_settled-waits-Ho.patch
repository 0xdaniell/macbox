diff --git a/crates/metal2vulkan-runtime/src/shadow_coherent.rs b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
index 7cbcbee4..dee6bf93 100644
--- a/crates/metal2vulkan-runtime/src/shadow_coherent.rs
+++ b/crates/metal2vulkan-runtime/src/shadow_coherent.rs
@@ -1204,6 +1204,10 @@ impl Coherent {
         skip_held: bool,
     ) -> (MutexGuard<'a, State>, bool) {
         let until = Instant::now() + Duration::from_millis(knob("surface_coherent_wait_ms", DEFAULT_WAIT_MS));
+        // LOCAL (Atlas, DEEP-GPU): while it waits, no submission group is kept, so a record held
+        // in one goes now and is seen complete at its own end, not after later batches
+        // (`command_buffer::HostWait`, VM-A's review of grouped submissions).
+        let mut host_wait = None;
         loop {
             // With `skip_held`, a record held for an event is not waited for: on the command
             // thread (an encoder's take, a reader's copy back) its signal comes from the guest
@@ -1220,6 +1224,15 @@ impl Coherent {
             if left.is_zero() {
                 return (state, false);
             }
+            if host_wait.is_none() {
+                // The scheduler is woken without this surface's lock held (its submissions take
+                // it, `before_flush`), and what is busy is looked at again after.
+                drop(state);
+                let lazy = self.lazy.upgrade();
+                host_wait = Some(super::command_buffer::HostWait::begin(lazy.as_deref().and_then(Lazy::device)));
+                state = self.lock();
+                continue;
+            }
             let (guard, _) = self.moved.wait_timeout(state, left).unwrap_or_else(|e| e.into_inner());
             state = guard;
         }
