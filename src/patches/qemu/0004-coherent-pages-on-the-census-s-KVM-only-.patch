+static int coherent_on_sigbus(CensusVcpu *vc, void **addr, uint64_t page, uint32_t w)
+{
+    uint32_t st = PW_ST(w), id = PW_ID(w);
+    uint64_t start, rip;
+    bool write;
+
+    if (st != ST_ARMED && st != ST_FROZEN) {
+        /* A thread moved the page meanwhile, and the access reruns; real poison stays armed. */
+        if (vc->spin_addr == *addr) {
+            if (++vc->spins > SPIN_LIMIT) {
+                *addr = census.main_map + ((uint8_t *)*addr - census.view);
+                return CENSUS_NOT_OURS;
+            }
+        } else {
+            vc->spin_addr = *addr;
+            vc->spins = 0;
+        }
+        atomic_fetch_add(&census.spurious, 1);
+        return CENSUS_HANDLED;
+    }
+    vc->spin_addr = NULL;
+    start = now_ns();
+    rip = vcpu_rip(vc);
+    write = vc->probe_rip && vc->probe_rip == rip;
+    vc->probe_rip = 0;
+    census.ops.fault(census.ops.ctx, coh_addr(id, page), write);
+    /* The library answers for its pages; a page still marked here would trap forever. */
+    w = atomic_load(&census.pg[page]);
+    if (PW_ST(w) == ST_ARMED || PW_ST(w) == ST_FROZEN) {
+        uint64_t at = coh_addr(id, page);
+
+        if (PW_ST(w) == ST_ARMED) {
+            census_coh_hold(&at, 1, false, NULL, 0);
+        } else {
+            census_coh_thaw(&at, 1);
+        }
+    }
+    vc->pending = write ? -1 : (int64_t)page;
+    vc->pending_rip = rip;
+    vc->efault_first = 0;
+    atomic_fetch_add(&census.traps, 1);
+    if (write) {
+        atomic_fetch_add(&census.writes, 1);
+    }
+    census.ops.timed(census.ops.ctx, coh_addr(id, page), now_ns() - start);
+    return CENSUS_HANDLED;
+}
