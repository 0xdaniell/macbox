+static void coh_runs(const uint64_t *addrs, size_t n, uint32_t mask, RunFn *fn, void *arg)
+{
+    uint32_t id = 0;
+    uint64_t index = 0, first = 0, count = 0;
+    Surface *s = n ? coh_surface(addrs[0], &id, &index) : NULL;
+    bool any_held = false;
+
+    if (!s) {
+        return;
     }
-    pthread_mutex_unlock(&census.lock);
-    if (now - vc->efault_first > FATAL_AFTER_NS) {
