+/* Where the pages a vCPU reached as their markers moved go. */
+typedef struct Came {
+    uint64_t *out;
+    size_t room, found;
+} Came;
+
+/*
+ * HELD -> ARMED. Poison needs a bare PTE, so the write protection goes first, and a write between
+ * the two would go unseen. So the mapping goes before it, the protection staying behind as a PTE
+ * marker: then a write needs a mapping, and POISON refuses a page mapped. A page it refuses may
+ * hold a write, and it may be what the vCPU's about to read, so there is no retrying it: it goes
+ * back to held, and the library hears, and has what the arm would have left to the page's trap.
+ */
+static void coh_arm_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    Came *refused = arg;
+    uint64_t at = first, end = first + count;
+    int tries = 0;
+
+    page_drop(first, count);
+    if (page_wp(first, count, false)) {
+        count_error("WP off for arming", first);
+    }
+    while (at < end) {
+        struct uffdio_poison z = {
+            .range = { (uint64_t)census.view + (at << PG_SHIFT), (end - at) << PG_SHIFT },
+        };
+        uint64_t done;
+
+        if (ioctl(census.uffd, UFFDIO_POISON, &z) == 0) {
+            store_pages(at, end - at, ST_ARMED, id);
+            return;
+        }
+        done = z.updated > 0 ? (uint64_t)z.updated >> PG_SHIFT : 0;
+        store_pages(at, done, ST_ARMED, id);
+        at += done;
+        if (at == end) {
+            return;
+        }
+        if (errno == EAGAIN && ++tries < POISON_TRIES) {
+            continue;
+        }
+        if (errno != EEXIST) {
+            count_error("poison", at);
+        }
+        page_drop(at, 1);
+        if (page_wp(at, 1, true)) {
+            count_error("WP on", at);
+        }
+        store_pages(at, 1, ST_HELD, id);
+        if (refused->found < refused->room) {
+            refused->out[refused->found++] = coh_addr(id, at);
+        }
+        at++;
+        tries = 0;
+    }
+}
+
+/*
+ * Between the poison's going and the write protection a vCPU may have faulted a page in, and
+ * written it: any page the view maps now did so, as the drop left none mapped.
+ */
+static void came_in(uint64_t first, uint64_t count, uint32_t id, Came *came)
+{
+    uint64_t bits[512];
+
+    for (uint64_t at = first; at < first + count && came->found < came->room;) {
+        uint64_t batch = MIN(first + count - at, sizeof(bits) / sizeof(bits[0]));
+        off_t place = ((uint64_t)census.view >> PG_SHIFT) + at;
+        ssize_t got = pread(census.pagemap, bits, batch * sizeof(bits[0]), place * sizeof(bits[0]));
+
+        for (ssize_t i = 0; i < got / (ssize_t)sizeof(bits[0]) && came->found < came->room; i++) {
+            if (bits[i] >> 63) {
+                came->out[came->found++] = coh_addr(id, at + i);
+            }
+        }
+        at += batch;
+    }
+}
+
+static void coh_held_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    /* A page in the run that was open keeps a mapping: it reads and writes as it pleases. */
+    page_drop(first, count);
+    if (page_wp(first, count, true)) {
+        count_error("WP on", first);
+    }
+    store_pages(first, count, ST_HELD, id);
+    if (arg) {
+        came_in(first, count, id, arg);
+    }
+}
+
+size_t census_coh_arm(const uint64_t *addrs, size_t n, uint64_t *refused, size_t room)
+{
+    Came found = { refused, room, 0 };
+
+    if (!atomic_load(&census.dead)) {
+        coh_runs(addrs, n, MASK(ST_HELD), coh_arm_run, &found);
+    }
+    return found.found;
+}
+
+size_t census_coh_hold(const uint64_t *addrs, size_t n, bool open_too, uint64_t *came, size_t room)
+{
+    uint32_t mask = MASK(ST_ARMED) | (open_too ? MASK(ST_OPEN) : 0);
+    Came found = { came, room, 0 };
+
+    coh_runs(addrs, n, mask, coh_held_run, came && census.pagemap >= 0 ? &found : NULL);
+    return found.found;
+}
+
+void census_coh_open(uint64_t addr)
+{
+    coh_runs(&addr, 1, MASK(ST_HELD), open_held, NULL);
+}
+
+static void coh_freeze_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    page_drop(first, count);
+    for (uint64_t at = first; at < first + count; at++) {
+        struct uffdio_poison z = {
+            .range = { (uint64_t)census.view + (at << PG_SHIFT), PG },
+        };
+
+        /* A vCPU writing the page wins some of these; a merge needs it out, so it loses in time. */
+        for (int tries = 0;; tries++) {
+            if (ioctl(census.uffd, UFFDIO_POISON, &z) == 0) {
+                break;
+            }
+            if (tries == FREEZE_TRIES) {
+                count_error("poison to freeze", at);
+                break;
+            }
+            if (errno == EEXIST) {
+                page_drop(at, 1);
+            }
+        }
+    }
+    store_pages(first, count, ST_FROZEN, id);
+}
+
+static void coh_thaw_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    page_drop(first, count);
+    store_pages(first, count, ST_OPEN, id);
+}
+
+void census_coh_freeze(const uint64_t *addrs, size_t n)
+{
+    coh_runs(addrs, n, MASK(ST_OPEN), coh_freeze_run, NULL);
+}
+
+void census_coh_thaw(const uint64_t *addrs, size_t n)
+{
+    coh_runs(addrs, n, MASK(ST_FROZEN), coh_thaw_run, NULL);
+}
