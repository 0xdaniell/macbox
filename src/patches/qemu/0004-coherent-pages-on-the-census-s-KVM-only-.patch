+/* An -EFAULT: is it worth another try? Unanswered, the fuses go as in census_on_efault. */
+static bool efault_again(CensusVcpu *vc, bool at_once)
+{
+    uint64_t now = now_ns();
+
+    if (!vc->efault_first || now - vc->efault_last > EFAULT_GAP_NS) {
+        vc->efault_first = now;
+    }
+    vc->efault_last = now;
+    if (now - vc->efault_first > FUSE_AFTER_NS) {
+        census_fuse("an -EFAULT no held page explains");
+    }
+    if (now - vc->efault_first > FATAL_AFTER_NS) {
+        return false;
+    }
+    if (!at_once) {
+        usleep(20);
+    }
+    return true;
+}
+
+static bool coherent_on_efault(CensusVcpu *vc)
+{
+    uint64_t rip = vcpu_rip(vc);
+
+    if (vc->pending >= 0 && vc->pending_rip == rip) {
+        uint64_t page = vc->pending;
+        uint32_t w = atomic_load(&census.pg[page]);
+
+        vc->pending = -1;
+        if (PW_ST(w) == ST_HELD) {
+            census.ops.fault(census.ops.ctx, coh_addr(PW_ID(w), page), true);
+            atomic_fetch_add(&census.writes, 1);
+            vc->efault_first = 0;
+            return true;
+        }
+    }
+    vc->pending = -1;
+    if (atomic_load(&census_coherent_pages) && !atomic_load(&census.dead)) {
+        vc->probe_rip = rip;
+        atomic_fetch_add(&census.upgrades, 1);
+        census.ops.probe(census.ops.ctx);
+        return efault_again(vc, true);
+    }
+    return efault_again(vc, false);
+}
