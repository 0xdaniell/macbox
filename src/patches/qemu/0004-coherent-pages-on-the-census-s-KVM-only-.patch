+/* Every marker off the surface, its pages left open. */
+static void coh_free_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    if (any_held) {
+        page_wp(first, count, false);
+    }
+    page_drop(first, count);
+    store_pages(first, count, ST_OPEN, id);
+}
+
+static void coh_untrack_locked(Surface *s, uint32_t id)
+{
+    if (s->tracked) {
+        s->tracked = false;
+        atomic_fetch_sub(&census_coherent_pages, s->page_total);
+        take_pages(s, id, MASK(ST_ARMED) | MASK(ST_HELD) | MASK(ST_FROZEN), true, coh_free_run,
+                   NULL);
+    }
+}
+
+void census_coh_untrack(uint64_t start)
+{
+    uint32_t id;
+    uint64_t index;
+    Surface *s;
+
+    if (!census.active || !census.coherent) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    s = coh_surface(start, &id, &index);
+    if (s) {
+        coh_untrack_locked(s, id);
+    }
+    pthread_mutex_unlock(&census.lock);
+}
