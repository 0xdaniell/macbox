+/* LOCAL (Atlas): reads guest memory for the census's instruction bytes. */
+static void kvm_census_read_gpa(void *opaque, uint64_t gpa, void *buf, unsigned len)
+{
+    address_space_read(&address_space_memory, gpa, MEMTXATTRS_UNSPECIFIED, buf, len);
+}
+
+static CensusVcpu *kvm_census_vcpu(CPUState *cpu)
+{
+    return census_vcpu(cpu->cpu_index, cpu->kvm_fd, cpu, kvm_census_read_gpa);
+}
+
+/*
+ * REIMS_VGPU_CENSUS_SELFTEST=<offset>:<length>, in hex, bytes of the RAM block named "ram": arms
+ * a surface no library told of, so that a guest with no GPU device can drive the census.
+ */
+static void kvm_census_selftest(void)
+{
+    const char *test = getenv("REIMS_VGPU_CENSUS_SELFTEST");
+    uint64_t offset, length;
+    RAMBlock *block;
+    g_autofree uint64_t *pages = NULL;
+    CensusSurface facts = { .mapping_id = 1, .width = 4096, .height = 4096 };
+
+    if (!test || sscanf(test, "%" SCNx64 ":%" SCNx64, &offset, &length) != 2) {
+        return;
+    }
+    block = qemu_ram_block_by_name("ram");
+    if (!block) {
+        return;
+    }
+    pages = g_new(uint64_t, length >> 12);
+    for (uint64_t i = 0; i < length >> 12; i++) {
+        pages[i] = (uint64_t)block->host + offset + (i << 12);
+    }
+    census_surface_mapped(&facts, pages, length >> 12, 4096);
+}
+
+static void kvm_census_reset(void *opaque)
+{
+    census_reset();
+    kvm_census_selftest();
+}
+
+/*
+ * LOCAL (Atlas): the address KVM gets for main-mapping address ram: the census's KVM-only view
+ * for a memslot of guest RAM, when the census is on (accel/kvm/census.c); otherwise ram, and
+ * nothing is mapped. slot->ram stays the main mapping's, for kvm_physical_memory_addr_from_host.
+ * ROMs, pflash and every other block have no fd of this kind, or are too small to hold a surface.
+ */
+static void *kvm_census_hva(void *ram)
+{
+    ram_addr_t offset;
+    RAMBlock *block;
+
+    if (likely(!census_wanted())) {
+        return ram;
+    }
+    if (!census_active()) {
+        block = qemu_ram_block_from_host(ram, false, &offset);
+        if (!block || block->fd < 0 || !qemu_ram_is_shared(block) ||
+            block->page_size != 4096 || block->used_length < 256 * MiB) {
+            return ram;
+        }
+        if (!census_start(block->fd, block->fd_offset, block->host, block->used_length)) {
+            return ram;
+        }
+        qemu_register_reset(kvm_census_reset, NULL);
+    }
+    return census_hva(ram);
+}
