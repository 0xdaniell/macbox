+#include <fcntl.h>
+#include <inttypes.h>
+#include <linux/kvm.h>
+#include <linux/userfaultfd.h>
+#include <pthread.h>
+#include <sched.h>
+#include <semaphore.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "system/kvm_census.h"
+
+#ifndef MIN
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MAX(a, b) ((a) > (b) ? (a) : (b))
+#endif
+
+#define PG 4096ULL
+#define PG_SHIFT 12
+#define RING_SIZE 8192 /* a power of two */
+#define TOP_RIPS 8
+#define RIP_SEEN_SLOTS (1 << 16)
+#define POISON_TRIES 4
+#define SPIN_LIMIT 100000 /* about 0.5 s of repeated SIGBUS on one page: real poison */
+/* An -EFAULT unanswered this long is no race: first the markers go, then QEMU's fatal path. */
+#define EFAULT_GAP_NS 5000000
+#define FUSE_AFTER_NS 20000000
+#define FATAL_AFTER_NS 120000000
+
+/* A page's word: the state's three bits, then the mapping id. 0 is a page never armed. */
+enum { ST_NONE, ST_ARMED, ST_HELD, ST_OPEN, ST_SKIP, ST_WORK, ST_STALE };
+#define PW(st, id) (((uint32_t)(st) << 29) | (id))
+#define PW_ST(w) ((w) >> 29)
+#define PW_ID(w) ((w) & 0x1fffffffu)
+
+enum { REC_TOUCH, REC_WRITE, REC_UPGRADE };
+
+typedef struct Rec {
+    uint64_t rip;
+    uint64_t cr3;
+    uint32_t page;
+    uint32_t serial;
+    uint16_t id;
+    uint8_t kind;
+    uint8_t cpl;
+    uint8_t ncode;
+    uint8_t code[15];
+} Rec;
+
+struct CensusVcpu {
+    int index;
+    int fd;
+    void *opaque;
+    CensusReadGpa *read_gpa;
+    /* The page this vCPU trapped on last, while its instruction may be rerunning. */
+    int64_t pending;
+    uint64_t pending_rip;
+    void *spin_addr;
+    uint32_t spins;
+    uint64_t efault_first;
+    uint64_t efault_last;
+    uint64_t seen[256];
+    _Atomic uint32_t head;
+    _Atomic uint32_t tail;
+    Rec ring[RING_SIZE];
+};
+
+typedef struct Run {
+    uint32_t first;
+    uint32_t count;
+} Run;
+
+typedef struct RipCount {
+    uint64_t rip;
+    uint64_t count;
+} RipCount;
+
+/* The running totals of a surface, and of the tick written next. */
+typedef struct Tally {
+    uint64_t traps, writes, upgrades;
+    uint64_t pages_r, pages_w, pages_skip;
+    uint64_t windows_touched, windows_saturated;
+    uint64_t cpl0, cpl3;
+    uint64_t vcpus;
+    RipCount rips[TOP_RIPS];
+} Tally;
+
+typedef struct Surface {
+    bool live;
+    uint32_t serial;
+    Run *runs;
+    uint32_t run_count;
+    uint64_t armed_pages;
+    uint64_t overlaps;
+    uint64_t foreign;
+    uint64_t presents_at_map;
+    uint64_t windows_at_map;
+    uint64_t max_window_pages;
+    uint64_t presents_at_tick;
+    Tally total;
+    Tally tick;
+    _Atomic uint64_t presents;
+    _Atomic uint32_t window_traps;
+    _Atomic uint32_t saturate;
+} Surface;
+
+typedef struct Line {
+    struct Line *next;
+    char text[];
+} Line;
+
+static struct {
+    int wanted; /* -1 not read yet */
+    bool active;
+    _Atomic bool dead;
+    char dir[3584];
+    uint8_t *view;
+    uint8_t *main_map;
+    uint64_t len;
+    uint64_t pages;
+    int uffd;
+    _Atomic uint32_t *pg;
+    Surface *surfaces;
+    CensusVcpu *vcpus[CENSUS_MAX_VCPUS];
+
+    pthread_mutex_t lock;
+    sem_t wake;
+    pthread_t thread;
+    Line *lines_head, **lines_tail;
+    FILE *ticks, *facts, *rips;
+    uint64_t *rips_seen;
+    uint32_t next_serial;
+
+    bool rw;
+    _Atomic uint32_t every;
+    uint32_t min_pixels;
+    uint32_t saturate_at;
+    uint32_t flush_ms;
+    uint32_t window_ms;
+
+    _Atomic uint64_t presents;
+    uint64_t presents_at_window;
+    uint64_t presents_at_tick;
+    uint64_t window_ns;
+    uint64_t windows;
+    uint64_t tick_ns;
+
+    _Atomic uint64_t traps, writes, upgrades, spurious, dropped, errors;
+    uint64_t overlaps;
+} census = {
+    .wanted = -1,
+    .uffd = -1,
+    .lock = PTHREAD_MUTEX_INITIALIZER,
+};
+
+static uint64_t now_ns(void)
+{
+    struct timespec t;
+
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000000000ULL + t.tv_nsec;
+}
+
+static uint32_t env_u32(const char *name, uint32_t fallback)
+{
+    const char *v = getenv(name);
+
+    return v && *v ? (uint32_t)strtoul(v, NULL, 0) : fallback;
+}
+
+bool census_wanted(void)
+{
+    if (census.wanted < 0) {
+        const char *dir = getenv(CENSUS_ENV);
+
+        census.wanted = dir && *dir;
+        if (census.wanted) {
+            snprintf(census.dir, sizeof(census.dir), "%s", dir);
+        }
+    }
+    return census.wanted;
+}
+
+bool census_active(void)
+{
+    return census.active;
+}
+
+bool census_view_holds(const void *addr)
+{
+    return census.view &&
+        (uint64_t)((const uint8_t *)addr - census.view) < census.len;
+}
+
+void *census_hva(void *ram)
+{
+    uint64_t off = (uint8_t *)ram - census.main_map;
+
+    return census.active && off < census.len ? census.view + off : ram;
+}
+
+void *census_main_addr(void *addr)
+{
+    return census_view_holds(addr) ?
+        census.main_map + ((uint8_t *)addr - census.view) : addr;
+}
+
+/* ---- markers ------------------------------------------------------------------------------ */
+
+static void count_error(const char *what, uint64_t page)
+{
+    if (atomic_fetch_add(&census.errors, 1) < 16) {
+        fprintf(stderr, "census: %s at page %#" PRIx64 ": %s\n", what, page, strerror(errno));
+    }
+}
+
+static int page_drop(uint64_t page, uint64_t count)
+{
+    return madvise(census.view + (page << PG_SHIFT), count << PG_SHIFT, MADV_DONTNEED);
+}
+
+static int page_wp(uint64_t page, uint64_t count, bool on)
+{
+    struct uffdio_writeprotect w = {
+        .range = { (uint64_t)census.view + (page << PG_SHIFT), count << PG_SHIFT },
+        /* The kernel takes DONTWAKE only for WP off. Nothing ever waits on this uffd. */
+        .mode = on ? UFFDIO_WRITEPROTECT_MODE_WP : UFFDIO_WRITEPROTECT_MODE_DONTWAKE,
+    };
+
+    int r;
+
+    for (int tries = 0; tries < POISON_TRIES; tries++) {
+        r = ioctl(census.uffd, UFFDIO_WRITEPROTECT, &w);
+        if (r == 0 || errno != EAGAIN) {
+            break;
+        }
+    }
+    return r;
+}
+
+static void store_pages(uint64_t first, uint64_t count, uint32_t state, uint32_t id)
+{
+    for (uint64_t p = first; p < first + count; p++) {
+        atomic_store(&census.pg[p], PW(state, id));
+    }
+}
+
+/*
+ * Poisons pages this thread owns (ST_WORK), then gives each its state: armed, or skipped for a
+ * page a vCPU faulted back in between the DONTNEED and the POISON, so that a marker exists only
+ * where the word says armed. EEXIST names that race, and the page's next window arms it. EAGAIN
+ * is a PTE table a concurrent MADV_DONTNEED just freed, and a retry finds a new one.
+ */
+static void poison_run(uint64_t first, uint64_t count, uint32_t id)
+{
+    uint64_t at = first, end = first + count;
+    int tries = 0;
+
+    while (at < end) {
+        struct uffdio_poison z = {
+            .range = { (uint64_t)census.view + (at << PG_SHIFT), (end - at) << PG_SHIFT },
+        };
+        uint64_t done;
+
+        if (ioctl(census.uffd, UFFDIO_POISON, &z) == 0) {
+            store_pages(at, end - at, ST_ARMED, id);
+            return;
+        }
+        done = z.updated > 0 ? (uint64_t)z.updated >> PG_SHIFT : 0;
+        store_pages(at, done, ST_ARMED, id);
+        at += done;
+        if (at == end) {
+            return;
+        }
+        if ((errno == EEXIST || errno == EAGAIN) && ++tries < POISON_TRIES) {
+            if (errno == EEXIST) {
+                page_drop(at, 1);
+            }
+            continue;
+        }
+        if (errno != EEXIST && errno != EAGAIN) {
+            count_error("poison", at);
+        }
+        store_pages(at, 1, ST_SKIP, id);
+        at++;
+        tries = 0;
+    }
+}
+
+static void arm_run(uint64_t first, uint64_t count, uint32_t id, bool any_held)
+{
+    if (any_held && page_wp(first, count, false)) {
+        count_error("WP off for arming", first);
+    }
+    page_drop(first, count);
+    poison_run(first, count, id);
+}
+
+/* ---- the fault path, on a vCPU's thread ----------------------------------------------------- */
+
+CensusVcpu *census_vcpu(int index, int fd, void *opaque, CensusReadGpa *read_gpa)
+{
+    CensusVcpu *vc;
+
+    if (index < 0 || index >= CENSUS_MAX_VCPUS) {
+        return NULL;
+    }
+    vc = census.vcpus[index];
+    if (!vc) {
+        vc = calloc(1, sizeof(*vc));
+        vc->index = index;
+        vc->fd = fd;
+        vc->opaque = opaque;
+        vc->read_gpa = read_gpa;
+        vc->pending = -1;
+        census.vcpus[index] = vc;
+    }
+    return vc;
+}
+
+static void ring_push(CensusVcpu *vc, const Rec *r)
+{
+    uint32_t head = atomic_load_explicit(&vc->head, memory_order_relaxed);
+    uint32_t tail = atomic_load_explicit(&vc->tail, memory_order_acquire);
+
+    if (head - tail == RING_SIZE) {
+        atomic_fetch_add(&census.dropped, 1);
+        return;
+    }
+    vc->ring[head & (RING_SIZE - 1)] = *r;
+    atomic_store_explicit(&vc->head, head + 1, memory_order_release);
+}
+
+/* RIP, CPL and CR3 at the access, and the bytes at RIP the first time this vCPU sees it. */
+static void snapshot(CensusVcpu *vc, Rec *r)
+{
+    struct kvm_regs regs;
+    struct kvm_sregs sregs;
+
+    if (ioctl(vc->fd, KVM_GET_REGS, &regs) == 0) {
+        r->rip = regs.rip;
+    }
+    if (ioctl(vc->fd, KVM_GET_SREGS, &sregs) == 0) {
+        r->cpl = sregs.cs.dpl;
+        r->cr3 = sregs.cr3;
+    }
+    if (vc->read_gpa && vc->seen[(r->rip ^ (r->rip >> 8)) & 255] != r->rip) {
+        unsigned have = 0;
+
+        vc->seen[(r->rip ^ (r->rip >> 8)) & 255] = r->rip;
+        while (have < sizeof(r->code)) {
+            uint64_t at = r->rip + have;
+            unsigned n = MIN(sizeof(r->code) - have, PG - (at & (PG - 1)));
+            struct kvm_translation t = { .linear_address = at };
+
+            if (ioctl(vc->fd, KVM_TRANSLATE, &t) || !t.valid) {
+                break;
+            }
+            vc->read_gpa(vc->opaque, t.physical_address, r->code + have, n);
+            have += n;
+        }
+        r->ncode = have;
+    }
+}
+
+int census_on_sigbus(CensusVcpu *vc, void **addr)
+{
+    uint64_t off = (uint8_t *)*addr - census.view;
+    uint64_t page;
+    uint32_t w, id;
+    Rec r = { .kind = REC_TOUCH };
+
+    if (!census.view || !vc || off >= census.len) {
+        return CENSUS_NOT_OURS;
+    }
+    page = off >> PG_SHIFT;
+    w = atomic_load(&census.pg[page]);
+    if (w == 0) {
+        *addr = census.main_map + off;
+        return CENSUS_NOT_OURS;
+    }
+    if (PW_ST(w) != ST_ARMED ||
+        !atomic_compare_exchange_strong(&census.pg[page], &w, PW(ST_WORK, PW_ID(w)))) {
+        /*
+         * Another vCPU took this page, or a thread is mid-way through its markers: the fault
+         * reruns. Only real poison on a page once armed keeps coming back.
+         */
+        if (vc->spin_addr == *addr) {
+            if (++vc->spins > SPIN_LIMIT) {
+                *addr = census.main_map + off;
+                return CENSUS_NOT_OURS;
+            }
+        } else {
+            vc->spin_addr = *addr;
+            vc->spins = 0;
+        }
+        atomic_fetch_add(&census.spurious, 1);
+        return CENSUS_HANDLED;
+    }
+    vc->spin_addr = NULL;
+    id = PW_ID(w);
+    snapshot(vc, &r);
+    page_drop(page, 1);
+    if (census.rw && page_wp(page, 1, true) == 0) {
+        vc->pending = page;
+        vc->pending_rip = r.rip;
+        atomic_store(&census.pg[page], PW(ST_HELD, id));
+    } else {
+        if (census.rw) {
+            count_error("WP on after a trap", page);
+        }
+        atomic_store(&census.pg[page], PW(ST_OPEN, id));
+    }
+    r.page = page;
+    r.id = id;
+    r.serial = census.surfaces[id].serial;
+    ring_push(vc, &r);
+    atomic_fetch_add(&census.traps, 1);
+    if (atomic_fetch_add(&census.surfaces[id].window_traps, 1) + 1 == census.saturate_at) {
+        atomic_store(&census.surfaces[id].saturate, 1);
+        sem_post(&census.wake);
+    }
+    return CENSUS_HANDLED;
+}
+
+/*
+ * Moves the pages of s in the states of mask to ST_WORK, and runs fn over each contiguous run of
+ * them; fn ends the work by giving each page its next state. wait: wait out a page another
+ * thread is working on, as an unmap must; otherwise that page is left for the next pass.
+ */
+typedef void RunFn(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg);
+
+static uint32_t take_pages(Surface *s, uint32_t id, uint32_t mask, bool wait, RunFn *fn, void *arg)
+{
+    uint32_t taken = 0;
+
+    for (uint32_t i = 0; i < s->run_count; i++) {
+        uint64_t first = 0, count = 0;
+        bool any_held = false;
+
+        for (uint64_t p = s->runs[i].first; p < s->runs[i].first + s->runs[i].count; p++) {
+            uint32_t w = atomic_load(&census.pg[p]);
+
+            while (wait && PW_ID(w) == id && PW_ST(w) == ST_WORK) {
+                sched_yield();
+                w = atomic_load(&census.pg[p]);
+            }
+            if (PW_ID(w) == id && (mask >> PW_ST(w) & 1) &&
+                atomic_compare_exchange_strong(&census.pg[p], &w, PW(ST_WORK, id))) {
+                if (count && first + count != p) {
+                    fn(first, count, id, any_held, arg);
+                    count = 0;
+                    any_held = false;
+                }
+                first = count ? first : p;
+                count++;
+                taken++;
+                any_held |= PW_ST(w) == ST_HELD;
+            } else if (count) {
+                fn(first, count, id, any_held, arg);
+                count = 0;
+                any_held = false;
+            }
+        }
+        if (count) {
+            fn(first, count, id, any_held, arg);
+        }
+    }
+    return taken;
+}
+
+static void open_held(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    if (page_wp(first, count, false)) {
+        count_error("WP off", first);
+    }
+    store_pages(first, count, ST_OPEN, id);
+}
+
+/* Everything off: the unmap's and the reset's work, done before either returns. */
+static void clear_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    if (any_held) {
+        page_wp(first, count, false);
+    }
+    page_drop(first, count);
+    store_pages(first, count, ST_STALE, 0x1fffffffu);
+}
+
+#define MASK(st) (1u << (st))
+#define TOUCHED (MASK(ST_HELD) | MASK(ST_OPEN) | MASK(ST_SKIP))
+
+static void census_fuse(const char *why)
+{
+    if (atomic_exchange(&census.dead, true)) {
+        return;
+    }
+    fprintf(stderr, "census: %s: every marker dropped, the census is off\n", why);
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        Surface *s = &census.surfaces[id];
+
+        if (s->live) {
+            take_pages(s, id, MASK(ST_ARMED) | TOUCHED, true, clear_run, NULL);
+        }
+    }
+}
+
+bool census_on_efault(CensusVcpu *vc)
+{
+    Rec r = { .kind = REC_UPGRADE };
+    uint32_t opened = 0;
+    uint64_t now;
+
+    if (!census.active || !vc) {
+        return false;
+    }
+    snapshot(vc, &r);
+    if (vc->pending >= 0 && vc->pending_rip == r.rip) {
+        uint64_t page = vc->pending;
+        uint32_t w = atomic_load(&census.pg[page]);
+
+        vc->pending = -1;
+        if (PW_ST(w) == ST_HELD &&
+            atomic_compare_exchange_strong(&census.pg[page], &w, PW(ST_WORK, PW_ID(w)))) {
+            uint32_t id = PW_ID(w);
+
+            open_held(page, 1, id, false, NULL);
+            r.kind = REC_WRITE;
+            r.page = page;
+            r.id = id;
+            r.serial = census.surfaces[id].serial;
+            ring_push(vc, &r);
+            atomic_fetch_add(&census.writes, 1);
+            vc->efault_first = 0;
+            return true;
+        }
+    }
+    vc->pending = -1;
+    /* A write to a page held from an earlier read: no address, so every held page opens. */
+    pthread_mutex_lock(&census.lock);
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        Surface *s = &census.surfaces[id];
+
+        if (s->live) {
+            uint32_t n = take_pages(s, id, MASK(ST_HELD), false, open_held, NULL);
+
+            s->total.upgrades += n;
+            s->tick.upgrades += n;
+            opened += n;
+        }
+    }
+    if (opened) {
+        pthread_mutex_unlock(&census.lock);
+        vc->efault_first = 0;
+        r.page = opened;
+        ring_push(vc, &r);
+        atomic_fetch_add(&census.upgrades, 1);
+        return true;
+    }
+    /*
+     * Nothing was held: another thread had the page, and the -EFAULT should not return. Should it
+     * keep returning, something answers it that no write protection explains.
+     */
+    now = now_ns();
+    if (!vc->efault_first || now - vc->efault_last > EFAULT_GAP_NS) {
+        vc->efault_first = now;
+    }
+    vc->efault_last = now;
+    if (now - vc->efault_first > FUSE_AFTER_NS) {
+        census_fuse("an -EFAULT no held page explains");
+    }
+    pthread_mutex_unlock(&census.lock);
+    if (now - vc->efault_first > FATAL_AFTER_NS) {
+        return false;
+    }
+    usleep(20);
+    return true;
+}
+
+/* ---- surfaces, from the library's threads ------------------------------------------------- */
+
+static void queue_line(const char *format, ...)
+{
+    va_list a, b;
+    int n;
+    Line *line;
+
+    va_start(a, format);
+    va_copy(b, a);
+    n = vsnprintf(NULL, 0, format, a);
+    va_end(a);
+    line = malloc(sizeof(*line) + n + 1);
+    vsnprintf(line->text, n + 1, format, b);
+    va_end(b);
+    line->next = NULL;
+    *census.lines_tail = line;
+    census.lines_tail = &line->next;
+}
+
+static double census_time(void)
+{
+    return now_ns() / 1e9;
+}
+
+static void rip_add(RipCount *top, uint64_t rip)
+{
+    RipCount *low = &top[0];
+
+    for (int i = 0; i < TOP_RIPS; i++) {
+        if (top[i].rip == rip) {
+            top[i].count++;
+            return;
+        }
+        if (top[i].count < low->count) {
+            low = &top[i];
+        }
+    }
+    low->rip = rip;
+    low->count = 1;
+}
+
+static void drain_rec(const Rec *r, int vcpu)
+{
+    Surface *s = &census.surfaces[r->id];
+
+    if (r->ncode) {
+        uint64_t *slot = &census.rips_seen[(r->rip * 0x9e3779b97f4a7c15ULL) >> 48];
+
+        if (*slot != r->rip) {
+            char hex[sizeof(r->code) * 2 + 1];
+
+            *slot = r->rip;
+            for (int i = 0; i < r->ncode; i++) {
+                snprintf(hex + i * 2, 3, "%02x", r->code[i]);
+            }
+            queue_line("{\"rip\":\"%#" PRIx64 "\",\"cpl\":%u,\"cr3\":\"%#" PRIx64
+                       "\",\"bytes\":\"%s\"}\n", r->rip, r->cpl, r->cr3, hex);
+        }
+    }
+    if (r->kind == REC_UPGRADE) {
+        queue_line("{\"upgrade\":%u,\"t\":%.3f,\"rip\":\"%#" PRIx64 "\",\"vcpu\":%d}\n",
+                   r->page, census_time(), r->rip, vcpu);
+        return;
+    }
+    if (r->serial != s->serial) {
+        return;
+    }
+    if (r->kind == REC_WRITE) {
+        s->total.writes++;
+        s->tick.writes++;
+        return;
+    }
+    for (Tally *t = &s->total; ; t = &s->tick) {
+        t->traps++;
+        t->cpl0 += r->cpl == 0;
+        t->cpl3 += r->cpl != 0;
+        t->vcpus |= 1ULL << vcpu;
+        rip_add(t->rips, r->rip);
+        if (t == &s->tick) {
+            break;
+        }
+    }
+}
+
+static void drain_locked(void)
+{
+    for (int i = 0; i < CENSUS_MAX_VCPUS; i++) {
+        CensusVcpu *vc = census.vcpus[i];
+        uint32_t tail, head;
+
+        if (!vc) {
+            continue;
+        }
+        tail = atomic_load_explicit(&vc->tail, memory_order_relaxed);
+        head = atomic_load_explicit(&vc->head, memory_order_acquire);
+        while (tail != head) {
+            drain_rec(&vc->ring[tail & (RING_SIZE - 1)], i);
+            tail++;
+        }
+        atomic_store_explicit(&vc->tail, tail, memory_order_release);
+    }
+}
+
+static void rips_text(char *out, size_t size, const RipCount *top)
+{
+    size_t at = 0;
+
+    out[0] = 0;
+    for (int i = 0; i < TOP_RIPS && at + 48 < size; i++) {
+        if (top[i].count) {
+            at += snprintf(out + at, size - at, "%s[\"%#" PRIx64 "\",%" PRIu64 "]",
+                           at ? "," : "", top[i].rip, top[i].count);
+        }
+    }
+}
+
+static void surface_end(Surface *s, uint32_t id, const char *event)
+{
+    char rips[512];
+
+    rips_text(rips, sizeof(rips), s->total.rips);
+    queue_line("{\"ev\":\"%s\",\"t\":%.3f,\"s\":%u,\"id\":%u,\"traps\":%" PRIu64
+               ",\"writes\":%" PRIu64 ",\"upgrades\":%" PRIu64 ",\"pages_r\":%" PRIu64
+               ",\"pages_w\":%" PRIu64 ",\"pages_skip\":%" PRIu64 ",\"cpl0\":%" PRIu64
+               ",\"cpl3\":%" PRIu64 ",\"vcpus\":\"%#" PRIx64 "\",\"presents\":%" PRIu64
+               ",\"frames\":%" PRIu64 ",\"windows\":%" PRIu64 ",\"windows_touched\":%" PRIu64
+               ",\"windows_saturated\":%" PRIu64 ",\"max_window_pages\":%" PRIu64
+               ",\"rips\":[%s]}\n",
+               event, census_time(), s->serial, id, s->total.traps, s->total.writes,
+               s->total.upgrades, s->total.pages_r, s->total.pages_w, s->total.pages_skip,
+               s->total.cpl0, s->total.cpl3, s->total.vcpus, atomic_load(&s->presents),
+               atomic_load(&census.presents) - s->presents_at_map,
+               census.windows - s->windows_at_map, s->total.windows_touched,
+               s->total.windows_saturated, s->max_window_pages, rips);
+}
+
+static void surface_close(Surface *s, uint32_t id, const char *event)
+{
+    drain_locked();
+    take_pages(s, id, MASK(ST_ARMED) | TOUCHED, true, clear_run, NULL);
+    surface_end(s, id, event);
+    s->live = false;
+    free(s->runs);
+    s->runs = NULL;
+    s->run_count = 0;
+}
+
+void census_surface_mapped(const CensusSurface *f, const uint64_t *pages, size_t page_count,
+                           uint64_t page_size)
+{
+    Surface *s;
+    uint32_t id = f->mapping_id;
+    uint64_t pixels = f->width * f->height;
+    size_t capacity = page_count ? page_count : 1;
+
+    if (!census.active || atomic_load(&census.dead) || id == 0 || id >= CENSUS_MAX_SURFACES ||
+        pixels < census.min_pixels) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    s = &census.surfaces[id];
+    if (s->live) {
+        surface_close(s, id, "replaced");
+    }
+    atomic_store(&s->presents, 0);
+    atomic_store(&s->window_traps, 0);
+    atomic_store(&s->saturate, 0);
+    memset(&s->total, 0, sizeof(s->total));
+    memset(&s->tick, 0, sizeof(s->tick));
+    s->serial = ++census.next_serial;
+    s->armed_pages = s->overlaps = s->foreign = s->max_window_pages = 0;
+    s->presents_at_map = s->presents_at_tick = atomic_load(&census.presents);
+    s->windows_at_map = census.windows;
+    s->runs = calloc(capacity, sizeof(*s->runs));
+    s->live = true;
+
+    /* A page already armed for a surface over the same memory stays with that one. */
+    for (size_t i = 0; i < page_count; i++) {
+        uint64_t off = pages[i] - (uint64_t)census.main_map;
+        uint64_t first = off >> PG_SHIFT, count = page_size >> PG_SHIFT;
+
+        if (off >= census.len || off + page_size > census.len || off & (PG - 1)) {
+            s->foreign += count;
+            continue;
+        }
+        for (uint64_t p = first; p < first + count; p++) {
+            uint32_t w = atomic_load(&census.pg[p]);
+
+            if ((w != 0 && PW_ST(w) != ST_STALE) ||
+                !atomic_compare_exchange_strong(&census.pg[p], &w, PW(ST_WORK, id))) {
+                s->overlaps++;
+                census.overlaps++;
+                continue;
+            }
+            if (s->run_count && s->runs[s->run_count - 1].first +
+                s->runs[s->run_count - 1].count == p) {
+                s->runs[s->run_count - 1].count++;
+            } else {
+                if (s->run_count == capacity) {
+                    capacity *= 2;
+                    s->runs = realloc(s->runs, sizeof(*s->runs) * capacity);
+                }
+                s->runs[s->run_count].first = p;
+                s->runs[s->run_count].count = 1;
+                s->run_count++;
+            }
+            s->armed_pages++;
+        }
+    }
+    for (uint32_t i = 0; i < s->run_count; i++) {
+        arm_run(s->runs[i].first, s->runs[i].count, id, false);
+    }
+    queue_line("{\"ev\":\"map\",\"t\":%.3f,\"s\":%u,\"id\":%u,\"format\":\"%#x\",\"w\":%" PRIu64
+               ",\"h\":%" PRIu64 ",\"row\":%" PRIu64 ",\"alloc\":%" PRIu64 ",\"protection\":%"
+               PRIu64 ",\"address_format\":%u,\"compression\":%u,\"read_only\":%d,"
+               "\"host_only\":%d,\"armed_pages\":%" PRIu64 ",\"runs\":%u,\"overlaps\":%" PRIu64
+               ",\"foreign\":%" PRIu64 "}\n",
+               census_time(), s->serial, id, f->pixel_format, f->width, f->height,
+               f->bytes_per_row, f->alloc_size, f->protection_options, f->address_format,
+               f->compression_type, f->read_only, f->host_only, s->armed_pages, s->run_count,
+               s->overlaps, s->foreign);
+    pthread_mutex_unlock(&census.lock);
+}
+
+void census_surface_unmapped(uint32_t mapping_id)
+{
+    if (!census.active || mapping_id == 0 || mapping_id >= CENSUS_MAX_SURFACES) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    if (census.surfaces[mapping_id].live) {
+        surface_close(&census.surfaces[mapping_id], mapping_id, "unmap");
+    }
+    pthread_mutex_unlock(&census.lock);
+}
+
+void census_surface_used(uint32_t mapping_id, uint64_t usage, uint64_t storage_mode)
+{
+    if (!census.active || mapping_id == 0 || mapping_id >= CENSUS_MAX_SURFACES) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    if (census.surfaces[mapping_id].live) {
+        queue_line("{\"ev\":\"use\",\"s\":%u,\"usage\":\"%#" PRIx64 "\",\"storage\":%" PRIu64 "}\n",
+                   census.surfaces[mapping_id].serial, usage, storage_mode);
+    }
+    pthread_mutex_unlock(&census.lock);
+}
+
+void census_presented(uint64_t mapping_id)
+{
+    uint64_t n;
+
+    if (!census.active) {
+        return;
+    }
+    n = atomic_fetch_add(&census.presents, 1) + 1;
+    if (mapping_id > 0 && mapping_id < CENSUS_MAX_SURFACES &&
+        census.surfaces[mapping_id].live) {
+        atomic_fetch_add(&census.surfaces[mapping_id].presents, 1);
+    }
+    if (n % atomic_load(&census.every) == 0) {
+        sem_post(&census.wake);
+    }
+}
+
+void census_reset(void)
+{
+    if (!census.active) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        if (census.surfaces[id].live) {
+            surface_close(&census.surfaces[id], id, "reset");
+        }
+    }
+    for (int i = 0; i < CENSUS_MAX_VCPUS; i++) {
+        if (census.vcpus[i]) {
+            census.vcpus[i]->pending = -1;
+        }
+    }
+    pthread_mutex_unlock(&census.lock);
+}
+
+/* ---- the census's thread ------------------------------------------------------------------- */
+
+typedef struct WindowCount {
+    uint64_t r, w, skip;
+} WindowCount;
+
+static void rearm_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    arm_run(first, count, id, any_held);
+}
+
+static void count_pages(Surface *s, uint32_t id, WindowCount *c)
+{
+    for (uint32_t i = 0; i < s->run_count; i++) {
+        for (uint64_t p = s->runs[i].first; p < s->runs[i].first + s->runs[i].count; p++) {
+            uint32_t w = atomic_load(&census.pg[p]);
+
+            if (PW_ID(w) == id) {
+                c->r += PW_ST(w) == ST_HELD;
+                c->w += PW_ST(w) == ST_OPEN;
+                c->skip += PW_ST(w) == ST_SKIP;
+            }
+        }
+    }
+}
+
+static void saturate_run(uint64_t first, uint64_t count, uint32_t id, bool any_held, void *arg)
+{
+    page_drop(first, count);
+    store_pages(first, count, ST_SKIP, id);
+}
+
+/*
+ * A surface read whole in a window has answered for that window: the rest of its markers go at
+ * once, so that a recorder pays a few hundred traps a window rather than thousands.
+ */
+static void saturate_locked(void)
+{
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        Surface *s = &census.surfaces[id];
+
+        if (s->live && atomic_exchange(&s->saturate, 0)) {
+            take_pages(s, id, MASK(ST_ARMED), false, saturate_run, NULL);
+            s->total.windows_saturated++;
+            s->tick.windows_saturated++;
+        }
+    }
+}
+
+static void close_window_locked(void)
+{
+    census.windows++;
+    census.presents_at_window = atomic_load(&census.presents);
+    census.window_ns = now_ns();
+    if (atomic_load(&census.dead)) {
+        return;
+    }
+    drain_locked();
+    saturate_locked();
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        Surface *s = &census.surfaces[id];
+        WindowCount c = { 0 };
+        uint64_t pages;
+
+        if (!s->live || !atomic_exchange(&s->window_traps, 0)) {
+            continue;
+        }
+        count_pages(s, id, &c);
+        pages = c.r + c.w + c.skip;
+        s->total.pages_r += c.r;
+        s->tick.pages_r += c.r;
+        s->total.pages_w += c.w;
+        s->tick.pages_w += c.w;
+        s->total.pages_skip += c.skip;
+        s->tick.pages_skip += c.skip;
+        s->total.windows_touched++;
+        s->tick.windows_touched++;
+        s->max_window_pages = MAX(s->max_window_pages, pages);
+        take_pages(s, id, TOUCHED, false, rearm_run, NULL);
+        /* The lock is the fallback path's and the map's: never held for a whole pass of arming. */
+        pthread_mutex_unlock(&census.lock);
+        sched_yield();
+        pthread_mutex_lock(&census.lock);
+    }
+}
+
+void census_close_window(void)
+{
+    pthread_mutex_lock(&census.lock);
+    close_window_locked();
+    pthread_mutex_unlock(&census.lock);
+}
+
+static void tick_locked(void)
+{
+    uint64_t presents = atomic_load(&census.presents);
+    char rips[512];
+
+    drain_locked();
+    queue_line("{\"t\":%.3f,\"presents\":%" PRIu64 ",\"frames\":%" PRIu64 ",\"windows\":%" PRIu64
+               ",\"traps\":%" PRIu64 ",\"writes\":%" PRIu64 ",\"upgrades\":%" PRIu64
+               ",\"spurious\":%" PRIu64 ",\"dropped\":%" PRIu64 ",\"errors\":%" PRIu64
+               ",\"dead\":%d}\n",
+               census_time(), presents, presents - census.presents_at_tick, census.windows,
+               atomic_load(&census.traps), atomic_load(&census.writes),
+               atomic_load(&census.upgrades), atomic_load(&census.spurious),
+               atomic_load(&census.dropped), atomic_load(&census.errors),
+               (int)atomic_load(&census.dead));
+    census.presents_at_tick = presents;
+    for (uint32_t id = 1; id < CENSUS_MAX_SURFACES; id++) {
+        Surface *s = &census.surfaces[id];
+        uint64_t own;
+
+        if (!s->live) {
+            continue;
+        }
+        own = atomic_load(&s->presents);
+        if (s->tick.traps || s->tick.upgrades || s->tick.windows_touched) {
+            rips_text(rips, sizeof(rips), s->tick.rips);
+            queue_line("{\"tick\":%u,\"t\":%.3f,\"presents\":%" PRIu64 ",\"traps\":%" PRIu64
+                       ",\"writes\":%" PRIu64 ",\"upgrades\":%" PRIu64 ",\"pages_r\":%" PRIu64
+                       ",\"pages_w\":%" PRIu64 ",\"pages_skip\":%" PRIu64
+                       ",\"windows_touched\":%" PRIu64 ",\"windows_saturated\":%" PRIu64
+                       ",\"cpl0\":%" PRIu64 ",\"cpl3\":%" PRIu64 ",\"rips\":[%s]}\n",
+                       s->serial, census_time(), own - s->presents_at_tick, s->tick.traps,
+                       s->tick.writes, s->tick.upgrades, s->tick.pages_r, s->tick.pages_w,
+                       s->tick.pages_skip, s->tick.windows_touched, s->tick.windows_saturated,
+                       s->tick.cpl0, s->tick.cpl3, rips);
+            memset(&s->tick, 0, sizeof(s->tick));
+        }
+        s->presents_at_tick = own;
+    }
+}
+
+static void write_lines(void)
+{
+    Line *line;
+
+    pthread_mutex_lock(&census.lock);
+    line = census.lines_head;
+    census.lines_head = NULL;
+    census.lines_tail = &census.lines_head;
+    pthread_mutex_unlock(&census.lock);
+    while (line) {
+        Line *next = line->next;
+        FILE *to = census.ticks;
+
+        if (strncmp(line->text, "{\"ev\"", 5) == 0) {
+            to = census.facts;
+        } else if (strncmp(line->text, "{\"rip\"", 6) == 0) {
+            to = census.rips;
+        }
+        fputs(line->text, to);
+        free(line);
+        line = next;
+    }
+    fflush(census.ticks);
+    fflush(census.facts);
+    fflush(census.rips);
+}
+
+/* <dir>/mark: "every N" sets the re-arm period; anything else is a label in the timeline. */
+static void read_mark(void)
+{
+    char path[sizeof(census.dir) + 8], text[128] = "";
+    FILE *f;
+    size_t n;
+    unsigned long every;
+
+    snprintf(path, sizeof(path), "%s/mark", census.dir);
+    f = fopen(path, "r");
+    if (!f) {
+        return;
+    }
+    n = fread(text, 1, sizeof(text) - 1, f);
+    fclose(f);
+    unlink(path);
+    text[n] = 0;
+    text[strcspn(text, "\n")] = 0;
+    pthread_mutex_lock(&census.lock);
+    if (sscanf(text, "every %lu", &every) == 1 && every > 0) {
+        atomic_store(&census.every, every);
+        queue_line("{\"mark\":\"every %lu\",\"t\":%.3f}\n", every, census_time());
+    } else {
+        for (char *c = text; *c; c++) {
+            *c = *c == '"' || *c == '\\' || (unsigned char)*c < 32 ? '_' : *c;
+        }
+        tick_locked();
+        queue_line("{\"mark\":\"%s\",\"t\":%.3f}\n", text, census_time());
+    }
+    pthread_mutex_unlock(&census.lock);
+}
+
+static void *census_thread(void *unused)
+{
+    sigset_t all;
+
+    sigfillset(&all);
+    pthread_sigmask(SIG_BLOCK, &all, NULL);
+    pthread_setname_np(pthread_self(), "reims-census");
+    census.window_ns = census.tick_ns = now_ns();
+    for (;;) {
+        struct timespec until;
+        uint64_t now, every = atomic_load(&census.every);
+
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_nsec += 50000000;
+        if (until.tv_nsec >= 1000000000) {
+            until.tv_sec++;
+            until.tv_nsec -= 1000000000;
+        }
+        sem_timedwait(&census.wake, &until);
+        now = now_ns();
+        read_mark();
+        pthread_mutex_lock(&census.lock);
+        drain_locked();
+        saturate_locked();
+        if (atomic_load(&census.presents) - census.presents_at_window >= every ||
+            now - census.window_ns >= census.window_ms * 1000000ULL) {
+            close_window_locked();
+        }
+        if (now - census.tick_ns >= census.flush_ms * 1000000ULL) {
+            tick_locked();
+            census.tick_ns = now;
+        }
+        pthread_mutex_unlock(&census.lock);
+        write_lines();
+    }
+    return unused;
+}
+
+void census_flush(void)
+{
+    if (!census.active) {
+        return;
+    }
+    pthread_mutex_lock(&census.lock);
+    tick_locked();
+    pthread_mutex_unlock(&census.lock);
+    write_lines();
+}
+
+static void census_at_exit(void)
+{
+    census_flush();
+}
+
+void census_counts(CensusCounts *out)
+{
+    *out = (CensusCounts) {
+        .traps = atomic_load(&census.traps),
+        .writes = atomic_load(&census.writes),
+        .upgrades = atomic_load(&census.upgrades),
+        .spurious = atomic_load(&census.spurious),
+        .dropped = atomic_load(&census.dropped),
+        .errors = atomic_load(&census.errors),
+        .overlaps = census.overlaps,
+        .windows = census.windows,
+        .dead = atomic_load(&census.dead),
+    };
+}
+
+int census_page_state(const void *main_addr)
+{
+    uint64_t off = (const uint8_t *)main_addr - census.main_map;
+
+    return off < census.len ? (int)PW_ST(atomic_load(&census.pg[off >> PG_SHIFT])) : -1;
+}
+
+static FILE *open_output(const char *name)
+{
+    char path[sizeof(census.dir) + 32];
+
+    snprintf(path, sizeof(path), "%s/%s", census.dir, name);
+    return fopen(path, "ae");
+}
+
+static bool census_refuse(const char *what)
+{
+    fprintf(stderr, "census: %s: %s; the census is off\n", what, strerror(errno));
+    census.wanted = 0;
+    if (census.view) {
+        munmap(census.view, census.len);
+        census.view = NULL;
+    }
+    if (census.uffd >= 0) {
+        close(census.uffd);
+        census.uffd = -1;
+    }
+    return false;
+}
+
+bool census_start(int fd, uint64_t offset, void *main_map, uint64_t len)
+{
+    struct uffdio_api api = {
+        .api = UFFD_API,
+        .features = UFFD_FEATURE_POISON | UFFD_FEATURE_WP_HUGETLBFS_SHMEM |
+                    UFFD_FEATURE_WP_UNPOPULATED,
+    };
+    struct uffdio_register reg = { .mode = UFFDIO_REGISTER_MODE_WP };
+
+    mkdir(census.dir, 0777);
+    census.ticks = open_output("ticks.jsonl");
+    census.facts = open_output("surfaces.jsonl");
+    census.rips = open_output("rips.jsonl");
+    if (!census.ticks || !census.facts || !census.rips) {
+        return census_refuse("the output directory");
+    }
+    census.uffd = syscall(__NR_userfaultfd, O_CLOEXEC | O_NONBLOCK | UFFD_USER_MODE_ONLY);
+    if (census.uffd < 0) {
+        return census_refuse("userfaultfd(UFFD_USER_MODE_ONLY)");
+    }
+    if (ioctl(census.uffd, UFFDIO_API, &api)) {
+        return census_refuse("UFFDIO_API, poison and shmem write protection");
+    }
+    census.view = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, offset);
+    if (census.view == MAP_FAILED) {
+        census.view = NULL;
+        return census_refuse("the view");
+    }
+    /* A fork's child, which only execs, needs none of this. */
+    madvise(census.view, len, MADV_DONTFORK);
+    reg.range.start = (uint64_t)census.view;
+    reg.range.len = len;
+    if (ioctl(census.uffd, UFFDIO_REGISTER, &reg)) {
+        return census_refuse("UFFDIO_REGISTER");
+    }
+    census.main_map = main_map;
+    census.len = len;
+    census.pages = len >> PG_SHIFT;
+    census.pg = calloc(census.pages, sizeof(*census.pg));
+    census.surfaces = calloc(CENSUS_MAX_SURFACES, sizeof(*census.surfaces));
+    census.rips_seen = calloc(RIP_SEEN_SLOTS, sizeof(*census.rips_seen));
+    if (!census.pg || !census.surfaces || !census.rips_seen) {
+        return census_refuse("memory");
+    }
+    census.lines_tail = &census.lines_head;
+    census.rw = env_u32("REIMS_VGPU_CENSUS_RW", 1);
+    census.every = env_u32("REIMS_VGPU_CENSUS_EVERY", 32);
+    census.min_pixels = env_u32("REIMS_VGPU_CENSUS_MIN_PIXELS", 1000000);
+    census.saturate_at = env_u32("REIMS_VGPU_CENSUS_SATURATE", 256);
+    census.flush_ms = env_u32("REIMS_VGPU_CENSUS_FLUSH_MS", 5000);
+    census.window_ms = env_u32("REIMS_VGPU_CENSUS_WINDOW_MS", 2000);
+    if (!census.every) {
+        census.every = 1;
+    }
+    sem_init(&census.wake, 0, 0);
+    census.active = true;
+    if (pthread_create(&census.thread, NULL, census_thread, NULL)) {
+        census.active = false;
+        return census_refuse("the census's thread");
+    }
+    atexit(census_at_exit);
+    queue_line("{\"started\":%.3f,\"pid\":%d,\"bytes\":%" PRIu64 ",\"rw\":%d,\"every\":%u,"
+               "\"min_pixels\":%u,\"saturate\":%u}\n", census_time(), getpid(), len, census.rw,
+               census.every, census.min_pixels, census.saturate_at);
+    fprintf(stderr, "census: on, writing to %s: %" PRIu64 " MiB view at %p\n", census.dir,
+            len >> 20, census.view);
+    return true;
+}
