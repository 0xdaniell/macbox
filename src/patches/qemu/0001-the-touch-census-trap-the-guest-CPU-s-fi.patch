diff --git a/include/system/kvm_census.h b/include/system/kvm_census.h
new file mode 100644
index 0000000000..e242236452
--- /dev/null
+++ b/include/system/kvm_census.h
@@ -0,0 +1,91 @@
+/*
+ * LOCAL (Atlas): the touch census. See accel/kvm/census.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KVM_CENSUS_H
+#define KVM_CENSUS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define CENSUS_ENV "REIMS_VGPU_CENSUS"
+#define CENSUS_MAX_SURFACES 8192
+#define CENSUS_MAX_VCPUS 64
+
+/* What a surface's map tells the census, the descriptor's fields as they came. */
+typedef struct CensusSurface {
+    uint32_t mapping_id;
+    uint32_t pixel_format;
+    uint64_t width;
+    uint64_t height;
+    uint64_t bytes_per_row;
+    uint64_t alloc_size;
+    uint64_t protection_options;
+    uint32_t address_format;
+    uint32_t compression_type;
+    bool read_only;
+    bool host_only;
+} CensusSurface;
+
+typedef struct CensusVcpu CensusVcpu;
+
+/* Reads guest memory for the instruction bytes a record keeps; never armed memory. */
+typedef void CensusReadGpa(void *opaque, uint64_t gpa, void *buf, unsigned len);
+
+/* REIMS_VGPU_CENSUS is set, and nothing has refused it yet. */
+bool census_wanted(void);
+/* The view exists and traps are being counted. */
+bool census_active(void);
+
+/*
+ * Maps the KVM-only view of [main, main + len), the mapping of fd at offset, registers it with
+ * userfaultfd and starts the census's thread. On failure, says why on stderr and turns the census
+ * off; memslots then stay on the main mapping and the VM runs as it would without the variable.
+ */
+bool census_start(int fd, uint64_t offset, void *main_map, uint64_t len);
+/* The address memslots use for main-mapping address ram: the view's when it holds ram. */
+void *census_hva(void *ram);
+/* Whether addr lies in the view. Async-signal-safe. */
+bool census_view_holds(const void *addr);
+/* The main mapping's address for a view address, or addr itself. */
+void *census_main_addr(void *addr);
+
+CensusVcpu *census_vcpu(int index, int fd, void *opaque, CensusReadGpa *read_gpa);
+
+enum { CENSUS_NOT_OURS, CENSUS_HANDLED };
+/*
+ * On the vCPU's thread, outside the signal handler, after KVM_RUN returned. CENSUS_HANDLED: run
+ * the vCPU again. CENSUS_NOT_OURS: not a marker of the census's, as for real poison, and *addr
+ * is the address to go on with, the main mapping's for an address in the view.
+ */
+int census_on_sigbus(CensusVcpu *vc, void **addr);
+/* KVM_RUN gave a bare -EFAULT: true when the census answers for it, and the vCPU runs again. */
+bool census_on_efault(CensusVcpu *vc);
+
+/* The guest's reset: every marker goes. vCPUs are stopped. */
+void census_reset(void);
+
+/* From the library's threads. None waits on a vCPU, and presented takes no lock. */
+void census_surface_mapped(const CensusSurface *facts, const uint64_t *pages, size_t page_count,
+                           uint64_t page_size);
+void census_surface_unmapped(uint32_t mapping_id);
+void census_surface_used(uint32_t mapping_id, uint64_t usage, uint64_t storage_mode);
+void census_presented(uint64_t mapping_id);
+
+/* Writes everything counted so far. For a test: the census's thread does this on its own. */
+void census_flush(void);
+
+/* What a test reads. */
+typedef struct CensusCounts {
+    uint64_t traps, writes, upgrades, spurious, dropped, overlaps, errors, windows, dead;
+} CensusCounts;
+void census_counts(CensusCounts *out);
+/* Runs the end of a window now, whatever the presents count. */
+void census_close_window(void);
+/* Whether the page at this main-mapping address carries a marker of the census's, by its state. */
+int census_page_state(const void *main_addr);
+
+#endif
