+// probe_common.swift: shared by probe_untracked, probe_signal, probe_tail and probe_long. Build each as
+//   swiftc -O probe_common.swift probe_<name>.swift -o probe_<name>
+// A GPU gradient renderer, a GPU copy (sample one texture into another surface), and pixel checks
+// at a grid of points, as readback.swift has them, for surfaces of any size.
+import Foundation
+import Metal
+import IOSurface
+
+let probeSource = """
+#include <metal_stdlib>
+using namespace metal;
+struct V { float4 p [[position]]; float2 uv; };
+vertex V vs(uint i [[vertex_id]]) { float2 a[3] = {{-1,-1},{3,-1},{-1,3}}; V o; o.p = float4(a[i],0,1); o.uv = (a[i]+1)/2; o.uv.y = 1-o.uv.y; return o; }
+fragment float4 grad(V i [[stage_in]], constant float4 &c [[buffer(0)]]) { return float4(i.uv.x*c.x, i.uv.y*c.y, c.z, c.w); }
+fragment float4 copy(V i [[stage_in]], texture2d<float> t [[texture(0)]]) { constexpr sampler s(filter::nearest); return t.sample(s, i.uv); }
+"""
+let dev = MTLCopyAllDevices().first!
+let lib = try! dev.makeLibrary(source: probeSource, options: nil)
+func pipe(_ f: String) -> MTLRenderPipelineState {
+    let d = MTLRenderPipelineDescriptor()
+    d.vertexFunction = lib.makeFunction(name: "vs"); d.fragmentFunction = lib.makeFunction(name: f)
+    d.colorAttachments[0].pixelFormat = .bgra8Unorm
+    return try! dev.makeRenderPipelineState(descriptor: d)
+}
+let gradP = pipe("grad"), copyP = pipe("copy")
+let queue = dev.makeCommandQueue()!
+
+func makeSurface(_ w: Int, _ h: Int, allocSize: Int? = nil) -> IOSurface {
+    var p: [IOSurfacePropertyKey: Any] = [.width: w, .height: h, .bytesPerElement: 4, .pixelFormat: 0x42475241,
+                                          IOSurfacePropertyKey(rawValue: "IOSurfaceIsGlobal"): true]
+    if let a = allocSize { p[.allocSize] = a }
+    return IOSurface(properties: p)!
+}
+func texture(_ s: IOSurface, untracked: Bool = false) -> MTLTexture {
+    let d = MTLTextureDescriptor.texture2DDescriptor(pixelFormat: .bgra8Unorm, width: s.width, height: s.height, mipmapped: false)
+    d.usage = [.renderTarget, .shaderRead]; d.storageMode = .managed
+    if untracked { d.hazardTrackingMode = .untracked }
+    return dev.makeTexture(descriptor: d, iosurface: s, plane: 0)!
+}
+/// Encodes `draws` draws of the gradient `c` into `t` in `b`.
+func encodeGradient(_ b: MTLCommandBuffer, _ t: MTLTexture, _ c: [Float], draws: Int = 1) {
+    let p = MTLRenderPassDescriptor(); p.colorAttachments[0].texture = t
+    p.colorAttachments[0].loadAction = .dontCare; p.colorAttachments[0].storeAction = .store
+    let e = b.makeRenderCommandEncoder(descriptor: p)!
+    e.setRenderPipelineState(gradP); var c = c; e.setFragmentBytes(&c, length: 16, index: 0)
+    for _ in 0..<draws { e.drawPrimitives(type: .triangle, vertexStart: 0, vertexCount: 3) }
+    e.endEncoding()
+}
+func gradient(_ t: MTLTexture, _ c: [Float], wait: Bool = true) {
+    let b = queue.makeCommandBuffer()!
+    encodeGradient(b, t, c); b.commit()
+    if wait { b.waitUntilCompleted() }
+}
+func encodeCopy(_ b: MTLCommandBuffer, _ from: MTLTexture, _ to: MTLTexture) {
+    let p = MTLRenderPassDescriptor(); p.colorAttachments[0].texture = to
+    p.colorAttachments[0].loadAction = .dontCare; p.colorAttachments[0].storeAction = .store
+    let e = b.makeRenderCommandEncoder(descriptor: p)!
+    e.setRenderPipelineState(copyP); e.setFragmentTexture(from, index: 0)
+    e.drawPrimitives(type: .triangle, vertexStart: 0, vertexCount: 3); e.endEncoding()
+}
+/// Samples `t` into a new surface and answers with that surface: the GPU's view of `t`.
+func viaGPU(_ t: MTLTexture) -> IOSurface {
+    let out = makeSurface(t.width, t.height), o = texture(out)
+    let b = queue.makeCommandBuffer()!
+    encodeCopy(b, t, o); b.commit(); b.waitUntilCompleted()
+    return out
+}
+func px(_ s: IOSurface, _ x: Int, _ y: Int) -> [UInt8] {
+    let p = (s.baseAddress + y * s.bytesPerRow + x * 4).assumingMemoryBound(to: UInt8.self)
+    return [p[0], p[1], p[2], p[3]]
+}
+/// BGRA of the gradient `c` at x, y of a w x h surface.
+func want(_ c: [Float], _ w: Int, _ h: Int, _ x: Int, _ y: Int) -> [UInt8] {
+    let u = (Float(x) + 0.5) / Float(w), v = (Float(y) + 0.5) / Float(h)
+    let f = [c[2], v * c[1], u * c[0], c[3]]
+    return f.map { UInt8(max(0, min(255, ($0 * 255).rounded()))) }
+}
+/// Compares `s` with `expect` at a grid of points, the last row and column among them:
+/// (matched, total, the first mismatch).
+func compare(_ s: IOSurface, lock: Bool = true, step: Int = 37, _ expect: (Int, Int) -> [UInt8]) -> (Int, Int, String) {
+    if lock { s.lock(options: .readOnly, seed: nil) }
+    defer { if lock { s.unlock(options: .readOnly, seed: nil) } }
+    var bad = 0, total = 0, first = ""
+    let xs = Array(stride(from: 1, to: s.width, by: step)) + [s.width - 1]
+    let ys = Array(stride(from: 2, to: s.height, by: step)) + [s.height - 1]
+    for y in ys {
+        for x in xs {
+            let g = px(s, x, y), e = expect(x, y)
+            total += 1
+            if zip(g, e).contains(where: { abs(Int($0) - Int($1)) > 2 }) {
+                bad += 1
+                if first.isEmpty { first = "(\(x),\(y)) got \(g) want \(e)" }
+            }
+        }
+    }
+    return (total - bad, total, first)
+}
+var failed = 0
+func check(_ name: String, _ s: IOSurface, lock: Bool = true, _ expect: (Int, Int) -> [UInt8]) {
+    let (good, total, first) = compare(s, lock: lock, expect)
+    print(good == total ? "  ok  " : "  BAD ", name, "\(good)/\(total)", first)
+    if good != total { failed += 1 }
+}
+func finish(_ extra: String = "") -> Never {
+    print(failed == 0 ? "PASS" : "FAIL", "\(failed) checks failed", extra)
+    exit(failed == 0 ? 0 : 1)
+}
+func env(_ name: String, _ fallback: Double) -> Double {
+    Double(ProcessInfo.processInfo.environment[name] ?? "") ?? fallback
+}
diff --git a/scripts/internal/census/probe_encode.swift b/scripts/internal/census/probe_encode.swift
new file mode 100644
index 00000000..95a3e8c3
--- /dev/null
+++ b/scripts/internal/census/probe_encode.swift
@@ -0,0 +1,161 @@
+// probe_encode.swift (P1): on a guest, swiftc -O probe_encode.swift -o probe_encode && ./probe_encode
+// PROBE_SECONDS (default 180) is how long it runs.
+// The GPU renders a moving frame into an IOSurface of 1920x1088 BGRA (2,088,960 texels), and the
+// frame is encoded right away with VTCompressionSession, decoded, and compared. Nothing on the CPU
+// touches the surface between the render and the encode, so the host's video encoder (outside the
+// runtime) is the first to read it. If the host misses the GPU's writes still held in the texture,
+// the decoded frame is a stale one: its frame number, drawn as 32 big blocks, is wrong.
+// Three surfaces are used in turn, so each is reused every third frame.
+// It prints one line per 100 frames and ends with PASS or FAIL plus numbers.
+import Foundation
+import Metal
+import IOSurface
+import CoreVideo
+import CoreMedia
+import VideoToolbox
+
+let W = 1920, H = 1088
+let seconds = Double(ProcessInfo.processInfo.environment["PROBE_SECONDS"] ?? "180")!
+let source = """
+#include <metal_stdlib>
+using namespace metal;
+struct V { float4 p [[position]]; float2 uv; };
+vertex V vs(uint i [[vertex_id]]) { float2 a[3] = {{-1,-1},{3,-1},{-1,3}}; V o; o.p = float4(a[i],0,1); o.uv = (a[i]+1)/2; o.uv.y = 1-o.uv.y; return o; }
+// The top 80%: 8x4 blocks, block b white where bit b of the frame number is set.
+// The bottom band: a bar that moves with the frame number, over a gradient.
+fragment float4 frame(V i [[stage_in]], constant uint &n [[buffer(0)]]) {
+    if (i.uv.y < 0.8) {
+        uint bx = min(uint(i.uv.x * 8), 7u), by = min(uint(i.uv.y / 0.8 * 4), 3u);
+        float fx = fract(i.uv.x * 8), fy = fract(i.uv.y / 0.8 * 4);
+        if (fx < 0.1 || fx > 0.9 || fy < 0.1 || fy > 0.9) return float4(0.5, 0.5, 0.5, 1);
+        float on = float((n >> (by * 8 + bx)) & 1u);
+        return float4(on, on, on, 1);
+    }
+    float bar = fract(float(n) / 120.0);
+    float d = abs(i.uv.x - bar);
+    return d < 0.02 ? float4(1, 0, 0, 1) : float4(i.uv.x, 0.3, 1 - i.uv.x, 1);
+}
+"""
+let dev = MTLCopyAllDevices().first!
+let lib = try! dev.makeLibrary(source: source, options: nil)
+let pd = MTLRenderPipelineDescriptor()
+pd.vertexFunction = lib.makeFunction(name: "vs"); pd.fragmentFunction = lib.makeFunction(name: "frame")
+pd.colorAttachments[0].pixelFormat = .bgra8Unorm
+let pipe = try! dev.makeRenderPipelineState(descriptor: pd)
+let queue = dev.makeCommandQueue()!
+
+struct Slot { let surface: IOSurface; let texture: MTLTexture; let buffer: CVPixelBuffer }
+func makeSlot() -> Slot {
+    let s = IOSurface(properties: [.width: W, .height: H, .bytesPerElement: 4, .pixelFormat: 0x42475241,
+                                   IOSurfacePropertyKey(rawValue: "IOSurfaceIsGlobal"): true])!
+    let d = MTLTextureDescriptor.texture2DDescriptor(pixelFormat: .bgra8Unorm, width: W, height: H, mipmapped: false)
+    d.usage = [.renderTarget, .shaderRead]; d.storageMode = .managed
+    let t = dev.makeTexture(descriptor: d, iosurface: s, plane: 0)!
+    var pb: Unmanaged<CVPixelBuffer>?
+    let r = CVPixelBufferCreateWithIOSurface(nil, unsafeBitCast(s, to: IOSurfaceRef.self), nil, &pb)
+    precondition(r == kCVReturnSuccess, "CVPixelBufferCreateWithIOSurface: \(r)")
+    return Slot(surface: s, texture: t, buffer: pb!.takeRetainedValue())
+}
+let slots = [makeSlot(), makeSlot(), makeSlot()]
+
+func render(_ t: MTLTexture, _ n: UInt32) {
+    let p = MTLRenderPassDescriptor(); p.colorAttachments[0].texture = t
+    p.colorAttachments[0].loadAction = .dontCare; p.colorAttachments[0].storeAction = .store
+    let b = queue.makeCommandBuffer()!, e = b.makeRenderCommandEncoder(descriptor: p)!
+    e.setRenderPipelineState(pipe); var n = n; e.setFragmentBytes(&n, length: 4, index: 0)
+    e.drawPrimitives(type: .triangle, vertexStart: 0, vertexCount: 3); e.endEncoding()
+    b.commit(); b.waitUntilCompleted()
+}
+
+// Encoder: H.264, real time, no reordering, so each frame's sample comes out in order.
+var encoded: [(UInt32, CMSampleBuffer)] = []
+let encodedLock = NSLock()
+var session: VTCompressionSession?
+let made = VTCompressionSessionCreate(allocator: nil, width: Int32(W), height: Int32(H),
+    codecType: kCMVideoCodecType_H264, encoderSpecification: nil, imageBufferAttributes: nil,
+    compressedDataAllocator: nil, outputCallback: { _, tag, status, _, sample in
+        guard status == noErr, let sample = sample else { print("  encode status \(status)"); return }
+        encodedLock.lock(); encoded.append((UInt32(UInt(bitPattern: tag)), sample)); encodedLock.unlock()
+    }, refcon: nil, compressionSessionOut: &session)
+precondition(made == noErr, "VTCompressionSessionCreate: \(made)")
+let enc = session!
+VTSessionSetProperty(enc, key: kVTCompressionPropertyKey_RealTime, value: kCFBooleanTrue)
+VTSessionSetProperty(enc, key: kVTCompressionPropertyKey_AllowFrameReordering, value: kCFBooleanFalse)
+VTSessionSetProperty(enc, key: kVTCompressionPropertyKey_MaxKeyFrameInterval, value: 30 as CFNumber)
+VTSessionSetProperty(enc, key: kVTCompressionPropertyKey_AverageBitRate, value: 20_000_000 as CFNumber)
+
+var decoder: VTDecompressionSession?
+func makeDecoder(_ format: CMFormatDescription) {
+    let attrs = [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA] as CFDictionary
+    var d: VTDecompressionSession?
+    let r = VTDecompressionSessionCreate(allocator: nil, formatDescription: format, decoderSpecification: nil,
+                                         imageBufferAttributes: attrs, outputCallback: nil, decompressionSessionOut: &d)
+    precondition(r == noErr, "VTDecompressionSessionCreate: \(r)")
+    decoder = d
+}
+/// The frame number read back from a decoded BGRA frame: each block's centre, thresholded.
+func readNumber(_ pb: CVPixelBuffer) -> (Int64, Bool) {
+    CVPixelBufferLockBaseAddress(pb, .readOnly); defer { CVPixelBufferUnlockBaseAddress(pb, .readOnly) }
+    let base = CVPixelBufferGetBaseAddress(pb)!, bpr = CVPixelBufferGetBytesPerRow(pb)
+    let w = CVPixelBufferGetWidth(pb), h = CVPixelBufferGetHeight(pb)
+    var n: Int64 = 0, clean = true
+    for b in 0..<32 {
+        let bx = b % 8, by = b / 8
+        let x = Int((Double(bx) + 0.5) / 8 * Double(w)), y = Int((Double(by) + 0.5) / 4 * 0.8 * Double(h))
+        let p = (base + y * bpr + x * 4).assumingMemoryBound(to: UInt8.self)
+        let g = Int(p[1])
+        if g > 160 { n |= 1 << b } else if g >= 96 { clean = false }
+    }
+    return (n, clean)
+}
+func decode(_ sample: CMSampleBuffer) -> (Int64, Bool)? {
+    if decoder == nil { makeDecoder(CMSampleBufferGetFormatDescription(sample)!) }
+    var got: (Int64, Bool)?
+    let r = VTDecompressionSessionDecodeFrame(decoder!, sampleBuffer: sample, flags: [], infoFlagsOut: nil) {
+        status, _, image, _, _ in
+        if status == noErr, let image = image { got = readNumber(image) }
+    }
+    VTDecompressionSessionWaitForAsynchronousFrames(decoder!)
+    return r == noErr ? got : nil
+}
+
+print("device:", dev.name, "frames of \(W)x\(H) BGRA for \(Int(seconds)) s")
+let start = Date()
+var n: UInt32 = 1, frames = 0, wrong = 0, undecoded = 0, unclean = 0, firstWrong = ""
+var renderNs: UInt64 = 0, encodeNs: UInt64 = 0
+while Date().timeIntervalSince(start) < seconds {
+    let slot = slots[Int(n) % slots.count]
+    let t0 = DispatchTime.now().uptimeNanoseconds
+    render(slot.texture, n)
+    let t1 = DispatchTime.now().uptimeNanoseconds
+    let pts = CMTime(value: CMTimeValue(n), timescale: 60)
+    let r = VTCompressionSessionEncodeFrame(enc, imageBuffer: slot.buffer, presentationTimeStamp: pts,
+        duration: .invalid, frameProperties: nil, sourceFrameRefcon: UnsafeMutableRawPointer(bitPattern: UInt(n)),
+        infoFlagsOut: nil)
+    precondition(r == noErr, "VTCompressionSessionEncodeFrame: \(r)")
+    // The encoder reads the surface before this returns; the frame must be out of its
+    // queue before the slot is reused three frames on.
+    VTCompressionSessionCompleteFrames(enc, untilPresentationTimeStamp: pts)
+    let t2 = DispatchTime.now().uptimeNanoseconds
+    renderNs += t1 - t0; encodeNs += t2 - t1
+    encodedLock.lock(); let out = encoded; encoded.removeAll(); encodedLock.unlock()
+    for (tag, sample) in out {
+        frames += 1
+        guard let (got, clean) = decode(sample) else { undecoded += 1; continue }
+        if !clean { unclean += 1 }
+        if got != Int64(tag & 0xffff_ffff) {
+            wrong += 1
+            if firstWrong.isEmpty { firstWrong = "frame \(tag) decoded as \(got)" }
+        }
+    }
+    if n % 100 == 0 {
+        print("  \(n) frames, \(wrong) wrong, render \(renderNs / UInt64(n) / 1000) us, encode \(encodeNs / UInt64(n) / 1000) us")
+        fflush(stdout)
+    }
+    n += 1
+}
+VTCompressionSessionCompleteFrames(enc, untilPresentationTimeStamp: .invalid)
+let ok = wrong == 0 && undecoded == 0 && frames > 0
+print(ok ? "PASS" : "FAIL", "frames \(frames) wrong \(wrong) undecoded \(undecoded) unclean-blocks-frames \(unclean)",
+      "render-us \(renderNs / UInt64(max(n, 1)) / 1000) encode-us \(encodeNs / UInt64(max(n, 1)) / 1000)", firstWrong)
+exit(ok ? 0 : 1)
diff --git a/scripts/internal/census/probe_long.swift b/scripts/internal/census/probe_long.swift
new file mode 100644
index 00000000..760a2c4f
--- /dev/null
+++ b/scripts/internal/census/probe_long.swift
@@ -0,0 +1,60 @@
+// probe_long.swift (long run): swiftc -O probe_common.swift probe_long.swift -o probe_long
+// PROBE_SECONDS (default 300). Thousands of frames over minutes, each one checked:
+// - Four surfaces are used in turn, so each is reused every fourth frame.
+// - Every 37th frame, a surface's texture is dropped and a new one made on it.
+// - Every 101st frame, a surface is dropped and a new one made, which may land on its pages.
+// - Each frame the GPU renders a gradient whose colour changes every frame. Then the CPU reads it,
+//   and the GPU reads it through a second texture.
+// - Every 5th frame the CPU writes a band of rows first, and the GPU's read must see it.
+// It prints one line per 500 frames and ends with PASS or FAIL plus numbers.
+import Foundation
+import Metal
+import IOSurface
+
+let W = 1600, H = 1000
+let seconds = env("PROBE_SECONDS", 300)
+struct Slot { var surface: IOSurface; var writer: MTLTexture; var reader: MTLTexture }
+func makeSlot() -> Slot { let s = makeSurface(W, H); return Slot(surface: s, writer: texture(s), reader: texture(s)) }
+var slots = (0..<4).map { _ in makeSlot() }
+func colour(_ n: Int) -> [Float] {
+    [Float(n % 7 + 1) / 8, Float(n % 5 + 1) / 6, Float(n % 11) / 11, 1]
+}
+let band = 40, bandValue: UInt32 = 0xff20_4060
+print("device:", dev.name, "\(W)x\(H) BGRA for \(Int(seconds)) s")
+let start = Date()
+var n = 0, recreatedTextures = 0, recreatedSurfaces = 0, frameFails = 0, firstFail = ""
+while Date().timeIntervalSince(start) < seconds {
+    let i = n % slots.count
+    if n % 101 == 100 { slots[i] = makeSlot(); recreatedSurfaces += 1 }
+    else if n % 37 == 36 {
+        slots[i].writer = texture(slots[i].surface); slots[i].reader = texture(slots[i].surface); recreatedTextures += 1
+    }
+    let slot = slots[i], c = colour(n), y0 = (n * 13) % (H - band)
+    gradient(slot.writer, c)
+    let cpuBand = n % 5 == 0
+    if cpuBand {
+        slot.surface.lock(options: [], seed: nil)
+        for y in y0..<(y0 + band) {
+            let row = (slot.surface.baseAddress + y * slot.surface.bytesPerRow).assumingMemoryBound(to: UInt32.self)
+            for x in 0..<W { row[x] = bandValue }
+        }
+        slot.surface.unlock(options: [], seed: nil)
+    }
+    let expect: (Int, Int) -> [UInt8] = { x, y in
+        cpuBand && y >= y0 && y < y0 + band ? [0x60, 0x40, 0x20, 0xff] : want(c, W, H, x, y)
+    }
+    let (g1, t1, f1) = compare(slot.surface, step: 53, expect)
+    let (g2, t2, f2) = compare(viaGPU(slot.reader), step: 53, expect)
+    if g1 != t1 || g2 != t2 {
+        frameFails += 1
+        if firstFail.isEmpty { firstFail = "frame \(n) slot \(i): cpu \(g1)/\(t1) \(f1) gpu \(g2)/\(t2) \(f2)" }
+    }
+    n += 1
+    if n % 500 == 0 {
+        print("  \(n) frames, \(frameFails) failed, \(recreatedTextures) textures and \(recreatedSurfaces) surfaces made again",
+              String(format: "%.1f fps", Double(n) / Date().timeIntervalSince(start)))
+        fflush(stdout)
+    }
+}
+if frameFails != 0 { failed += 1; print("  first:", firstFail) }
+finish("frames \(n) failed-frames \(frameFails) textures-made-again \(recreatedTextures) surfaces-made-again \(recreatedSurfaces)")
diff --git a/scripts/internal/census/probe_signal.swift b/scripts/internal/census/probe_signal.swift
new file mode 100644
index 00000000..b3d408d9
--- /dev/null
+++ b/scripts/internal/census/probe_signal.swift
@@ -0,0 +1,43 @@
+// probe_signal.swift (CPU read after a shared-event signal): swiftc -O probe_common.swift probe_signal.swift -o probe_signal
+// One command buffer renders a gradient into a surface, signals a shared event, then keeps the GPU
+// busy with unrelated work. The CPU waits for the event, not for the command buffer, and reads the
+// surface at once. Metal promises the render's writes are visible at the signal, so the read must
+// see them though the command buffer has not completed. It prints whether the command buffer was
+// still running at the read; a round where it had completed proves nothing and is counted apart.
+import Foundation
+import Metal
+import IOSurface
+
+let W = 1920, H = 1200
+let A: [Float] = [1, 1, 0.25, 1], B: [Float] = [0.5, 1, 0.75, 1]
+let rounds = Int(env("PROBE_ROUNDS", 20))
+let busyDraws = Int(env("PROBE_BUSY_DRAWS", 600))
+print("device:", dev.name, "rounds \(rounds), busy draws \(busyDraws)")
+let busySurface = makeSurface(W, H), busy = texture(busySurface)
+var running = 0, completed = 0
+for round in 0..<rounds {
+    let s = makeSurface(W, H), t = texture(s)
+    let c = round % 2 == 0 ? A : B, before = round % 2 == 0 ? B : A
+    gradient(t, before); _ = viaGPU(t)
+    let ev = dev.makeSharedEvent()!
+    let b = queue.makeCommandBuffer()!
+    encodeGradient(b, t, c)
+    b.encodeSignalEvent(ev, value: 1)
+    encodeGradient(b, busy, A, draws: busyDraws)
+    b.commit()
+    let until = Date().addingTimeInterval(5)
+    while ev.signaledValue < 1 && Date() < until { usleep(50) }
+    let signalled = ev.signaledValue >= 1
+    let stillRunning = b.status != .completed
+    // Read with no lock first, as an app that trusts the event may, then with a read lock.
+    let (good, total, first) = compare(s, lock: false) { want(c, W, H, $0, $1) }
+    let (good2, total2, first2) = compare(s) { want(c, W, H, $0, $1) }
+    b.waitUntilCompleted()
+    if stillRunning { running += 1 } else { completed += 1 }
+    let ok = signalled && good == total && good2 == total2
+    print(ok ? "  ok  " : "  BAD ", "round \(round)", signalled ? "" : "(the event never came)",
+          stillRunning ? "the buffer was running" : "the buffer had completed",
+          "unlocked \(good)/\(total) locked \(good2)/\(total2)", first, first2)
+    if !ok { failed += 1 }
+}
+finish("rounds-read-while-running \(running) rounds-already-completed \(completed)")
diff --git a/scripts/internal/census/probe_tail.swift b/scripts/internal/census/probe_tail.swift
new file mode 100644
index 00000000..c0b3641f
--- /dev/null
+++ b/scripts/internal/census/probe_tail.swift
@@ -0,0 +1,52 @@
+// probe_tail.swift (B1): swiftc -O probe_common.swift probe_tail.swift -o probe_tail
+// A 3200x1800 BGRA surface's rows end at 23,040,000 bytes; it is made with 64 KiB more, so its
+// allocation has whole pages past the rows. The CPU writes those trailing pages (as an app keeping
+// its own data after the pixels may) between GPU renders and CPU reads of the pixels. Every check
+// must pass, and the trailing bytes must keep what the CPU wrote.
+// That Coherent stays on is checked on the host: after a run the census must not have fused
+// ("census: fused" absent from the QEMU log) and the m2v counters closed_by_overlap and
+// closed_by_marks must not grow. The probe prints the time per round too: a surface that fell back
+// to copies costs a full copy each way, so a large jump between rounds is a hint.
+import Foundation
+import Metal
+import IOSurface
+
+let W = 3200, H = 1800
+let rowsEnd = W * 4 * H
+let s = makeSurface(W, H, allocSize: rowsEnd + 65536)
+let t = texture(s)
+let A: [Float] = [1, 1, 0.25, 1], B: [Float] = [0.5, 1, 0.75, 1]
+print("device:", dev.name, "bytesPerRow \(s.bytesPerRow) allocationSize \(s.allocationSize) rows end \(s.bytesPerRow * H)")
+let tailStart = s.bytesPerRow * H, tailLength = s.allocationSize - tailStart
+if tailLength < 4096 { print("  note: only \(tailLength) bytes past the rows; the trailing-page case is not reached") }
+func writeTail(_ v: UInt8) {
+    s.lock(options: [], seed: nil)
+    memset(s.baseAddress + tailStart, Int32(v), tailLength)
+    s.unlock(options: [], seed: nil)
+}
+func tailHolds(_ v: UInt8) -> Bool {
+    s.lock(options: .readOnly, seed: nil); defer { s.unlock(options: .readOnly, seed: nil) }
+    let p = (s.baseAddress + tailStart).assumingMemoryBound(to: UInt8.self)
+    return (0..<tailLength).allSatisfy { p[$0] == v }
+}
+let rounds = Int(env("PROBE_ROUNDS", 200))
+var times: [Double] = []
+for round in 0..<rounds {
+    let c = round % 2 == 0 ? A : B, v = UInt8(truncatingIfNeeded: round &+ 1)
+    let t0 = Date()
+    gradient(t, c)
+    writeTail(v)
+    let (good, total, first) = compare(s) { want(c, W, H, $0, $1) }
+    let (good2, total2, first2) = compare(viaGPU(t)) { want(c, W, H, $0, $1) }
+    let tail = tailHolds(v)
+    times.append(Date().timeIntervalSince(t0) * 1000)
+    let ok = good == total && good2 == total2 && tail
+    if !ok || round % 50 == 0 {
+        print(ok ? "  ok  " : "  BAD ", "round \(round): cpu \(good)/\(total) gpu \(good2)/\(total2) tail \(tail)",
+              String(format: "%.2f ms", times.last!), first, first2)
+    }
+    if !ok { failed += 1 }
+}
+let sorted = times.sorted()
+finish(String(format: "rounds %d median-ms %.2f p95-ms %.2f max-ms %.2f", rounds, sorted[sorted.count / 2],
+              sorted[sorted.count * 95 / 100], sorted.last!))
diff --git a/scripts/internal/census/probe_untracked.swift b/scripts/internal/census/probe_untracked.swift
new file mode 100644
index 00000000..42622f90
--- /dev/null
+++ b/scripts/internal/census/probe_untracked.swift
@@ -0,0 +1,55 @@
+// probe_untracked.swift (P2): swiftc -O probe_common.swift probe_untracked.swift -o probe_untracked
+// An untracked-hazard texture is made on a surface first, then a tracked one on the same surface.
+// The GPU writes through the tracked one and reads through the untracked one, which the runtime's
+// hazard tracking does not see. The read must still see the write: the untracked reader is
+// synced like any other. Run in four orders: the reader waits for the writer, or commits right
+// after it on the same queue; the reader samples, or blits.
+import Foundation
+import Metal
+import IOSurface
+
+let W = 1920, H = 1200
+let A: [Float] = [1, 1, 0.25, 1], B: [Float] = [0.5, 1, 0.75, 1]
+print("device:", dev.name)
+for (name, waits) in [("the reader commits after the write completed", true),
+                      ("the reader commits right after the writer, same queue", false)] {
+    print("[1] untracked reader made first, tracked writer:", name)
+    for round in 0..<3 {
+        let s = makeSurface(W, H)
+        let reader = texture(s, untracked: true), writer = texture(s)
+        gradient(writer, B); _ = viaGPU(reader)
+        let c = round % 2 == 0 ? A : B
+        let other = round % 2 == 0 ? B : A
+        gradient(writer, other)
+        gradient(writer, c, wait: waits)
+        let out = makeSurface(W, H), o = texture(out)
+        let b = queue.makeCommandBuffer()!
+        encodeCopy(b, reader, o); b.commit(); b.waitUntilCompleted()
+        check("round \(round): the untracked texture's view", out) { want(c, W, H, $0, $1) }
+    }
+}
+print("[2] untracked reader made first, read by a blit into a buffer")
+do {
+    let s = makeSurface(W, H)
+    let reader = texture(s, untracked: true), writer = texture(s)
+    gradient(writer, B); _ = viaGPU(reader)
+    gradient(writer, A, wait: false)
+    let bpr = W * 4, buf = dev.makeBuffer(length: bpr * H, options: .storageModeShared)!
+    let b = queue.makeCommandBuffer()!, e = b.makeBlitCommandEncoder()!
+    e.copy(from: reader, sourceSlice: 0, sourceLevel: 0, sourceOrigin: MTLOrigin(x: 0, y: 0, z: 0),
+           sourceSize: MTLSize(width: W, height: H, depth: 1), to: buf, destinationOffset: 0,
+           destinationBytesPerRow: bpr, destinationBytesPerImage: bpr * H)
+    e.endEncoding(); b.commit(); b.waitUntilCompleted()
+    let p = buf.contents().assumingMemoryBound(to: UInt8.self)
+    var bad = 0, total = 0, first = ""
+    for y in stride(from: 2, to: H, by: 37) {
+        for x in stride(from: 1, to: W, by: 37) {
+            let at = y * bpr + x * 4, g = [p[at], p[at + 1], p[at + 2], p[at + 3]], w = want(A, W, H, x, y)
+            total += 1
+            if zip(g, w).contains(where: { abs(Int($0) - Int($1)) > 2 }) { bad += 1; if first.isEmpty { first = "(\(x),\(y)) got \(g) want \(w)" } }
+        }
+    }
+    print(bad == 0 ? "  ok  " : "  BAD ", "the blit's bytes", "\(total - bad)/\(total)", first)
+    if bad != 0 { failed += 1 }
+}
+finish()
