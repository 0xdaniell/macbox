+// Two planes of one census surface, each a range of its own, as a biplanar surface's two
+// textures are: each tracks, arms and goes alone, and a range over another is refused.
+static void t_planes(struct vcpu *c) {
+    printf("[planes] two ranges of one surface: one's untrack leaves the other armed\n");
+    named = PAGES / 2;
+    surface(15, 0x1100000);
+    uint64_t second = s.base + (PAGES / 2) * PG, pages0 = census_coherent_pages;
+    CHECK(!census_coh_track(s.base + PG, PG), "a range inside the first is refused");
+    CHECK(!census_coh_track(second - PG, 2 * PG), "and one that meets it");
+    CHECK(census_coh_track(s.base, (PAGES / 2) * PG), "the same range again is tracked already");
+    CHECK(census_coherent_pages == pages0, "and counts once");
+    CHECK(census_coh_track(second, (PAGES / 2) * PG), "the second plane tracks");
+    CHECK(census_coherent_pages == pages0 + PAGES / 2, "its pages count");
+    CHECK(state(PAGES / 2) == 2 && state(PAGES - 1) == 2, "held");
+    completed(1, 0x9999);
+    uint64_t at = second;
+    CHECK(census_coh_arm(&at, 1, NULL, 0) == 0 && state(PAGES / 2) == 1, "a page of each armed");
+    CHECK(state(0) == 1, "the first's too");
+    census_coh_untrack(s.base);
+    CHECK(state(0) == 3 && state(PAGES / 2 - 1) == 3, "the first plane's pages open");
+    CHECK(state(PAGES / 2) == 1 && state(PAGES - 1) == 2, "the second's stay as they were");
+    CHECK(census_coherent_pages == pages0, "the first's pages no longer count");
+    int faults = s.faults;
+    census_coherent_touch(main_map + s.off, 8, true);
+    CHECK(s.faults == faults, "a device's write to the first plane is no one's now");
+    CHECK(census_coh_track(s.base, (PAGES / 2) * PG), "and it tracks again");
+    census_coh_untrack(second);
+    CHECK(state(PAGES / 2) == 3 && state(0) == 2, "the second goes alone");
+    census_surface_unmapped(15);
+    CHECK(state(0) == 6 && census_coherent_pages == pages0 - PAGES / 2, "the unmap takes the rest");
     named = PAGES;
 }
 
