+/// LOCAL (Atlas): tells the runtime's trapping surfaces (`shadow_coherent`) that a host outside
+/// it is about to read or write `surface`'s `length` bytes (`notice` is `host_reads` or
+/// `host_writes`), so a read sees the GPU's writes copied back first and a write reaches the
+/// image the next command uses. A trapping surface lies over the buffer a texture on it is over,
+/// which is either the run of the guest's pages the bytes lie in or the surface's own view of
+/// them at `base`, so both are named; a surface that meets neither costs a scan of the tracked
+/// surfaces, none when nothing traps.
+/// LOCAL (Atlas): a device is about to read (`write` false) or write `surface`'s bytes as a lend
+/// would lend them, through memory lent to it outside a lend (a dma-buf of its pages): the
+/// trapping surfaces over them are told, as [`lend_surface_bytes`] tells them.
+pub fn surface_device_access(surface: &OsSurface, write: bool) {
+    let base = surface.base_address().as_ptr::<u8>().addr().to_u64();
+    if surface.protection_options() != 0 || base == 0 {
+        return;
+    }
+    let made = recorded(surface, |made| (made.pages.clone(), made.offset));
+    let offset = made.as_ref().map_or(0, |(_, offset)| *offset);
+    let length = surface.alloc_size().saturating_sub(offset);
+    let notice = if write { rt::shadow_coherent::host_writes } else { rt::shadow_coherent::host_reads };
+    host_meets(&made, base, offset, length, notice);
+}
+
+fn host_meets(
+    made: &Option<(Vec<std::ops::Range<u64>>, u64)>,
+    base: u64,
+    offset: u64,
+    length: u64,
+    mut notice: impl FnMut(std::ops::Range<u64>),
+) {
+    notice(base..base.saturating_add(length));
+    if let Some((pages, _)) = made {
+        for run in in_runs(pages, &(offset..offset.saturating_add(length))) {
+            notice(run);
+        }
+    }
+}
+
