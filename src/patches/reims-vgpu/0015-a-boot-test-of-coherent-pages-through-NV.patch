diff --git a/crates/reims-vgpu-c/src/coherent.rs b/crates/reims-vgpu-c/src/coherent.rs
index d8f6e9ad..25278ac4 100644
--- a/crates/reims-vgpu-c/src/coherent.rs
+++ b/crates/reims-vgpu-c/src/coherent.rs
@@ -59,6 +59,53 @@ mod on {
 
     pub(super) use metal2vulkan_runtime::shadow_coherent as runtime;
 
+    /// While `REIMS_VGPU_COHERENT_REHEARSE=<period us>:<take every n frames, 0 for never>` says so,
+    /// a thread runs a surface's command buffers over its top half, with no GPU, each "image" a
+    /// new word in every texel, until the surface goes.
+    pub(super) fn rehearse(base: u64, width: u32, height: u32, row: u64) {
+        use metal2vulkan_runtime::shadow_coherent::{Layout, Rehearsal};
+        use std::time::Duration;
+
+        let Ok(asked) = std::env::var("REIMS_VGPU_COHERENT_REHEARSE") else {
+            return;
+        };
+        let (period, every) = asked.split_once(':').unwrap_or((&asked, "0"));
+        let period = Duration::from_micros(period.parse().unwrap_or(500));
+        let every: u64 = every.parse().unwrap_or(0);
+        let frame = std::sync::Arc::new(std::sync::atomic::AtomicU32::new(0));
+        let word = frame.clone();
+        let layout = Layout { base, row, texel: 4, width, height };
+        let read = Box::new(move |[x0, y0, x1, y1]: [u32; 4], to: *mut u8, stride: u32| {
+            let word = word.load(std::sync::atomic::Ordering::Relaxed) | 0xc0de_0000;
+            for y in 0..u64::from(y1 - y0) {
+                for x in 0..u64::from(x1 - x0) {
+                    let at = (y * u64::from(stride) + x) * 4;
+                    // SAFETY: the sync gives `to` over the rectangle's rows of `stride` texels.
+                    unsafe { to.add(at as usize).cast::<u32>().write_unaligned(word) };
+                }
+            }
+            true
+        });
+        let area = [0, 0, width, height / 2];
+        let surface = Rehearsal::new(layout, read);
+        let spawned = std::thread::Builder::new().name("rehearsal".into()).spawn(move || {
+            if !surface.track() {
+                eprintln!("rehearsal: the surface at {base:#x} does not track");
+                return;
+            }
+            eprintln!("rehearsal: {width}x{height} at {base:#x}");
+            for id in (1u64 << 48).. {
+                frame.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                let take = every != 0 && id % every == 0;
+                if !surface.frame(id, area, period / 4, take) {
+                    return;
+                }
+                std::thread::sleep(period);
+            }
+        });
+        drop(spawned);
+    }
+
     /// The host's hooks, as the runtime's marks.
     pub(super) struct HostPages(pub(super) RvgCoherentHooks);
 
@@ -225,6 +272,17 @@ pub extern "C" fn rvg_coherent_unmapped(start: u64, len: u64) {
     });
 }
 
+/// A rehearsal of the surface. See the header.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_coherent_rehearse(base: u64, width: u32, height: u32, row: u64) {
+    ffi::export(|| {
+        #[cfg(feature = "vulkan")]
+        on::rehearse(base, width, height, row);
+        #[cfg(not(feature = "vulkan"))]
+        let _ = (base, width, height, row);
+    });
+}
+
 /// The report. See the header.
 ///
 /// # Safety
