From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: macbox <macbox@localhost>
Date: Thu, 5 Nov 2026 15:51:31 +0000
Subject: [PATCH 27/33] REIMS_VGPU_GROUPED=1 boot switch for grouped completion
 (DEEP-GPU A/B)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/reims-vgpu-vulkan/src/platform.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/crates/reims-vgpu-vulkan/src/platform.rs b/crates/reims-vgpu-vulkan/src/platform.rs
index 8c7771db..f8b22b88 100644
--- a/crates/reims-vgpu-vulkan/src/platform.rs
+++ b/crates/reims-vgpu-vulkan/src/platform.rs
@@ -273,6 +273,18 @@ pub(crate) fn device_options() -> &'static rt::DeviceOptions {
         crate::os::add_window_extensions(&mut options);
         options.gpu_times_from_host = true;
         options.policy = exact_policy(std::env::var("REIMS_VGPU_EXACT").ok().as_deref());
+        // LOCAL (Atlas, DEEP-GPU): `REIMS_VGPU_GROUPED=1`, read once per process, takes the
+        // runtime's grouped completion (`CompletionPolicy::Grouped`) for an A/B of kernel
+        // submissions per frame. It groups only where the driver fact
+        // `SubmissionsWithoutSignalsMerge` holds (the live switch `facts_on=` gives it), and the
+        // runtime announces `GroupedCompletion` once, relayed outside strict mode.
+        if std::env::var_os("REIMS_VGPU_GROUPED").is_some_and(|v| v == "1") {
+            options.policy.completion = metal2vulkan::device::CompletionPolicy::Grouped;
+            let _ = std::io::Write::write_all(
+                &mut std::io::stderr(),
+                b"reims-vgpu: REIMS_VGPU_GROUPED=1: grouped completion\n",
+            );
+        }
         let sink = rt::MessageSink::new(crate::answer::notice);
         options.messages = Some(sink.with_least_severity(crate::answer::least_severity()));
         options.announce_each =
