index 00000000..5ebfa14e
--- /dev/null
+++ b/crates/reims-vgpu-core/src/memory/page_refs.rs
@@ -0,0 +1,262 @@
+//! LOCAL (Atlas): the live views over each guest page, and the staged page-up they allow.
+//!
+//! **What it is for.** A new paged texture's first page-up copies its guest pages into the host
+//! texture through a view: one `mmap` per run of guest pages (a 2.4 MB texture of the Sim's
+//! compositor is about 600 of them), a Vulkan import, and at the view's release a `munmap` whose
+//! dirty shared PTEs flush the TLB once per run on every CPU the process ran on, the vCPUs among
+//! them. Measured 2026-11-09 with one Sim: ~520 such views a second, all first page-ups of new
+//! `Shared` render targets, 15% of the Sim task thread, and ~57k TLB shootdowns a second. A staged
+//! page-up instead copies the pages on the CPU into a new buffer of the runtime's own and blits
+//! from it: no view, no import, no `munmap`.
+//!
+//! **Why the copy is the same bytes.** The view's blit reads the pages on the GPU, after every
+//! earlier exec's GPU work (the paging command buffer waits on the FIFO's chain). A copy at the
+//! exec reads them earlier. The two can differ only by a GPU write still pending at the exec, and
+//! the GPU reaches guest RAM only through views a [`MemoryMap`](super::map::MemoryMap) makes
+//! (`new_range_mapping`), each alive until the runtime frees the last buffer over it, after the
+//! GPU's last use. So a page no live view covers has nothing pending, and the copy is taken only
+//! when no page of the texture is covered; else the view is made as ever. The guest's CPU writing
+//! the pages of a committed command buffer's resource is outside Metal's rules either way.
+//!
+//! **The switch.** `REIMS_VGPU_STAGED_PAGE_UP=<path>`: views are counted from the start, and
+//! page-ups are staged while that file exists (looked at once a second). Unset: nothing is
+//! counted and nothing changes. Counts stay at `u16::MAX` once they reach it (the page then
+//! always takes the view).
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU16, AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+use crate::guest::records::{APV_PAGE_MASK, APV_PAGE_SHIFT};
+use crate::host::PhysRange;
+use crate::num::ToUsize;
+
+/// The variable naming the switch file.
+pub const ENV_VAR: &str = "REIMS_VGPU_STAGED_PAGE_UP";
+
+/// The switch file and its last look.
+struct Switch {
+    path: Option<std::path::PathBuf>,
+    look: crate::sync::Mutex<(Option<Instant>, bool)>,
+}
+
+fn switch() -> &'static Switch {
+    static S: OnceLock<Switch> = OnceLock::new();
+    S.get_or_init(|| Switch {
+        path: std::env::var_os(ENV_VAR)
+            .filter(|p| !p.is_empty())
+            .map(std::path::PathBuf::from),
+        look: crate::sync::Mutex::new((None, false)),
+    })
+}
+
+/// Whether views are counted: the variable is set (read once).
+pub(crate) fn counting() -> bool {
+    !cfg!(test) && switch().path.is_some()
+}
+
+/// Whether page-ups are staged now: counting, and the file exists at the last look.
+pub(crate) fn staging() -> bool {
+    let s = switch();
+    let Some(path) = &s.path else {
+        return false;
+    };
+    if cfg!(test) {
+        return false;
+    }
+    let mut look = s.look.lock();
+    let now = Instant::now();
+    if look.0.is_none_or(|t| now.duration_since(t) >= Duration::from_secs(1)) {
+        *look = (Some(now), path.exists());
+    }
+    look.1
+}
+
+/// The staged page-ups' counters, all tasks together.
+struct Stats {
+    staged: AtomicU64,
+    staged_bytes: AtomicU64,
+    covered: AtomicU64,
+    copy_ns: AtomicU64,
+    last: crate::sync::Mutex<Option<Instant>>,
+}
+
+static STATS: Stats = Stats {
+    staged: AtomicU64::new(0),
+    staged_bytes: AtomicU64::new(0),
+    covered: AtomicU64::new(0),
+    copy_ns: AtomicU64::new(0),
+    last: crate::sync::Mutex::new(None),
+};
+
+/// Counts a staged page-up of `bytes`, whose buffer and copy took `ns`.
+pub(crate) fn note_staged(bytes: u64, ns: u64) {
+    STATS.staged.fetch_add(1, Ordering::Relaxed);
+    STATS.staged_bytes.fetch_add(bytes, Ordering::Relaxed);
+    STATS.copy_ns.fetch_add(ns, Ordering::Relaxed);
+    log_stats();
+}
+
+/// Counts a page-up that took the view because a live view covered one of its pages.
+pub(crate) fn note_covered() {
+    STATS.covered.fetch_add(1, Ordering::Relaxed);
+    log_stats();
+}
+
+/// Logs the counts (and resets them) at most every 10 s.
+fn log_stats() {
+    let now = Instant::now();
+    {
+        let mut last = STATS.last.lock();
+        match *last {
+            None => {
+                *last = Some(now);
+                return;
+            }
+            Some(t) if now.duration_since(t) < Duration::from_secs(10) => return,
+            Some(_) => *last = Some(now),
+        }
+    }
+    let staged = STATS.staged.swap(0, Ordering::Relaxed);
+    let bytes = STATS.staged_bytes.swap(0, Ordering::Relaxed);
+    let covered = STATS.covered.swap(0, Ordering::Relaxed);
+    let ns = STATS.copy_ns.swap(0, Ordering::Relaxed);
+    log::info!(
+        "staged page-ups: {staged} staged ({} KiB, {} us making and copying), {covered} took \
+         the view (a live view covered a page)",
+        bytes >> 10,
+        ns.wrapping_div(1000)
+    );
+}
+
+/// The live views over each guest page of `first..first + counts.len()` pages.
+pub struct PageRefs {
+    first: u64,
+    counts: Box<[AtomicU16]>,
+}
+
+impl std::fmt::Debug for PageRefs {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PageRefs")
+            .field("first", &self.first)
+            .field("pages", &self.counts.len())
+            .finish()
+    }
+}
+
+impl PageRefs {
+    /// Counts for the guest physical range `start..end`, all zero; `None` for an empty or
+    /// overflowing range.
+    pub(crate) fn new(start: u64, end: u64) -> Option<Self> {
+        let first = start >> APV_PAGE_SHIFT;
+        let last = end.checked_add(APV_PAGE_MASK)? >> APV_PAGE_SHIFT;
+        let pages = last.checked_sub(first).filter(|&n| n != 0)?.to_usize();
+        let counts = std::iter::repeat_with(|| AtomicU16::new(0))
+            .take(pages)
+            .collect();
+        Some(PageRefs { first, counts })
+    }
+
+    /// The pages of `range`, as indices: `None` when one lies outside.
+    fn indices(&self, range: &PhysRange) -> Option<std::ops::Range<usize>> {
+        let start = range.physical_address >> APV_PAGE_SHIFT;
+        let end = range
+            .physical_address
+            .checked_add(range.physical_length)?
+            .checked_add(APV_PAGE_MASK)?
+            >> APV_PAGE_SHIFT;
+        let from = start.checked_sub(self.first)?.to_usize();
+        let to = end.checked_sub(self.first)?.to_usize();
+        (to <= self.counts.len()).then_some(from..to)
+    }
+
+    /// A view over `ranges` was made.
+    pub(crate) fn add(&self, ranges: &[PhysRange]) {
+        for r in ranges {
+            if let Some(pages) = self.indices(r) {
+                for c in &self.counts[pages] {
+                    // Saturates, and then stays.
+                    let _ = c.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                        n.checked_add(1)
+                    });
+                }
+            }
+        }
+    }
+
+    /// A view over `ranges` is gone.
+    pub(crate) fn remove(&self, ranges: &[PhysRange]) {
+        for r in ranges {
+            if let Some(pages) = self.indices(r) {
+                for c in &self.counts[pages] {
+                    // A saturated count stays; 0 stays (never reached by a counted view).
+                    let _ = c.fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                        (n != 0 && n != u16::MAX).then(|| n.wrapping_sub(1))
+                    });
+                }
+            }
+        }
+    }
+
+    /// Whether a live view covers a page of `ranges`, or a page lies outside the counts.
+    pub(crate) fn covered(&self, ranges: &[PhysRange]) -> bool {
+        ranges.iter().any(|r| match self.indices(r) {
+            Some(pages) => self.counts[pages]
+                .iter()
+                .any(|c| c.load(Ordering::Acquire) != 0),
+            None => true,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PAGE: u64 = 1 << APV_PAGE_SHIFT;
+
+    fn pr(at: u64, len: u64) -> PhysRange {
+        PhysRange {
+            physical_address: at,
+            physical_length: len,
+        }
+    }
+
+    #[test]
+    fn a_page_is_covered_while_a_view_over_it_lives() {
+        let refs = PageRefs::new(PAGE, 9 * PAGE).unwrap();
+        let view = [pr(2 * PAGE, PAGE), pr(5 * PAGE, 2 * PAGE)];
+        assert!(!refs.covered(&[pr(PAGE, 8 * PAGE)]));
+        refs.add(&view);
+        refs.add(&view[..1]);
+        assert!(refs.covered(&[pr(6 * PAGE, PAGE)]));
+        assert!(!refs.covered(&[pr(3 * PAGE, 2 * PAGE), pr(7 * PAGE, PAGE)]));
+        refs.remove(&view);
+        assert!(!refs.covered(&[pr(5 * PAGE, 2 * PAGE)]));
+        assert!(refs.covered(&[pr(2 * PAGE, PAGE)]));
+        refs.remove(&view[..1]);
+        assert!(!refs.covered(&[pr(PAGE, 8 * PAGE)]));
+    }
+
+    #[test]
+    fn pages_outside_the_counts_count_as_covered() {
+        let refs = PageRefs::new(PAGE, 3 * PAGE).unwrap();
+        assert!(refs.covered(&[pr(0, PAGE)]));
+        assert!(refs.covered(&[pr(2 * PAGE, 2 * PAGE)]));
+        assert!(refs.covered(&[pr(u64::MAX - 1, 2)]));
+        refs.add(&[pr(3 * PAGE, PAGE)]);
+        assert!(!refs.covered(&[pr(PAGE, 2 * PAGE)]));
+    }
+
+    #[test]
+    fn a_saturated_count_stays() {
+        let refs = PageRefs::new(PAGE, 2 * PAGE).unwrap();
+        for _ in 0..u32::from(u16::MAX) + 2 {
+            refs.add(&[pr(PAGE, PAGE)]);
+        }
+        for _ in 0..u32::from(u16::MAX) + 2 {
+            refs.remove(&[pr(PAGE, PAGE)]);
+        }
+        assert!(refs.covered(&[pr(PAGE, PAGE)]));
