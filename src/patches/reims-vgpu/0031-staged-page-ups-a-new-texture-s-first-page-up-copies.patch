+    /// LOCAL (Atlas): a new buffer holding a copy of the task's pages `page..page + length`, for
+    /// a texture's first page-up, when page-ups are staged and no live view covers any of the
+    /// pages (`memory::page_refs` says why that copy is the bytes a view's blit would read);
+    /// `None` takes the view as ever. Raises as the view's walk would.
+    pub(super) fn staged_page_buffer(
+        &self,
+        hold: Hold<'_>,
+        page: u32,
+        length: u64,
+    ) -> RaiseResult<Option<P::Buffer>> {
+        if !crate::memory::page_refs::staging() || length == 0 || length & PAGE_MASK != 0 {
+            return Ok(None);
+        }
+        let offset = u64::from(page).wrapping_shl(APV_PAGE_SHIFT);
+        Self::check_task_range(offset, length, self.task_length())?;
+        let (Some(map), Some(device)) = (self.map(), self.device_handle()) else {
+            return Ok(None);
+        };
+        let Some(refs) = map.page_refs().cloned() else {
+            return Ok(None);
+        };
+        let started = self.mono();
+        let runs = self.task_page_runs(hold, offset, length)?;
+        let total = runs
+            .ranges
+            .iter()
+            .try_fold(0_u64, |sum, r| sum.checked_add(r.physical_length));
+        if total != Some(length) {
+            return Ok(None);
+        }
+        if refs.covered(&runs.ranges) {
+            crate::memory::page_refs::note_covered();
+            return Ok(None);
+        }
+        let Some(buffer) = device.new_buffer(BufferDesc {
+            length,
+            options: Vec::new(),
+            pinned_gpu_address: None,
+            contents: None,
+            no_copy: false,
+            deallocator: None,
+        })?
+        else {
+            return Ok(None);
+        };
+        let contents = buffer.contents();
+        if contents.is_null() {
+            return Ok(None);
+        }
+        #[allow(unsafe_code)] // architecture 17.3: the new buffer's own bytes, written once
+        // SAFETY: `contents` is the CPU address of the `length` bytes of a `Shared` buffer made
+        // just now, which nothing else holds yet, and `buffer` keeps them for this borrow.
+        let bytes = unsafe { std::slice::from_raw_parts_mut(contents.as_ptr::<u8>(), length.to_usize()) };
+        let mut at: usize = 0;
+        for r in &runs.ranges {
+            let end = at.wrapping_add(r.physical_length.to_usize());
+            let Some(dst) = bytes.get_mut(at..end) else {
+                return Ok(None);
+            };
+            if !map.read(r.physical_address, dst) {
+                return Ok(None);
+            }
+            at = end;
+        }
+        let ns = u64::try_from(self.mono().saturating_duration_since(started).as_nanos())
+            .unwrap_or(u64::MAX);
+        crate::memory::page_refs::note_staged(length, ns);
+        Ok(Some(buffer))
+    }
