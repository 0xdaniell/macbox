+/// The mode [`SKIP_ENV_VAR`] asks for (read once): 0 without it, or for any other value.
+pub(crate) fn skip_mode_by_env() -> u8 {
+    static MODE: OnceLock<u8> = OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var(SKIP_ENV_VAR).as_deref() {
+        Ok("1") => 1,
+        Ok("2") => 2,
+        _ => 0,
+    })
