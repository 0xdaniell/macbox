+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Off, nothing is ever skipped, and nothing is kept
+    #[test]
+    fn mode_zero_says_no() {
+        let fresh = FreshPageUps::new(0);
+        fresh.note_paged_down(3);
+        assert_eq!(fresh.mode_at(4, false), 0);
+        assert!(fresh.paged_down.lock().as_ref().unwrap().is_empty());
+    }
+
+    /// On, it says its mode, but not for a page a page-down reached, or after a resume
+    #[test]
+    fn a_paged_down_page_and_a_resume_refuse() {
+        let fresh = FreshPageUps::new(2);
+        assert_eq!(fresh.mode_at(3, false), 2);
+        fresh.note_paged_down(3);
+        assert_eq!(fresh.mode_at(3, false), 0);
+        assert_eq!(fresh.mode_at(4, false), 2);
+        assert_eq!(fresh.mode_at(4, true), 0);
+    }
+
+    /// Past the bound it forgets the pages, and so skips nothing more for good
+    #[test]
+    fn past_the_bound_it_refuses_for_good() {
+        let fresh = FreshPageUps::new(1);
+        for page in 0..=u32::try_from(MAX_PAGED_DOWN).unwrap() {
+            fresh.note_paged_down(page);
+        }
+        assert_eq!(fresh.mode_at(u32::MAX, false), 0);
+        fresh.note_paged_down(u32::MAX);
+        assert_eq!(fresh.mode_at(u32::MAX, false), 0);
+    }
+}
