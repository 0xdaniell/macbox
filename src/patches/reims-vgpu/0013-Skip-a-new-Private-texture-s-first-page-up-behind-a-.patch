+    /// LOCAL (Atlas): a `Private` texture of this task, registered at reference 1.
+    fn fresh_private(tx: &Tx) -> Arc<Resource<FakePlatform>> {
+        let t = new_texture(tx.p.world(), desc(70, 16, 8, 1, 3), None, 0, None, false);
+        t.state().device = Some(tx.p.device().erase());
+        t.set_storage_mode(2);
+        let task = Arc::clone(&tx.task) as Arc<dyn ResourceHost<FakePlatform>>;
+        let dimension = rec1(
+            header(0x300, 4, 3),
+            vec![
+                mip(0, 0x200, 64, 16, 8, 1),
+                mip(0x200, 0x80, 32, 8, 4, 1),
+                mip(0x280, 0x20, 16, 4, 2, 1),
+            ],
+        );
+        let r = with_platform(&tx.p, || {
+            create_texture_resource(
+                Arc::downgrade(&task),
+                2,
+                &paging(1, 0x1000),
+                &dimension,
+                0x84,
+                t,
+            )
+        })
+        .unwrap()
+        .unwrap();
+        assert!(
+            tx.task
+                .parts()
+                .1
+                .register_object::<Resources>(1, Arc::clone(&r))
+        );
+        r
+    }
+
+    /// The calls of one prepare of reference 1 with `flags`.
+    fn prepared(tx: &Tx, flags: u32) -> Vec<&'static str> {
+        let record = [CmdExecIndirectResource3 {
+            reference: 1,
+            flags,
+        }];
+        let mark = tx.p.call_log().mark();
+        let mut ids = Vec::new();
+        tx.task
+            .prepare_resources(
+                Hold::NONE,
+                Records::new(record.as_bytes(), 1).unwrap(),
+                None,
+                0,
+                &mut ids,
+            )
+            .unwrap();
+        tx.p.call_log().sels_since(mark)
+    }
+
+    fn pages(sels: &[&str]) -> bool {
+        sels.contains(&"commit")
+    }
+
+    /// LOCAL (Atlas): on, a new `Private` texture adds no paging buffer to the exec's path
+    #[test]
+    fn a_skipped_page_up_makes_no_paging_buffer() {
+        let tx = ready(&rw_pages(4));
+        tx.task.fresh_page_ups.set_mode(1);
+        let r = fresh_private(&tx);
+        let sels = prepared(&tx, 0);
+        assert!(!pages(&sels), "{sels:?}");
+        assert!(sels.is_empty(), "{sels:?}");
+        assert!(r.state.host_valid());
+    }
+
