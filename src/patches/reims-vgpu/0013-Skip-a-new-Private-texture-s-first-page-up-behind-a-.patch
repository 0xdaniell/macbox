+/// A task's say over new `Private` textures' page-ups ([`SKIP_ENV_VAR`]).
+pub(crate) struct FreshPageUps {
+    mode: AtomicU8,
+    /// The task pages a `Private` page-down reached, where a later object is paged up as ever;
+    /// `None` past [`MAX_PAGED_DOWN`], where the task skips no more.
+    paged_down: crate::sync::Mutex<Option<HashSet<u32>>>,
+}
+
+impl FreshPageUps {
+    /// With mode `mode`.
+    pub(crate) fn new(mode: u8) -> Self {
+        FreshPageUps {
+            mode: AtomicU8::new(mode),
+            paged_down: crate::sync::Mutex::new(Some(HashSet::new())),
+        }
+    }
+
+    /// Turns the mode to `mode`, as the variable would have.
+    #[cfg(test)]
+    pub(crate) fn set_mode(&self, mode: u8) {
+        self.mode.store(mode, Ordering::Relaxed);
+    }
+
+    /// The mode for a texture at `page`, 0 for none, `resumed` being [`resumed`].
+    pub(crate) fn mode_at(&self, page: u32, resumed: bool) -> u8 {
+        let mode = self.mode.load(Ordering::Relaxed);
+        if mode == 0 || resumed {
+            return 0;
+        }
+        match self.paged_down.lock().as_ref() {
+            Some(pages) if !pages.contains(&page) => mode,
+            _ => 0,
+        }
+    }
+
+    /// A `Private` page-down reached `page`.
+    pub(crate) fn note_paged_down(&self, page: u32) {
+        if self.mode.load(Ordering::Relaxed) == 0 {
+            return;
+        }
+        let mut guard = self.paged_down.lock();
+        if let Some(pages) = guard.as_mut() {
+            pages.insert(page);
+            if pages.len() > MAX_PAGED_DOWN {
+                *guard = None;
+            }
+        }
+    }
+}
