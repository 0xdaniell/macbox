+    // Each frame's Metal objects (viaGPU's surface and texture) go back at its end, or they pile up
+    // until the guest driver faults (SIGBUS after ~4000 frames, seen 2026-11-03).
+    autoreleasepool {
+        let i = n % slots.count
+        if n % 101 == 100 { slots[i] = makeSlot(); recreatedSurfaces += 1 }
+        else if n % 37 == 36 {
+            slots[i].writer = texture(slots[i].surface); slots[i].reader = texture(slots[i].surface); recreatedTextures += 1
+        }
+        let slot = slots[i], c = colour(n), y0 = (n * 13) % (H - band)
