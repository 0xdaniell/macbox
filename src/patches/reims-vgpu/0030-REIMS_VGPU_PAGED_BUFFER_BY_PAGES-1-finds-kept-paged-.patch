+/// LOCAL (Atlas): whether entries are found by the guest pages they show (read once).
+fn by_pages() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("REIMS_VGPU_PAGED_BUFFER_BY_PAGES").as_deref() == Ok("1"))
+}
