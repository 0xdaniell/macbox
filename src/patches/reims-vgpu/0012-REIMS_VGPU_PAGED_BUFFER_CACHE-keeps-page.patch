+//! LOCAL (Atlas): the buffers over guest pages a paged texture pages through, kept across the
+//! textures that use the same pages.
+//!
+//! macOS's compositor makes and deletes a texture per frame on a dozen recycled ranges of task
+//! pages. Each new texture cost a walk, one `mmap` per run of guest pages (a 2.4 MB texture is
+//! about 148 of them, 2.7 ms on the exec's serial path), a Vulkan import and, at its release, the
+//! free and the `munmap`. `REIMS_VGPU_PAGED_BUFFER_CACHE=<entries>` keeps that many buffers per
+//! task; unset or 0 keeps none and the path is the plain one.
+//!
+//! **What a hit proves.** The key is the task page and the length, and every lookup walks the
+//! guest's page table first: a hit needs the same guest-physical runs, the same writability and
+//! the same memory map as the entry. An entry that no longer matches is dropped, never used. So
+//! nothing is ever paged through a view of pages the task does not map at that moment, whatever
+//! the guest did to them meanwhile, told or not.
+//!
+//! **When entries go.** At `UnmapMemory` over their range, at `ReplacePhysical` and
+//! `DiscardResources` (all of them: neither says which pages it means), at a failed match, past
+//! the capacity (least recently used first), [`MAX_IDLE`] after their last use, and at the task's
+//! end and drop, which is also where a device's guest-memory lease ends for its tasks. Dropping
+//! an entry drops one reference: a command buffer or texture still using the buffer keeps it,
+//! and the view goes with the last reference, by the buffer's own deallocator, as ever.
+
+use std::collections::VecDeque;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::time::Duration;
+
+use crate::host::PhysRange;
+use crate::num::ToU64;
+use crate::platform::Handle;
+use crate::platform::os::clock::MonoTime;
+
+/// The environment variable: entries per task.
+pub(crate) const ENV_VAR: &str = "REIMS_VGPU_PAGED_BUFFER_CACHE";
+/// The most entries the variable takes.
+const MAX_ENTRIES: usize = 256;
+/// An entry unused for this long goes at the next sweep.
+pub(crate) const MAX_IDLE: Duration = Duration::from_secs(1);
+/// A summary line per this many presents.
+const LOG_EVERY: u64 = 600;
+
+/// The entries the variable asks for (read once): 0 without it.
+pub(crate) fn entries_by_env() -> usize {
+    static ENTRIES: OnceLock<usize> = OnceLock::new();
+    *ENTRIES.get_or_init(|| {
+        std::env::var(ENV_VAR)
+            .ok()
+            .and_then(|v| v.parse::<usize>().ok())
+            .unwrap_or(0)
+            .min(MAX_ENTRIES)
+    })
+}
+
+/// Counters of the guest-page mappings of the whole process, relaxed, cumulative. They count with
+/// the switch off too, for the baseline.
+#[derive(Debug, Default)]
+pub struct MappingStats {
+    /// Views made of task pages for a new buffer.
+    pub made: AtomicU64,
+    /// Buffers a paged texture took from the cache.
+    pub reused: AtomicU64,
+    /// Entries dropped by an invalidation or a failed match (not by capacity or age).
+    pub invalidated: AtomicU64,
+    /// Nanoseconds walking page tables for these buffers.
+    pub walk_ns: AtomicU64,
+    /// Nanoseconds making views: `mmap`, its bookkeeping and locks.
+    pub map_ns: AtomicU64,
+    /// Nanoseconds making no-copy buffers over the views: the Vulkan import.
+    pub import_ns: AtomicU64,
+}
+
+/// The process's counters.
+pub static STATS: MappingStats = MappingStats {
+    made: AtomicU64::new(0),
+    reused: AtomicU64::new(0),
+    invalidated: AtomicU64::new(0),
+    walk_ns: AtomicU64::new(0),
+    map_ns: AtomicU64::new(0),
+    import_ns: AtomicU64::new(0),
+};
+
+impl MappingStats {
+    /// The counters, in the order of the `mapstat` event.
+    fn values(&self) -> [u64; 6] {
+        [
+            self.made.load(Ordering::Relaxed),
+            self.reused.load(Ordering::Relaxed),
+            self.invalidated.load(Ordering::Relaxed),
+            self.walk_ns.load(Ordering::Relaxed),
+            self.map_ns.load(Ordering::Relaxed),
+            self.import_ns.load(Ordering::Relaxed),
+        ]
+    }
+}
+
+/// Adds the time since `from` to `counter`.
+pub(crate) fn add_since(counter: &AtomicU64, from: MonoTime, to: MonoTime) {
+    let ns = u64::try_from(to.saturating_duration_since(from).as_nanos()).unwrap_or(u64::MAX);
+    counter.fetch_add(ns, Ordering::Relaxed);
+}
+
+/// One present: the trace's `mapstat` (made, reused, invalidated, walk, map and import ns, all
+/// cumulative), and with the switch on a log line per [`LOG_EVERY`] presents, of the difference.
+pub fn present_counted() {
+    static PRESENTS: AtomicU64 = AtomicU64::new(0);
+    static LAST: crate::sync::Mutex<[u64; 6]> = crate::sync::Mutex::new([0; 6]);
+    let values = STATS.values();
+    crate::trace::event("mapstat", &values);
+    let presents = PRESENTS.fetch_add(1, Ordering::Relaxed).wrapping_add(1);
+    if entries_by_env() != 0 && presents.is_multiple_of(LOG_EVERY) {
+        let before = std::mem::replace(&mut *LAST.lock(), values);
+        let [made, reused, gone, walk, map, import] = values;
+        let [made0, reused0, gone0, walk0, map0, import0] = before;
+        let per = |now: u64, then: u64| now.wrapping_sub(then).div_euclid(LOG_EVERY);
+        let us = |now: u64, then: u64| per(now, then).div_euclid(1000);
+        log::info!(
+            "paged buffers, per present: {} views made, {} reused, {} invalidated, walk {} us, \
+             map {} us, import {} us",
+            per(made, made0),
+            per(reused, reused0),
+            per(gone, gone0),
+            us(walk, walk0),
+            us(map, map0),
+            us(import, import0)
+        );
+    }
+}
+
+/// What a walk found behind a task range.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct Runs {
+    /// The guest-physical runs, in task order.
+    pub(crate) ranges: Vec<PhysRange>,
+    /// Whether every leaf is writable.
+    pub(crate) writable: bool,
+}
+
+impl Runs {
+    /// The same pages, in the same order, with the same writability.
+    fn same_as(&self, other: &Runs) -> bool {
+        self.writable == other.writable
+            && self.ranges.len() == other.ranges.len()
+            && self.ranges.iter().zip(&other.ranges).all(|(a, b)| {
+                a.physical_address == b.physical_address && a.physical_length == b.physical_length
+            })
+    }
+}
+
+/// One kept buffer.
+struct Entry<B, L> {
+    page: u32,
+    length: u64,
+    runs: Runs,
+    /// The memory map the view was made through: the guest's RAM under this lease.
+    lease: L,
+    buffer: B,
+    used: MonoTime,
+}
+
+/// The kept buffers of one task, most recently used last. A leaf lock: every removal hands its
+/// entries back in a [`Gone`], so no buffer is released under it.
+pub(crate) struct PagedBuffers<B, L> {
+    capacity: AtomicUsize,
+    entries: crate::sync::Mutex<VecDeque<Entry<B, L>>>,
+}
+
+/// Entries going, to drop outside the lock: a buffer's last release runs its deallocator.
+pub(crate) struct Gone<B, L>(#[expect(dead_code, reason = "held for its drop")] Vec<Entry<B, L>>);
+
+impl<B: Handle, L: PartialEq> PagedBuffers<B, L> {
+    pub(crate) fn new(capacity: usize) -> Self {
+        PagedBuffers {
+            capacity: AtomicUsize::new(capacity),
+            entries: crate::sync::Mutex::new(VecDeque::new()),
+        }
+    }
+
+    /// Whether the cache is switched on.
+    pub(crate) fn enabled(&self) -> bool {
+        self.capacity() != 0
+    }
+
+    fn capacity(&self) -> usize {
+        self.capacity.load(Ordering::Relaxed)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn set_capacity(&self, capacity: usize) {
+        self.capacity.store(capacity, Ordering::Relaxed);
+    }
+
+    /// The entry's buffer when it still shows exactly `runs` under `lease`; an entry of the key
+    /// that does not goes.
+    pub(crate) fn lookup(
+        &self,
+        page: u32,
+        length: u64,
+        runs: &Runs,
+        lease: &L,
+        now: MonoTime,
+    ) -> (Option<B>, Gone<B, L>) {
+        let mut entries = self.entries.lock();
+        let Some(at) = entries
+            .iter()
+            .position(|e| e.page == page && e.length == length)
+        else {
+            return (None, Gone(Vec::new()));
+        };
+        let Some(mut entry) = entries.remove(at) else {
+            return (None, Gone(Vec::new()));
+        };
+        if entry.lease == *lease && entry.runs.same_as(runs) {
+            entry.used = now;
+            let buffer = entry.buffer.clone_ref();
+            entries.push_back(entry);
+            drop(entries);
+            STATS.reused.fetch_add(1, Ordering::Relaxed);
+            return (Some(buffer), Gone(Vec::new()));
+        }
+        drop(entries);
+        STATS.invalidated.fetch_add(1, Ordering::Relaxed);
+        (None, Gone(vec![entry]))
+    }
+
+    /// Keeps `buffer` for its key; the oldest goes past the capacity.
+    pub(crate) fn insert(
+        &self,
+        page: u32,
+        length: u64,
+        runs: Runs,
+        lease: L,
+        buffer: &B,
+        now: MonoTime,
+    ) -> Gone<B, L> {
+        let mut gone = Vec::new();
+        let mut entries = self.entries.lock();
+        if let Some(at) = entries
+            .iter()
+            .position(|e| e.page == page && e.length == length)
+        {
+            gone.extend(entries.remove(at));
+        }
+        while entries.len() >= self.capacity() {
+            gone.extend(entries.pop_front());
+        }
+        entries.push_back(Entry {
+            page,
+            length,
+            runs,
+            lease,
+            buffer: buffer.clone_ref(),
+            used: now,
+        });
+        Gone(gone)
+    }
+
+    /// Entries unused for [`MAX_IDLE`] go.
+    pub(crate) fn sweep(&self, now: MonoTime) -> Gone<B, L> {
+        let mut entries = self.entries.lock();
+        let mut gone = Vec::new();
+        // Oldest first: the order of use.
+        while entries
+            .front()
+            .is_some_and(|e| now.saturating_duration_since(e.used) >= MAX_IDLE)
+        {
+            gone.extend(entries.pop_front());
+        }
+        Gone(gone)
+    }
+
+    /// Entries over task bytes `offset..offset + length` go (the ends wrap, as the message's do).
+    pub(crate) fn invalidate_range(&self, offset: u64, length: u64) -> Gone<B, L> {
+        let end = offset.wrapping_add(length);
+        let mut entries = self.entries.lock();
+        let (gone, kept): (Vec<_>, Vec<_>) = entries.drain(..).partition(|e| {
+            let first = u64::from(e.page).wrapping_shl(crate::guest::records::APV_PAGE_SHIFT);
+            first < end && offset < first.wrapping_add(e.length)
+        });
+        entries.extend(kept);
+        drop(entries);
+        STATS
+            .invalidated
+            .fetch_add(gone.len().to_u64(), Ordering::Relaxed);
+        Gone(gone)
+    }
+
+    /// Every entry goes.
+    pub(crate) fn clear(&self) -> Gone<B, L> {
+        let gone: Vec<_> = self.entries.lock().drain(..).collect();
+        STATS
+            .invalidated
+            .fetch_add(gone.len().to_u64(), Ordering::Relaxed);
+        Gone(gone)
+    }
+
+    #[cfg(test)]
+    pub(crate) fn len(&self) -> usize {
+        self.entries.lock().len()
+    }
+}
