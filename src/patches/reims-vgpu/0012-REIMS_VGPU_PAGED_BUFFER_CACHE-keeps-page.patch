+    /// LOCAL (Atlas): the buffer a paged texture pages through: a kept one over exactly the pages
+    /// the task maps at `page` now, else a new one, kept (`paged_buffers`). Every call walks the
+    /// page table, so a stale entry is never used.
+    pub(super) fn paged_texture_buffer(
+        &self,
+        hold: Hold<'_>,
+        page: u32,
+        length: u64,
+    ) -> RaiseResult<P::Buffer> {
+        if !self.paged_buffers.enabled() {
+            return self.new_buffer_for_virtual_page(hold, page, length);
+        }
+        let offset = u64::from(page).wrapping_shl(APV_PAGE_SHIFT);
+        Self::check_task_range(offset, length, self.task_length())?;
+        let Some(lease) = self.map().map(|m| Arc::as_ptr(&m).addr()) else {
+            return self.new_buffer_for_virtual_page(hold, page, length);
+        };
+        let now = self.mono();
+        drop(self.paged_buffers.sweep(now));
+        let runs = self.task_page_runs(hold, offset, length)?;
+        paged_buffers::add_since(&STATS.walk_ns, now, self.mono());
+        let (kept, stale) = self.paged_buffers.lookup(page, length, &runs, &lease, now);
+        drop(stale);
+        if let Some(buffer) = kept {
+            return Ok(buffer);
+        }
+        let buffer = self.new_buffer_for_virtual_page(hold, page, length)?;
+        drop(
+            self.paged_buffers
+                .insert(page, length, runs, lease, &buffer, now),
+        );
+        Ok(buffer)
+    }
