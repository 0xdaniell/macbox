+/// Starts SDL's video on the compositor the file names (the module doc): whether SDL's events
+/// run. Its video may not: the file is looked at again each second.
+fn start_on_file(file: &Path) -> bool {
+    // SAFETY: NUL-terminated strings SDL copies; SDL's events start on this thread.
+    unsafe {
+        SDL_SetHint(SDL_HINT_VIDEO_DRIVER, c"wayland".as_ptr());
+        if !SDL_Init(SDL_INIT_EVENTS) {
+            return false;
+        }
+    }
+    let named = named_socket(file);
+    let socket = named.clone().or_else(env_socket);
+    let on = socket.and_then(|socket| match connect_video(&socket) {
+        Ok(display) => Some((socket, display)),
+        Err(why) => {
+            log::warn!(
+                target: "reims_vgpu_window",
+                "no window shows on {}: {why}; {} is looked at each second",
+                socket.display(),
+                file.display()
+            );
+            None
+        }
+    });
+    write_on(file, on.as_ref().map(|(s, _)| s.as_path()));
+    if let Some((socket, _)) = &on {
+        log::info!(target: "reims_vgpu_window", "windows show on {}", socket.display());
+    }
+    COMPOSITOR.with(|c| {
+        *c.borrow_mut() = Some(Compositor {
+            file: file.to_path_buf(),
+            on,
+            named,
+            looked: super::now(),
+            reopen: Vec::new(),
+            moving: None,
+        });
+    });
+    true
+}
+
+/// Looks at the compositor file, at most once a second (the module doc): a new socket named
+/// starts a move; with no compositor reached, the named one is tried again.
+fn look() {
+    let move_to = COMPOSITOR.with(|c| {
+        let mut c = c.borrow_mut();
+        let c = c.as_mut()?;
+        let now = super::now();
+        if let Some(m) = &mut c.moving {
+            if !m.said && now.saturating_duration_since(m.since) >= MOVE_SLOW {
+                m.said = true;
+                log::warn!(
+                    target: "reims_vgpu_window",
+                    "the windows' move waits for their render threads to let their surfaces go"
+                );
+            }
+            return None;
+        }
+        if now.saturating_duration_since(c.looked) < LOOK_EVERY {
+            return None;
+        }
+        c.looked = now;
+        let named = named_socket(&c.file);
+        let on = c.on.as_ref().map(|(s, _)| s.clone());
+        let changed = named != c.named;
+        c.named.clone_from(&named);
+        let named = named?;
+        ((changed && Some(&named) != on.as_ref()) || on.is_none()).then_some((named, changed))
+    });
+    if let Some((to, asked)) = move_to {
+        begin_move(to, asked);
+    }
+}
+
+/// Starts a move to `to` (the module doc), asked by the file now (`asked`) or a retry with no
+/// compositor reached: the windows let go, and the move goes on as their SDL windows go.
+fn begin_move(to: PathBuf, asked: bool) {
+    let from = COMPOSITOR.with(|c| {
+        let mut c = c.borrow_mut();
+        let c = c.as_mut()?;
+        c.moving = Some(Move {
+            to: to.clone(),
+            asked,
+            since: super::now(),
+            said: false,
+        });
+        Some(c.on.as_ref().map(|(s, _)| s.clone()))
+    });
+    let Some(from) = from else {
+        return;
+    };
+    let ids = shell::detach_all();
+    if asked {
+        log::info!(
+            target: "reims_vgpu_window",
+            "the windows move from {} to {} ({} to let go)",
+            from.as_deref().map_or("nowhere".into(), |s| s.display().to_string()),
+            to.display(),
+            ids.len()
+        );
+    }
+    move_on();
+}
+
+/// Makes the move once no SDL window is left (the module doc): SDL's video stops, starts on the
+/// new compositor (else on the old one again, else on none), and the windows open there.
+fn move_on() {
+    if !shell::none_open() {
+        return;
+    }
+    let taken = COMPOSITOR.with(|c| {
+        let mut c = c.borrow_mut();
+        let c = c.as_mut()?;
+        let next = c.moving.take()?;
+        Some((next, c.on.take(), c.file.clone()))
+    });
+    let Some((next, old, file)) = taken else {
+        return;
+    };
+    if let Some((_, display)) = &old {
+        disconnect_video(*display);
+    }
+    let on = match connect_video(&next.to) {
+        Ok(display) => Some((next.to.clone(), display)),
+        Err(why) => {
+            if next.asked {
+                log::warn!(
+                    target: "reims_vgpu_window",
+                    "the windows do not move to {}: {why}",
+                    next.to.display()
+                );
+            }
+            old.and_then(|(socket, _)| match connect_video(&socket) {
+                Ok(display) => Some((socket, display)),
+                Err(why) => {
+                    log::warn!(
+                        target: "reims_vgpu_window",
+                        "nor back to {}: {why}; no window shows",
+                        socket.display()
+                    );
+                    None
+                }
+            })
+        }
+    };
+    write_on(&file, on.as_ref().map(|(s, _)| s.as_path()));
+    let up = on.is_some();
+    if let Some((socket, _)) = &on
+        && (next.asked || socket == &next.to)
+    {
+        log::info!(
+            target: "reims_vgpu_window",
+            "windows show on {} ({} ms)",
+            socket.display(),
+            super::now().saturating_duration_since(next.since).as_millis()
+        );
+    }
+    let reopen = COMPOSITOR.with(|c| {
+        let mut c = c.borrow_mut();
+        let Some(c) = c.as_mut() else {
+            return Vec::new();
+        };
+        c.on = on;
+        if up {
+            std::mem::take(&mut c.reopen)
+        } else {
+            Vec::new()
+        }
+    });
+    if !up {
+        return;
+    }
+    snapshot_screens();
+    shell::screens_changed();
+    for window in reopen.iter().filter_map(Weak::upgrade) {
+        if !window.is_closed() {
+            window.opening();
+            shell::open(&window);
+        }
+    }
 }
 
