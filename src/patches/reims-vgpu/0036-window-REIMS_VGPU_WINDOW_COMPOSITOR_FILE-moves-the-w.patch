+/// libwayland-client's connect and disconnect, the library SDL opens too.
+struct Wl {
+    connect: unsafe extern "C" fn(*const c_char) -> *mut c_void,
+    disconnect: unsafe extern "C" fn(*mut c_void),
+}
+
+/// libwayland-client, opened once; `None` where it is not there.
+fn wl() -> Option<&'static Wl> {
+    static WL: OnceLock<Option<Wl>> = OnceLock::new();
+    WL.get_or_init(|| {
+        // SAFETY: the library's name and symbols are NUL-terminated; the symbols are
+        // libwayland-client's two functions of these types, and the library stays open.
+        unsafe {
+            let lib = libc::dlopen(
+                c"libwayland-client.so.0".as_ptr(),
+                libc::RTLD_NOW | libc::RTLD_GLOBAL,
+            );
+            if lib.is_null() {
+                return None;
+            }
+            let connect = libc::dlsym(lib, c"wl_display_connect".as_ptr());
+            let disconnect = libc::dlsym(lib, c"wl_display_disconnect".as_ptr());
+            if connect.is_null() || disconnect.is_null() {
+                return None;
+            }
+            Some(Wl {
+                connect: std::mem::transmute::<
+                    *mut c_void,
+                    unsafe extern "C" fn(*const c_char) -> *mut c_void,
+                >(connect),
+                disconnect: std::mem::transmute::<*mut c_void, unsafe extern "C" fn(*mut c_void)>(
+                    disconnect,
+                ),
+            })
+        }
+    })
+    .as_ref()
+}
+
+/// The compositor file, where its variable names one (read once).
+fn compositor_file() -> Option<&'static Path> {
+    static FILE: OnceLock<Option<PathBuf>> = OnceLock::new();
+    FILE.get_or_init(|| {
+        std::env::var_os(COMPOSITOR_VAR)
+            .filter(|v| !v.is_empty())
+            .map(PathBuf::from)
+    })
+    .as_deref()
+}
+
+/// The socket a name gives, as libwayland reads `WAYLAND_DISPLAY`: the name where it is a path,
+/// else the name in `runtime_dir`. `None` for an empty name, or a bare one without the directory.
+fn socket_path(name: &str, runtime_dir: Option<&Path>) -> Option<PathBuf> {
+    let name = name.trim();
+    if name.is_empty() {
+        return None;
+    }
+    let path = Path::new(name);
+    if path.is_absolute() {
+        Some(path.to_path_buf())
+    } else {
+        runtime_dir.map(|d| d.join(path))
+    }
+}
+
+/// The socket the file's first line names, `None` where it names none or cannot be read.
+fn named_socket(file: &Path) -> Option<PathBuf> {
+    let text = std::fs::read_to_string(file).ok()?;
+    let runtime_dir = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from);
+    socket_path(text.lines().next()?, runtime_dir.as_deref())
+}
+
+/// The socket `WAYLAND_DISPLAY` names.
+fn env_socket() -> Option<PathBuf> {
+    let name = std::env::var("WAYLAND_DISPLAY").ok()?;
+    let runtime_dir = std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from);
+    socket_path(&name, runtime_dir.as_deref())
+}
+
+/// SDL's video driver now, empty where none runs.
+fn current_driver() -> String {
+    // SAFETY: the driver's name is a string SDL keeps, or null.
+    unsafe {
+        let name = SDL_GetCurrentVideoDriver();
+        if name.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr(name).to_string_lossy().into_owned()
+        }
+    }
+}
+
+/// Connects to `socket` and starts SDL's video on the connection, with its Wayland driver: the
+/// connection, or why not, with nothing left of the try.
+fn connect_video(socket: &Path) -> Result<*mut c_void, String> {
+    let wl = wl().ok_or("libwayland-client is not there")?;
+    let name = CString::new(socket.as_os_str().as_bytes()).map_err(|_| "a NUL in the path")?;
+    // SAFETY: a NUL-terminated path.
+    let display = unsafe { (wl.connect)(name.as_ptr()) };
+    if display.is_null() {
+        return Err("no compositor there".into());
+    }
+    // SAFETY: SDL's video is stopped; SDL reads the connection as it starts and does not close one
+    // it was given. Its events run apart (the module doc).
+    let started = unsafe {
+        SDL_SetPointerProperty(
+            SDL_GetGlobalProperties(),
+            SDL_PROP_GLOBAL_VIDEO_WAYLAND_WL_DISPLAY_POINTER,
+            display,
+        );
+        SDL_InitSubSystem(SDL_INIT_VIDEO)
+    };
+    let driver = current_driver();
+    if started && driver == "wayland" {
+        return Ok(display);
+    }
+    let why = if started {
+        // SAFETY: SDL's video started on this thread, with no window.
+        unsafe { SDL_QuitSubSystem(SDL_INIT_VIDEO) };
+        format!("SDL took its {driver} driver")
+    } else {
+        format!("SDL's video does not start ({})", sdl_error())
+    };
+    // SAFETY: SDL's video is stopped and holds the connection no more.
+    unsafe {
+        SDL_ClearProperty(
+            SDL_GetGlobalProperties(),
+            SDL_PROP_GLOBAL_VIDEO_WAYLAND_WL_DISPLAY_POINTER,
+        );
+        (wl.disconnect)(display);
+    }
+    Err(why)
+}
+
+/// Stops SDL's video, with no window left, and closes `display`, its connection.
+fn disconnect_video(display: *mut c_void) {
+    // SAFETY: on SDL's thread, with every SDL window destroyed; the connection was made by
+    // `connect_video` and SDL holds it no more once its video stops.
+    unsafe {
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+        SDL_ClearProperty(
+            SDL_GetGlobalProperties(),
+            SDL_PROP_GLOBAL_VIDEO_WAYLAND_WL_DISPLAY_POINTER,
+        );
+        if let Some(wl) = wl() {
+            (wl.disconnect)(display);
+        }
+    }
+}
+
+/// Writes `<file>.on`: the socket the windows are on, or nothing.
+fn write_on(file: &Path, on: Option<&Path>) {
+    let mut path = file.as_os_str().to_owned();
+    path.push(".on");
+    let path = PathBuf::from(path);
+    let mut tmp = path.clone().into_os_string();
+    tmp.push(".tmp");
+    let mut text = on
+        .map(|p| p.as_os_str().as_bytes().to_vec())
+        .unwrap_or_default();
+    text.push(b'\n');
+    if let Err(e) = std::fs::write(&tmp, text).and_then(|()| std::fs::rename(&tmp, &path)) {
+        log::warn!(target: "reims_vgpu_window", "{} not written: {e}", path.display());
+    }
+}
+
+/// Whether a window that opens now waits for the next compositor: a move is under way, or no
+/// compositor is reached.
+pub(crate) fn holding() -> bool {
+    COMPOSITOR.with(|c| {
+        c.borrow()
+            .as_ref()
+            .is_some_and(|c| c.moving.is_some() || c.on.is_none())
+    })
+}
+
+/// `window` opens on the next compositor.
+pub(crate) fn reopen_later(window: &Arc<Window>) {
+    COMPOSITOR.with(|c| {
+        if let Some(c) = c.borrow_mut().as_mut()
+            && !c.reopen.iter().any(|w| w.as_ptr() == Arc::as_ptr(window))
+        {
+            c.reopen.push(Arc::downgrade(window));
+        }
+    });
+}
+
+/// An SDL window was destroyed: a move goes on once the last is gone, after the destroy (posted).
+pub(crate) fn window_gone() {
+    if COMPOSITOR.with(|c| c.borrow().as_ref().is_some_and(|c| c.moving.is_some())) {
+        post(move_on);
+    }
+}
