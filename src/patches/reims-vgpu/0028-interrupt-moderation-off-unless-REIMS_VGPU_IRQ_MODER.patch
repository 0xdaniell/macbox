@@ -0,0 +1,181 @@
+//! LOCAL (Atlas, ARCH experiment, branch atlas/arch-irqmod): interrupt moderation.
+//!
+//! Every stamp signal and display poke raised the guest interrupt (~100 raises per Sim frame,
+//! ~1.9 per read of the status under load). The status the guest's ISR reads is read-to-clear
+//! (0x1018 stamps, 0x1014 display) and its completion is level-based on stamp memory
+//! (`notifyStamp` reads the stamp values): a raise while an earlier one is not yet read adds
+//! nothing the guest's next read would not see. With the switch on, a raise goes out only when
+//! none is outstanding; a read of 0x1018 or 0x1014 ends the outstanding one *before* the bits
+//! are taken, so a bit set after the read always raises again (no lost interrupt):
+//! - writer: set bit, then `pending.swap(true)`; raise when it was false;
+//! - reader: `pending.store(false)`, then take the bits.
+//!
+//! A bit set before the read is either taken by it, or its writer's swap came after the
+//! store and raised. As a safety net a raise held more than [`RESCUE`] after the outstanding
+//! one goes out anyway (a raise the guest never read: MSI off then, a lost message).
+//! A reset or a restore ends the outstanding raise.
+//!
+//! The switch: `REIMS_VGPU_IRQ_MODERATE=<path>`; moderation is on while that file exists,
+//! looked at most once a second. Unset: every raise goes out, as before.
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+/// The longest a raise is held behind an outstanding one.
+pub const RESCUE: Duration = Duration::from_millis(2);
+
+const LOOK_EVERY_NS: u64 = 1_000_000_000;
+const LOG_EVERY_NS: u64 = 10_000_000_000;
+
+fn base() -> Instant {
+    static B: OnceLock<Instant> = OnceLock::new();
+    *B.get_or_init(Instant::now)
+}
+
+fn now_ns() -> u64 {
+    u64::try_from(base().elapsed().as_nanos()).unwrap_or(u64::MAX)
+}
+
+struct Switch {
+    path: Option<std::path::PathBuf>,
+    on: AtomicBool,
+    /// When the file was last looked at (ns after `base`, `u64::MAX` before the first look).
+    looked: AtomicU64,
+}
+
+fn switch() -> &'static Switch {
+    static S: OnceLock<Switch> = OnceLock::new();
+    S.get_or_init(|| Switch {
+        path: std::env::var_os("REIMS_VGPU_IRQ_MODERATE")
+            .filter(|p| !p.is_empty())
+            .map(std::path::PathBuf::from),
+        on: AtomicBool::new(false),
+        looked: AtomicU64::new(u64::MAX),
+    })
+}
+
+fn switched_on(now: u64) -> bool {
+    let s = switch();
+    let Some(path) = &s.path else {
+        return false;
+    };
+    let looked = s.looked.load(Ordering::Relaxed);
+    if (looked == u64::MAX || now.saturating_sub(looked) >= LOOK_EVERY_NS)
+        && s
+            .looked
+            .compare_exchange(looked, now, Ordering::Relaxed, Ordering::Relaxed)
+            .is_ok()
+    {
+        let on = path.exists();
+        if s.on.swap(on, Ordering::SeqCst) != on {
+            log::info!("irq moderation {}", if on { "on" } else { "off" });
+        }
+    }
+    s.on.load(Ordering::SeqCst)
+}
+
+/// A device's moderation state.
+#[derive(Default)]
+pub struct Moderation {
+    pending: AtomicBool,
+    since: AtomicU64,
+    raised: AtomicU64,
+    held: AtomicU64,
+    rescued: AtomicU64,
+    logged: AtomicU64,
+}
+
+impl Moderation {
+    /// Whether this raise goes out (always, with the switch off).
+    pub fn should_raise(&self) -> bool {
+        let now = now_ns();
+        if !switched_on(now) {
+            return true;
+        }
+        self.log(now);
+        self.decide(now)
+    }
+
+    /// The moderation itself, with the switch on.
+    fn decide(&self, now: u64) -> bool {
+        if !self.pending.swap(true, Ordering::SeqCst) {
+            self.since.store(now, Ordering::SeqCst);
+            self.raised.fetch_add(1, Ordering::Relaxed);
+            return true;
+        }
+        let since = self.since.load(Ordering::SeqCst);
+        let rescue = u64::try_from(RESCUE.as_nanos()).unwrap_or(u64::MAX);
+        if now.saturating_sub(since) > rescue
+            && self
+                .since
+                .compare_exchange(since, now, Ordering::SeqCst, Ordering::SeqCst)
+                .is_ok()
+        {
+            self.rescued.fetch_add(1, Ordering::Relaxed);
+            return true;
+        }
+        self.held.fetch_add(1, Ordering::Relaxed);
+        false
+    }
+
+    /// The guest read its status (or the device reset or restored): the outstanding raise ends.
+    /// Before the bits are taken.
+    pub fn acked(&self) {
+        self.pending.store(false, Ordering::SeqCst);
+    }
+
+    fn log(&self, now: u64) {
+        let last = self.logged.load(Ordering::Relaxed);
+        if now.saturating_sub(last) >= LOG_EVERY_NS
+            && self
+                .logged
+                .compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed)
+                .is_ok()
+        {
+            log::info!(
+                "irq moderation: raised {} held {} rescued {}",
+                self.raised.load(Ordering::Relaxed),
+                self.held.load(Ordering::Relaxed),
+                self.rescued.load(Ordering::Relaxed)
+            );
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MS: u64 = 1_000_000;
+
+    #[test]
+    fn holds_behind_an_outstanding_raise_until_the_read() {
+        let m = Moderation::default();
+        assert!(m.decide(10 * MS)); // first raise goes out
+        assert!(!m.decide(10 * MS + 1)); // held: the guest has not read
+        assert!(!m.decide(11 * MS));
+        m.acked(); // the ISR's read of 0x1018, before it takes the bits
+        assert!(m.decide(11 * MS + 1)); // a bit after the read raises again
+        assert_eq!(m.held.load(Ordering::Relaxed), 2);
+    }
+
+    #[test]
+    fn rescues_a_raise_the_guest_never_read() {
+        let m = Moderation::default();
+        assert!(m.decide(0));
+        assert!(!m.decide(MS));
+        assert!(m.decide(3 * MS)); // past RESCUE (2 ms)
+        assert!(!m.decide(3 * MS + 1)); // the rescue restarts the clock
+        assert_eq!(m.rescued.load(Ordering::Relaxed), 1);
+    }
+
+    #[test]
+    fn off_without_the_switch() {
+        let m = Moderation::default();
+        for _ in 0..4 {
+            assert!(m.should_raise());
+        }
+        assert!(!m.pending.load(Ordering::SeqCst));
+    }
+}
