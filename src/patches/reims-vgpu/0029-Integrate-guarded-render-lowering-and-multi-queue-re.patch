+/// LOCAL (Atlas, DEEP-CPU): the variable that picks where render encoders' calls are lowered.
+pub const RENDER_LOWERING_VAR: &str = "REIMS_VGPU_RENDER_LOWERING";
+
+/// Where the device lowers its render encoders' calls (`DevicePolicy::render_lowering`), from
+/// `REIMS_VGPU_RENDER_LOWERING` (`value`), and the stderr line to write, if any.
+///
+/// Unset, empty or `at_call`: inside each call, the runtime's default
+/// (`RenderLoweringPolicy::AtCall`), production's form. `worker`: the runtime logs each render
+/// call after its checks at the call and lowers it, the encoder's end and the commit's own work
+/// on the device's lowering thread, in order (metal2vulkan docs/API.md section 1,
+/// `render/deferral.rs`). The guest task's service thread then decodes the next commands while
+/// that thread lowers the earlier ones: two stages of one task's serial stream, its order
+/// unchanged. Commit order across the device's queues stays the program's
+/// (`render/queued_commits.rs`), so every FIFO's event chain, scheduled signal and completion
+/// keeps its order.
+///
+/// What changes under `worker`, and why it is kept out of audits:
+/// - A refusal only the lowering finds (a runtime gap of the draw's variant, out of memory, a
+///   Vulkan error) fails the command buffer (`CallRefused`, completion status 3) instead of
+///   raising at the call (the exec's reply 2). Refusals the call's checks find still return
+///   from the call.
+/// - A degradation announced while the lowering thread lowers a call is announced outside every
+///   call of this platform: `answer::hearing` does not hear it (the `HalfOutputPrecision` relay
+///   of `binds`), census attributes it to no selector, and strict mode dies on that thread rather
+///   than at the call. So `worker` is refused, with a line, in a strict or census process
+///   (`audited`) and under `REIMS_VGPU_EXACT=all`, whose exact answers take `AtCall`.
+///
+/// Another value changes nothing, and a line says so.
+pub(crate) fn render_lowering(
+    value: Option<&std::ffi::OsStr>,
+    audited: bool,
+    exact: Option<&str>,
+) -> (metal2vulkan::device::RenderLoweringPolicy, Option<String>) {
+    use metal2vulkan::device::RenderLoweringPolicy::{AtCall, Worker};
+    let Some(value) = value else {
+        return (AtCall, None);
+    };
+    let value = value.to_string_lossy();
+    match value.trim() {
+        "" | "at_call" => (AtCall, None),
+        "worker" => {
+            let exact_all = exact
+                .unwrap_or_default()
+                .split(',')
+                .any(|n| n.trim() == EXACT_ALL);
+            if audited || exact_all {
+                let why = if audited { "strict or census mode" } else { "REIMS_VGPU_EXACT=all" };
+                let line = format!(
+                    "reims-vgpu: {RENDER_LOWERING_VAR}=worker refused under {why}: render calls \
+                     lowered at the call\n"
+                );
+                (AtCall, Some(line))
+            } else {
+                let line = format!(
+                    "reims-vgpu: {RENDER_LOWERING_VAR}=worker: render calls lowered on the \
+                     runtime's lowering thread\n"
+                );
+                (Worker, Some(line))
+            }
+        }
+        other => (
+            AtCall,
+            Some(format!(
+                "reims-vgpu: {RENDER_LOWERING_VAR} names {other:?}, none of at_call, worker: \
+                 ignored\n"
+            )),
+        ),
+    }
+}
