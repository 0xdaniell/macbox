+            "the draws drew"
+        );
+        let filled: Vec<u8> = (0..N)
+            .flat_map(|i| [u8::try_from(i + 1).unwrap(); 4])
+            .collect();
+        assert_eq!((a.2.clone(), w.2), (filled.clone(), filled));
