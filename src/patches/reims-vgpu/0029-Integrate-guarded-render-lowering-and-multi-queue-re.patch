+    /// LOCAL (Atlas, DEEP-CPU): a guest task's stream of command buffers on one queue, each a
+    /// fill, then a cleared pass of 1 to 40 draws, a completed handler and a scheduled signal
+    /// after the pass's end (in the order `gpu_task/exec.rs` encodes an exec's tail), runs on a device that lowers render calls on the runtime's
+    /// lowering thread (`REIMS_VGPU_RENDER_LOWERING=worker`, [`crate::platform::render_lowering`])
+    /// as on one that lowers them at the call: the same texels and bytes, the event at the last
+    /// value, every command buffer completed, in commit order. The worker device's counts show its
+    /// ends left to the lowering thread, the at-call device's none
+    #[test]
+    fn render_calls_lowered_on_the_worker_run_as_at_the_call() {
+        use metal2vulkan::device::RenderLoweringPolicy;
+        const N: usize = 24;
+        let run = |d: &crate::gpu::device::VulkanDevice| exec_shaped_stream(d, N);
+        let at_call = dev();
+        let mut policy = crate::platform::device_options().policy;
+        assert_eq!(policy.render_lowering, RenderLoweringPolicy::AtCall);
+        policy.render_lowering = RenderLoweringPolicy::Worker;
+        let worker = crate::gpu::device::tests::device_with_policy(policy);
+        let before = (at_call.raw.work_counts(), worker.raw.work_counts());
+        let (a, w) = (run(&at_call), run(&worker));
+        let after = (at_call.raw.work_counts(), worker.raw.work_counts());
+        let expected: Vec<_> = (0..N).map(|i| (i, 4)).collect();
+        assert_eq!(a.0, expected, "at the call: completed in order");
+        assert_eq!(w.0, expected, "worker: completed in order");
+        assert_eq!(w.1, a.1, "texels");
+        assert!(
