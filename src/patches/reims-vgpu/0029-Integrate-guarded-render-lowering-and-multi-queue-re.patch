+    /// LOCAL (Atlas, DEEP-CPU): two Sims' exec streams at once, each on its own thread and queue,
+    /// lower on the device's lanes (m2v `render/lowering_worker.rs`, one lane per queue in turn)
+    /// and give what they give lowered at the call: per queue, every command buffer completed in
+    /// its commit order with status 4, the same texels and bytes, the event at the last value.
+    /// The worker's ends ran off the program's threads. The lanes' CPU time against the wall
+    /// time is printed (diagnostic only: lavapipe, debug, not a frame-rate figure).
+    #[test]
+    fn two_sims_lowered_on_the_lanes_run_as_at_the_call() {
+        use metal2vulkan::device::RenderLoweringPolicy;
+        const N: usize = 24;
+        let run = |d: &crate::gpu::device::VulkanDevice| {
+            std::thread::scope(|scope| {
+                let sims: Vec<_> = (0..2)
+                    .map(|_| scope.spawn(|| exec_shaped_stream(d, N)))
+                    .collect();
+                sims.into_iter()
+                    .map(|sim| sim.join().unwrap())
+                    .collect::<Vec<_>>()
+            })
+        };
+        let at_call = dev();
+        let mut policy = crate::platform::device_options().policy;
+        policy.render_lowering = RenderLoweringPolicy::Worker;
+        let worker = crate::gpu::device::tests::device_with_policy(policy);
+        let a = run(&at_call);
+        let (before, lanes_before) = (worker.raw.work_counts(), lane_cpu_nanos());
+        let wall = std::time::Instant::now();
+        let w = run(&worker);
+        let wall = wall.elapsed().as_nanos() as u64;
+        let lanes_after = lane_cpu_nanos();
+        let after = worker.raw.work_counts();
+        let expected: Vec<_> = (0..N).map(|i| (i, 4)).collect();
+        let filled: Vec<u8> = (0..N)
+            .flat_map(|i| [u8::try_from(i + 1).unwrap(); 4])
+            .collect();
+        for (sim, (a, w)) in a.iter().zip(&w).enumerate() {
+            assert_eq!(a.0, expected, "at the call, sim {sim}: completed in order");
+            assert_eq!(w.0, expected, "worker, sim {sim}: completed in order");
+            assert_eq!(w.1, a.1, "sim {sim}: texels");
+            assert!(
+                a.1.iter().any(|t| t.iter().any(|&b| b != 0)),
+                "sim {sim}: drew"
+            );
+            assert_eq!((&a.2, &w.2), (&filled, &filled), "sim {sim}: filled");
+            assert_eq!((a.3, w.3), (N as u64, N as u64), "sim {sim}: event");
+        }
+        let counts = lowering_counts(&before, &after);
+        let lane_nanos: Vec<u64> = (lanes_after.iter())
+            .map(|(tid, n)| {
+                n - lanes_before
+                    .iter()
+                    .find(|(t, _)| t == tid)
+                    .map_or(0, |b| b.1)
+            })
+            .filter(|&n| n > 0)
+            .collect();
+        eprintln!(
+            "two sims, worker, {} lanes: counts {counts:?}; lowering threads busy {lane_nanos:?} ns \
+             of {wall} ns wall (sum/wall {:.2})",
+            lane_nanos.len(),
+            lane_nanos.iter().sum::<u64>() as f64 / wall as f64
+        );
+        assert!(counts[2] > 0, "worker: ends left to the lowering threads");
+    }
