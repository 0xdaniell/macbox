+    /// The device's lowering threads' (`metal2vulkan-lowering`) CPU time in ns, by thread id
+    /// (`/proc/self/task/*/schedstat`).
+    fn lane_cpu_nanos() -> Vec<(u64, u64)> {
+        let Ok(tasks) = std::fs::read_dir("/proc/self/task") else {
+            return Vec::new();
+        };
+        (tasks.flatten())
+            .filter_map(|task| {
+                let comm = std::fs::read_to_string(task.path().join("comm")).ok()?;
+                if !comm.starts_with("metal2vulkan-lo") {
+                    return None;
+                }
+                let stat = std::fs::read_to_string(task.path().join("schedstat")).ok()?;
+                let tid = task.file_name().to_str()?.parse().ok()?;
+                Some((tid, stat.split_whitespace().next()?.parse().ok()?))
+            })
+            .collect()
+    }
+
+    /// What [`exec_shaped_stream`] reads: the completions in order (index, status), the three
+    /// targets' texels, the filled bytes and the event's value.
+    type ExecStream = (Vec<(usize, u64)>, Vec<Vec<u8>>, Vec<u8>, u64);
+
+    /// `n` command buffers on a new queue of `d`, in the order Reims's exec makes them: a fill,
+    /// a cleared pass of 1-40 draws over 3 rotating targets, end, completed handler, scheduled
+    /// signal on one shared event, commit. What it read once all completed.
+    fn exec_shaped_stream(d: &crate::gpu::device::VulkanDevice, n: usize) -> ExecStream {
+        use reims_vgpu_core::platform::types::NsRange;
+        let p = platform();
+        let state = fixture_state::<VulkanPlatform>(d, "vert:tri_vert", "frag:tri_frag");
+        let targets: Vec<_> = (0..3).map(|_| pass_of(&p, d, (4, 4))).collect();
+        let bytes = buffer::<VulkanPlatform>(d, (n * 4) as u64, 0, &vec![0; n * 4]);
+        let event = d.new_shared_event().unwrap();
+        let q = d.new_command_queue().unwrap();
+        let (done, completed) = std::sync::mpsc::channel();
+        for i in 0..n {
+            let cb = q.command_buffer(OnFault::Die).unwrap().unwrap();
+            let blit = cb.blit_encoder(OnFault::Die).unwrap().unwrap();
+            let fill = BlitCmd::FillBuffer {
+                buffer: &bytes,
+                range: NsRange::new((i * 4) as u64, 4),
+                value: u8::try_from(i + 1).unwrap(),
+            };
+            blit.encode(OnFault::Die, fill).unwrap();
+            blit.encode(OnFault::Die, BlitCmd::EndEncoding).unwrap();
+            let e = cb
+                .render_encoder(OnFault::Die, &targets[i % 3].1)
+                .unwrap()
+                .unwrap();
+            let mut cmds = vec![RenderCmd::SetRenderPipelineState {
+                pipeline_state: Some(&state),
+            }];
+            let draws = if i % 4 == 0 { 40 } else { i % 4 };
+            cmds.extend((0..draws).map(|_| three(3, None)));
+            cmds.push(RenderCmd::EndEncoding);
+            send_all(&e, cmds);
+            let done = done.clone();
+            cb.add_completed_handler(
+                OnFault::Die,
+                Box::new(move |info| done.send((i, info.status.0)).unwrap()),
+            )
+            .unwrap();
+            cb.encode_signal_when_scheduled(Some(&event), (i + 1) as u64)
+                .unwrap();
+            cb.commit(OnFault::Die).unwrap();
+        }
+        let order: Vec<_> = (0..n)
+            .map(|_| {
+                completed
+                    .recv_timeout(std::time::Duration::from_secs(30))
+                    .unwrap()
+            })
+            .collect();
+        let texels: Vec<_> = targets
+            .iter()
+            .map(|(t, _)| crate::gpu::resource::tests::read_back(t))
+            .collect();
+        // SAFETY: a Shared buffer's bytes, read after every command buffer completed.
+        let filled =
+            unsafe { std::slice::from_raw_parts(bytes.contents().as_ptr::<u8>(), n * 4) }.to_vec();
+        (order, texels, filled, event.signaled_value())
+    }
+
+    /// The lowering counts from `b` to `a`: batches by thread and program, ends by thread and
+    /// program, commits run by thread and program, waits.
+    fn lowering_counts(
+        b: &metal2vulkan_runtime::WorkCounts,
+        a: &metal2vulkan_runtime::WorkCounts,
+    ) -> [u64; 7] {
+        [
+            a.render_log_batches_by_thread - b.render_log_batches_by_thread,
+            a.render_log_batches_by_program - b.render_log_batches_by_program,
+            a.render_log_ends_by_thread - b.render_log_ends_by_thread,
+            a.render_log_ends_by_program - b.render_log_ends_by_program,
+            a.render_log_commits_by_thread - b.render_log_commits_by_thread,
+            a.render_log_commits_by_program - b.render_log_commits_by_program,
+            a.render_log_waits - b.render_log_waits,
+        ]
+    }
