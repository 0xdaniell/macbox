+    fn render_lowering_takes_the_worker_only_when_asked_and_unaudited() {
+        use metal2vulkan::device::RenderLoweringPolicy::{AtCall, Worker};
+        use std::ffi::OsStr;
+        assert_eq!(render_lowering(None, false, None), (AtCall, None));
+        for quiet in ["", " ", "at_call", " at_call "] {
