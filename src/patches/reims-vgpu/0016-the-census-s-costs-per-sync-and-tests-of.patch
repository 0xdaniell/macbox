@@ -59,11 +59,24 @@ static void io(uint32_t op, uint32_t lba, uint32_t prp1, uint32_t prp2, uint32_t
     nvme_cmd(c, IOSQ, &sqt, 1);
     if (nvme_done(IOCQ, &cqh, &phase, 1)) die(0x42);
 }
+/* With the VM's RAM the BARs lie past this 32-bit guest's reach: `at` is below it. */
+static uint32_t reachable(int d, uint32_t at) {
+    if (cfg(d, 0x10) & 4) {
+        cfgw(d, 4, cfg(d, 4) & ~2u);
+        cfgw(d, 0x14, 0);
+    }
+    if (!(cfg(d, 0x10) & ~0xfu) || cfg(d, 0x10) >= 0xfec00000u || (cfg(d, 0x10) & 4)) {
+        cfgw(d, 4, cfg(d, 4) & ~2u);
+        cfgw(d, 0x10, at);
+    }
+    return cfg(d, 0x10) & ~0xfu;
+}
+
 static void nvme_up(void) {
     phase = phase_a = 1;
     for (int d = 0; d < 32 && !nv; d++)
         if (cfg(d, 8) >> 8 == 0x010802) {
-            nv = cfg(d, 0x10) & ~0xfu;
+            nv = reachable(d, 0xb0000000u);
             cfgw(d, 4, cfg(d, 4) | 6);
         }
     if (!nv) die(0x43);
@@ -127,9 +140,15 @@ static void unmap(uint32_t id) {
 
 void main_c(void) {
     uint32_t i;
+#ifdef FILLMEM
+    /* For a core's size: 1 GiB of the guest's RAM in use, then the host may kill it. */
+    for (uint32_t p = 0x40000000u; p < 0x80000000u; p += PG) R32(p) = p;
+    outb(0xe9, 'F');
+    for (;;) __asm__("hlt");
+#endif
     for (int d = 0; d < 32 && !bar; d++)
         if (cfg(d, 0) == (0xeeefu << 16 | 0x106b)) {
-            bar = cfg(d, 0x10) & ~0xfu;
+            bar = reachable(d, 0xa0000000u);
             cfgw(d, 4, cfg(d, 4) | 6);
         }
     if (!bar) die(0x31);
