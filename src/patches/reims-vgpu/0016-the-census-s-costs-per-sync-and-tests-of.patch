+// A surface as macOS lays one out: chunks of `run` pages, descending inside, apart in the view.
+static size_t scattered(uint64_t off, size_t n, size_t run, uint64_t *list) {
+    size_t chunks = 0;
+
+    for (size_t i = 0; i < n; chunks++) {
+        for (size_t j = 0; j < run && i < n; j++, i++) {
+            list[i] = (uint64_t)main_map + off + (chunks * (run + 1) + run - 1 - j) * PG;
+        }
+    }
+    return chunks;
+}
+
+enum { SCATTERED = 5650, SCATTERED_RUN = 9 };
+#define SCATTERED_OFF 0x10000000UL
+static uint64_t scattered_main[SCATTERED], scattered_view[SCATTERED];
+
+static size_t scattered_surface(uint32_t id) {
+    size_t chunks = scattered(SCATTERED_OFF, SCATTERED, SCATTERED_RUN, scattered_main);
+    CensusSurface f = {.mapping_id = id, .width = 2000, .height = 2000, .pixel_format = 0x42475241,
+                       .alloc_size = SCATTERED * PG, .bytes_per_row = 8000,
+                       .base_address = scattered_main[0]};
+    uint64_t start = 0, len = 0;
+
+    census_surface_mapped(&f, scattered_main, SCATTERED, PG);
+    census_coh_surface(id, &start, &len);
+    if (!census_coh_track(start, len)) DIE("track");
+    for (size_t i = 0; i < SCATTERED; i++) scattered_view[i] = start + i * PG;
+    return chunks;
+}
+
+static void t_scattered(void) {
+    printf("[scattered] pages descending in the surface move in runs of the view\n");
+    static uint64_t refused[SCATTERED], came[SCATTERED];
+    uint64_t *view = scattered_view, tries = 200, armed_ns = 0, held_ns = 0, one_ns = 0;
+    size_t chunks = scattered_surface(21);
+
+    uint64_t runs = census_coh_run_count();
+    census_coh_arm(view, SCATTERED, refused, SCATTERED);
+    CHECK(census_coh_run_count() - runs == chunks, "an arm is one run a chunk: %llu for %zu chunks",
+          (unsigned long long)(census_coh_run_count() - runs), chunks);
+    int right = 0;
+    for (size_t i = 0; i < SCATTERED; i++) right += census_page_state((void *)scattered_main[i]) == 1;
+    CHECK(right == SCATTERED, "every page armed");
+    runs = census_coh_run_count();
+    census_coh_hold(view, SCATTERED, false, came, SCATTERED);
+    CHECK(census_coh_run_count() - runs == chunks, "a hold too");
+
+    census_coh_arm(view + 100, 3, refused, SCATTERED);
+    right = 0;
+    for (size_t i = 0; i < SCATTERED; i++) {
+        right += census_page_state((void *)scattered_main[i]) == (i >= 100 && i < 103 ? 1 : 2);
+    }
+    CHECK(right == SCATTERED, "an arm of three pages moved those three, wherever they lie");
+    census_coh_hold(view, SCATTERED, false, came, SCATTERED);
+
+    for (uint64_t i = 0; i < tries; i++) {
+        uint64_t t0 = now_ns();
+        census_coh_arm(view, SCATTERED, refused, SCATTERED);
+        uint64_t t1 = now_ns();
+        census_coh_hold(view, SCATTERED, false, came, SCATTERED);
+        armed_ns += t1 - t0;
+        held_ns += now_ns() - t1;
+    }
+    for (uint64_t i = 0; i < 20; i++) {
+        uint64_t t0 = now_ns();
+        for (size_t p = 0; p < SCATTERED; p++) census_coh_arm(view + p, 1, refused, SCATTERED);
+        for (size_t p = 0; p < SCATTERED; p++) census_coh_hold(view + p, 1, false, came, SCATTERED);
+        one_ns += now_ns() - t0;
+    }
+    printf("    %d pages, %zu chunks: arm %.0f us, hold %.0f us; a run a page, both: %.0f us\n",
+           SCATTERED, chunks, armed_ns / 1e3 / tries, held_ns / 1e3 / tries, one_ns / 1e3 / 20);
+    census_surface_unmapped(21);
+}
+
+// Guest memory speed, the view against the main mapping, beside the markers' traffic.
+#define MAIN_GPA (64UL << 30)
+enum { COPY, VCOPY, CHASE };
+static struct vcpu speed_vcpus[8];
+struct speed_run {
+    struct vcpu *c;
+    int kind;
+    uint64_t base, bytes;
+    atomic_int *stop;
+    uint64_t done, ns;
+};
+
+static void *speed_vcpu(void *arg) {
+    struct speed_run *r = arg;
+    struct vcpu *c = r->c;
+    uint64_t src = r->base, dst = src + r->bytes, t0, rounds = 0;
+
+    setr(c, STUB(g_loop), 0, src, r->bytes * 2 / PG, PG, 0, 0);
+    run_guest(c, 0);
+    t0 = now_ns();
+    while (!atomic_load(r->stop)) {
+        if (r->kind == COPY) setr(c, STUB(g_copy), 4, 0, r->bytes, 0, src, dst);
+        else if (r->kind == VCOPY) setr(c, STUB(g_vcopy), 4, 0, r->bytes, 0, src, dst);
+        else setr(c, STUB(g_chase), 0, src, 1 << 18, 0, 0, 0);
+        if (run_guest(c, 0) != RUN_IO) DIE("speed vcpu");
+        rounds++;
+    }
+    r->ns = now_ns() - t0;
+    r->done = r->kind == CHASE ? rounds << 18 : rounds * 4 * r->bytes;
+    return 0;
+}
+
+// The markers beside the vCPUs: the scattered surface armed and held `hz` times a second, 0 flat
+// out, and with `mapped` read by a vCPU of its own while held, so each move has EPT entries to zap
+// and every vCPU a TLB shootdown to take.
+static struct { int hz, mapped; atomic_int *stop; uint64_t frames; int per_page; } traffic;
+
+static void *traffic_thread(void *unused) {
+    static uint64_t refused[SCATTERED], came[SCATTERED];
+    uint64_t *view = scattered_view;
+    struct vcpu *reader = &speed_vcpus[7];
+    uint64_t span = SCATTERED / SCATTERED_RUN * (SCATTERED_RUN + 1);
+
+    while (!atomic_load(traffic.stop)) {
+        if (traffic.mapped) {
+            setr(reader, STUB(g_loop), 0, DATA_GPA + SCATTERED_OFF, span, PG, 0, 0);
+            if (run_guest(reader, 0) != RUN_IO) DIE("traffic reader");
+        }
+        if (traffic.per_page) {
+            for (size_t p = 0; p < SCATTERED; p++) census_coh_arm(view + p, 1, refused, SCATTERED);
+            for (size_t p = 0; p < SCATTERED; p++) census_coh_hold(view + p, 1, false, came, SCATTERED);
+        } else {
+            census_coh_arm(view, SCATTERED, refused, SCATTERED);
+            census_coh_hold(view, SCATTERED, false, came, SCATTERED);
+        }
+        traffic.frames++;
+        if (traffic.hz) usleep(1000000 / traffic.hz);
+    }
+    return 0;
+}
+
+static double speed(int kind, uint64_t base, int n, uint64_t bytes) {
+    static struct speed_run runs[16];
+    pthread_t t[16], th;
+    atomic_int stop = 0;
+    double total = 0;
+
+    traffic.stop = &stop;
+    traffic.frames = 0;
+    for (int i = 0; i < n; i++) {
+        uint64_t off = 0x40000000UL + i * 2 * (bytes + (1 << 20));
+
+        runs[i] = (struct speed_run){&speed_vcpus[i], kind, base + off, bytes, &stop};
+        // A ring through every page in a random order, each load a walk of the page tables.
+        for (uint64_t pages = bytes / PG, p = 0, at = 0; kind == CHASE && p < pages; p++) {
+            static uint32_t order[1 << 16];
+
+            if (p == 0) {
+                for (uint64_t k = 0; k < pages; k++) order[k] = k;
+                for (uint64_t k = pages - 1; k > 0; k--) {
+                    uint64_t j = rand() % (k + 1), t = order[k];
+                    order[k] = order[j]; order[j] = t;
+                }
+            }
+            at = order[p];
+            *(uint64_t *)(main_map + off + at * PG) = base + off + order[(p + 1) % pages] * PG;
+        }
+        pthread_create(&t[i], 0, speed_vcpu, &runs[i]);
+    }
+    if (traffic.hz >= 0) pthread_create(&th, 0, traffic_thread, 0);
+    usleep(2500000);
+    atomic_store(&stop, 1);
+    if (traffic.hz >= 0) pthread_join(th, 0);
+    for (int i = 0; i < n; i++) {
+        pthread_join(t[i], 0);
+        total += kind == CHASE ? runs[i].ns / (double)runs[i].done : runs[i].done * 1e3 / runs[i].ns;
+    }
+    return kind == CHASE ? total / n : total;
+}
+
+static void t_guest_speed(void) {
+    printf("[speed] guest memory on the view and on the main mapping (MB/s all vCPUs, ns a load)\n");
+    static const char *kinds[] = {"rep movsb", "avx2 copy", "chase"};
+    struct kvm_userspace_memory_region m = {.slot = 2, .guest_phys_addr = MAIN_GPA, .memory_size = mem_len,
+                                            .userspace_addr = (uint64_t)main_map};
+    if (ioctl(vmfd, KVM_SET_USER_MEMORY_REGION, &m)) DIE("slot 2");
+    for (int i = 0; i < 8; i++) vcpu_init(&speed_vcpus[i], 40 + i);
+    traffic.hz = -1;
+    for (int n = 1; n <= 7; n += 6) {
+        for (uint64_t bytes = 8 << 20; bytes <= (256 << 20); bytes <<= 5) {
+            for (int kind = COPY; kind <= CHASE; kind++) {
+                double view = speed(kind, DATA_GPA, n, bytes), main = speed(kind, MAIN_GPA, n, bytes);
+                printf("    %d vCPU %3llu MiB %-9s view %9.2f main %9.2f (%+.1f%%)\n", n,
+                       (unsigned long long)(bytes >> 20), kinds[kind], view, main, (view / main - 1) * 100);
+            }
+        }
+    }
+    printf("[speed] 7 vCPUs' avx2 copy of 8 MiB on the view, markers beside them\n");
+    scattered_surface(22);
+    static const struct { const char *what; int hz, mapped, per_page; } cases[] = {
+        {"no markers", -1, 0, 0},
+        {"26 Hz", 26, 0, 0},
+        {"26 Hz, read by a vCPU", 26, 1, 0},
+        {"flat out", 0, 0, 0},
+        {"flat out, read by a vCPU", 0, 1, 0},
+        {"26 Hz, read, a run a page", 26, 1, 1},
+    };
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        traffic.hz = cases[i].hz; traffic.mapped = cases[i].mapped; traffic.per_page = cases[i].per_page;
+        double rate = speed(VCOPY, DATA_GPA, 7, 8 << 20);
+        printf("    %-28s %9.1f MB/s, %.0f frames/s\n", cases[i].what, rate, traffic.frames / 2.5);
+    }
+    census_surface_unmapped(22);
+}
+
 static void t_fuse_coherent(struct vcpu *c) {
     printf("[fuse] an -EFAULT nothing explains: everything lands, markers off\n");
     surface(11, 0xd00000);
@@ -491,6 +700,8 @@ int main(int argc, char **argv) {
     t_coherent_race(mib);
     t_arm_window();
     t_coherent_cost(&c);
+    t_scattered();
+    if (getenv("CENSUS_SPEED")) t_guest_speed();
     t_fuse_coherent(&c);
     census_flush();
     printf("%s: %d failed\n", failures ? "FAILED" : "PASSED", failures);
