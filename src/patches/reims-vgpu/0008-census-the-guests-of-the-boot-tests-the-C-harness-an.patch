diff --git a/scripts/internal/census/census_report.py b/scripts/internal/census/census_report.py
index 9b9fe2a2..c3609449 100644
--- a/scripts/internal/census/census_report.py
+++ b/scripts/internal/census/census_report.py
@@ -9,6 +9,10 @@
 A mark is one line in <dir>/mark ("motionbench"), which the census reads within 50 ms. "every 1"
 there sets the re-arm period instead. A page counts once a window: touches/frame cannot exceed
 pages/window divided by the window's frames, so read `touched windows` with `every`.
+
+pages R were only read in their window and pages W were caught writing. pages R|W were read, then
+opened when a write hit some page held from an earlier read: at least one of them was written,
+and KVM does not say which. `sat` counts windows the saturation fuse cut short.
 """
 
 import argparse
@@ -91,7 +95,7 @@ def fmt(s):
 def table(surfaces, per, frames, windows, every, rw):
     print(f"frames {frames}, windows {windows}" + (f", one window every {every} frames" if every else ""))
     print(f"{'surface':>7} {'facts':<44} {'present':>7} {'traps':>8} {'/frame':>8} {'win':>6}"
-          f" {'pages R':>8} {'pages W':>8} {'sat':>4} {'upg':>5} {'k/u':>9}  top RIPs")
+          f" {'pages R':>8} {'pages W':>8} {'R|W':>8} {'sat':>4} {'k/u':>9}  top RIPs")
     rows = []
     for serial, p in per.items():
         rows.append((p["traps"], serial, p))
@@ -99,9 +103,11 @@ def table(surfaces, per, frames, windows, every, rw):
         s = surfaces.get(serial, {})
         top = sorted(p["rips"].items(), key=lambda kv: -kv[1])[:3]
         rate = p["traps"] / frames if frames else 0
+        caught = max(p["pages_w"] - p["upgrades"], 0)  # pages_w holds every page a write opened
         print(f"{serial:>7} {fmt(s):<44.44} {p['presents']:>7} {p['traps']:>8} {rate:>8.2f}"
               f" {p['windows_touched']:>6} {p['pages_r']:>8}"
-              f" {p['pages_w'] if rw else '-':>8} {p['windows_saturated']:>4} {p['upgrades']:>5}"
+              f" {caught if rw else '-':>8} {p['upgrades'] if rw else '-':>8}"
+              f" {p['windows_saturated']:>4}"
               f" {p['cpl0']:>4}/{p['cpl3']:<4}  " + " ".join(f"{r}:{n}" for r, n in top))
     armed = [s for s in surfaces.values() if s.get("armed_pages")]
     untouched = len(armed) - sum(1 for serial in per if surfaces.get(serial, {}).get("armed_pages"))
diff --git a/scripts/internal/census/guest/device.c b/scripts/internal/census/guest/device.c
new file mode 100644
index 00000000..1408b8cb
--- /dev/null
+++ b/scripts/internal/census/guest/device.c
@@ -0,0 +1,107 @@
+/* A multiboot guest that drives the real IOSurface device, as macOS's mapper driver does, over
+ * PCI: real Reims map and unmap commands reach the census, and this guest's own loads and stores
+ * trap. 32-bit protected mode, paging off. Exit code (stage << 1) | 1: 0x11 passes.
+ * CMOS byte 0x34 counts boots: the first boot resets the machine with a surface armed. */
+#include <stdint.h>
+#define RING 0x01000000u
+#define TABLE 0x01001000u
+#define DPAGE 0x01002000u
+#define ROOT 0x01010000u
+#define SURF 0x20000000u
+#define PAGES 1024u
+#define ID 5u
+#define HOST_ONLY_ID 6u
+#define PG 4096u
+
+static inline void outb(uint16_t p, uint8_t v) { __asm__ volatile("outb %0,%1" : : "a"(v), "Nd"(p)); }
+static inline uint8_t inb(uint16_t p) { uint8_t v; __asm__ volatile("inb %1,%0" : "=a"(v) : "Nd"(p)); return v; }
+static inline void outl(uint16_t p, uint32_t v) { __asm__ volatile("outl %0,%1" : : "a"(v), "Nd"(p)); }
+static inline uint32_t inl(uint16_t p) { uint32_t v; __asm__ volatile("inl %1,%0" : "=a"(v) : "Nd"(p)); return v; }
+static void die(int stage) { outb(0xf4, stage); for (;;) __asm__("hlt"); }
+#define R32(a) (*(volatile uint32_t *)(uintptr_t)(a))
+#define R64(a) (*(volatile uint64_t *)(uintptr_t)(a))
+static uint32_t cfg(int d, int r) { outl(0xcf8, 0x80000000u | d << 11 | r); return inl(0xcfc); }
+static void cfgw(int d, int r, uint32_t v) { outl(0xcf8, 0x80000000u | d << 11 | r); outl(0xcfc, v); }
+
+static uint32_t bar, wr;
+static uint32_t pte(uint32_t pa) { return (pa >> 12) << 2 | 1; }
+
+static int cmd(uint32_t c, uint32_t id) {
+    uint32_t at = RING + (wr % 256) * 16;
+    R32(at) = c; R32(at + 4) = id; R32(at + 8) = 0x5555;
+    wr++;
+    R32(bar + 0x1018) = wr;
+    for (uint32_t n = 0; R32(bar + 0x1020) != wr; n++)
+        if (n > 400000000u) die(0x30);
+    return R32(at + 8);
+}
+static void descriptor(uint32_t id, int host_only) {
+    uint32_t d = DPAGE + id * 0x400;
+    for (uint32_t i = 0; i < 0x400; i += 4) R32(d + i) = 0;
+    R32(d) = pte(ROOT);
+    R32(d + 4) = 0x42475241;
+    R64(d + 0x18) = PAGES * PG;
+    R64(d + 0x20) = 1024;
+    R64(d + 0x28) = 1024;
+    R64(d + 0x30) = 4096;
+    *(volatile uint16_t *)(d + 0x38) = 4;
+    *(volatile uint8_t *)(d + 0x3c) = 1;
+    *(volatile uint8_t *)(d + 0x3d) = 1;
+    *(volatile uint8_t *)(d + 0x3f) = 0; /* address_format */
+    *(volatile uint8_t *)(d + 0x40) = 0; /* compression_type */
+    *(volatile uint8_t *)(d + 0x41) = host_only ? 2 : 0;
+    /* protection_options stays 0: Linux refuses it over guest pages. */
+}
+static uint32_t page(uint32_t i) { return SURF + 2 * i * PG; } /* scattered, as a surface's are */
+
+void main_c(void) {
+    uint8_t boots;
+    outb(0x70, 0x34); boots = inb(0x71); outb(0x70, 0x34); outb(0x71, boots + 1);
+
+    for (int d = 0; d < 32 && !bar; d++)
+        if (cfg(d, 0) == (0xeeefu << 16 | 0x106b)) {
+            bar = cfg(d, 0x10) & ~0xfu;
+            cfgw(d, 4, cfg(d, 4) | 6);
+        }
+    if (!bar) die(0x31);
+    for (uint32_t i = 0; i < 16; i++) R32(TABLE + 4 * i) = pte(DPAGE + i * PG);
+    for (uint32_t i = 0; i < PAGES; i++) R32(ROOT + 4 * i) = pte(page(i));
+    R32(bar + 0x1030) = 1;
+    R32(bar + 0x1000) = RING;
+    R32(bar + 0x1008) = 256;
+    R32(bar + 0x1010) = TABLE;
+    wr = R32(bar + 0x1020);
+    if (boots) {
+        /* The second boot: the surface left armed is gone, and a map works again. */
+        descriptor(ID, 0);
+        if (cmd(1, ID)) die(0x32);
+        for (uint32_t i = 0; i < PAGES; i++) R32(page(i)) = i;
+        if (cmd(2, ID)) die(0x33);
+        die(0x11);
+    }
+    descriptor(ID, 0);
+    if (cmd(1, ID)) die(0x34);
+    for (uint32_t round = 1; round <= 300; round++) {
+        volatile uint32_t sink = 0;
+        for (uint32_t i = 0; i < PAGES; i++) sink += R32(page(i) + 8);
+        for (uint32_t i = 0; i < PAGES / 2; i++) R32(page(i) + 8) = round + i;
+        for (uint32_t i = 0; i < PAGES / 2; i++)
+            if (R32(page(i) + 8) != round + i) die(0x35);
+        for (uint32_t n = 0; n < 300000; n++) __asm__("pause");
+    }
+    /* The host's own write, through the main mapping and the surface's view: the guest must read
+     * it through a marker. The test command writes each 8-byte word its own offset. */
+    if (cmd(3, ID)) die(0x36);
+    for (uint32_t i = 0; i < PAGES; i++)
+        if (R32(page(i) + 8) != i * PG + 8) die(0x37);
+    if (cmd(2, ID)) die(0x38);
+    for (uint32_t i = 0; i < PAGES; i++) R32(page(i) + 8) = 7; /* free pages, no trap */
+    descriptor(HOST_ONLY_ID, 1);
+    if (cmd(1, HOST_ONLY_ID)) die(0x39);
+    if (cmd(2, HOST_ONLY_ID)) die(0x3a);
+    descriptor(ID, 0);
+    if (cmd(1, ID)) die(0x3b);
+    for (uint32_t i = 0; i < PAGES; i++) (void)R32(page(i));
+    outb(0xcf9, 0x06); /* reset with the surface mapped, armed and held */
+    for (;;) __asm__("hlt");
+}
