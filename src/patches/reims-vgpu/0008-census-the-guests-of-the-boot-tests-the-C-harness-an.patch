diff --git a/scripts/internal/census/guest/run.sh b/scripts/internal/census/guest/run.sh
new file mode 100755
index 00000000..ec129251
--- /dev/null
+++ b/scripts/internal/census/guest/run.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+# run.sh <name> <guest.elf> <gfx: 0|1> [ENV=VALUE]...: boots a guest in the run image, own container,
+# as macos-vm does, under taskset 8-19, on lavapipe: no GPU, no disk. Output in
+# /srv/warm/census/out/<name>. Exit 35 is the guest's pass.
+#
+#   gcc -m32 -c guest.S -o guest.o && ld -m elf_i386 -T link.ld -o guest.elf guest.o
+#   gcc -m32 -O1 -ffreestanding -fno-pic -fno-pie -fno-stack-protector -mno-sse -nostdlib -static \
+#     -c device.c -o device.o && gcc -m32 -c device_start.S -o device_start.o \
+#     && ld -m elf_i386 -T link.ld -o device.elf device_start.o device.o
+#   run.sh on $PWD/guest.elf 0 REIMS_VGPU_CENSUS=/srv/warm/census/out/on \
+#     REIMS_VGPU_CENSUS_SELFTEST=20000000:1000000
+#   run.sh dev $PWD/device.elf 1 REIMS_VGPU_CENSUS=/srv/warm/census/out/dev REIMS_VGPU_WINDOW=0
+name=$1 elf=$2 gfx=$3; shift 3
+Q=/srv/data/macos-vm/home/.local/share/reims-ctl/qemu/${CENSUS_BUILD:-20261031-220217-2e0d4d1-census}
+O=/srv/warm/census/out/$name
+rm -rf "$O"; mkdir -p "$O"
+args=()
+for e in "$@"; do args+=(-e "$e"); done
+dev=()
+[ "$gfx" = 1 ] && dev=(-device apple-gfx-pci,id=gfx,bus=pcie.0,addr=0x4,displays=1,resolution=1280x720 -device apple-gfx-iosurface-pci,id=iosfc,gpu=gfx,bus=pcie.0,addr=0x6)
+timeout ${LIMIT:-60} docker run -i --rm --name census-boot-$name --init \
+  --security-opt seccomp=unconfined --security-opt apparmor=unconfined --device /dev/kvm \
+  -e HOME=/srv/warm/census/home -e VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json \
+  -e VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json -e RUST_LOG=${RUST_LOG:-warn} "${args[@]}" \
+  -v /srv/data/macos-vm/home/.local/share/reims-ctl/qemu:/srv/data/macos-vm/home/.local/share/reims-ctl/qemu:ro \
+  -v /srv/warm/census:/srv/warm/census macos-vm:run2 \
+  sh -c 'echo cap $(grep CapEff /proc/self/status) >&2; exec taskset -c 8-19 "$@"' sh $Q/bin/qemu-system-x86_64 -L $Q/share/qemu \
+    -accel kvm -cpu host -smp 2 -machine q35,memory-backend=ram -display none -vga none \
+    -object memory-backend-memfd,id=ram,size=1G,share=on \
+    -device isa-debug-exit,iobase=0xf4,iosize=1 -chardev file,id=dbg,path=$O/console -device isa-debugcon,iobase=0xe9,chardev=dbg -serial none -monitor ${MON:-none} \
+    -kernel "$elf" "${dev[@]}" ${EXTRA:-}
+echo "exit $?"
