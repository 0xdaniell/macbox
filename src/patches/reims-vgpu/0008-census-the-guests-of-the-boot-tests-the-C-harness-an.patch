diff --git a/scripts/internal/census/guest/guest.S b/scripts/internal/census/guest/guest.S
new file mode 100644
index 00000000..cdd2ab1a
--- /dev/null
+++ b/scripts/internal/census/guest/guest.S
@@ -0,0 +1,101 @@
+/* A multiboot guest for the census's boot test: runs in 32-bit protected mode with paging off,
+ * walks the armed range reading, writing and with rep movs, then resets the machine once through
+ * port 0xcf9 and, on the second boot, leaves through isa-debug-exit. CMOS byte 0x34 counts boots. */
+    .set MB_MAGIC, 0x1badb002
+    .set MB_FLAGS, 0x00010000
+    .section .multiboot, "a"
+    .align 4
+header:
+    .long MB_MAGIC, MB_FLAGS, -(MB_MAGIC + MB_FLAGS)
+    .long header, header, _edata, _end, _start
+    .text
+    .code32
+    .globl _start
+_start:
+    cli
+    movl $0x00f00000, %esp
+    movb $0x34, %al
+    outb %al, $0x70
+    inb $0x71, %al
+    movb %al, %bl          /* boots so far */
+    incb %al
+    movb %al, %cl
+    movb $0x34, %al
+    outb %al, $0x70
+    movb %cl, %al
+    outb %al, $0x71
+
+    movl $200, %ebp        /* rounds */
+1:  movl $0x20000000, %esi /* armed: 16 MiB at 512 MiB */
+    movl $4096, %ecx
+2:  movl (%esi), %eax      /* read every page */
+    addl $4096, %esi
+    loop 2b
+    movl $0x20000000, %edi
+    movl $2048, %ecx
+3:  movl %ebp, (%edi)      /* write half of them */
+    addl $4096, %edi
+    loop 3b
+    movl $0x20400000, %esi /* rep movs across pages, armed to armed */
+    movl $0x20800000, %edi
+    movl $0x4000, %ecx
+    rep movsl
+    /* the guest's pages are the truth: read back what it wrote */
+    movl $0x20000000, %edi
+    movl $2048, %ecx
+4:  cmpl %ebp, (%edi)
+    jne fail
+    addl $4096, %edi
+    loop 4b
+    movl $20000, %ecx      /* some time for the windows to turn */
+5:  pause
+    loop 5b
+    decl %ebp
+    jnz 1b
+
+    cmpb $0, %bl
+    jne done
+    movb $0x06, %al        /* reset with the surface armed */
+    movw $0xcf9, %dx
+    outb %al, %dx
+6:  hlt
+    jmp 6b
+done:
+    movb $0x11, %al        /* qemu exits 35: the pass, soon after this */
+    outb %al, $0xf4
+10: hlt
+    jmp 10b
+fail:
+    movl (%edi), %esi      /* what the guest read, again */
+    movl %ebp, %eax
+    call hex
+    movl %edi, %eax
+    call hex
+    movl %esi, %eax
+    call hex
+    movl %ecx, %eax
+    call hex
+    movzbl %bl, %eax
+    call hex
+    movl %edi, %esi        /* the same word through the next read of a neighbour */
+    movl -4(%esi), %eax
+    call hex
+    movb $0x22, %al        /* qemu exits 69 */
+    outb %al, $0xf4
+7:  hlt
+    jmp 7b
+hex:                       /* %eax to the debug console, as 8 digits and a space */
+    movl %eax, %edx
+    movl $8, %ecx
+8:  roll $4, %edx
+    movb %dl, %al
+    andb $15, %al
+    addb $48, %al
+    cmpb $58, %al
+    jb 9f
+    addb $39, %al
+9:  outb %al, $0xe9
+    loop 8b
+    movb $32, %al
+    outb %al, $0xe9
+    ret
