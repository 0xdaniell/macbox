@@ -407,6 +441,87 @@ mod tests {
     use crate::testkit::platform::FakePlatform;
     use crate::testkit::script::Step;
 
+    /// The census's sink hears of a map with the guest's pages, of an unmap before it returns and
+    /// only when it succeeds, and of each surface a teardown drops. The process has one sink, and
+    /// other tests' rigs run beside this one, so it keeps what this thread does.
+    mod census {
+        use std::thread::ThreadId;
+
+        use super::*;
+        use crate::census::{Sink, SurfaceFacts};
+
+        #[derive(Debug, Clone, PartialEq, Eq)]
+        enum Heard {
+            Mapped(SurfaceFacts, Vec<u64>, u64),
+            Unmapped(u32),
+        }
+
+        static HEARD: parking_lot::Mutex<Vec<(ThreadId, Heard)>> =
+            parking_lot::Mutex::new(Vec::new());
+
+        struct Recorder;
+
+        impl Sink for Recorder {
+            fn mapped(&self, facts: &SurfaceFacts, pages: &[u64], page_size: u64) {
+                let heard = Heard::Mapped(*facts, pages.to_vec(), page_size);
+                HEARD.lock().push((std::thread::current().id(), heard));
+            }
+            fn unmapped(&self, mapping_id: u32) {
+                let heard = Heard::Unmapped(mapping_id);
+                HEARD.lock().push((std::thread::current().id(), heard));
+            }
+            fn used(&self, _: u32, _: u64, _: u64) {}
+            fn presented(&self, _: u64) {}
+        }
+
+        fn take_mine() -> Vec<Heard> {
+            let me = std::thread::current().id();
+            let mut heard = HEARD.lock();
+            let mine = heard.iter().filter(|h| h.0 == me).map(|h| h.1.clone());
+            let mine = mine.collect();
+            heard.retain(|h| h.0 != me);
+            mine
+        }
+
+        #[test]
+        fn a_sink_hears_the_maps_and_unmaps_the_guest_sees() {
+            crate::census::register(Box::new(Recorder));
+            let r = rig();
+            r.mapped_v2(3, 2);
+            let d = v2(2, ROOT);
+            let facts = SurfaceFacts {
+                mapping_id: 3,
+                pixel_format: d.base.pixel_format,
+                width: d.base.width,
+                height: d.base.height,
+                bytes_per_row: d.base.bytes_per_row,
+                alloc_size: d.base.alloc_size,
+                protection_options: d.base.protection_options,
+                address_format: u32::from(d.base.address_format),
+                compression_type: u32::from(d.base.compression_type),
+                read_only: false,
+                host_only: false,
+            };
+            let pages = vec![r.host(SURF), r.host(SURF + PAGE)];
+            assert!(
+                take_mine().contains(&Heard::Mapped(facts, pages, PAGE)),
+                "the guest's pages"
+            );
+            let held = r.held(3);
+            assert_eq!(r.unmap(3), IoReturn::Busy);
+            assert_eq!(take_mine(), [], "a busy unmap keeps the surface");
+            drop(held);
+            assert_eq!(r.unmap(3), IoReturn::Success);
+            assert_eq!(take_mine(), [Heard::Unmapped(3)]);
+            assert_eq!(r.unmap(3), IoReturn::Success);
+            assert_eq!(take_mine(), [], "an empty slot is nothing to hear");
+            r.mapped_v2(4, 1);
+            take_mine();
+            r.teardown();
+            assert_eq!(take_mine(), [Heard::Unmapped(4)]);
+        }
+    }
+
     mod map {
         use super::*;
 
