diff --git a/crates/reims-vgpu-c/src/census.rs b/crates/reims-vgpu-c/src/census.rs
new file mode 100644
index 00000000..c1fdaafa
--- /dev/null
+++ b/crates/reims-vgpu-c/src/census.rs
@@ -0,0 +1,215 @@
+//! LOCAL (Atlas): the touch census's news of the guest's surfaces, [`RvgCensusCallbacks`], and
+//! `rvg_census_set_callbacks`. See `reims_vgpu_core::census`.
+
+use std::ffi::c_void;
+
+use reims_vgpu_core::census::{self, Sink, SurfaceFacts};
+
+use crate::ffi;
+use crate::sized::{self, HostStruct};
+use crate::status::{RVG_ERR_INVALID_ARGUMENT, RVG_OK, RvgStatus};
+
+/// What a surface's descriptor says of it.
+#[repr(C)]
+#[derive(Clone, Copy)]
+#[expect(
+    missing_docs,
+    reason = "the fields' names say what they hold, as the header shows them"
+)]
+pub struct RvgCensusSurface {
+    pub mapping_id: u32,
+    pub pixel_format: u32,
+    pub width: u64,
+    pub height: u64,
+    pub bytes_per_row: u64,
+    pub alloc_size: u64,
+    pub protection_options: u64,
+    pub address_format: u32,
+    pub compression_type: u32,
+    pub read_only: bool,
+    pub host_only: bool,
+}
+
+/// `mapped(ctx, surface, pages, page_count, page_size)`: a surface was mapped, with each guest
+/// page's host address.
+///
+/// Thread: the IOSurface device's own, under its state's lock. May call: nothing of this header.
+pub type RvgCensusMappedFn = Option<
+    unsafe extern "C-unwind" fn(
+        ctx: *mut c_void,
+        surface: *const RvgCensusSurface,
+        pages: *const u64,
+        page_count: usize,
+        page_size: u64,
+    ),
+>;
+
+/// `unmapped(ctx, mapping_id)`: the surface goes, and its pages may be reused when this returns.
+///
+/// Thread: the IOSurface device's own, under its state's lock. May call: nothing of this header.
+pub type RvgCensusUnmappedFn =
+    Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, mapping_id: u32)>;
+
+/// `used(ctx, mapping_id, usage, storage_mode)`: a texture was made over the surface.
+///
+/// Thread: the task's that made it. May call: nothing of this header.
+pub type RvgCensusUsedFn = Option<
+    unsafe extern "C-unwind" fn(
+        ctx: *mut c_void,
+        mapping_id: u32,
+        usage: u64,
+        storage_mode: u64,
+    ),
+>;
+
+/// `presented(ctx, mapping_id)`: a frame was presented; 0 for a kernel task's backing.
+///
+/// Thread: the present's, under the guest display's mutex: it must not wait. May call: nothing of
+/// this header.
+pub type RvgCensusPresentedFn =
+    Option<unsafe extern "C-unwind" fn(ctx: *mut c_void, mapping_id: u64)>;
+
+/// The touch census's callbacks.
+#[repr(C)]
+#[derive(Clone, Copy)]
+#[expect(
+    missing_docs,
+    reason = "the fields' names say what they hold, as the header shows them"
+)]
+pub struct RvgCensusCallbacks {
+    /// sizeof(RvgCensusCallbacks) as the host was compiled.
+    pub struct_size: u32,
+    pub ctx: *mut c_void,
+    pub mapped: RvgCensusMappedFn,
+    pub unmapped: RvgCensusUnmappedFn,
+    pub used: RvgCensusUsedFn,
+    pub presented: RvgCensusPresentedFn,
+}
+
+// SAFETY: repr(C), a u32 first; a pointer and optional function pointers.
+unsafe impl HostStruct for RvgCensusCallbacks {}
+
+/// The host's callbacks, as the core's sink.
+struct HostSink(RvgCensusCallbacks);
+
+// SAFETY: the host's contract: its functions run on any of the library's threads, with its `ctx`.
+unsafe impl Send for HostSink {}
+// SAFETY: as above.
+unsafe impl Sync for HostSink {}
+
+impl Sink for HostSink {
+    fn mapped(&self, facts: &SurfaceFacts, pages: &[u64], page_size: u64) {
+        let Some(mapped) = self.0.mapped else { return };
+        let surface = RvgCensusSurface {
+            mapping_id: facts.mapping_id,
+            pixel_format: facts.pixel_format,
+            width: facts.width,
+            height: facts.height,
+            bytes_per_row: facts.bytes_per_row,
+            alloc_size: facts.alloc_size,
+            protection_options: facts.protection_options,
+            address_format: facts.address_format,
+            compression_type: facts.compression_type,
+            read_only: facts.read_only,
+            host_only: facts.host_only,
+        };
+        let (ctx, at, count) = (self.0.ctx, pages.as_ptr(), pages.len());
+        // SAFETY: the host's function, given its context and what lives across the call.
+        ffi::host_call("census.mapped", || unsafe {
+            mapped(ctx, &raw const surface, at, count, page_size);
+        });
+    }
+
+    fn unmapped(&self, mapping_id: u32) {
+        let Some(unmapped) = self.0.unmapped else {
+            return;
+        };
+        let ctx = self.0.ctx;
+        // SAFETY: the host's function, given its context.
+        ffi::host_call("census.unmapped", || unsafe { unmapped(ctx, mapping_id) });
+    }
+
+    fn used(&self, mapping_id: u32, usage: u64, storage_mode: u64) {
+        let Some(used) = self.0.used else { return };
+        let ctx = self.0.ctx;
+        // SAFETY: the host's function, given its context.
+        ffi::host_call("census.used", || unsafe {
+            used(ctx, mapping_id, usage, storage_mode);
+        });
+    }
+
+    fn presented(&self, mapping_id: u64) {
+        let Some(presented) = self.0.presented else {
+            return;
+        };
+        let ctx = self.0.ctx;
+        // SAFETY: the host's function, given its context.
+        ffi::host_call("census.presented", || unsafe { presented(ctx, mapping_id) });
+    }
+}
+
+/// Registers the touch census's callbacks, the process's one set, before the first device. Without
+/// it the library makes none of these calls. RVG_ERR_INVALID_ARGUMENT for NULL or a second set.
+///
+/// # Safety
+/// `callbacks` is NULL or a live table. Its functions and `ctx` live as long as the process.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_census_set_callbacks(
+    callbacks: *const RvgCensusCallbacks,
+) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: the caller's contract.
+        let table = match unsafe { sized::read(callbacks) } {
+            Ok(Some(table)) => table,
+            Ok(None) => return RVG_ERR_INVALID_ARGUMENT,
+            Err(status) => return status,
+        };
+        if census::register(Box::new(HostSink(table))) {
+            RVG_OK
+        } else {
+            RVG_ERR_INVALID_ARGUMENT
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::status::RVG_ERR_UNSUPPORTED;
+
+    /// A table the host wrote is taken once; NULL, a short table and one past the library's are
+    /// refused and take no place.
+    #[test]
+    fn the_callbacks_are_taken_once() {
+        let zeroed = RvgCensusCallbacks {
+            struct_size: 0,
+            ctx: std::ptr::null_mut(),
+            mapped: None,
+            unmapped: None,
+            used: None,
+            presented: None,
+        };
+        let size = u32::try_from(size_of::<RvgCensusCallbacks>()).unwrap();
+        // SAFETY: NULL, and tables that live across each call.
+        unsafe {
+            assert_eq!(
+                rvg_census_set_callbacks(std::ptr::null()),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+            assert_eq!(rvg_census_set_callbacks(&zeroed), RVG_ERR_INVALID_ARGUMENT);
+            let mut long = [0u8; 256];
+            long[..4].copy_from_slice(&255u32.to_ne_bytes());
+            long[254] = 1;
+            assert_eq!(
+                rvg_census_set_callbacks(long.as_ptr().cast()),
+                RVG_ERR_UNSUPPORTED
+            );
+            let table = RvgCensusCallbacks {
+                struct_size: size,
+                ..zeroed
+            };
+            assert_eq!(rvg_census_set_callbacks(&table), RVG_OK);
+            assert_eq!(rvg_census_set_callbacks(&table), RVG_ERR_INVALID_ARGUMENT);
+        }
+    }
+}
