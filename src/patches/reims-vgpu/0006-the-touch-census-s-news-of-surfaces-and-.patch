new file mode 100644
index 00000000..5d3ac435
--- /dev/null
+++ b/crates/reims-vgpu-core/src/census.rs
@@ -0,0 +1,64 @@
+//! LOCAL (Atlas): what the touch census hears of the guest's surfaces: QEMU's
+//! `accel/kvm/census.c` traps the guest CPU's first touch of a page of a large IOSurface, and
+//! needs to know which pages those are, what the guest said of them, and when a frame went by.
+//!
+//! The census is the host's: it registers a [`Sink`] once, before the first device, and only when
+//! it runs. Nothing registered costs one atomic load per map, unmap, texture and present, and
+//! the library's behaviour is the same with one registered: a sink keeps no reference, and answers
+//! nothing. A sink's calls never reach the GPU, and `presented` takes no lock.
+
+use std::sync::OnceLock;
+
+/// What a surface's descriptor says of it.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub struct SurfaceFacts {
+    /// The mapping id.
+    pub mapping_id: u32,
+    /// The IOSurface pixel format.
+    pub pixel_format: u32,
+    /// The width in pixels.
+    pub width: u64,
+    /// The height in pixels.
+    pub height: u64,
+    /// Bytes per row.
+    pub bytes_per_row: u64,
+    /// The allocation's size.
+    pub alloc_size: u64,
+    /// `protection_options`.
+    pub protection_options: u64,
+    /// `address_format`.
+    pub address_format: u32,
+    /// `compression_type`.
+    pub compression_type: u32,
+    /// `readOnly`.
+    pub read_only: bool,
+    /// `hostOnly`: the surface has no guest pages.
+    pub host_only: bool,
+}
+
+/// Who hears of the surfaces.
+pub trait Sink: Send + Sync {
+    /// A surface was mapped. `pages` is each guest page's host address, none for a host-only one.
+    /// On the IOSurface device's queue, under its state's lock.
+    fn mapped(&self, facts: &SurfaceFacts, pages: &[u64], page_size: u64);
+    /// The surface at `mapping_id` goes. Called before the unmap returns to the guest, and
+    /// returns only when no trap remains on its pages, which the guest may reuse at once.
+    fn unmapped(&self, mapping_id: u32);
+    /// A texture was made over the surface at `mapping_id`.
+    fn used(&self, mapping_id: u32, usage: u64, storage_mode: u64);
+    /// A frame was presented: the surface's mapping id, 0 for a kernel task's backing.
+    fn presented(&self, mapping_id: u64);
+}
+
+static SINK: OnceLock<Box<dyn Sink>> = OnceLock::new();
+
+/// Registers `sink`, the process's one: false if there is one already.
+pub fn register(sink: Box<dyn Sink>) -> bool {
+    SINK.set(sink).is_ok()
+}
+
+/// The registered sink.
+#[inline]
+pub fn sink() -> Option<&'static dyn Sink> {
+    SINK.get().map(|sink| &**sink)
+}
