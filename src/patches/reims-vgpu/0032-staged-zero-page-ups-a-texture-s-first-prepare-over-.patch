+impl StagedTimes {
+    fn add(self) {
+        STATS.walk_ns.fetch_add(self.walk, Ordering::Relaxed);
+        STATS.scan_ns.fetch_add(self.scan, Ordering::Relaxed);
+        STATS.make_ns.fetch_add(self.make, Ordering::Relaxed);
